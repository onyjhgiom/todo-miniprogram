/* kanban */
.kb-page { min-height: 100vh; padding-bottom: 200rpx; }
.kb-header {
  padding: 32rpx 32rpx 24rpx;
  background: var(--color-card);
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
}
.kb-title { font-size: 36rpx; color: var(--color-text); font-weight: 600; }
.kb-sub { font-size: 24rpx; color: var(--color-text-mute); margin-top: 4rpx; }
.kb-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 24rpx 16rpx;
}
.kb-quadrant {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  border-top: 6rpx solid var(--kb-color);
  padding: 16rpx;
  min-height: 400rpx;
  box-shadow: var(--shadow-sm);
}
.kb-q-header {
  display: flex; align-items: center; gap: 8rpx;
  margin-bottom: 12rpx;
}
.kb-q-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--kb-color); }
.kb-q-title { flex: 1; font-size: 22rpx; color: var(--color-text); font-weight: 500; }
.kb-q-count {
  min-width: 36rpx; height: 36rpx; padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--color-bg-soft);
  color: var(--color-text-soft);
  font-size: 20rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}
.kb-q-add {
  width: 36rpx; height: 36rpx;
  border-radius: 50%;
  background: var(--kb-color);
  color: #ffffff;
  font-size: 26rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  line-height: 1;
  transition: transform var(--duration-fast) var(--ease-out);
}
.kb-q-add:active { transform: scale(0.88); opacity: 0.85; }
.kb-q-body { display: flex; flex-direction: column; gap: 8rpx; }
.kb-card {
  position: relative;
  padding: 12rpx 48rpx 12rpx 14rpx;
  background: var(--color-bg-soft);
  border-radius: 10rpx;
  border-left: 4rpx solid var(--kb-color);
  transition: all 200ms;
}
/* 常驻「完成」按钮：一步标记完成，省去弹菜单 */
.kb-card-done {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid var(--kb-color);
  color: var(--kb-color);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-card);
  transition: all 160ms var(--ease-out, ease-out);
}
.kb-card-done:active {
  background: var(--kb-color);
  color: #fff;
  transform: scale(0.9);
}
.kb-card:active { transform: scale(0.98); background: var(--color-primary-soft); }
.kb-card-text {
  font-size: 24rpx; color: var(--color-text);
  display: -webkit-box; -webkit-box-orient: vertical;
  -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden;
  word-break: break-all;
}
.kb-card-meta { font-size: 20rpx; color: var(--color-text-mute); margin-top: 4rpx; }
.kb-q-empty {
  padding: 20rpx; text-align: center;
  font-size: 22rpx; color: var(--color-text-mute);
  border: 2rpx dashed var(--color-border);
  border-radius: 8rpx;
}
.kb-tip {
  margin: 24rpx 32rpx; padding: 16rpx;
  background: var(--color-bg-soft);
  border-radius: 12rpx;
  font-size: 22rpx; color: var(--color-text-soft);
  line-height: 1.5;
}
/* 舞台层配合：fx-stage 为 fixed z-index:0，主内容容器显式抬升 */
.kb-header,
.kb-grid,
.kb-tip {
  position: relative;
  z-index: 1;
}
