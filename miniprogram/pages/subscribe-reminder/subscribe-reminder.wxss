/* pages/subscribe-reminder/subscribe-reminder.wxss
 * 订阅提醒 · 香槟金高级版
 * 浅米金底 + 玻璃拟态卡 + 香槟金渐变按钮，克制沉稳有质感。
 */
@import "../../styles/tool-shell.wxss";

page {
  background: #EEE8DF;
}

.sr {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 0 calc(48rpx + env(safe-area-inset-bottom));
  color: #252525;
  background:
    radial-gradient(circle at 88% 10%, rgba(229, 187, 120, 0.20), transparent 27%),
    radial-gradient(circle at 8% 75%, rgba(220, 229, 215, 0.38), transparent 28%),
    linear-gradient(180deg, #f3e6d3 0%, #faf7f1 43%, #f3f0e9 100%);
}

/* ===== 玻璃卡（Hero / 推荐 / 订阅项共用）===== */
.sr-glass {
  background: rgba(255, 255, 255, 0.78);
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 34rpx;
  box-shadow: 0 16rpx 44rpx rgba(91, 67, 39, 0.10);
}

/* ===== 顶部标题栏 ===== */
.sr-nav {
  position: relative;
  display: flex;
  align-items: center;
  height: 120rpx;
  padding: 0 30rpx;
}
.sr-nav__back {
  width: 60rpx;
  font-size: 62rpx;
  line-height: 1;
  color: #252525;
  font-weight: 300;
}
.sr-nav__title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
}
.sr-nav__t { display: block; font-size: 38rpx; font-weight: 700; letter-spacing: 1rpx; }
.sr-nav__s { display: block; margin-top: 6rpx; font-size: 21rpx; color: #8d8378; }
.sr-nav__acts { display: flex; gap: 14rpx; margin-left: auto; }
.sr-circle {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 10rpx 26rpx rgba(70, 50, 30, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #6b5a45;
}
.sr-circle:active { transform: scale(0.94); }

/* ===== Hero 玻璃卡 ===== */
.sr-hero {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: 0 32rpx;
  padding: 34rpx 30rpx;
}
.sr-hero__icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #fff2da, #f4d59d);
  box-shadow: inset 0 2rpx 0 #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  flex: none;
}
.sr-hero__main { flex: 1; min-width: 0; }
.sr-hero__title { font-size: 34rpx; font-weight: 700; }
.sr-hero__desc {
  margin-top: 12rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #8c857e;
  padding-right: 4rpx;
}
.sr-hero__add {
  flex: none;
  padding: 18rpx 24rpx;
  border-radius: 30rpx;
  color: #fff;
  background: linear-gradient(135deg, #d8a45a, #b9792d);
  box-shadow: 0 12rpx 28rpx rgba(174, 113, 38, 0.22);
  font-size: 24rpx;
  white-space: nowrap;
}
.sr-hero__add:active { transform: scale(0.96); }

/* ===== 分类筛选 ===== */
.sr-filters { width: 100%; white-space: nowrap; margin-top: 26rpx; }
.sr-filters-in { display: inline-flex; gap: 16rpx; padding: 0 32rpx; }
.sr-filter {
  flex: none;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 18rpx 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  color: #8b8781;
  font-size: 24rpx;
  box-shadow: 0 10rpx 26rpx rgba(80, 60, 40, 0.04);
}
.sr-filter.is-on {
  background: linear-gradient(135deg, #d7a45e, #b97d32);
  color: #fff;
  box-shadow: 0 14rpx 30rpx rgba(170, 111, 40, 0.20);
  font-weight: 600;
}
.sr-filter__ico { font-size: 22rpx; }
.sr-filter__t { line-height: 1; }
.sr-filter__n { font-size: 22rpx; }

/* ===== 订阅列表项（两段式：上行内容 + 下行操作，杜绝按钮挤压正文） ===== */
.sr-list { margin: 26rpx 32rpx 0; }
.sr-item {
  padding: 28rpx 26rpx 24rpx;
  margin-bottom: 22rpx;
}
.sr-item__top {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.sr-item__icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #fff2da, #f4d59d);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex: none;
}
.sr-item__main { flex: 1; min-width: 0; }
.sr-item__row { display: flex; align-items: center; gap: 12rpx; }
.sr-item__title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #252525;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sr-item__meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
  white-space: nowrap;
}
.sr-item__time {
  font-size: 26rpx;
  font-weight: 700;
  color: #b98135;
  letter-spacing: 0.5rpx;
}
.sr-item__freq {
  font-size: 21rpx;
  color: #9b958d;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sr-item__note {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #9b958d;
}
/* 开关 */
.sr-switch {
  width: 76rpx;
  height: 42rpx;
  border-radius: 21rpx;
  background: rgba(160, 150, 140, 0.32);
  padding: 4rpx;
  box-sizing: border-box;
  transition: background 0.22s ease;
  flex: none;
}
.sr-switch.is-on { background: linear-gradient(135deg, #d7a45e, #b97d32); }
.sr-switch__knob {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(90, 70, 40, 0.22);
  transition: transform 0.22s ease;
}
.sr-switch.is-on .sr-switch__knob { transform: translateX(34rpx); }
/* 操作按钮：独立成行，与上方内容用发丝线分隔，三键等宽对齐 */
.sr-item__acts {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(120, 95, 60, 0.08);
}
.sr-act {
  flex: 1;
  height: 60rpx;
  border-radius: 20rpx;
  background: rgba(160, 140, 110, 0.10);
  color: #6b6259;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}
.sr-act--primary {
  background: linear-gradient(135deg, #d7a45e, #b97d32);
  color: #fff;
  font-weight: 600;
}
.sr-act--danger { color: #b4635a; }
.sr-act:active { transform: scale(0.96); }

/* ===== 主按钮 ===== */
.sr-main-add {
  width: 410rpx;
  height: 94rpx;
  margin: 36rpx auto 0;
  border-radius: 47rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #d7a45c, #b97b30);
  box-shadow: 0 18rpx 38rpx rgba(177, 117, 41, 0.22);
}
.sr-main-add:active { transform: scale(0.97); }

/* ===== 空状态插画（日历 + 铃铛 + 轨道） ===== */
.sr-empty { text-align: center; padding: 40rpx 32rpx 0; }
.sr-ill {
  position: relative;
  width: 300rpx;
  height: 250rpx;
  margin: 0 auto;
}
.sr-ill__orbit {
  position: absolute;
  top: 20rpx;
  left: 0;
  width: 300rpx;
  height: 130rpx;
  border: 2rpx solid rgba(210, 155, 74, 0.32);
  border-radius: 50%;
  transform: rotate(-9deg);
}
.sr-ill__cal {
  position: absolute;
  left: 78rpx;
  top: 60rpx;
  width: 184rpx;
  height: 160rpx;
  border-radius: 34rpx;
  background: linear-gradient(145deg, #fff, #f5ead8);
  border: 2rpx solid #eee0ca;
  box-shadow: 0 26rpx 48rpx rgba(119, 88, 45, 0.16);
  transform: rotate(-4deg);
}
.sr-ill__ring {
  position: absolute;
  top: -12rpx;
  width: 24rpx;
  height: 40rpx;
  border: 6rpx solid #c58d48;
  border-radius: 14rpx;
}
.sr-ill__ring--l { left: 34rpx; }
.sr-ill__ring--r { right: 34rpx; }
.sr-ill__check {
  position: absolute;
  left: 50%;
  top: 58rpx;
  transform: translateX(-50%);
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #fff1d4;
  color: #c88c3b;
  font-size: 42rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sr-ill__bell {
  position: absolute;
  right: 34rpx;
  bottom: 20rpx;
  width: 76rpx;
  height: 84rpx;
  border-radius: 42rpx 42rpx 20rpx 20rpx;
  background: linear-gradient(145deg, #e8b35e, #a96f29);
  box-shadow: 0 16rpx 30rpx rgba(155, 103, 39, 0.25);
}
.sr-ill__bell::after {
  content: '';
  position: absolute;
  left: 26rpx;
  bottom: -12rpx;
  width: 24rpx;
  height: 12rpx;
  border-radius: 0 0 16rpx 16rpx;
  background: #a56b28;
}
.sr-empty__t { margin-top: 26rpx; font-size: 38rpx; font-weight: 700; }
.sr-empty__s {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #9b958d;
}
.sr-empty__l { display: block; }

/* ===== 热门推荐 ===== */
.sr-rec {
  margin: 46rpx 32rpx 32rpx;
  padding: 30rpx 24rpx 26rpx;
}
.sr-rec__hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 6rpx 26rpx;
}
.sr-rec__t { font-size: 32rpx; font-weight: 700; }
.sr-rec__more { font-size: 22rpx; color: #a08d76; }
.sr-rec__grid { display: flex; }
.sr-rec__item {
  flex: 1;
  text-align: center;
  padding: 10rpx 8rpx;
  position: relative;
}
.sr-rec__item::after {
  content: '';
  position: absolute;
  right: 0;
  top: 16rpx;
  height: 136rpx;
  width: 2rpx;
  background: rgba(80, 60, 40, 0.08);
}
.sr-rec__item:last-child::after { display: none; }
.sr-rec__ico {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin: 0 auto 14rpx;
  font-size: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sr-rec__n { display: block; font-size: 24rpx; font-weight: 600; }
.sr-rec__d { display: block; margin-top: 8rpx; font-size: 20rpx; color: #aaa39b; }
.sr-rec__item:active { transform: scale(0.96); }

/* ===== 质感面板 ===== */
.sr-sheet-scope {
  margin: 0 32rpx 20rpx;
  padding: 26rpx 24rpx;
}
.sr-theme-row { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.sr-theme-row:last-child { margin-bottom: 0; }
.sr-theme-label { font-size: 23rpx; color: #8d8378; margin-right: 6rpx; }
.sr-theme-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  font-size: 22rpx;
  color: #7b736a;
}
.sr-theme-chip.is-on {
  background: linear-gradient(135deg, #d7a45e, #b97d32);
  color: #fff;
  font-weight: 600;
}
.sr-theme-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }

/* ===== 弹层 ===== */
.sr-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.28);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.sr-sheet {
  width: 100%;
  box-sizing: border-box;
  background: #fbf8f3;
  border-radius: 48rpx 48rpx 0 0;
  padding: 30rpx 34rpx calc(44rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -26rpx 80rpx rgba(0, 0, 0, 0.18);
  max-height: 86vh;
  overflow-y: auto;
}
.sr-sheet__handle {
  width: 68rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #d6d0c8;
  margin: 0 auto 32rpx;
}
.sr-sheet__title { font-size: 34rpx; font-weight: 700; margin-bottom: 26rpx; }
.sr-sheet__save {
  margin-top: 34rpx;
  height: 92rpx;
  border-radius: 40rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #d7a45c, #b97b30);
  box-shadow: 0 16rpx 34rpx rgba(177, 117, 41, 0.22);
}
.sr-sheet__save:active { transform: scale(0.98); }
.sr-sheet__grid { display: flex; flex-wrap: wrap; gap: 18rpx; }
.sr-tpl {
  width: calc(50% - 9rpx);
  box-sizing: border-box;
  padding: 26rpx 22rpx;
  border-radius: 30rpx;
  background: #fff;
  border: 2rpx solid #eee5da;
}
.sr-tpl:active { transform: scale(0.97); }
.sr-tpl__t { display: block; font-size: 27rpx; font-weight: 600; color: #3a342e; }
.sr-tpl__d { display: block; margin-top: 10rpx; font-size: 21rpx; color: #9d968d; }

/* ===== 表单 ===== */
.sr-field { margin-bottom: 26rpx; }
.sr-field__label { display: block; font-size: 23rpx; color: #8d8378; margin-bottom: 12rpx; }
.sr-field__label-row { display: flex; align-items: center; justify-content: space-between; }
.sr-link { font-size: 23rpx; color: #b98135; }
.sr-field__input {
  width: 100%;
  height: 82rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 2rpx solid #eee5da;
  font-size: 26rpx;
  color: #252525;
}
.sr-pick {
  height: 82rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 2rpx solid #eee5da;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #b98135;
}
.sr-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.sr-chip {
  padding: 14rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(160, 140, 110, 0.10);
  color: #6b6259;
  font-size: 23rpx;
}
.sr-chip.is-on {
  background: linear-gradient(135deg, #d7a45e, #b97d32);
  color: #fff;
  font-weight: 600;
}
.sr-field__err { margin-top: 8rpx; font-size: 23rpx; color: #c0574c; }

.press { opacity: 0.86; }