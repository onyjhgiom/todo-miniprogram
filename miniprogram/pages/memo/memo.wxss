/* pages/memo/memo.wxss */
/* 语音备忘录 · AI 智能语音工作台：蓝紫生产力风格（参考高级语音备忘录视觉稿） */

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 240rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 85% -5%, rgba(108, 124, 255, 0.16), transparent 42%),
    radial-gradient(circle at 0% 22%, rgba(139, 92, 246, 0.08), transparent 36%),
    #F5F7FC;
}

/* ===== Hero 区 ===== */
.mm__hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 32rpx;
}
.mm__title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #18213D;
  letter-spacing: 1rpx;
}
.mm__hero-line {
  width: 56rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6C7CFF, #8B5CF6);
  margin: 14rpx 0 16rpx;
}
.mm__sub {
  display: block;
  font-size: 27rpx;
  line-height: 1.6;
  color: #7C8499;
}
.mm__acts {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
  padding-top: 6rpx;
}
.mm__act {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid #E4E9F5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-shadow: 0 8rpx 24rpx rgba(40, 60, 100, 0.06);
}
.mm__act:active {
  transform: scale(0.95);
}
.mm__act-ico {
  font-size: 34rpx;
  line-height: 1;
}
.mm__act-txt {
  font-size: 20rpx;
  color: #5A6478;
}

/* ===== 搜索 ===== */
.mm__search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid #E4E9F5;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(40, 60, 100, 0.05);
}
.mm__search-icon {
  font-size: 28rpx;
}
.mm__search-input {
  flex: 1;
  font-size: 27rpx;
  color: #18213D;
}
.mm__search-clear {
  font-size: 26rpx;
  color: #A6ADC0;
  padding: 4rpx 8rpx;
}
.mm__filter-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #5A6478;
  background: #F0F3FA;
  border-radius: 16rpx;
  padding: 10rpx 20rpx;
}
.mm__filter-btn--on {
  color: #fff;
  background: linear-gradient(135deg, #6C7CFF, #8B5CF6);
}
.mm__ph {
  color: #A6ADC0;
}
.mm__filter-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

/* ===== 标签筛选 ===== */
.mm__tags {
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.mm__tag {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #7C8499;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid #E4E9F5;
}
.mm__tag--on {
  color: #fff;
  background: linear-gradient(135deg, #6C7CFF, #8B5CF6);
  border-color: transparent;
  font-weight: 600;
}

/* ===== 分类条 ===== */
.mm__cats-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.mm__cats-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #18213D;
}
.mm__cats-new {
  font-size: 22rpx;
  color: #6C7CFF;
  background: rgba(108, 124, 255, 0.1);
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
}
.mm__cats {
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.mm__cat {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  height: 72rpx;
  padding: 0 26rpx;
  margin-right: 16rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  color: #5A6478;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid #E4E9F5;
}
.mm__cat-ico {
  font-size: 28rpx;
}
.mm__cat-count {
  font-size: 22rpx;
  color: #A6ADC0;
}
.mm__cat--on {
  background: linear-gradient(135deg, #6C7CFF, #8B5CF6);
  border-color: transparent;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(108, 124, 255, 0.35);
}
.mm__cat--on .mm__cat-count {
  color: rgba(255, 255, 255, 0.85);
}

/* ===== 面包屑 ===== */
.mm__crumb {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx;
  margin-bottom: 20rpx;
}
.mm__crumb-item {
  font-size: 26rpx;
  color: #A6ADC0;
  padding: 6rpx 8rpx;
}
.mm__crumb--cur {
  color: #18213D;
  font-weight: 600;
}
.mm__crumb-sep {
  margin-left: 8rpx;
  color: #C6CBDA;
}

/* ===== 子文件夹 ===== */
.mm__folders {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.mm__folder {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  border-radius: 18rpx;
  border: 2rpx solid transparent;
  background: rgba(255, 255, 255, 0.9);
}
.mm__folder-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}
.mm__folder-name {
  font-size: 26rpx;
  color: #18213D;
  font-weight: 500;
}
.mm__folder-count {
  font-size: 22rpx;
  color: #A6ADC0;
}

/* ===== 数据统计面板 ===== */
.mm__stat {
  display: flex;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid #E9EDF7;
  border-radius: 28rpx;
  padding: 28rpx 0 22rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(40, 60, 100, 0.06);
}
.mm__stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.mm__stat-ico {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-bottom: 4rpx;
}
.mm__stat-ico--doc { background: rgba(108, 124, 255, 0.14); }
.mm__stat-ico--mic { background: rgba(139, 92, 246, 0.14); }
.mm__stat-ico--lock { background: rgba(108, 190, 255, 0.16); }
.mm__stat-ico--arch { background: rgba(52, 168, 83, 0.13); }
.mm__stat-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #18213D;
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}
.mm__stat-label {
  font-size: 22rpx;
  color: #7C8499;
}
.mm__stat-delta {
  font-size: 18rpx;
}
.mm__stat-delta.up { color: #34A853; }
.mm__stat-delta.down { color: #F07020; }
.mm__stat-delta.flat { color: #A6ADC0; }

/* ===== 备忘卡片 ===== */
.mm__list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.mm__card {
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid #E9EDF7;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(40, 60, 100, 0.06);
}
.mm__card:active {
  transform: scale(0.985);
}
.mm__card--locked {
  background: rgba(246, 247, 251, 0.92);
}
.mm__card-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.mm__card-thumb {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
.mm__card-headmain {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.mm__card-titlerow {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}
.mm__pin {
  font-size: 24rpx;
  flex-shrink: 0;
}
.mm__card-title-text {
  font-size: 30rpx;
  font-weight: 650;
  color: #18213D;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mm__card-cat {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.mm__card-time {
  font-size: 22rpx;
  color: #A6ADC0;
}
.mm__card-more {
  flex-shrink: 0;
  font-size: 34rpx;
  color: #A6ADC0;
  padding: 0 8rpx;
  line-height: 1;
}
.mm__card-summary {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #5A6478;
  line-height: 1.55;
}
.mm__card-meta {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}
.mm__chip {
  font-size: 22rpx;
  color: #7C8499;
  background: #F0F3FA;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}
.mm__chip--audio {
  color: #6C7CFF;
  background: rgba(108, 124, 255, 0.1);
}
.mm__chip--tag {
  color: #8B5CF6;
  background: rgba(139, 92, 246, 0.1);
}

/* ===== 空状态 ===== */
.mm__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 40rpx;
}
.mm__empty-visual {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}
.mm__empty-mic {
  font-size: 100rpx;
  filter: drop-shadow(0 12rpx 24rpx rgba(108, 124, 255, 0.35));
  animation: mm-breathe 1.2s ease-in-out infinite;
}
.mm__empty-ring {
  position: absolute;
  border-radius: 50%;
  border: 3rpx solid rgba(108, 124, 255, 0.25);
}
.mm__empty-ring--1 {
  width: 190rpx;
  height: 190rpx;
}
.mm__empty-ring--2 {
  width: 240rpx;
  height: 240rpx;
  border-color: rgba(139, 92, 246, 0.14);
  animation: mm-ring 2.4s ease-in-out infinite;
}
@keyframes mm-breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}
@keyframes mm-ring {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.06); opacity: 0.55; }
}
.mm__empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #18213D;
  margin-bottom: 12rpx;
}
.mm__empty-sub {
  font-size: 23rpx;
  color: #A6ADC0;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 36rpx;
}
.mm__empty-btns {
  display: flex;
  gap: 20rpx;
}
.mm__empty-btn {
  padding: 20rpx 40rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #5A6478;
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid #E4E9F5;
}
.mm__empty-btn--main {
  color: #fff;
  background: linear-gradient(135deg, #6C7CFF, #8B5CF6);
  border-color: transparent;
  box-shadow: 0 12rpx 28rpx rgba(108, 124, 255, 0.35);
}

/* ===== AI 能力快捷入口 ===== */
.mm__tools {
  display: flex;
  gap: 14rpx;
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid #E9EDF7;
  border-radius: 28rpx;
  padding: 26rpx 18rpx;
  box-shadow: 0 12rpx 40rpx rgba(40, 60, 100, 0.06);
}
.mm__tool {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.mm__tool:active {
  transform: scale(0.94);
}
.mm__tool-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-bottom: 4rpx;
}
.mm__tool-ico--1 { background: rgba(108, 124, 255, 0.14); }
.mm__tool-ico--2 { background: rgba(139, 92, 246, 0.14); }
.mm__tool-ico--3 { background: rgba(52, 168, 83, 0.13); }
.mm__tool-ico--4 { background: rgba(108, 190, 255, 0.16); }
.mm__tool-name {
  font-size: 23rpx;
  font-weight: 600;
  color: #2A3350;
}
.mm__tool-sub {
  font-size: 19rpx;
  color: #A6ADC0;
}

/* ===== 今日效率 ===== */
.mm__eff {
  margin-top: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid #E9EDF7;
  border-radius: 28rpx;
  padding: 26rpx 30rpx;
  box-shadow: 0 12rpx 40rpx rgba(40, 60, 100, 0.06);
}
.mm__eff-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.mm__eff-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #18213D;
}
.mm__eff-pct {
  font-size: 24rpx;
  font-weight: 600;
  color: #6C7CFF;
}
.mm__eff-bar {
  height: 14rpx;
  border-radius: 999rpx;
  background: #EDF0F9;
  overflow: hidden;
}
.mm__eff-bar-in {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6C7CFF, #8B5CF6);
  transition: width 0.4s ease;
}
.mm__eff-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #7C8499;
}

/* ===== 录音 FAB ===== */
.mm__fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6C7CFF, #8B5CF6);
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(108, 124, 255, 0.45);
  z-index: 50;
}
.mm__fab:active {
  transform: scale(0.94);
}

/* ===== 弹层通用 ===== */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(24, 33, 61, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  max-height: 86vh;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}
.sheet--tall {
  max-height: 92vh;
}
.sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.sheet__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #18213D;
}
.sheet__close {
  font-size: 30rpx;
  color: #A6ADC0;
  padding: 8rpx;
}
.sheet__save {
  font-size: 28rpx;
  color: #6C7CFF;
  font-weight: 600;
}
.sheet__body {
  max-height: 70vh;
}
.sheet__hint {
  margin-top: 24rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #A6ADC0;
  background: #F5F7FC;
  border-radius: 16rpx;
}

/* ===== 解锁视图 ===== */
.mm__unlock {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  gap: 28rpx;
}
.mm__unlock-icon {
  font-size: 88rpx;
}
.mm__unlock-tip {
  font-size: 26rpx;
  color: #7C8499;
}
.mm__unlock-input {
  width: 100%;
  background: #F5F7FC;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  color: #18213D;
  text-align: center;
}
.mm__unlock-btn {
  width: 100%;
  padding: 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #6C7CFF, #8B5CF6);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

/* ===== 编辑器 ===== */
.mm__row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.mm__input-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  color: #18213D;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #EDF0F9;
}
.mm__input-folder {
  flex: 1;
  font-size: 28rpx;
  color: #18213D;
  background: #F5F7FC;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
}
.mm__content {
  width: 100%;
  min-height: 220rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #18213D;
  background: #F5F7FC;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

/* ===== 清单 ===== */
.mm__checklist {
  margin-bottom: 24rpx;
}
.mm__check {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}
.mm__check-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 3rpx solid #C6CBDA;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  flex-shrink: 0;
}
.mm__check-box--on {
  background: #6C7CFF;
  border-color: #6C7CFF;
}
.mm__check-input {
  flex: 1;
  font-size: 28rpx;
  color: #18213D;
}
.mm__check-input--done {
  color: #A6ADC0;
  text-decoration: line-through;
}
.mm__check-del {
  font-size: 24rpx;
  color: #A6ADC0;
  padding: 8rpx;
}
.mm__check-add {
  margin-top: 12rpx;
  padding: 18rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #F5F7FC;
  color: #6C7CFF;
  font-size: 26rpx;
}

/* ===== 语音速记 ===== */
.mm__voice {
  background: #F5F7FC;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}
.mm__voice-head {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mm__voice-title {
  font-size: 24rpx;
  color: #7C8499;
}
.mm__voice-sec {
  font-size: 24rpx;
  color: #6C7CFF;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.mm__wave {
  display: flex;
  align-items: center;
  align-content: center;
  justify-content: center;
  gap: 10rpx;
  height: 96rpx;
  width: 100%;
}
.mm__wave-bar {
  width: 10rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, #6C7CFF, #8B5CF6);
  min-height: 8rpx;
  transition: height 0.12s linear;
}
.mm__partial {
  width: 100%;
  font-size: 26rpx;
  color: #18213D;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  line-height: 1.6;
}
.mm__voice-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6C7CFF, #8B5CF6);
  color: #fff;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(108, 124, 255, 0.4);
}
.mm__voice-btn--rec {
  background: linear-gradient(135deg, #F07020, #F0A020);
  animation: mm-pulse 1.2s ease-in-out infinite;
  font-size: 32rpx;
}
/* 识别中：按钮置灰、不可点，避免重复触发 */
.mm__voice-btn--busy {
  background: #C6CBDA;
  box-shadow: none;
  animation: mm-spin 1s linear infinite;
}
@keyframes mm-spin {
  0% { opacity: 0.55; }
  50% { opacity: 1; }
  100% { opacity: 0.55; }
}
@keyframes mm-pulse {
  0%, 100% { transform: scale(1); box-shadow: 0 10rpx 28rpx rgba(240, 112, 32, 0.35); }
  50% { transform: scale(1.08); box-shadow: 0 14rpx 40rpx rgba(240, 112, 32, 0.5); }
}
.mm__voice-tip {
  font-size: 22rpx;
  color: #A6ADC0;
}
/* 插件未启用时的补充说明（弱化展示，不干扰主流程） */
.mm__voice-note {
  font-size: 20rpx;
  line-height: 1.5;
  color: #A6ADC0;
  opacity: 0.75;
  text-align: center;
  padding: 0 24rpx;
}

/* ===== 语音片段 ===== */
.mm__clips {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.mm__clip {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #F5F7FC;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}
.mm__clip-play {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(108, 124, 255, 0.12);
  color: #6C7CFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
}
.mm__clip-play--on {
  background: linear-gradient(135deg, #6C7CFF, #8B5CF6);
  color: #fff;
}
.mm__clip-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.mm__clip-text {
  font-size: 26rpx;
  color: #18213D;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.mm__clip-text--mute {
  color: #A6ADC0;
}
.mm__clip-dur {
  font-size: 22rpx;
  color: #A6ADC0;
}
.mm__clip-del {
  font-size: 24rpx;
  color: #A6ADC0;
  padding: 8rpx;
}

/* ===== 图片 ===== */
.mm__images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.mm__img {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.mm__img-pic {
  width: 100%;
  height: 100%;
}
.mm__img-del {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(24, 33, 61, 0.6);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mm__img-add {
  padding: 18rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #F5F7FC;
  color: #6C7CFF;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

/* ===== 属性区 ===== */
.mm__props {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-bottom: 24rpx;
}
.mm__prop {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #EDF0F9;
}
.mm__prop-label {
  font-size: 26rpx;
  color: #7C8499;
  flex-shrink: 0;
}
.mm__colors {
  display: flex;
  gap: 16rpx;
}
.mm__color {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
}
.mm__color--on {
  border-color: #18213D;
  transform: scale(1.12);
}
.mm__picker {
  font-size: 28rpx;
  color: #6C7CFF;
  background: #F5F7FC;
  border-radius: 16rpx;
  padding: 14rpx 24rpx;
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 标签编辑 ===== */
.mm__tagrow {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  justify-content: flex-end;
}
.mm__tag--edit {
  margin: 0;
}
.mm__tag-input {
  width: 160rpx;
  font-size: 24rpx;
  background: #F5F7FC;
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  color: #18213D;
}
.mm__tag-add {
  font-size: 24rpx;
  color: #6C7CFF;
  padding: 8rpx 16rpx;
}

/* ===== 版本 ===== */
.mm__versions {
  background: #F5F7FC;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}
.mm__ver-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #18213D;
}
.mm__ver-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.mm__ver-empty {
  font-size: 24rpx;
  color: #A6ADC0;
  padding: 12rpx 0;
}
.mm__ver {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #EDF0F9;
}
.mm__ver-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.mm__ver-title {
  font-size: 26rpx;
  color: #18213D;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mm__ver-time {
  font-size: 22rpx;
  color: #A6ADC0;
}
.mm__ver-restore {
  font-size: 24rpx;
  color: #6C7CFF;
  padding: 8rpx 20rpx;
  border: 2rpx solid #6C7CFF;
  border-radius: 999rpx;
  flex-shrink: 0;
}

/* ===== 底部操作 ===== */
.mm__foot {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}
.mm__foot-btn {
  flex: 1;
  padding: 22rpx;
  text-align: center;
  border-radius: 20rpx;
  background: #F5F7FC;
  color: #2A3350;
  font-size: 26rpx;
}
.mm__foot-btn--danger {
  color: #E5484D;
}
