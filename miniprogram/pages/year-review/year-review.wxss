/* pages/year-review/year-review.wxss */
.page.yr {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* hero */
.yr-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 36rpx;
  background: linear-gradient(135deg, #eef2ff, #e3ecff);
  border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(93, 79, 232, 0.12);
}
.yr-hero__year {
  font-size: 28rpx;
  font-weight: 700;
  color: #5d4fe8;
  letter-spacing: 2rpx;
}
.yr-hero__lab {
  font-size: 22rpx;
  color: #8a8ab0;
  margin-top: 4rpx;
}
.yr-hero__big {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin: 18rpx 0 10rpx;
}
.yr-hero__n {
  font-size: 96rpx;
  font-weight: 800;
  color: #4b3fd1;
  line-height: 1;
}
.yr-hero__u {
  font-size: 26rpx;
  color: #6a6a8a;
}
.yr-hero__sub {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #5a5a7a;
}
.yr-dot { color: #b0b0c8; }

/* 通用卡片 */
.yr-card {
  margin-top: 24rpx;
  padding: 24rpx;
  background: var(--color-card, #fff);
  border-radius: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.04);
}
.yr-card__t {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text, #2a2a3a);
  margin-bottom: 20rpx;
}

/* 每月柱状 */
.yr-bars {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 220rpx;
}
.yr-bar {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  justify-content: flex-end;
}
.yr-bar__col {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.yr-bar__fill {
  width: 70%;
  min-height: 3rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: linear-gradient(180deg, #7b86e8, #5d4fe8);
  transition: height 0.3s ease;
}
.yr-bar__m {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: var(--color-text-mute, #9a9ab5);
}

/* 优先级构成 */
.yr-prios {
  display: flex;
  gap: 16rpx;
}
.yr-prio {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 18rpx 0;
  border-radius: 16rpx;
  background: var(--color-card-sub, rgba(0, 0, 0, 0.03));
}
.yr-prio__n { font-size: 38rpx; font-weight: 800; }
.yr-prio__l { font-size: 20rpx; color: var(--color-text-mute, #9a9ab5); }
.yr-prio--h .yr-prio__n { color: #ef4444; }
.yr-prio--m .yr-prio__n { color: #f59e0b; }
.yr-prio--l .yr-prio__n { color: #10b981; }
.yr-prio--n .yr-prio__n { color: #94a3b8; }

/* 标签 */
.yr-tags { display: flex; flex-wrap: wrap; gap: 14rpx; }
.yr-tag {
  font-size: 23rpx;
  color: #5d4fe8;
  background: rgba(93, 79, 232, 0.1);
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
}

/* 治愈文案 */
.yr-quote {
  margin-top: 24rpx;
  padding: 28rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #4a4a6a;
  background: linear-gradient(135deg, rgba(123, 134, 232, 0.1), rgba(59, 130, 246, 0.08));
  border-left: 6rpx solid #7b86e8;
  border-radius: 16rpx;
}

/* 操作 */
.yr-actions { margin-top: 32rpx; }
.yr-btn {
  background: linear-gradient(135deg, #7b86e8, #5d4fe8);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 18rpx 0;
  box-shadow: 0 8rpx 22rpx rgba(93, 79, 232, 0.35);
}
.yr-btn::after { border: none; }
.yr-empty {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-mute, #9a9ab5);
  padding: 30rpx 0;
}

/* 离屏画布 */
.yr-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 300px;
  height: 420px;
}
