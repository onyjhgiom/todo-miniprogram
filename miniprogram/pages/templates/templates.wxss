/* templates */
.tpl-page { min-height: 100vh; padding-bottom: 200rpx; position: relative; }
.tpl-hero {
  padding: 48rpx 32rpx 64rpx;
  color: #fff;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
  position: relative;
  overflow: hidden;
}
.tpl-hero-title { font-size: 48rpx; font-weight: 700; }
.tpl-hero-sub { font-size: 26rpx; opacity: 0.85; margin-top: 8rpx; }
.tpl-section { padding: 32rpx 24rpx 0; }
.tpl-section-title {
  font-size: 24rpx; color: var(--color-text-mute); font-weight: 500;
  margin-bottom: 16rpx; padding: 0 8rpx;
}
.tpl-empty { padding: 32rpx; }
.tpl-footer {
  margin-top: 48rpx; text-align: center;
}
.tpl-footer-btn {
  display: inline-block;
  padding: 16rpx 32rpx;
  background: var(--color-card);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: 999rpx;
  font-size: 24rpx; font-weight: 500;
}
.tpl-footer-btn:active { background: var(--color-primary-soft); }
.tpl-fab {
  position: fixed;
  right: 32rpx; bottom: 160rpx;
  width: 96rpx; height: 96rpx;
  border-radius: 50%;
  background: var(--gradient-hero);
  box-shadow: var(--shadow-lg);
  display: flex; align-items: center; justify-content: center;
  color: #fff;
  font-size: 56rpx; font-weight: 300;
  z-index: 90;
}
.tpl-fab:active { transform: scale(0.92); }
/* 舞台层配合：fx-stage 为 fixed z-index:0，主内容容器显式抬升（fab 自带更高层级不受影响） */
.tpl-hero,
.tpl-section,
.tpl-empty,
.tpl-footer {
  position: relative;
  z-index: 1;
}
