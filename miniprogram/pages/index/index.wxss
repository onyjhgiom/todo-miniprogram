/* pages/index/index.wxss */
/* Phase 2 视觉升级：轻奢玻璃拟态 + 环境氛围层 + 呼吸光效 */

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 16rpx 24rpx calc(220rpx + env(safe-area-inset-bottom));
}

/* 内容层：压在氛围光斑之上，玻璃卡片 backdrop-filter 可拾取光斑色彩 */
.page-content {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
}

/* ============ 加载 ============ */
.loading {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  color: var(--color-text-mute);
  min-height: 50vh;
}
.loading__spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid var(--color-primary-soft);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.85s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading__text {
  margin-top: 24rpx;
  font-size: 26rpx;
  letter-spacing: 1rpx;
  color: var(--color-text-mute);
}

/* ============ 列表 ============ */
.list {
  flex: 1;
  margin-top: 12rpx;
}
.list__footer {
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-mute);
  padding: 40rpx 0 24rpx;
  letter-spacing: 0.4rpx;
}

/* ============ 虚拟列表（超大清单：只渲染可视窗口） ============ */
/* vwrapper 处于正常流中，由 vphantom 撑出全部数据的总高度，
   vrows 绝对定位覆盖其上，每个 .vrow 按 top 精确定位 —— 节点数恒定在 20 个左右。 */
.vwrapper {
  position: relative;
  width: 100%;
}
.vphantom {
  width: 100%;
}
.vrows {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
}
.vrow {
  position: absolute;
  left: 0;
  right: 0;
  box-sizing: border-box;
  padding-bottom: 12rpx;
  overflow: hidden;
}

/* 紧凑单行：行高固定，才能做虚拟滚动 */
.vitem {
  height: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 22rpx;
  background: var(--glass-bg-strong);
  border-width: var(--home-card-edge);
  border-style: solid;
  border-color: var(--glass-border);
  border-radius: 20rpx;
  box-shadow: var(--home-card-shadow);
}
.vitem--done {
  opacity: 0.6;
  background: var(--glass-bg-soft);
}

/* 勾选 */
.vitem__check {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--glass-bg-strong);
}
.vitem__check--on {
  background: var(--gradient-primary);
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx var(--color-primary-shadow);
}
.vitem__check-icon {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

/* 主体 */
.vitem__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4rpx;
}
.vitem__content {
  display: block;
  width: 100%;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.25;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.vitem--done .vitem__content {
  color: var(--color-text-mute);
  text-decoration: line-through;
  font-weight: 400;
}

/* 副信息行（倒计时 / 地点 / 标签），单行裁剪 */
.vitem__sub {
  display: flex;
  align-items: center;
  gap: 10rpx;
  overflow: hidden;
  height: 28rpx;
}
.vitem__pill {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  line-height: 1.2;
}
.vitem__pill--overdue { background: #fee2e2; color: #b91c1c; }
.vitem__pill--today { background: #ffedd5; color: #c2410c; }
.vitem__pill--tomorrow { background: #fef3c7; color: #b45309; }
.vitem__pill--week { background: #dbeafe; color: #1d4ed8; }
.vitem__pill--later { background: var(--color-bg-soft); color: var(--color-text-soft); }
.vitem__loc {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--color-text-soft);
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.45);
}
.vitem__tags {
  font-size: 20rpx;
  color: var(--color-text-mute);
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.45);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.vitem__attach {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--color-primary);
}

/* 优先级圆点 */
.vitem__dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}
.vitem__dot--rose { background: #B5714C; }
.vitem__dot--amber { background: #C09A5E; }
.vitem__dot--emerald { background: #6E8E6E; }
.vitem__dot--slate { background: #94a3b8; }

/* 删除入口（与 todo-card 的 × 保持一致的视觉与反馈） */
.vitem__del {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 300;
  line-height: 1;
  color: var(--color-text-mute);
}
.vitem__del--hover {
  background: rgba(239, 68, 68, 0.12);
  color: #dc2626;
}

/* ============ 底部小提示（玻璃胶囊） ============ */
.footer-tip {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: 210rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 28rpx;
  background: var(--glass-bg-strong);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-text-soft);
  box-shadow: var(--shadow-lg);
  z-index: 4;
  letter-spacing: 0.4rpx;
}
.footer-tip__btn {
  color: var(--color-danger);
  font-weight: 600;
  padding-left: 16rpx;
  border-left: 1rpx solid var(--color-border);
}

/* ============ FAB 悬浮添加按钮（呼吸光晕） ============ */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--color-primary-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 10rpx 28rpx var(--color-primary-shadow),
    0 0 0 8rpx var(--glass-bg-soft);
  z-index: 6;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}
/* 呼吸光环：柔和向外扩散 */
.fab__halo {
  position: absolute;
  top: -14rpx;
  left: -14rpx;
  right: -14rpx;
  bottom: -14rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--color-primary-shadow) 0%, transparent 70%);
  animation: soft-breathe 2.6s ease-in-out infinite;
  pointer-events: none;
}
.fab__icon {
  position: relative;
  color: #ffffff;
  font-size: 64rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.18);
}
.fab--hover {
  transform: scale(0.94);
}

/* ============================================================
 * 主页「风格」维度（6 套工艺方案）
 * ------------------------------------------------------------
 * 与主题正交：主题给「颜色」，风格给「工艺」——
 * 圆角 / 描边宽度 / 阴影形状 / 玻璃通透度。因此任意主题可配任意风格。
 *
 * 为什么能影响子组件：CSS 变量会级联进自定义组件（stats-card / todo-card /
 * bottom-tab 都用 var(--home-*) / var(--glass-*) / var(--shadow-*) 取值），
 * 所以这里覆盖 token 就等于换了组件的工艺，无需改动组件逻辑。
 *
 * 选择器写成 .themed.home-style-X（两个类，与 .themed[data-theme='X'] 同权重），
 * 靠「页面 wxss 晚于 app.wxss 注入」的顺序取胜；深色底另有更高权重的校正块。
 *
 * ⚠️ 增删风格时必须同步四处：utils/home-skin.ts 的联合类型 / HOME_STYLES 常量 /
 *    HOME_STYLE_CHIPS 选择器 / 本文件的 .themed.home-style-X 规则。
 * ============================================================ */

/* ---- 1. jicha 侘寂纸感（默认）—— 即全局默认工艺，显式写出便于对照维护 ---- */
.themed.home-style-jicha {
  --home-card-r: 34rpx;
  --home-card-edge: 1rpx;
  --home-card-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.4) inset, 0 8rpx 24rpx rgba(90, 74, 56, 0.07);
  --home-hero-r: 44rpx;
  --home-hero-edge-w: 0rpx;
  --home-hero-edge-c: transparent;
  --home-bar-r: 999rpx;
}

/* ---- 2. frosted 冰肌玻璃：更通透的冷玻璃 —— 强模糊 + 高光边 + 极轻影 ---- */
.themed.home-style-frosted {
  --glass-bg: rgba(255, 255, 255, 0.34);
  --glass-bg-strong: rgba(255, 255, 255, 0.5);
  --glass-bg-soft: rgba(255, 255, 255, 0.22);
  --glass-border: rgba(255, 255, 255, 0.68);
  --glass-highlight: rgba(255, 255, 255, 0.95);
  --glass-blur: blur(30rpx) saturate(150%);
  --glass-shadow: 0 6rpx 26rpx rgba(63, 74, 92, 0.1), inset 0 1rpx 0 rgba(255, 255, 255, 0.85);
  --shadow-sm: 0 1px 3px rgba(63, 74, 92, 0.06);
  --shadow-md: 0 6rpx 22rpx rgba(63, 74, 92, 0.09);
  --shadow-lg: 0 16rpx 40rpx rgba(63, 74, 92, 0.14);
  --home-card-r: 28rpx;
  --home-card-edge: 1rpx;
  --home-card-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.85) inset, 0 10rpx 28rpx rgba(63, 74, 92, 0.1);
  --home-hero-r: 32rpx;
  --home-hero-edge-w: 1rpx;
  --home-hero-edge-c: rgba(255, 255, 255, 0.5);
  --home-hero-shadow: 0 14rpx 36rpx rgba(63, 74, 92, 0.26);
  --home-bar-r: 999rpx;
  --home-bar-shadow: 0 12rpx 34rpx rgba(63, 74, 92, 0.16), 0 1rpx 0 rgba(255, 255, 255, 0.85) inset;
}

/* ---- 3. inkwash 水墨宣纸：去阴影 + 墨线描边 + 方正圆角，低对比的纸面感 ---- */
.themed.home-style-inkwash {
  --glass-bg: rgba(252, 251, 248, 0.5);
  --glass-bg-strong: rgba(252, 251, 248, 0.68);
  --glass-bg-soft: rgba(252, 251, 248, 0.4);
  --glass-border: rgba(53, 48, 42, 0.16);
  --glass-highlight: rgba(255, 255, 255, 0.5);
  --glass-blur: blur(6rpx);
  --glass-shadow: none;
  --shadow-sm: none;
  --shadow-md: none;
  --shadow-lg: none;
  --home-card-r: 18rpx;
  --home-card-edge: 1rpx;
  --home-card-shadow: none;
  --home-hero-r: 20rpx;
  --home-hero-edge-w: 1rpx;
  --home-hero-edge-c: rgba(53, 48, 42, 0.22);
  --home-hero-shadow: none;
  --home-bar-r: 20rpx;
  --home-bar-shadow: none;
}

/* ---- 4. brutal 硬边几何：小圆角 + 粗墨边 + 硬投影（向右下偏移的实色块） ---- */
.themed.home-style-brutal {
  --glass-bg: rgba(255, 255, 255, 0.86);
  --glass-bg-strong: rgba(255, 255, 255, 0.94);
  --glass-bg-soft: rgba(255, 255, 255, 0.62);
  --glass-border: rgba(94, 84, 70, 0.75);
  --glass-highlight: rgba(255, 255, 255, 0.9);
  --glass-blur: blur(0rpx);
  --glass-shadow: 4rpx 4rpx 0 rgba(74, 68, 60, 0.16);
  --shadow-sm: 2rpx 2rpx 0 rgba(74, 68, 60, 0.14);
  --shadow-md: 4rpx 4rpx 0 rgba(74, 68, 60, 0.16);
  --shadow-lg: 6rpx 6rpx 0 rgba(74, 68, 60, 0.2);
  --home-card-r: 10rpx;
  --home-card-edge: 3rpx;
  --home-card-shadow: 4rpx 4rpx 0 rgba(74, 68, 60, 0.16);
  --home-hero-r: 12rpx;
  --home-hero-edge-w: 3rpx;
  --home-hero-edge-c: rgba(94, 84, 70, 0.75);
  --home-hero-shadow: 8rpx 8rpx 0 rgba(74, 68, 60, 0.34);
  --home-bar-r: 12rpx;
  --home-bar-shadow: 4rpx 4rpx 0 rgba(74, 68, 60, 0.18);
}

/* ---- 5. neumorph 柔光拟物：同色系双向阴影（右下暗 + 左上亮）的凸起感 ---- */
.themed.home-style-neumorph {
  --glass-bg: rgba(255, 255, 255, 0.55);
  --glass-bg-strong: rgba(255, 255, 255, 0.68);
  --glass-bg-soft: rgba(255, 255, 255, 0.42);
  --glass-border: transparent;
  --glass-highlight: rgba(255, 255, 255, 0.9);
  --glass-blur: blur(0rpx);
  --glass-shadow: 10rpx 10rpx 24rpx rgba(90, 74, 56, 0.14), -8rpx -8rpx 20rpx rgba(255, 255, 255, 0.9);
  --shadow-sm: 4rpx 4rpx 10rpx rgba(90, 74, 56, 0.1), -3rpx -3rpx 8rpx rgba(255, 255, 255, 0.85);
  --shadow-md: 8rpx 8rpx 20rpx rgba(90, 74, 56, 0.14), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
  --shadow-lg: 14rpx 14rpx 32rpx rgba(90, 74, 56, 0.18), -10rpx -10rpx 24rpx rgba(255, 255, 255, 0.9);
  --home-card-r: 36rpx;
  --home-card-edge: 0rpx;
  --home-card-shadow: 8rpx 8rpx 20rpx rgba(90, 74, 56, 0.13), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
  --home-hero-r: 40rpx;
  --home-hero-edge-w: 0rpx;
  --home-hero-edge-c: transparent;
  --home-hero-shadow: 14rpx 14rpx 34rpx rgba(0, 0, 0, 0.3), -8rpx -8rpx 22rpx rgba(255, 255, 255, 0.09);
  --home-bar-r: 999rpx;
  --home-bar-shadow: 10rpx 10rpx 26rpx rgba(90, 74, 56, 0.16), -6rpx -6rpx 18rpx rgba(255, 255, 255, 0.9);
}

/* ---- 6. retro 复古套印：实色偏移投影 + 雕版描边，海报 / 老印刷品观感 ---- */
.themed.home-style-retro {
  --glass-bg: rgba(252, 251, 248, 0.8);
  --glass-bg-strong: rgba(252, 251, 248, 0.88);
  --glass-bg-soft: rgba(252, 251, 248, 0.6);
  --glass-border: rgba(90, 74, 56, 0.55);
  --glass-highlight: rgba(255, 255, 255, 0.6);
  --glass-blur: blur(0rpx);
  --glass-shadow: 6rpx 6rpx 0 rgba(90, 74, 56, 0.18);
  --shadow-sm: 3rpx 3rpx 0 rgba(90, 74, 56, 0.14);
  --shadow-md: 5rpx 5rpx 0 rgba(90, 74, 56, 0.18);
  --shadow-lg: 8rpx 8rpx 0 rgba(90, 74, 56, 0.22);
  --home-card-r: 16rpx;
  --home-card-edge: 2rpx;
  --home-card-shadow: 6rpx 6rpx 0 rgba(90, 74, 56, 0.18);
  --home-hero-r: 20rpx;
  --home-hero-edge-w: 2rpx;
  --home-hero-edge-c: rgba(255, 255, 255, 0.32);
  --home-hero-shadow: 9rpx 9rpx 0 rgba(60, 48, 38, 0.32);
  --home-bar-r: 16rpx;
  --home-bar-shadow: 5rpx 5rpx 0 rgba(90, 74, 56, 0.18);
}

/* ---------- 深色主题校正 ----------
 * 风格块里的玻璃值按「浅色底」设计；深色主题（dark / rose）必须整体收敛为深色档，
 * 否则白玻璃会变成贴在深底上的刺眼亮块。
 * 这里只覆盖「颜色类」token，圆角 / 描边宽度 / 投影形状仍由各风格自己决定。
 * 权重 (0,3,0) 高于上面的 (0,2,0)，因此必定覆盖。 */
.themed[data-theme='light'].home-style-frosted,
.themed[data-theme='dark'].home-style-frosted,
.themed[data-theme='rose'].home-style-frosted,
.themed[data-theme='tech'].home-style-frosted,
.themed[data-theme='noir'].home-style-frosted,
.themed[data-theme='pixel'].home-style-frosted,
.themed[data-theme='light'].home-style-inkwash,
.themed[data-theme='dark'].home-style-inkwash,
.themed[data-theme='rose'].home-style-inkwash,
.themed[data-theme='tech'].home-style-inkwash,
.themed[data-theme='noir'].home-style-inkwash,
.themed[data-theme='pixel'].home-style-inkwash,
.themed[data-theme='light'].home-style-brutal,
.themed[data-theme='dark'].home-style-brutal,
.themed[data-theme='rose'].home-style-brutal,
.themed[data-theme='tech'].home-style-brutal,
.themed[data-theme='noir'].home-style-brutal,
.themed[data-theme='pixel'].home-style-brutal,
.themed[data-theme='light'].home-style-retro,
.themed[data-theme='dark'].home-style-retro,
.themed[data-theme='rose'].home-style-retro,
.themed[data-theme='tech'].home-style-retro,
.themed[data-theme='noir'].home-style-retro,
.themed[data-theme='pixel'].home-style-retro {
  --glass-bg: rgba(26, 20, 14, 0.6);
  --glass-bg-strong: rgba(26, 20, 14, 0.8);
  --glass-bg-soft: rgba(26, 20, 14, 0.52);
  --glass-border: rgba(242, 237, 228, 0.24);
  --glass-highlight: rgba(255, 255, 255, 0.14);
  --home-card-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.06) inset, 0 8rpx 24rpx rgba(0, 0, 0, 0.32);
  --home-hero-shadow: 0 14rpx 36rpx rgba(0, 0, 0, 0.45);
  --home-bar-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.5), 0 1rpx 0 rgba(255, 255, 255, 0.08) inset;
}
/* 柔光拟物在深色底不能用「无阴影」档，否则凸起感全失 —— 换成黑色下沉 + 微弱白色外发光 */
.themed[data-theme='light'].home-style-neumorph,
.themed[data-theme='dark'].home-style-neumorph,
.themed[data-theme='rose'].home-style-neumorph,
.themed[data-theme='tech'].home-style-neumorph,
.themed[data-theme='noir'].home-style-neumorph,
.themed[data-theme='pixel'].home-style-neumorph {
  --glass-bg: rgba(26, 20, 14, 0.6);
  --glass-bg-strong: rgba(26, 20, 14, 0.8);
  --glass-bg-soft: rgba(26, 20, 14, 0.52);
  --glass-border: transparent;
  --glass-highlight: rgba(255, 255, 255, 0.12);
  --glass-shadow: 10rpx 10rpx 24rpx rgba(0, 0, 0, 0.5), -8rpx -8rpx 20rpx rgba(255, 255, 255, 0.05);
  --home-card-shadow: 8rpx 8rpx 20rpx rgba(0, 0, 0, 0.5), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.05);
  --home-hero-shadow: 12rpx 12rpx 30rpx rgba(0, 0, 0, 0.55), -6rpx -6rpx 18rpx rgba(255, 255, 255, 0.06);
  --home-bar-shadow: 10rpx 10rpx 26rpx rgba(0, 0, 0, 0.55), -6rpx -6rpx 18rpx rgba(255, 255, 255, 0.06);
}
/* 硬边几何 / 复古套印的「实色偏移块」在深色底必须换成纯黑，否则褐灰色块几乎看不见。
 * 这两条必须排在通用深色校正之后，靠源码顺序取得最终生效权。 */
.themed[data-theme='light'].home-style-brutal,
.themed[data-theme='dark'].home-style-brutal,
.themed[data-theme='rose'].home-style-brutal,
.themed[data-theme='tech'].home-style-brutal,
.themed[data-theme='noir'].home-style-brutal,
.themed[data-theme='pixel'].home-style-brutal {
  --glass-border: rgba(242, 237, 228, 0.45);
  --glass-shadow: 4rpx 4rpx 0 rgba(0, 0, 0, 0.5);
  --shadow-sm: 2rpx 2rpx 0 rgba(0, 0, 0, 0.35);
  --shadow-md: 4rpx 4rpx 0 rgba(0, 0, 0, 0.45);
  --shadow-lg: 6rpx 6rpx 0 rgba(0, 0, 0, 0.5);
  --home-card-shadow: 4rpx 4rpx 0 rgba(0, 0, 0, 0.5);
  --home-hero-edge-c: rgba(242, 237, 228, 0.5);
  --home-hero-shadow: 8rpx 8rpx 0 rgba(0, 0, 0, 0.55);
  --home-bar-shadow: 4rpx 4rpx 0 rgba(0, 0, 0, 0.5);
}
.themed[data-theme='light'].home-style-retro,
.themed[data-theme='dark'].home-style-retro,
.themed[data-theme='rose'].home-style-retro,
.themed[data-theme='tech'].home-style-retro,
.themed[data-theme='noir'].home-style-retro,
.themed[data-theme='pixel'].home-style-retro {
  --glass-shadow: 6rpx 6rpx 0 rgba(0, 0, 0, 0.45);
  --shadow-sm: 3rpx 3rpx 0 rgba(0, 0, 0, 0.35);
  --shadow-md: 5rpx 5rpx 0 rgba(0, 0, 0, 0.45);
  --shadow-lg: 8rpx 8rpx 0 rgba(0, 0, 0, 0.5);
  --home-card-shadow: 6rpx 6rpx 0 rgba(0, 0, 0, 0.5);
  --home-hero-shadow: 9rpx 9rpx 0 rgba(0, 0, 0, 0.55);
  --home-bar-shadow: 5rpx 5rpx 0 rgba(0, 0, 0, 0.5);
}

/* ============================================================
 * 主页「背景」维度（6 套氛围装饰）
 * ------------------------------------------------------------
 * .ambient-layer 是 fixed 全屏层（z-index 0），内容层 .ambient-content 在 z-index 1，
 * 且整层 pointer-events: none —— 装饰绝不拦截点击。
 * 结构固定为「3 枚光斑 + 1 个纹理层」，各背景规则按需启停与换色，
 * 因此切换背景只换类名，不增删节点。
 *
 * ⚠️ 增删背景时同样要四处同步：home-skin.ts 联合类型 / HOME_BGS / HOME_BG_CHIPS /
 *    本文件的 .ambient-layer--X 规则。
 * ============================================================ */

/* 纹理层：默认不可见，只被需要的背景规则打开 */
.ambient-fx {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  opacity: 0;
}

/* ---- warm 暖晖流云（默认）：沿用 app.wxss 的三枚暖色光斑，不叠加纹理 ----
 * 规则显式写出（哪怕内容与默认一致）：一是让四元组自检覆盖到 warm，
 * 二是从其它背景切回时这里会把纹理层的旧形态覆盖干净。 */
.ambient-layer--warm .ambient-fx {
  display: none;
}

/* ---- plain 纯净底色：关闭全部装饰，只留主题纯色底 ---- */
.ambient-layer--plain .ambient-blob,
.ambient-layer--plain .ambient-fx {
  display: none;
}

/* ---- aurora 极光流彩：冷色光斑 + 斜向极光帘幕缓慢摆动 ---- */
.ambient-layer--aurora .ambient-blob {
  filter: blur(110rpx);
}
.ambient-layer--aurora .ambient-blob--1 {
  background: radial-gradient(circle, rgba(99, 102, 241, 0.26), transparent 68%);
}
.ambient-layer--aurora .ambient-blob--2 {
  background: radial-gradient(circle, rgba(34, 211, 238, 0.22), transparent 68%);
}
.ambient-layer--aurora .ambient-blob--3 {
  background: radial-gradient(circle, rgba(139, 92, 246, 0.2), transparent 68%);
}
.ambient-layer--aurora .ambient-fx {
  opacity: 0.7;
  background: linear-gradient(
    116deg,
    rgba(0, 0, 0, 0) 4%,
    rgba(99, 102, 241, 0.1) 30%,
    rgba(34, 211, 238, 0.13) 52%,
    rgba(139, 92, 246, 0.1) 70%,
    rgba(0, 0, 0, 0) 94%
  );
  animation: home-aurora 24s ease-in-out infinite alternate;
}
@keyframes home-aurora {
  0% { transform: translate3d(-8%, -4%, 0) rotate(-2deg); }
  100% { transform: translate3d(8%, 5%, 0) rotate(3deg); }
}

/* ---- nebula 星尘夜空：冷色光斑 + 双层星点呼吸闪烁 ---- */
.ambient-layer--nebula .ambient-blob {
  filter: blur(96rpx);
}
.ambient-layer--nebula .ambient-blob--1 {
  background: radial-gradient(circle, rgba(34, 211, 238, 0.2), transparent 68%);
}
.ambient-layer--nebula .ambient-blob--2 {
  background: radial-gradient(circle, rgba(139, 92, 246, 0.2), transparent 68%);
}
.ambient-layer--nebula .ambient-blob--3 {
  background: radial-gradient(circle, rgba(59, 130, 246, 0.16), transparent 68%);
}
.ambient-layer--nebula .ambient-fx {
  opacity: 0.6;
  background-image:
    radial-gradient(circle, rgba(122, 132, 158, 0.5) 1.6rpx, rgba(0, 0, 0, 0) 1.6rpx),
    radial-gradient(circle, rgba(139, 92, 246, 0.34) 1.2rpx, rgba(0, 0, 0, 0) 1.2rpx);
  background-size: 128rpx 128rpx, 68rpx 68rpx;
  background-position: 0 0, 34rpx 40rpx;
  /* 只做透明度呼吸：不动 background-position / transform，避免全屏重绘 */
  animation: home-twinkle 9s ease-in-out infinite alternate;
}
@keyframes home-twinkle {
  from { opacity: 0.42; }
  to { opacity: 0.7; }
}

/* ---- lattice 月光栅格：正交细网格 + 一枚角落柔光 ---- */
.ambient-layer--lattice .ambient-blob--1,
.ambient-layer--lattice .ambient-blob--3 {
  display: none;
}
.ambient-layer--lattice .ambient-blob--2 {
  background: radial-gradient(circle, rgba(143, 160, 184, 0.18), transparent 68%);
}
.ambient-layer--lattice .ambient-fx {
  opacity: 0.55;
  background-image:
    repeating-linear-gradient(
      0deg,
      rgba(122, 132, 148, 0.22) 0,
      rgba(122, 132, 148, 0.22) 1rpx,
      rgba(0, 0, 0, 0) 1rpx,
      rgba(0, 0, 0, 0) 64rpx
    ),
    repeating-linear-gradient(
      90deg,
      rgba(122, 132, 148, 0.22) 0,
      rgba(122, 132, 148, 0.22) 1rpx,
      rgba(0, 0, 0, 0) 1rpx,
      rgba(0, 0, 0, 0) 64rpx
    );
  animation: home-fx-in 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
}
@keyframes home-fx-in {
  from { opacity: 0; }
  to { opacity: 0.55; }
}

/* ---- dots 浮点粒子：密集圆点矩阵 + 稀疏紫色大点错位，缓慢漂移 ---- */
.ambient-layer--dots .ambient-blob {
  display: none;
}
.ambient-layer--dots .ambient-fx {
  opacity: 0.6;
  background-image:
    radial-gradient(circle, rgba(122, 132, 148, 0.26) 2rpx, rgba(0, 0, 0, 0) 2rpx),
    radial-gradient(circle, rgba(192, 132, 252, 0.2) 2.6rpx, rgba(0, 0, 0, 0) 2.6rpx);
  background-size: 36rpx 36rpx, 180rpx 180rpx;
  background-position: 0 0, 60rpx 90rpx;
  animation: home-dots-drift 22s ease-in-out infinite alternate;
}
@keyframes home-dots-drift {
  0% { transform: translate3d(0, 0, 0); }
  100% { transform: translate3d(18rpx, -14rpx, 0); }
}

/* ============================================================
 * 剧场版追加：FAB 与浮层提示的「主角化」处理
 * 这两个元素是页面里唯一的悬浮物，天然是视觉焦点，
 * 因此给它们最足的光影与动势 —— 让首页第一眼就有重点。
 * ============================================================ */

/* FAB：外侧呼吸光环 + 内部金属渐变 + 明确的下压反馈 */
.fab {
  background: linear-gradient(140deg, var(--color-primary-ink-2, #7B4D34) 0%, var(--color-primary-ink, #643E2A) 100%);
  box-shadow:
    0 14rpx 34rpx var(--color-primary-shadow),
    0 4rpx 10rpx rgba(0, 0, 0, .12),
    0 0 0 8rpx var(--glass-bg-soft),
    inset 0 2rpx 0 rgba(255, 255, 255, .26);
  animation: fab-breathe 4.2s ease-in-out infinite;
  transition: transform 220ms cubic-bezier(.34, 1.56, .64, 1);
}
@keyframes fab-breathe {
  0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
  50% { transform: translate3d(0, -6rpx, 0) scale(1.03); }
}
.fab__icon {
  color: #FFF6E8;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .28);
  position: relative;
  z-index: 2;
}
/* 外圈光环：一圈缓慢向外扩散的涟漪，暗示「点这里」 */
.fab__halo {
  border-radius: 50%;
  animation: fab-halo 3.2s ease-out infinite;
}
@keyframes fab-halo {
  0% { opacity: .55; transform: scale(1); }
  70%, 100% { opacity: 0; transform: scale(1.55); }
}

/* 底部「已完成 N 项」提示：从薄片升级为有厚度的玻璃胶囊 */
.footer-tip {
  box-shadow:
    var(--elev-3, 0 18rpx 48rpx rgba(0, 0, 0, .4)),
    inset 0 1rpx 0 rgba(255, 233, 198, .16);
  animation: tip-in .5s cubic-bezier(.16, .84, .28, 1) both;
}
@keyframes tip-in {
  from { opacity: 0; transform: translate3d(-50%, 26rpx, 0); }
  to { opacity: 1; transform: translate3d(-50%, 0, 0); }
}
.footer-tip__text { color: var(--color-text-soft); }

/* 列表末尾计数：降低存在感，作为自然的收尾 */
.list__footer {
  padding: 48rpx 0 32rpx;
  letter-spacing: 1rpx;
}


/* ============================================================
 * 暮金夜色 · 手写体标语（效果图点睛元素）
 * 固定于 FAB 上方：斜置手写 + 金色渐变 + 一道笔锋下划线
 * ============================================================ */
.motto {
  position: fixed;
  left: 50%;
  bottom: 264rpx;
  transform: translateX(-50%) rotate(-3deg);
  pointer-events: none;
  z-index: 60;
  animation: motto-in .8s cubic-bezier(.16, .84, .28, 1) .4s both;
}
@keyframes motto-in {
  from { opacity: 0; transform: translateX(-50%) rotate(-3deg) translateY(16rpx); }
  to   { opacity: 1; transform: translateX(-50%) rotate(-3deg) translateY(0); }
}
.motto__text {
  font-family: 'Xingkai SC', 'STXingkai', 'Kaiti SC', 'STKaiti', var(--font-serif, serif);
  font-size: 34rpx;
  font-style: italic;
  letter-spacing: 4rpx;
  background: linear-gradient(180deg, #FFF3DC 0%, #EBCE9C 70%, #D4AE74 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 2rpx 12rpx rgba(226, 168, 92, .22);
}
.motto__stroke {
  width: 240rpx;
  height: 3rpx;
  margin: 6rpx auto 0;
  border-radius: 50%;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0), rgba(226, 178, 115, .55), rgba(0, 0, 0, 0));
  filter: blur(1rpx);
}


/* ============================================================
 * 液态琉璃（liquid）：全流动渐变 3D 液态玻璃（钴蓝·冰川蓝主调）
 * ------------------------------------------------------------
 * 「全流动」实现拆解（背景每一层都在动）：
 *   L1 底色      钴蓝→冰川蓝→梦幻紫→珍珠粉纵深渐变（兜底，防闪白）
 *   L2 liq-flow  200% 幅面多层彩色渐变整体缓转缓移 —— 全场流动主引擎
 *   L3 光斑×3    复用 ambient-blob（--ambient-* 上色）缓慢游移
 *   L4 飘带×2    珍珠白芯 + 虹彩边缘大绸带横贯上下，反向缓摆
 *   L5 漩涡光    conic 冰蓝柔光缓慢自转
 *   L6 星屑      双层点阵呼吸闪烁
 *   L7 气泡×4    珍珠母贝玻璃球错位漂浮；主球带行星环 + 珠光核（视觉焦点）
 *   内容层：--glass-blur 真·磨砂 + 全套玻璃 token（穿透组件隔离）
 * 性能约束：动画全部只动 transform / opacity；无大面积 filter 动画。
 * ============================================================ */

/* ---- L1 专属底色：钴蓝主导 + 冰川蓝光带 + 紫粉收尾（压过主题纯色底） ---- */
.page.home-bg-liquid {
  background: linear-gradient(
    180deg,
    #0A1136 0%,
    #122357 20%,
    #1E3E94 40%,
    #3A63C4 56%,
    #5B6FD6 70%,
    #8A7BE0 82%,
    #B48FD9 92%,
    #D9A8DC 100%
  );
}

/* ---- L2 全场流动主引擎：200% 幅面整体缓转缓移 ---- */
.liq-flow {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background:
    radial-gradient(42% 34% at 66% 20%, rgba(150, 120, 255, 0.42), transparent 70%),
    radial-gradient(40% 32% at 20% 36%, rgba(80, 130, 255, 0.40), transparent 70%),
    radial-gradient(34% 30% at 44% 48%, rgba(110, 200, 255, 0.30), transparent 72%),
    radial-gradient(46% 36% at 58% 70%, rgba(236, 160, 235, 0.32), transparent 72%),
    radial-gradient(30% 26% at 84% 74%, rgba(110, 230, 255, 0.30), transparent 70%),
    radial-gradient(56% 30% at 50% 96%, rgba(120, 190, 255, 0.38), transparent 72%),
    linear-gradient(160deg, rgba(50, 80, 200, 0.20) 0%, rgba(170, 120, 235, 0.18) 55%, rgba(255, 180, 225, 0.15) 100%);
  animation: liq-field 28s ease-in-out infinite alternate;
  will-change: transform;
}
@keyframes liq-field {
  0%   { transform: translate3d(-4%, -3%, 0) rotate(-10deg) scale(1.05); }
  50%  { transform: translate3d(2%, 2%, 0) rotate(3deg) scale(1.13); }
  100% { transform: translate3d(4%, 4%, 0) rotate(11deg) scale(1.06); }
}

/* ---- L4 虹彩飘带：珍珠白芯 + 冰蓝/紫/粉虹彩边缘，横贯全屏缓摆 ---- */
.liq-ribbon {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.liq-ribbon--a {
  top: 4%;
  left: -34%;
  width: 172%;
  height: 360rpx;
  transform: rotate(-16deg);
  background: linear-gradient(
    100deg,
    rgba(0, 0, 0, 0) 4%,
    rgba(255, 255, 255, 0.18) 18%,
    rgba(150, 190, 255, 0.38) 34%,
    rgba(255, 255, 255, 0.40) 50%,
    rgba(130, 225, 255, 0.36) 64%,
    rgba(245, 175, 240, 0.36) 80%,
    rgba(0, 0, 0, 0) 96%
  );
  filter: blur(2rpx);
  animation: liq-ribbon-a 24s ease-in-out infinite alternate;
}
@keyframes liq-ribbon-a {
  0%   { transform: rotate(-21deg) translate3d(-4%, -5%, 0) scale(1); }
  50%  { transform: rotate(-15deg) translate3d(1%, 2%, 0) scale(1.06); }
  100% { transform: rotate(-9deg) translate3d(4%, 6%, 0) scale(1.1); }
}
.liq-ribbon--b {
  bottom: 0%;
  left: -38%;
  width: 178%;
  height: 420rpx;
  transform: rotate(13deg);
  background: linear-gradient(
    80deg,
    rgba(0, 0, 0, 0) 4%,
    rgba(245, 180, 240, 0.38) 22%,
    rgba(255, 255, 255, 0.34) 40%,
    rgba(160, 150, 255, 0.38) 56%,
    rgba(255, 255, 255, 0.22) 70%,
    rgba(130, 225, 255, 0.30) 84%,
    rgba(0, 0, 0, 0) 96%
  );
  filter: blur(2rpx);
  animation: liq-ribbon-b 30s ease-in-out infinite alternate;
}
@keyframes liq-ribbon-b {
  0%   { transform: rotate(8deg) translate3d(4%, 4%, 0) scale(1.06); }
  50%  { transform: rotate(14deg) translate3d(-1%, -1%, 0) scale(1.1); }
  100% { transform: rotate(18deg) translate3d(-4%, -5%, 0) scale(1.02); }
}
/* 第三条飘带：纵贯中部的细亮绸带，补足「全屏都被流体穿过」的密度 */
.liq-ribbon--c {
  top: 34%;
  left: -40%;
  width: 180%;
  height: 200rpx;
  transform: rotate(-7deg);
  background: linear-gradient(
    95deg,
    rgba(0, 0, 0, 0) 8%,
    rgba(140, 200, 255, 0.24) 26%,
    rgba(255, 255, 255, 0.30) 44%,
    rgba(190, 160, 255, 0.30) 60%,
    rgba(255, 210, 245, 0.26) 76%,
    rgba(0, 0, 0, 0) 94%
  );
  filter: blur(3rpx);
  animation: liq-ribbon-c 20s ease-in-out infinite alternate;
}
@keyframes liq-ribbon-c {
  0%   { transform: rotate(-10deg) translate3d(-3%, 3%, 0) scale(1.02); }
  100% { transform: rotate(-4deg) translate3d(3%, -4%, 0) scale(1.08); }
}

/* ---- 斜贯流光带：画面中央的冰蓝光束（设计稿中部亮带的还原） ---- */
.liq-beam {
  position: absolute;
  top: -20%;
  left: 22%;
  width: 300rpx;
  height: 145%;
  transform: rotate(24deg);
  background: linear-gradient(
    90deg,
    rgba(0, 0, 0, 0) 0%,
    rgba(160, 215, 255, 0.14) 22%,
    rgba(235, 245, 255, 0.30) 50%,
    rgba(160, 190, 255, 0.14) 78%,
    rgba(0, 0, 0, 0) 100%
  );
  filter: blur(10rpx);
  animation: liq-beam-drift 16s ease-in-out infinite alternate;
  pointer-events: none;
}
@keyframes liq-beam-drift {
  0%   { transform: rotate(22deg) translate3d(-8%, -2%, 0); opacity: 0.7; }
  50%  { transform: rotate(25deg) translate3d(0%, 1%, 0); opacity: 1; }
  100% { transform: rotate(28deg) translate3d(8%, 2%, 0); opacity: 0.75; }
}

/* ---- L5 漩涡柔光：conic 缓慢自转（右上，冰蓝主调） ---- */
.liq-swirl {
  position: absolute;
  top: -14%;
  right: -20%;
  width: 700rpx;
  height: 700rpx;
  border-radius: 50%;
  background: conic-gradient(
    from 0deg,
    rgba(255, 255, 255, 0.20),
    rgba(140, 180, 255, 0.28),
    rgba(255, 200, 245, 0.22),
    rgba(120, 225, 255, 0.22),
    rgba(255, 255, 255, 0.20)
  );
  opacity: 0.62;
  animation: liq-swirl-spin 38s linear infinite;
}
@keyframes liq-swirl-spin {
  from { transform: rotate(0deg) scale(1); }
  50%  { transform: rotate(180deg) scale(1.12); }
  to   { transform: rotate(360deg) scale(1); }
}

/* ---- L6 星屑：三层点阵呼吸闪烁（大/中/微三层纵深） ---- */
.liq-spark {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image:
    radial-gradient(circle, rgba(255, 255, 255, 0.7) 1.8rpx, rgba(0, 0, 0, 0) 1.8rpx),
    radial-gradient(circle, rgba(200, 225, 255, 0.5) 1.3rpx, rgba(0, 0, 0, 0) 1.3rpx),
    radial-gradient(circle, rgba(255, 210, 250, 0.42) 1rpx, rgba(0, 0, 0, 0) 1rpx);
  background-size: 118rpx 118rpx, 76rpx 76rpx, 46rpx 46rpx;
  background-position: 0 0, 34rpx 42rpx, 18rpx 24rpx;
  animation: liq-twinkle 6s ease-in-out infinite alternate;
}
@keyframes liq-twinkle {
  from { opacity: 0.26; }
  to   { opacity: 0.62; }
}

/* ---- L7 气泡（另两颗走 .ambient-fx::before/::after） ---- */
.liq-orb {
  position: absolute;
  border-radius: 50%;
}
/* 主球：右上 hero 旁，带行星环的 3D 玻璃焦点球 */
.liq-orb--c {
  top: 9%;
  right: 6%;
  width: 216rpx;
  height: 216rpx;
  background:
    radial-gradient(circle at 32% 26%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.34) 14%, rgba(255, 255, 255, 0.05) 34%),
    radial-gradient(circle at 68% 80%, rgba(140, 200, 255, 0.42) 0%, rgba(140, 200, 255, 0) 48%),
    radial-gradient(circle at 50% 50%, rgba(120, 150, 255, 0.20) 0%, rgba(110, 130, 250, 0.34) 82%, rgba(255, 255, 255, 0.5) 97%);
  box-shadow:
    inset 0 -16rpx 34rpx rgba(90, 120, 255, 0.34),
    inset 0 10rpx 22rpx rgba(255, 255, 255, 0.5),
    0 26rpx 56rpx rgba(8, 10, 60, 0.45),
    0 0 60rpx rgba(140, 180, 255, 0.30);
  animation: liq-orb-float 12s ease-in-out infinite alternate;
}
/* 行星环：倾斜椭圆亮环（前缘亮、后缘隐入） */
.liq-orb--c::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 56%;
  width: 360rpx;
  height: 118rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(210, 232, 255, 0.55);
  border-top-color: rgba(255, 255, 255, 0.85);
  border-bottom-color: rgba(150, 190, 255, 0.22);
  box-shadow:
    0 6rpx 18rpx rgba(150, 190, 255, 0.30),
    inset 0 2rpx 8rpx rgba(255, 255, 255, 0.35);
  transform: translate(-50%, -50%) rotate(-16deg);
}
/* 球心珠光核 */
.liq-orb--c::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.55) 0%, rgba(200, 220, 255, 0.18) 55%, transparent 75%);
  transform: translate(-50%, -50%);
}
.liq-orb--d {
  top: 40%;
  right: 12%;
  width: 68rpx;
  height: 68rpx;
  background:
    radial-gradient(circle at 32% 26%, rgba(255, 255, 255, 0.88) 0%, rgba(255, 255, 255, 0.24) 16%, rgba(255, 255, 255, 0.03) 38%),
    radial-gradient(circle at 68% 78%, rgba(140, 230, 255, 0.36) 0%, rgba(140, 230, 255, 0) 46%),
    radial-gradient(circle at 50% 50%, rgba(150, 170, 255, 0.16) 0%, rgba(150, 170, 255, 0.28) 84%, rgba(255, 255, 255, 0.40) 97%);
  box-shadow:
    inset 0 -6rpx 16rpx rgba(90, 130, 255, 0.28),
    inset 0 5rpx 12rpx rgba(255, 255, 255, 0.38),
    0 10rpx 24rpx rgba(10, 8, 50, 0.30);
  animation: liq-orb-float 15s ease-in-out -5s infinite alternate-reverse;
}
@keyframes liq-orb-float {
  0%   { transform: translate3d(0, 0, 0) scale(1); }
  50%  { transform: translate3d(-14rpx, 18rpx, 0) scale(1.06); }
  100% { transform: translate3d(12rpx, -22rpx, 0) scale(0.95); }
}
/* 卫星气泡：环绕主球的小玻璃珠，增强「群落感」与纵深 */
.liq-orb--e {
  top: 6%;
  right: 30%;
  width: 44rpx;
  height: 44rpx;
  background:
    radial-gradient(circle at 32% 26%, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.26) 16%, rgba(255, 255, 255, 0.04) 38%),
    radial-gradient(circle at 68% 78%, rgba(170, 220, 255, 0.34) 0%, rgba(170, 220, 255, 0) 46%),
    radial-gradient(circle at 50% 50%, rgba(150, 180, 255, 0.18) 0%, rgba(150, 180, 255, 0.28) 84%, rgba(255, 255, 255, 0.42) 97%);
  box-shadow:
    inset 0 -4rpx 10rpx rgba(110, 150, 255, 0.3),
    inset 0 4rpx 9rpx rgba(255, 255, 255, 0.4),
    0 8rpx 18rpx rgba(10, 8, 50, 0.3);
  animation: liq-orb-float 9s ease-in-out -3s infinite alternate;
}
.liq-orb--f {
  top: 26%;
  right: 4%;
  width: 34rpx;
  height: 34rpx;
  background:
    radial-gradient(circle at 32% 26%, rgba(255, 255, 255, 0.88) 0%, rgba(255, 255, 255, 0.24) 16%, rgba(255, 255, 255, 0.03) 38%),
    radial-gradient(circle at 68% 78%, rgba(255, 200, 245, 0.34) 0%, rgba(255, 200, 245, 0) 46%),
    radial-gradient(circle at 50% 50%, rgba(190, 160, 255, 0.18) 0%, rgba(190, 160, 255, 0.28) 84%, rgba(255, 255, 255, 0.4) 97%);
  box-shadow:
    inset 0 -3rpx 8rpx rgba(160, 120, 255, 0.3),
    inset 0 3rpx 8rpx rgba(255, 255, 255, 0.38),
    0 6rpx 14rpx rgba(10, 8, 50, 0.3);
  animation: liq-orb-float 11s ease-in-out -7s infinite alternate-reverse;
}

/* ---- 氛围光斑取色（冰蓝/紫/青三色） + 纹理层兜底虹彩 + 两颗主气泡 ---- */
.themed.home-bg-liquid {
  --ambient-1: rgba(100, 150, 255, 0.5);
  --ambient-2: rgba(180, 130, 255, 0.4);
  --ambient-3: rgba(120, 230, 255, 0.32);
}
.ambient-layer--liquid .ambient-fx {
  opacity: 0.5;
  background: linear-gradient(
    200deg,
    rgba(255, 255, 255, 0) 30%,
    rgba(255, 190, 240, 0.10) 48%,
    rgba(255, 255, 255, 0.08) 56%,
    rgba(120, 200, 255, 0.10) 66%,
    rgba(0, 0, 0, 0) 84%
  );
  animation: liq-sheen 22s ease-in-out infinite alternate;
}
@keyframes liq-sheen {
  0%   { transform: translate3d(-3%, -2%, 0); }
  100% { transform: translate3d(3%, 2%, 0); }
}
/* 主气泡 A：左上冰蓝球（与右上行星环主球对角呼应） */
.ambient-layer--liquid .ambient-fx::before {
  content: '';
  position: absolute;
  top: 17%;
  left: 5%;
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background:
    radial-gradient(circle at 32% 26%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.32) 15%, rgba(255, 255, 255, 0.05) 36%),
    radial-gradient(circle at 66% 80%, rgba(160, 215, 255, 0.36) 0%, rgba(160, 215, 255, 0) 46%),
    radial-gradient(circle at 50% 50%, rgba(130, 165, 255, 0.20) 0%, rgba(130, 165, 255, 0.32) 82%, rgba(255, 255, 255, 0.45) 97%);
  box-shadow:
    inset 0 -12rpx 26rpx rgba(100, 140, 255, 0.30),
    inset 0 7rpx 18rpx rgba(255, 255, 255, 0.45),
    0 18rpx 40rpx rgba(10, 8, 50, 0.4);
  animation: liq-orb-float 13s ease-in-out infinite alternate;
}
/* 主气泡 B：左下粉紫球 */
.ambient-layer--liquid .ambient-fx::after {
  content: '';
  position: absolute;
  top: 63%;
  left: 7%;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background:
    radial-gradient(circle at 34% 28%, rgba(255, 255, 255, 0.88) 0%, rgba(255, 255, 255, 0.24) 16%, rgba(255, 255, 255, 0.03) 38%),
    radial-gradient(circle at 66% 78%, rgba(255, 190, 240, 0.38) 0%, rgba(255, 190, 240, 0) 46%),
    radial-gradient(circle at 50% 50%, rgba(180, 140, 255, 0.18) 0%, rgba(180, 140, 255, 0.30) 84%, rgba(255, 255, 255, 0.40) 97%);
  box-shadow:
    inset 0 -8rpx 20rpx rgba(150, 110, 255, 0.28),
    inset 0 6rpx 14rpx rgba(255, 255, 255, 0.38),
    0 14rpx 30rpx rgba(10, 8, 50, 0.32);
  animation: liq-orb-float 17s ease-in-out -6s infinite alternate-reverse;
}

/* ---- 内容玻璃化：紫粉调 token 覆盖（页面 wxss 晚于 app.wxss 生效） ---- */
.themed.home-bg-liquid {
  /* 文字 */
  --color-text: #F8F6FF;
  --color-text-soft: #E6DFFB;
  --color-text-mute: #B4A8E4;

  /* 主色：冰川蓝紫 → 珍珠粉 */
  --color-primary: #9FB0FF;
  --color-primary-ink: #5E6FE8;
  --color-primary-ink-2: #8F8BFF;
  --color-primary-deep: #3D4BC0;
  --color-primary-soft: rgba(150, 170, 255, 0.26);
  --color-primary-shadow: rgba(80, 100, 235, 0.55);
  --gradient-primary: linear-gradient(135deg, #6E8AFF 0%, #B48CF5 55%, #EC9BE8 100%);
  --color-accent: #8FE8F8;
  --color-danger: #FF9BB4;

  /* 表面：磨砂半透玻璃 + 真·毛玻璃折射 */
  --color-bg: #101B4E;
  --color-bg-elevated: rgba(255, 255, 255, 0.14);
  --color-bg-soft: rgba(255, 255, 255, 0.10);
  --color-card: rgba(255, 255, 255, 0.13);
  --color-border: rgba(255, 255, 255, 0.20);
  --edge-line: rgba(255, 255, 255, 0.28);
  --glass-blur: blur(40rpx) saturate(180%);
  --glass-bg-soft: rgba(255, 255, 255, 0.10);
  --glass-bg-strong: rgba(255, 255, 255, 0.17);
  --glass-border: rgba(255, 255, 255, 0.34);
  --glass-highlight: rgba(255, 255, 255, 0.5);
  --home-card-edge: rgba(255, 255, 255, 0.38);

  /* 阴影：深靛投影 */
  --shadow-sm: 0 4rpx 14rpx rgba(12, 8, 52, 0.35);
  --shadow-md: 0 10rpx 26rpx rgba(12, 8, 52, 0.4);
  --shadow-lg: 0 18rpx 44rpx rgba(12, 8, 52, 0.48);
  --elev-2: 0 8rpx 22rpx rgba(12, 8, 52, 0.35);
  --elev-3: 0 16rpx 40rpx rgba(12, 8, 52, 0.42);
  --elev-4: 0 24rpx 56rpx rgba(12, 8, 52, 0.5);
  --home-card-shadow: 0 12rpx 30rpx rgba(12, 8, 52, 0.38), inset 0 1rpx 0 rgba(255, 255, 255, 0.26);
  --home-hero-shadow: 0 18rpx 44rpx rgba(12, 8, 52, 0.45), inset 0 1rpx 0 rgba(255, 255, 255, 0.32);
  --home-bar-shadow: 0 -8rpx 32rpx rgba(12, 8, 52, 0.4), inset 0 1rpx 0 rgba(255, 255, 255, 0.26);
}

/* ---- liquid 专属点睛：FAB / 手写标语 换虹彩配色 ---- */
.home-bg-liquid .fab {
  background: linear-gradient(140deg, #8FA8FF 0%, #5E6FE8 55%, #D88CF2 128%);
  box-shadow:
    0 16rpx 44rpx rgba(80, 100, 235, 0.6),
    0 4rpx 10rpx rgba(0, 0, 0, 0.14),
    0 0 0 10rpx rgba(255, 255, 255, 0.12),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.5);
}
.home-bg-liquid .fab__icon { color: #FFFFFF; }
.home-bg-liquid .motto__text {
  background: linear-gradient(100deg, #FFFFFF 0%, #CCD9FF 38%, #FFC9EC 72%, #AEE8FF 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 2rpx 14rpx rgba(150, 170, 255, 0.4);
}
.home-bg-liquid .motto__stroke {
  background: linear-gradient(90deg, rgba(0, 0, 0, 0), rgba(200, 220, 255, 0.6), rgba(0, 0, 0, 0));
}

/* ============================================================
 * 液态琉璃 v3：对标提示词的「焦散光斑 / 玻璃波浪曲面 / 折射高光 / 悬浮景深」
 * 新增 4 层：caustic（焦散）/ wave（玻璃波浪前层）/ edge-glow（卡片折射高光）
 * + hero/fab/first-card 悬浮景深呼吸
 * 仅 page-level 元素，避免污染组件样式隔离
 * ============================================================ */

/* ---- 焦散光斑（caustic）：多层 radial 强光斑，模拟流体折射光 ---- */
.liq-caustic {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background:
    radial-gradient(ellipse 24% 15% at 24% 16%, rgba(235, 245, 255, 0.5), transparent 60%),
    radial-gradient(ellipse 20% 13% at 72% 32%, rgba(220, 240, 255, 0.46), transparent 60%),
    radial-gradient(ellipse 17% 11% at 38% 60%, rgba(255, 225, 248, 0.4), transparent 60%),
    radial-gradient(ellipse 22% 14% at 80% 76%, rgba(205, 245, 255, 0.38), transparent 62%),
    radial-gradient(ellipse 13% 10% at 14% 82%, rgba(230, 215, 255, 0.34), transparent 60%);
  mix-blend-mode: screen;
  filter: blur(2rpx);
  animation: liq-caustic-drift 18s ease-in-out infinite alternate;
  will-change: opacity, transform;
  pointer-events: none;
}
@keyframes liq-caustic-drift {
  0%   { opacity: 0.6; transform: translate3d(-2%, -1%, 0) scale(1); }
  50%  { opacity: 0.95; transform: translate3d(2%, 1%, 0) scale(1.07); }
  100% { opacity: 0.65; transform: translate3d(-1%, 2%, 0) scale(1.04); }
}
/* 全屏色彩呼吸：冰蓝↔梦幻紫色温 30s 缓慢流转（让整屏「活」起来） */
.liq-caustic::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(
    165deg,
    rgba(90, 130, 255, 0.10) 0%,
    rgba(150, 120, 255, 0.12) 45%,
    rgba(220, 140, 245, 0.10) 100%
  );
  animation: liq-hue-breath 30s ease-in-out infinite alternate;
  pointer-events: none;
}
@keyframes liq-hue-breath {
  0%   { opacity: 0.35; }
  50%  { opacity: 1; }
  100% { opacity: 0.5; }
}
/* 景深暗角：四角轻压暗，视线聚焦画面中心（电影感收尾） */
.ambient-layer--liquid::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse 90% 70% at 50% 44%, transparent 58%, rgba(8, 10, 42, 0.30) 100%);
  pointer-events: none;
}

/* ---- 玻璃波浪曲面（前层大曲面，营造纵深与前后遮挡） ---- */
.liq-wave {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.liq-wave--front {
  bottom: -22%;
  left: -20%;
  width: 140%;
  height: 500rpx;
  background:
    radial-gradient(ellipse 60% 100% at 50% 0%,
      rgba(255, 255, 255, 0.22) 0%,
      rgba(230, 240, 255, 0.15) 28%,
      rgba(190, 190, 255, 0.11) 58%,
      rgba(120, 120, 235, 0.06) 88%,
      transparent 100%);
  border-top: 3rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  box-shadow:
    0 -26rpx 60rpx rgba(150, 170, 255, 0.32),
    0 -6rpx 24rpx rgba(200, 225, 255, 0.22),
    inset 0 5rpx 0 rgba(255, 255, 255, 0.42);
  backdrop-filter: blur(8rpx);
  animation: liq-wave-roll 26s ease-in-out infinite alternate;
  opacity: 0.95;
}
@keyframes liq-wave-roll {
  0%   { transform: translate3d(0, 0, 0) scaleY(1); }
  100% { transform: translate3d(2%, -3%, 0) scaleY(1.08); }
}
.liq-wave--back {
  top: -18%;
  right: -22%;
  width: 130%;
  height: 440rpx;
  background:
    radial-gradient(ellipse 60% 100% at 50% 100%,
      rgba(255, 255, 255, 0.18) 0%,
      rgba(190, 225, 255, 0.14) 35%,
      rgba(150, 145, 245, 0.09) 65%,
      transparent 70%);
  border-bottom: 3rpx solid rgba(255, 255, 255, 0.26);
  border-radius: 0 0 50% 50% / 0 0 100% 100%;
  box-shadow:
    0 22rpx 48rpx rgba(120, 140, 240, 0.30),
    inset 0 -5rpx 0 rgba(255, 255, 255, 0.38);
  animation: liq-wave-roll-back 24s ease-in-out infinite alternate-reverse;
  opacity: 0.9;
}
@keyframes liq-wave-roll-back {
  0%   { transform: translate3d(0, 0, 0) scaleY(1); }
  100% { transform: translate3d(-2%, 3%, 0) scaleY(1.06); }
}

/* ---- 顶部虹彩折射高光（提示「边缘折射高光」强化顶部边缘） ---- */
.liq-edge-glow {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2rpx;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(255, 200, 230, 0.4) 18%,
    rgba(255, 255, 255, 0.7) 50%,
    rgba(180, 220, 255, 0.4) 82%,
    transparent 100%);
  filter: blur(1.4rpx);
  animation: liq-edge-shimmer 9s ease-in-out infinite;
  pointer-events: none;
}
@keyframes liq-edge-shimmer {
  0%, 100% { opacity: 0.5; }
  50%      { opacity: 1; }
}

/* ---- 悬浮景深：hero 面板呼吸（仅作用于 page-level 元素） ---- */
.themed.home-bg-liquid .home-hero,
.home-bg-liquid .stats-card {
  animation: liq-hero-float 8s ease-in-out infinite alternate;
}
@keyframes liq-hero-float {
  0%   { transform: translate3d(0, 0, 0) scale(1); }
  100% { transform: translate3d(0, -8rpx, 0) scale(1.014); }
}

/* ---- FAB 悬浮呼吸 + 强化光环（接管 .fab__halo，更稳） ---- */
.home-bg-liquid .fab {
  animation: liq-fab-bob 5s ease-in-out infinite alternate;
  position: relative;
}
.home-bg-liquid .fab__halo {
  background: linear-gradient(140deg, rgba(143, 168, 255, 0.7), rgba(216, 140, 242, 0.5));
  filter: blur(20rpx);
  animation: liq-fab-halo 4s ease-in-out infinite;
  opacity: 0.7;
}
@keyframes liq-fab-bob {
  0%   { transform: translate3d(0, 0, 0); }
  100% { transform: translate3d(0, -10rpx, 0); }
}
@keyframes liq-fab-halo {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.45; }
  50%      { transform: translate(-50%, -50%) scale(1.4); opacity: 0.15; }
}

/* ---- 手写标语「珍珠母贝」呼吸光泽 ---- */
.home-bg-liquid .motto__text {
  animation: liq-motto-shine 7s ease-in-out infinite;
}
@keyframes liq-motto-shine {
  0%, 100% { filter: brightness(1) saturate(1); }
  50%      { filter: brightness(1.18) saturate(1.25); }
}

/* ---- 无障碍：系统「减弱动态效果」时关闭全部流动装饰（保留静态玻璃质感） ---- */
@media (prefers-reduced-motion: reduce) {
  .liq-flow,
  .liq-ribbon,
  .liq-beam,
  .liq-swirl,
  .liq-spark,
  .liq-orb,
  .liq-caustic,
  .liq-caustic::before,
  .liq-wave,
  .liq-edge-glow,
  .ambient-layer--liquid .ambient-fx,
  .ambient-layer--liquid .ambient-fx::before,
  .ambient-layer--liquid .ambient-fx::after,
  .ambient-layer--liquid .ambient-blob,
  .themed.home-bg-liquid .home-hero,
  .home-bg-liquid .stats-card,
  .home-bg-liquid .fab,
  .home-bg-liquid .fab__halo,
  .home-bg-liquid .motto__text {
    animation: none !important;
  }
}

/* ============================ 重要日联动横幅 ============================ */
.imp-banner {
  margin: 22rpx 24rpx 0;
  padding: 22rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  border-radius: 24rpx;
  color: #fff;
  background: linear-gradient(120deg, #7B86E8 0%, #9B8AD8 50%, #C49BE0 100%);
  box-shadow: 0 12rpx 30rpx rgba(123, 134, 232, 0.34);
  position: relative;
  overflow: hidden;
}
.imp-banner::after {
  content: "";
  position: absolute; right: -40rpx; top: -40rpx;
  width: 180rpx; height: 180rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.22), transparent 70%);
}
.imp-banner__l { flex: none; display: flex; flex-direction: column; gap: 4rpx; z-index: 1; }
.imp-banner__tag { font-size: 21rpx; opacity: 0.95; }
.imp-banner__big { font-size: 30rpx; font-weight: 700; }
.imp-banner__n { font-size: 44rpx; font-weight: 800; margin: 0 4rpx; }
.imp-banner__sub { font-size: 21rpx; opacity: 0.9; }
.imp-banner__div { width: 1rpx; align-self: stretch; background: rgba(255,255,255,0.3); }
.imp-banner__r { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2rpx; z-index: 1; }
.imp-banner__lab { font-size: 20rpx; opacity: 0.9; }
.imp-banner__t {
  font-size: 27rpx; font-weight: 600;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.imp-banner__c { font-size: 21rpx; opacity: 0.95; }
.imp-banner__arrow { z-index: 1; font-size: 46rpx; opacity: 0.9; margin-left: 4rpx; }

/* 今日聚焦（最多 3 件事） */
.home-focus {
  margin: 24rpx 24rpx 0;
  padding: 20rpx 24rpx 8rpx;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(59, 130, 246, 0.1));
  border: 1rpx solid rgba(16, 185, 129, 0.25);
  border-radius: 24rpx;
}
.home-focus__hd {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 12rpx;
}
.home-focus__t { font-size: 26rpx; font-weight: 700; color: var(--color-text); }
.home-focus__c { font-size: 22rpx; color: #10b981; font-weight: 600; }
.home-focus__row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 14rpx 0; border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}
.home-focus__check {
  width: 44rpx; height: 44rpx; flex-shrink: 0; border-radius: 50%;
  border: 2rpx solid var(--color-border);
  display: flex; align-items: center; justify-content: center;
}
.home-focus__check--tap { background: rgba(0, 0, 0, 0.05); }
.home-focus__tick { font-size: 24rpx; color: var(--color-primary); }
.home-focus__content {
  flex: 1; font-size: 28rpx; color: var(--color-text);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.home-focus__content.is-done { text-decoration: line-through; color: var(--color-text-mute); }

/* 效率小工具入口 */
.home-tools {
  display: flex; gap: 20rpx;
  margin: 20rpx 24rpx 0;
}
.home-tool {
  flex: 1;
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  padding: 22rpx 0;
  background: var(--color-card, #fff);
  border: 1rpx solid var(--color-border, rgba(0,0,0,0.06));
  border-radius: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.04);
}
.home-tool--tap { background: var(--color-card-press, rgba(0,0,0,0.04)); }
.home-tool__i { font-size: 32rpx; }
.home-tool__t { font-size: 25rpx; font-weight: 600; color: var(--color-text); }

/* 碎片时间匹配弹层 */
.sheet-mask {
  position: fixed; inset: 0;
  background: rgba(0, 0, 0, 0.42);
  z-index: 90;
}
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0;
  z-index: 91;
  background: var(--color-card, #fff);
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.16);
  max-height: 72vh; overflow-y: auto;
}
.sheet__hd {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 22rpx;
}
.sheet__title { font-size: 30rpx; font-weight: 700; color: var(--color-text); }
.sheet__close { font-size: 30rpx; color: var(--color-text-mute); padding: 0 8rpx; }
.free-presets { display: flex; gap: 16rpx; margin-bottom: 22rpx; }
.free-preset {
  flex: 1; text-align: center;
  padding: 16rpx 0; font-size: 25rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--color-border, rgba(0,0,0,0.08));
  color: var(--color-text);
  background: var(--color-card-sub, rgba(0,0,0,0.03));
}
.free-preset.is-on {
  color: #fff; font-weight: 700;
  background: linear-gradient(135deg, #7b86e8, #5d4fe8);
  border-color: transparent;
}
.free-list { display: flex; flex-direction: column; gap: 14rpx; }
.free-row {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  padding: 20rpx 22rpx;
  background: var(--color-card-sub, rgba(0,0,0,0.03));
  border-radius: 16rpx;
}
.free-row__t {
  flex: 1; font-size: 27rpx; color: var(--color-text);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.free-row__m {
  flex-shrink: 0; font-size: 23rpx; color: var(--color-primary, #5d4fe8);
  font-weight: 600;
}
.free-empty {
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
  padding: 50rpx 0;
}
.free-empty__t { font-size: 27rpx; color: var(--color-text); font-weight: 600; }
.free-empty__s { font-size: 23rpx; color: var(--color-text-mute); }
