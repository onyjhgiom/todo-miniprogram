/* ========== 课程卡配色轮转（按课程名 hash 取 0~5）==========
 * 6 组色板让同一屏的多门课彼此可辨，不再是一片同色。
 */
.cs-c0 { background: var(--cs-c1-bg); border-left-color: var(--cs-c1-line); }
.cs-c1 { background: var(--cs-c2-bg); border-left-color: var(--cs-c2-line); }
.cs-c2 { background: var(--cs-c3-bg); border-left-color: var(--cs-c3-line); }
.cs-c3 { background: var(--cs-c4-bg); border-left-color: var(--cs-c4-line); }
.cs-c4 { background: var(--cs-c5-bg); border-left-color: var(--cs-c5-line); }
.cs-c5 { background: var(--cs-c6-bg); border-left-color: var(--cs-c6-line); }
