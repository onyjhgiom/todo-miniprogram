/**
 * course-schedule/styles/themes.wxss
 * 课程表专属皮肤系统（6 套）
 *
 * 设计原则：
 *  1. 变量前缀 `--cs-*`，与主项目全局主题（`--color-*` / `--glass-*`）完全隔离，
 *     课程表的张扬配色不会污染工具中心、待办等其他页面。
 *  2. 页面根节点绑定 `class="cs-root cs-theme-{{csTheme}}"`，
 *     变量通过 `.cs-root.cs-theme-X` 生效并向下级联（自定义组件同样继承）。
 *     ⚠️ 刻意用「类选择器」而非 `[data-cs-theme='X']` 属性选择器：小程序编译器会报
 *        "Some selectors are not allowed in component wxss, including tag name
 *        selectors, ID selectors, and attribute selectors"，且属性选择器在部分
 *        渲染模式下不一定生效。类选择器是官方认可写法。
 *  3. 浅色壳 3 套（dawn / candy / retro）、深色壳 3 套（midnight / cyber / moss），
 *     三套深色壳均覆盖全部 token，避免浅色 token 泄漏成"白玻璃块"。
 *  4. 每套皮肤的圆角（--cs-radius）与字体（--cs-font）也各不相同，
 *     圆润/锐利/等宽的气质差异让 6 套皮肤彼此一眼可辨。
 *
 * 默认皮肤 = dawn（晨光笔记），直接写在 .cs-root 上作为兜底，
 * 因此 csTheme 为空或为 'dawn' 时都能正常渲染（此时根节点只有 `cs-root` 一个类）。
 */

/* ========== 基础布局 + 默认皮肤：dawn 晨光笔记 ========== */
.cs-root {
  --cs-bg: #F2F6FC;
  --cs-bg-soft: #E8EFF9;
  --cs-card: #FFFFFF;
  --cs-card-line: #E4EBF5;
  --cs-text: #17202F;
  --cs-text-soft: #434F66;
  --cs-text-mute: #69768C;
  --cs-border: #E1E8F3;

  --cs-primary: #3B6DF6;
  --cs-primary-deep: #2554D4;
  --cs-primary-soft: rgba(59, 109, 246, 0.10);
  --cs-on-primary: #FFFFFF;
  --cs-hero: linear-gradient(135deg, #3B6DF6 0%, #7A9BFF 100%);
  --cs-shadow: 0 8rpx 24rpx rgba(37, 84, 212, 0.12);

  --cs-overlay: rgba(16, 26, 48, 0.45);
  --cs-warn-bg: #FFF6E0;
  --cs-warn-text: #8A5C0A;
  --cs-danger: #E5484D;
  --cs-danger-bg: #FFEDEF;
  --cs-danger-text: #B42318;
  --cs-ok: #17A673;
  --cs-chip-bg: #FFFFFF;
  --cs-input-bg: #F2F5FA;

  --cs-radius: 20rpx;
  --cs-font: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;

  --cs-c1-bg: #E9F0FF; --cs-c1-line: #3B6DF6;
  --cs-c2-bg: #E4F6EE; --cs-c2-line: #17A673;
  --cs-c3-bg: #FFF1E4; --cs-c3-line: #E08139;
  --cs-c4-bg: #F2EBFF; --cs-c4-line: #7C5CF6;
  --cs-c5-bg: #FFEAF2; --cs-c5-line: #E5487C;
  --cs-c6-bg: #E4F5FA; --cs-c6-line: #0E93B5;

  box-sizing: border-box;
  min-height: 100vh;
  background: var(--cs-bg);
  color: var(--cs-text);
  font-family: var(--cs-font);
}

