@import "../../styles/themes.wxss";

/* 颜色一律走 --cs-* 变量，跟随课表皮肤 */

.page {
  padding: 24rpx 24rpx 0;
}

.summary {
  padding: 28rpx;
  background: var(--cs-card);
  border-radius: var(--cs-radius);
  box-shadow: var(--cs-shadow);
}

.summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.summary-head-main { flex: 1; min-width: 0; }

.summary-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--cs-text);
}

.summary-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--cs-text-mute);
}

.summary-actions {
  display: flex;
  margin-top: 20rpx;
}

.link {
  margin-right: 32rpx;
  font-size: 26rpx;
  color: var(--cs-primary);
}

.link-on { font-weight: 600; }

.warnings {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--cs-warn-bg);
  border-radius: 16rpx;
}

.warning-item {
  font-size: 24rpx;
  color: var(--cs-warn-text);
  line-height: 38rpx;
}

.card {
  margin-top: 20rpx;
  padding: 24rpx;
  background: var(--cs-card);
  border-radius: var(--cs-radius);
}

.card-low {
  border: 2rpx solid var(--cs-warn-text);
  background: var(--cs-warn-bg);
}

.card-head {
  display: flex;
  align-items: center;
}

.check {
  width: 40rpx;
  height: 40rpx;
  margin-right: 18rpx;
  border: 2rpx solid var(--cs-border);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.check-on {
  background: var(--cs-primary);
  border-color: var(--cs-primary);
}

.check-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--cs-on-primary);
}

.title-input {
  flex: 1;
  height: 56rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--cs-text);
}

.input-ph { color: var(--cs-text-mute); }

.badge {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  color: var(--cs-warn-text);
  background: var(--cs-warn-bg);
  border: 2rpx solid var(--cs-warn-text);
  border-radius: 8rpx;
}

.card-body {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--cs-card-line);
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.picker {
  padding: 12rpx 20rpx;
  background: var(--cs-input-bg);
  border-radius: 12rpx;
  margin-right: 12rpx;
}

.picker-flex { flex: 1; margin-right: 0; }

.picker-text {
  font-size: 26rpx;
  color: var(--cs-text-soft);
}

.picker-sep {
  margin-right: 12rpx;
  font-size: 26rpx;
  color: var(--cs-text-mute);
}

.field-input {
  flex: 1;
  height: 60rpx;
  padding: 0 20rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  color: var(--cs-text-soft);
  background: var(--cs-input-bg);
  border-radius: 12rpx;
  box-sizing: border-box;
}

.field-input:last-child { margin-right: 0; }

.note {
  font-size: 22rpx;
  color: var(--cs-text-mute);
  line-height: 34rpx;
}

.footer-space { height: 180rpx; }

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--cs-card);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.10);
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.btn-hover { opacity: 0.78; }

.btn-ghost {
  width: 200rpx;
  margin-right: 20rpx;
  color: var(--cs-text-soft);
  background: var(--cs-bg-soft);
}

.btn-primary {
  flex: 1;
  color: var(--cs-on-primary);
  font-weight: 600;
  background: var(--cs-primary);
}
