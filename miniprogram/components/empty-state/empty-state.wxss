/* empty-state */
.empty-state {
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 96rpx 48rpx;
  color: var(--color-text-soft);
  text-align: center;
}
.empty-icon {
  font-size: 120rpx; line-height: 1;
  margin-bottom: 24rpx;
  opacity: 0.8;
}
.empty-title {
  font-family: var(--font-serif, serif);
  font-size: 32rpx; color: var(--color-text); font-weight: 600; letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}
.empty-subtitle {
  font-size: 24rpx; color: var(--color-text-mute);
  line-height: 1.5;
  margin-bottom: 24rpx;
}
.empty-action {
  margin-top: 8rpx;
  padding: 16rpx 32rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
}
.empty-action:active { transform: scale(0.96); }

/* ============================================================
 * 剧场版追加：空状态不该是「什么都没有」，
 * 而是一个安静、有余韵的留白舞台 —— 图标漂浮 + 柔光承托 + 精致排印。
 * ============================================================ */

.empty-state {
  padding: 110rpx 48rpx 100rpx;
  animation: empty-in .6s cubic-bezier(.16, .84, .28, 1) both;
}

@keyframes empty-in {
  from { opacity: 0; transform: translate3d(0, 18rpx, 0); }
  to { opacity: 1; transform: translate3d(0, 0, 0); }
}

.empty-icon {
  position: relative;
  margin-bottom: 28rpx;
  font-size: 128rpx;
  opacity: .88;
  /* 极缓慢的上下浮动：画面「活着」，但不抢戏 */
  animation: empty-float 6.4s ease-in-out infinite;
}
/* 图标下方一团柔光，把主体「托」起来 */
.empty-icon::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 58%;
  width: 260rpx;
  height: 260rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(circle, var(--color-primary-soft), rgba(0, 0, 0, 0) 70%);
  z-index: -1;
  pointer-events: none;
}

@keyframes empty-float {
  0%, 100% { transform: translate3d(0, 0, 0); }
  50% { transform: translate3d(0, -12rpx, 0); }
}

.empty-title {
  letter-spacing: 3rpx;
  margin-bottom: 12rpx;
  animation: empty-in .6s cubic-bezier(.16, .84, .28, 1) .08s both;
}
.empty-subtitle {
  max-width: 460rpx;
  animation: empty-in .6s cubic-bezier(.16, .84, .28, 1) .16s both;
}

/* 行动按钮：主色渐变 + 落地光 + 回弹按压 */
.empty-action {
  margin-top: 16rpx;
  padding: 18rpx 40rpx;
  background: var(--gradient-primary, linear-gradient(135deg, #B5714C, #96573A));
  color: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: var(--elev-2, 0 8rpx 24rpx rgba(74, 58, 42, .1)), var(--color-primary-shadow, rgba(150, 87, 58, .26)) 0 8rpx 20rpx -6rpx;
  transition: transform 220ms cubic-bezier(.34, 1.56, .64, 1), box-shadow 220ms ease;
  animation: empty-in .6s cubic-bezier(.16, .84, .28, 1) .24s both;
}
.empty-action:active {
  transform: translate3d(0, 3rpx, 0) scale(.96);
}