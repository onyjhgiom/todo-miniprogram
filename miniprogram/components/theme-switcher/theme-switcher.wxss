/* theme-switcher：预览卡片式风格选择器（对齐效果图十宫格） */
.ts-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

/* ===== 卡片容器 ===== */
.ts-card {
  border-radius: 20rpx;
  padding: 12rpx 12rpx 16rpx;
  background: var(--color-bg-soft, rgba(255, 255, 255, 0.06));
  border: 2rpx solid transparent;
  transition: transform 200ms, border-color 200ms, background 200ms;
  box-sizing: border-box;
}
.ts-card.is-active {
  border-color: var(--color-primary, #E2B273);
  background: var(--color-primary-soft, rgba(226, 178, 115, 0.12));
}
.ts-card--press { transform: scale(0.97); }

/* ===== 迷你预览屏 ===== */
.ts-screen {
  position: relative;
  height: 190rpx;
  border-radius: 14rpx;
  padding: 16rpx 16rpx 0;
  overflow: hidden;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.14), 0 4rpx 12rpx rgba(0, 0, 0, 0.14);
  box-sizing: border-box;
}
.ts-screen__notch {
  width: 56rpx;
  height: 6rpx;
  border-radius: 999rpx;
  opacity: 0.6;
  margin-bottom: 14rpx;
}
.ts-screen__title {
  width: 96rpx;
  height: 10rpx;
  border-radius: 4rpx;
  opacity: 0.5;
  margin-bottom: 16rpx;
}
.ts-screen__panel {
  height: 44rpx;
  border-radius: 10rpx;
  opacity: 0.85;
  margin-bottom: 12rpx;
}
.ts-screen__row { display: flex; gap: 10rpx; }
.ts-screen__pill {
  flex: 1;
  height: 18rpx;
  border-radius: 999rpx;
  opacity: 0.9;
}
.ts-screen__pill--soft { opacity: 0.4; }

/* 选中角标 */
.ts-check {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 36rpx;
  height: 36rpx;
  background: var(--color-primary, #E2B273);
  color: #171310;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

/* 自定义屏：居中大 glyph */
.ts-screen--custom {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx dashed rgba(255, 255, 255, 0.6);
}
.ts-custom-glyph { font-size: 52rpx; line-height: 1; text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3); }

/* ===== 风格信息 ===== */
.ts-meta { padding: 14rpx 6rpx 0; }
.ts-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text, #F3EAD9);
  line-height: 1.3;
}
.ts-card.is-active .ts-name { color: var(--color-primary, #E2B273); }
.ts-tag {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-mute, #948871);
  line-height: 1.4;
}
.ts-dots { display: flex; gap: 10rpx; margin-top: 12rpx; }
.ts-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.35);
}
