/* components/fx-stage/fx-stage.wxss
   电影级舞台层样式。
   注意：自定义组件默认样式隔离，app.wxss 的类不会进来；
   但 CSS 自定义属性（--xxx）会沿 DOM 继承下来，
   所以这里可以直接消费 page/.themed 上定义的 --ambient-* / --shaft-* 实现主题联动。 */

/* fixed 而非 absolute：保证上下滚动时氛围层始终承托内容，
   与页面里既有的 .ambient-layer 行为一致；同时不要求父容器 position:relative。 */
.fxs {
  position: fixed;
  left: 0;
  top: 0;
  /* 显式 vw/vh：真机上 top/bottom 双锚点在 webview 里撑高不稳定，
     会让子元素 100% 高度解析成 0（背景图只露一小条）。vw/vh 是确定值。 */
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

/* ---------- 斜向体积光轴 ---------- */
.fxs__rays {
  position: absolute;
  left: -18%;
  top: -26%;
  width: 136%;
  height: 156%;
  transform: rotate(-16deg);
}
.fxs__ray {
  position: absolute;
  top: -18%;
  width: 150rpx;
  height: 150%;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0) 0%,
    var(--shaft-1, rgba(255, 252, 244, 0.5)) 34%,
    rgba(255, 255, 255, 0) 78%
  );
  filter: blur(30rpx);
  transform-origin: 50% 0;
  animation: fxs-ray 11s ease-in-out infinite;
  will-change: transform, opacity;
}
.fxs__ray--1 { left: 4%; animation-delay: -2s; animation-duration: 13s; }
.fxs__ray--2 { left: 40%; animation-delay: -6.5s; animation-duration: 16s; }
.fxs__ray--3 { left: 72%; animation-delay: -9s; animation-duration: 14s; }

@keyframes fxs-ray {
  0%, 100% { opacity: .28; transform: translate3d(0, 0, 0) scaleX(1); }
  50% { opacity: .7; transform: translate3d(46rpx, 0, 0) scaleX(1.14); }
}

/* ---------- 环境光晕 ---------- */
.fxs__blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(96rpx);
  will-change: transform;
}
.fxs__blob--a {
  width: 560rpx;
  height: 560rpx;
  top: -190rpx;
  right: -150rpx;
  background: radial-gradient(circle, var(--ambient-1), rgba(0, 0, 0, 0) 70%);
  animation: fxs-drift 27s ease-in-out infinite alternate;
}
.fxs__blob--b {
  width: 480rpx;
  height: 480rpx;
  bottom: -170rpx;
  left: -130rpx;
  background: radial-gradient(circle, var(--ambient-2), rgba(0, 0, 0, 0) 70%);
  animation: fxs-drift 35s ease-in-out infinite alternate-reverse;
}

@keyframes fxs-drift {
  0% { transform: translate3d(0, 0, 0) scale(1); }
  50% { transform: translate3d(38rpx, -30rpx, 0) scale(1.09); }
  100% { transform: translate3d(-30rpx, 26rpx, 0) scale(.95); }
}

/* ---------- 国风墨韵：极缓旋转的水墨光轮 ---------- */
.fxs__inkring {
  position: absolute;
  left: 50%;
  top: 12%;
  width: 760rpx;
  height: 760rpx;
  margin-left: -380rpx;
  border-radius: 50%;
  /* 用径向渐变做出「一圈墨痕」，避免 conic-gradient 的兼容性风险 */
  background: radial-gradient(
    circle,
    rgba(0, 0, 0, 0) 56%,
    var(--ambient-1) 70%,
    rgba(0, 0, 0, 0) 88%
  );
  filter: blur(46rpx);
  opacity: .42;
  animation: fxs-spin 96s linear infinite;
  will-change: transform;
}

@keyframes fxs-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* ---------- 浮尘微粒 ---------- */
.fxs__dust {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}
.fxs__mote {
  position: absolute;
  bottom: -16rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--shaft-1, rgba(255, 255, 255, .7)), rgba(255, 255, 255, 0) 72%);
  animation-name: fxs-mote;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  will-change: transform;
}

@keyframes fxs-mote {
  0% { transform: translate3d(0, 0, 0) scale(.65); }
  50% { transform: translate3d(28rpx, -540rpx, 0) scale(1); }
  100% { transform: translate3d(-20rpx, -1080rpx, 0) scale(.65); }
}

/* ---------- 顶部柔光带 ---------- */
.fxs__topglow {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 440rpx;
  background: linear-gradient(180deg, var(--shaft-2, rgba(255, 255, 255, .26)), rgba(0, 0, 0, 0));
  pointer-events: none;
}

/* ---------- 模式微调 ---------- */
/* 墨韵模式：光轴收敛、整体更沉，突出墨圈的东方意境 */
.fxs--ink .fxs__rays { opacity: .5; }
.fxs--ink .fxs__topglow { opacity: .7; }
/* 星尘模式：光晕压暗，让微粒更跳 */
.fxs--stardust .fxs__blob { opacity: .55; }

/* ============================================================
 * 暮色湖景（sunset）：程序化「日落湖山」背景，对齐效果图气质
 * 层次（自后向前）：天空 → 日晕 → 落日 → 远山 → 近山 → 水面 → 金光道 → 碎金
 * 全部为静态合成 + 极少量 opacity 动画（落日呼吸 / 碎金闪烁），
 * 无图片资源、无 layout/paint 动画。
 * ============================================================ */

/* 天空：夜蓝黑 → 暖褐 → 落日橙金，占上 62% */
.fxs__sky {
  position: absolute;
  left: 0; right: 0; top: 0;
  height: 63%;
  background: linear-gradient(
    180deg,
    #0D1220 0%,
    #171524 22%,
    #2E2430 44%,
    #5A3A2C 63%,
    #A96A34 80%,
    #D89A52 92%,
    #EDBE78 100%
  );
}

/* 落日大光晕：金橙径向光，罩住半个天际线 */
.fxs__sunhalo {
  position: absolute;
  left: 50%;
  top: 34%;
  width: 920rpx;
  height: 920rpx;
  margin-left: -460rpx;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(255, 214, 140, .5) 0%,
    rgba(238, 168, 88, .26) 34%,
    rgba(160, 96, 48, .1) 58%,
    rgba(0, 0, 0, 0) 74%
  );
  filter: blur(20rpx);
  animation: fxs-sun-breathe 9s ease-in-out infinite;
  will-change: opacity, transform;
}

/* 落日本体：暖金圆日，悬在天际线上 */
.fxs__sun {
  position: absolute;
  left: 50%;
  top: 47%;
  width: 150rpx;
  height: 150rpx;
  margin-left: -75rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 42%, #FFE9BE 0%, #F5C878 46%, #E89E52 78%, rgba(232, 158, 82, 0) 100%);
  box-shadow: 0 0 90rpx 30rpx rgba(248, 190, 110, .45);
  animation: fxs-sun-breathe 9s ease-in-out infinite;
  will-change: opacity, transform;
}

@keyframes fxs-sun-breathe {
  0%, 100% { opacity: .94; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.045); }
}

/* 远山：两层深色剪影，用大椭圆 + 底部矩形拼出山脊线 */
.fxs__hill {
  position: absolute;
  left: -12%;
  right: -12%;
  pointer-events: none;
}
.fxs__hill--far {
  top: 50%;
  height: 200rpx;
  background:
    radial-gradient(120% 200% at 22% 100%, #241B22 0%, rgba(36, 27, 34, 0) 62%),
    radial-gradient(130% 220% at 62% 100%, #201923 0%, rgba(32, 25, 35, 0) 58%),
    radial-gradient(110% 190% at 88% 100%, #2A2030 0%, rgba(42, 32, 48, 0) 60%);
}
.fxs__hill--near {
  top: 56%;
  height: 230rpx;
  background:
    radial-gradient(140% 240% at 12% 100%, #17121A 0%, rgba(23, 18, 26, 0) 64%),
    radial-gradient(150% 260% at 52% 100%, #131017 0%, rgba(19, 16, 23, 0) 60%),
    radial-gradient(130% 230% at 90% 100%, #1A1420 0%, rgba(26, 20, 32, 0) 62%);
}

/* 水面：落日橙在近处一线残光，向下沉入夜色 */
.fxs__water {
  position: absolute;
  left: 0; right: 0;
  top: 62%;
  bottom: 0;
  background: linear-gradient(
    180deg,
    #D89A52 0%,
    #8A5A32 8%,
    #3C2C1E 22%,
    #1A140F 46%,
    #100D0A 100%
  );
}

/* 金光道：落日在水面的竖向倒影，微微摇曳 */
.fxs__glowroad {
  position: absolute;
  left: 50%;
  top: 62%;
  width: 200rpx;
  height: 34%;
  margin-left: -100rpx;
  background: linear-gradient(
    180deg,
    rgba(255, 214, 140, .5) 0%,
    rgba(240, 178, 100, .22) 40%,
    rgba(0, 0, 0, 0) 100%
  );
  filter: blur(14rpx);
  transform-origin: 50% 0;
  animation: fxs-glow-sway 7s ease-in-out infinite;
  will-change: transform, opacity;
}

@keyframes fxs-glow-sway {
  0%, 100% { opacity: .8; transform: scaleX(1); }
  50% { opacity: 1; transform: scaleX(1.12); }
}

/* 碎金：水面两条横向光带极慢闪烁，替代大量粒子 */
.fxs__glitter {
  position: absolute;
  left: 18%;
  right: 18%;
  height: 3rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0), rgba(255, 220, 150, .5), rgba(0, 0, 0, 0));
  filter: blur(2rpx);
  animation: fxs-glitter 6s ease-in-out infinite;
  will-change: opacity;
}
.fxs__glitter--1 { top: 68%; animation-delay: -1.2s; }
.fxs__glitter--2 { top: 76%; width: 44%; left: 34%; animation-delay: -3.8s; animation-duration: 8s; }

@keyframes fxs-glitter {
  0%, 100% { opacity: .16; }
  50% { opacity: .85; }
}

/* sunset 模式微调：光轴收弱成薄暮雾光，顶部柔光换成天光余晖 */
.fxs--sunset .fxs__rays { opacity: .35; }
.fxs--sunset .fxs__topglow {
  height: 560rpx;
  background: linear-gradient(180deg, rgba(255, 200, 130, .1), rgba(0, 0, 0, 0));
}
.fxs--sunset .fxs__blob--a { background: radial-gradient(circle, rgba(238, 168, 88, .22), rgba(0, 0, 0, 0) 70%); }
.fxs--sunset .fxs__blob--b { background: radial-gradient(circle, rgba(120, 80, 60, .2), rgba(0, 0, 0, 0) 70%); }

/* ---------- grid 霓虹网格（tech / pixel 专属） ---------- */
/* 地平线：主题色霓虹光带横贯屏幕 55% 处，缓慢呼吸 */
.fxs__horizon {
  position: absolute;
  left: 0;
  right: 0;
  top: 55%;
  height: 6rpx;
  background: linear-gradient(
    90deg,
    rgba(0, 0, 0, 0) 0%,
    var(--color-primary, #22D3EE) 22%,
    rgba(255, 255, 255, .9) 50%,
    var(--color-primary, #22D3EE) 78%,
    rgba(0, 0, 0, 0) 100%
  );
  box-shadow: 0 0 28rpx var(--color-primary, #22D3EE);
  filter: blur(1rpx);
  animation: fxs-horizon-breathe 6s ease-in-out infinite;
  will-change: opacity;
}
@keyframes fxs-horizon-breathe {
  0%, 100% { opacity: .55; }
  50% { opacity: 1; }
}

/* 网格地面：两层 repeating 渐变织出方格，rotateX 压成透视地平面，向上流动 */
.fxs__gridfloor {
  position: absolute;
  left: -60%;
  right: -60%;
  top: 55%;
  height: 90%;
  background-image:
    repeating-linear-gradient(
      90deg,
      var(--grid-line, rgba(34, 211, 238, .16)) 0 2rpx,
      rgba(0, 0, 0, 0) 2rpx 72rpx
    ),
    repeating-linear-gradient(
      0deg,
      var(--grid-line, rgba(34, 211, 238, .16)) 0 2rpx,
      rgba(0, 0, 0, 0) 2rpx 72rpx
    );
  transform: perspective(500rpx) rotateX(62deg);
  transform-origin: 50% 0;
  mask-image: linear-gradient(180deg, rgba(0, 0, 0, .9) 0%, rgba(0, 0, 0, .35) 46%, rgba(0, 0, 0, 0) 100%);
  -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, .9) 0%, rgba(0, 0, 0, .35) 46%, rgba(0, 0, 0, 0) 100%);
  animation: fxs-grid-flow 5s linear infinite;
  will-change: background-position;
}
@keyframes fxs-grid-flow {
  from { background-position: 0 0, 0 0; }
  to { background-position: 0 0, 0 72rpx; }
}

/* grid 模式微调：光轴关掉避免和网格打架，色斑压暗成夜空辉光 */
.fxs--grid .fxs__rays { opacity: .18; }
.fxs--grid .fxs__blob--a { background: radial-gradient(circle, var(--color-primary-soft, rgba(34, 211, 238, .2)), rgba(0, 0, 0, 0) 70%); }
.fxs--grid .fxs__blob--b { background: radial-gradient(circle, rgba(20, 30, 60, .35), rgba(0, 0, 0, 0) 70%); }
.fxs--grid .fxs__topglow { opacity: .6; }

/* ============================================================
 * 一风格一场景：十大风格的专属舞台背景（效果图对齐）
 * 全部 CSS 程序化绘制，零图片资源；动画只动 transform/opacity
 * ============================================================ */

/* ---------- clean 极简白：左上玻璃圆球 ---------- */
.fxs__orb {
  position: absolute;
  border-radius: 50%;
}
.fxs__orb--glass {
  left: -60rpx;
  top: -40rpx;
  width: 380rpx;
  height: 380rpx;
  background:
    radial-gradient(circle at 32% 30%, rgba(255, 255, 255, .9) 0%, rgba(248, 250, 252, .35) 46%, rgba(226, 232, 240, 0) 72%);
  border: 1rpx solid rgba(148, 163, 184, .18);
  box-shadow: 0 24rpx 80rpx rgba(148, 163, 184, .12);
  filter: blur(2rpx);
  animation: fxs-orb-breathe 12s ease-in-out infinite;
  will-change: opacity, transform;
}
@keyframes fxs-orb-breathe {
  0%, 100% { opacity: .7; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.05); }
}
/* clean 模式微调：光斑几乎隐形，只留纯净空气 */
.fxs--clean .fxs__blob--a { opacity: .25; }
.fxs--clean .fxs__blob--b { opacity: .18; }
.fxs--clean .fxs__rays { opacity: .12; }
.fxs--clean .fxs__topglow { opacity: .35; }

/* ---------- grid 深色科技：暗星行星（补充） ---------- */
.fxs__planet {
  position: absolute;
  right: -70rpx;
  top: -90rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 34% 30%, #24365C 0%, #16233F 42%, #0B1222 78%);
  box-shadow:
    0 0 60rpx rgba(56, 132, 255, .22),
    inset -18rpx -24rpx 60rpx rgba(0, 0, 0, .55);
  animation: fxs-planet-float 16s ease-in-out infinite;
  will-change: transform;
}
@keyframes fxs-planet-float {
  0%, 100% { transform: translate3d(0, 0, 0); }
  50% { transform: translate3d(-10rpx, 8rpx, 0); }
}

/* ---------- meadow 治愈插画：暖阳 + 黄绿山丘 ---------- */
.fxs__mdsun {
  position: absolute;
  left: 18%;
  top: 6%;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 236, 170, .95) 0%, rgba(250, 210, 120, .5) 46%, rgba(250, 210, 120, 0) 74%);
  filter: blur(4rpx);
  animation: fxs-mdsun-glow 9s ease-in-out infinite;
  will-change: opacity, transform;
}
@keyframes fxs-mdsun-glow {
  0%, 100% { opacity: .75; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.08); }
}
.fxs__mdhill {
  position: absolute;
  border-radius: 50%;
}
.fxs__mdhill--far {
  left: -18%;
  top: -140rpx;
  width: 88%;
  height: 360rpx;
  background: linear-gradient(180deg, rgba(214, 226, 168, .8) 0%, rgba(214, 226, 168, 0) 82%);
  filter: blur(6rpx);
}
.fxs__mdhill--near {
  right: -26%;
  top: -190rpx;
  width: 96%;
  height: 420rpx;
  background: linear-gradient(180deg, rgba(184, 210, 140, .65) 0%, rgba(184, 210, 140, 0) 80%);
  filter: blur(8rpx);
}
/* meadow 模式微调：色斑转暖调薄雾 */
.fxs--meadow .fxs__blob--a { background: radial-gradient(circle, rgba(250, 214, 130, .2), rgba(0, 0, 0, 0) 70%); }
.fxs--meadow .fxs__blob--b { background: radial-gradient(circle, rgba(184, 214, 150, .16), rgba(0, 0, 0, 0) 70%); }
.fxs--meadow .fxs__rays { opacity: .2; }

/* ---------- eclipse 暗黑渐变：黑金日食 ---------- */
.fxs__eclipse {
  position: absolute;
  right: 12%;
  top: -60rpx;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 40% 42%, #060505 0%, #0B0906 52%, rgba(74, 59, 34, .55) 72%, rgba(0, 0, 0, 0) 86%);
  box-shadow: 0 0 90rpx rgba(226, 178, 115, .16);
  animation: fxs-eclipse-breathe 14s ease-in-out infinite;
  will-change: opacity;
}
@keyframes fxs-eclipse-breathe {
  0%, 100% { opacity: .8; }
  50% { opacity: 1; }
}
.fxs__ecomet {
  position: absolute;
  left: -10%;
  bottom: -12%;
  width: 70%;
  height: 44%;
  background: radial-gradient(ellipse at 30% 80%, rgba(226, 178, 115, .14) 0%, rgba(0, 0, 0, 0) 68%);
  filter: blur(30rpx);
}
/* eclipse 模式微调：色斑压成金雾，光轴收窄 */
.fxs--eclipse .fxs__blob--a { background: radial-gradient(circle, rgba(226, 178, 115, .12), rgba(0, 0, 0, 0) 70%); }
.fxs--eclipse .fxs__blob--b { background: radial-gradient(circle, rgba(60, 48, 30, .3), rgba(0, 0, 0, 0) 70%); }
.fxs--eclipse .fxs__rays { opacity: .15; }

/* ---------- confetti 潮流多彩：彩纸胶囊彩点 ---------- */
.fxs__cf {
  position: absolute;
  border-radius: 40rpx;
  will-change: transform, opacity;
  animation: fxs-cf-bob 7s ease-in-out infinite;
}
.fxs__cf--1 { left: 8%;  top: 4%;  width: 88rpx;  height: 34rpx; background: linear-gradient(135deg, #F472B6, #EC4899); transform: rotate(-18deg); animation-delay: -1s; }
.fxs__cf--2 { right: 14%; top: 8%; width: 30rpx; height: 30rpx; border-radius: 50%; background: linear-gradient(135deg, #FBBF24, #F59E0B); animation-delay: -3.2s; animation-duration: 8s; }
.fxs__cf--3 { right: 6%; top: 22%; width: 70rpx; height: 26rpx; background: linear-gradient(135deg, #8B5CF6, #6366F1); transform: rotate(24deg); animation-delay: -5s; }
.fxs__cf--4 { left: 20%; top: 16%; width: 26rpx; height: 26rpx; border-radius: 50%; background: linear-gradient(135deg, #34D399, #10B981); animation-delay: -2.2s; animation-duration: 9s; }
.fxs__cf--5 { left: 44%; top: 2%; width: 56rpx; height: 22rpx; background: linear-gradient(135deg, #38BDF8, #3B82F6); transform: rotate(-8deg); animation-delay: -4.1s; animation-duration: 7.6s; }
@keyframes fxs-cf-bob {
  0%, 100% { opacity: .5; }
  50% { opacity: .95; }
}
/* confetti 模式微调：色斑改成糖果柔雾 */
.fxs--confetti .fxs__blob--a { background: radial-gradient(circle, rgba(244, 114, 182, .14), rgba(0, 0, 0, 0) 70%); }
.fxs--confetti .fxs__blob--b { background: radial-gradient(circle, rgba(251, 191, 36, .13), rgba(0, 0, 0, 0) 70%); }
.fxs--confetti .fxs__rays { opacity: .18; }

/* ---------- polaroid 复古怀旧：倾斜拍立得相纸 ---------- */
.fxs__polaroid {
  position: absolute;
  right: 9%;
  top: 5%;
  width: 190rpx;
  height: 216rpx;
  padding: 12rpx 12rpx 44rpx;
  background: linear-gradient(180deg, #FBF7EE 0%, #F1E9D8 100%);
  border-radius: 10rpx;
  box-shadow: 0 18rpx 44rpx rgba(92, 62, 34, .28);
  transform: rotate(-7deg);
  animation: fxs-polaroid-sway 11s ease-in-out infinite;
  will-change: transform;
}
@keyframes fxs-polaroid-sway {
  0%, 100% { transform: rotate(-7deg) translate3d(0, 0, 0); }
  50% { transform: rotate(-5.2deg) translate3d(0, -8rpx, 0); }
}
.fxs__polaroid__photo {
  width: 100%;
  height: 100%;
  border-radius: 4rpx;
  background:
    radial-gradient(circle at 62% 30%, rgba(255, 226, 160, .85) 0%, rgba(214, 140, 70, .5) 40%, rgba(90, 58, 34, .9) 100%),
    linear-gradient(180deg, #C9A06A 0%, #8A5A38 100%);
  box-shadow: inset 0 0 24rpx rgba(60, 38, 20, .45);
}
/* polaroid 模式微调：底部泛起旧纸暖雾 */
.fxs--polaroid .fxs__blob--a { background: radial-gradient(circle, rgba(200, 150, 90, .16), rgba(0, 0, 0, 0) 70%); }
.fxs--polaroid .fxs__blob--b { background: radial-gradient(circle, rgba(140, 98, 57, .14), rgba(0, 0, 0, 0) 70%); }
.fxs--polaroid .fxs__rays { opacity: .2; }

/* ---------- leafshade 莫兰迪：柔和叶影 ---------- */
.fxs__leaf {
  position: absolute;
  border-radius: 50%;
  filter: blur(50rpx);
  will-change: transform;
}
.fxs__leaf--a {
  right: -14%;
  top: -10%;
  width: 62%;
  height: 40%;
  background: radial-gradient(ellipse, rgba(154, 175, 156, .4) 0%, rgba(154, 175, 156, 0) 70%);
  animation: fxs-leaf-drift 18s ease-in-out infinite;
}
.fxs__leaf--b {
  left: -12%;
  top: 12%;
  width: 46%;
  height: 30%;
  background: radial-gradient(ellipse, rgba(196, 188, 168, .34) 0%, rgba(196, 188, 168, 0) 70%);
  animation: fxs-leaf-drift 22s ease-in-out infinite;
  animation-delay: -9s;
}
@keyframes fxs-leaf-drift {
  0%, 100% { transform: translate3d(0, 0, 0); }
  50% { transform: translate3d(-20rpx, 12rpx, 0); }
}
/* leafshade 模式微调：光斑灰绿化，光轴几乎关闭 */
.fxs--leafshade .fxs__blob--a { background: radial-gradient(circle, rgba(168, 181, 168, .18), rgba(0, 0, 0, 0) 70%); }
.fxs--leafshade .fxs__blob--b { background: radial-gradient(circle, rgba(213, 207, 194, .2), rgba(0, 0, 0, 0) 70%); }
.fxs--leafshade .fxs__rays { opacity: .1; }

/* ---------- aurora 玻璃拟态：幻彩渐变球 + 极光雾 ---------- */
.fxs__gradient-orb {
  position: absolute;
  right: -4%;
  top: -8%;
  width: 460rpx;
  height: 460rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(124, 92, 252, .8) 0%, rgba(168, 85, 247, .62) 44%, rgba(56, 189, 248, .55) 100%);
  filter: blur(26rpx);
  animation: fxs-gorb-float 15s ease-in-out infinite;
  will-change: transform;
}
@keyframes fxs-gorb-float {
  0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
  50% { transform: translate3d(-18rpx, 14rpx, 0) scale(1.05); }
}
.fxs__aurora-mist {
  position: absolute;
  left: -8%;
  bottom: -6%;
  width: 88%;
  height: 40%;
  background: linear-gradient(20deg, rgba(168, 85, 247, .18) 0%, rgba(236, 72, 153, .12) 46%, rgba(0, 0, 0, 0) 82%);
  filter: blur(40rpx);
}
/* aurora 模式微调：色斑幻彩化 */
.fxs--aurora .fxs__blob--a { background: radial-gradient(circle, rgba(168, 85, 247, .2), rgba(0, 0, 0, 0) 70%); }
.fxs--aurora .fxs__blob--b { background: radial-gradient(circle, rgba(56, 189, 248, .18), rgba(0, 0, 0, 0) 70%); }
.fxs--aurora .fxs__rays { opacity: .3; }

/* ---------- ink 国风水墨：远山 + 竹枝（补充） ---------- */
.fxs__inkmount {
  position: absolute;
  border-radius: 50%;
}
.fxs__inkmount--far {
  left: -22%;
  bottom: -170rpx;
  width: 90%;
  height: 330rpx;
  background: radial-gradient(ellipse at 50% 20%, rgba(117, 137, 124, .3) 0%, rgba(117, 137, 124, 0) 72%);
  filter: blur(8rpx);
}
.fxs__inkmount--near {
  right: -30%;
  bottom: -210rpx;
  width: 100%;
  height: 380rpx;
  background: radial-gradient(ellipse at 50% 18%, rgba(78, 97, 87, .24) 0%, rgba(78, 97, 87, 0) 70%);
  filter: blur(10rpx);
}
.fxs__bamboo {
  position: absolute;
  right: 7%;
  top: 4%;
  width: 200rpx;
  height: 320rpx;
}
.fxs__bamboo__stem {
  position: absolute;
  right: 46rpx;
  top: 0;
  width: 5rpx;
  height: 100%;
  background: linear-gradient(180deg, rgba(78, 97, 87, .5) 0%, rgba(78, 97, 87, .1) 90%);
  transform: rotate(10deg);
  transform-origin: 50% 0;
}
.fxs__bamboo__leaf {
  position: absolute;
  width: 84rpx;
  height: 15rpx;
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  background: linear-gradient(90deg, rgba(78, 97, 87, .42) 0%, rgba(78, 97, 87, .06) 100%);
  will-change: transform, opacity;
  animation: fxs-bamboo-sway 9s ease-in-out infinite;
}
.fxs__bamboo__leaf--1 { right: 6rpx;  top: 36rpx;  transform: rotate(-26deg); }
.fxs__bamboo__leaf--2 { right: 70rpx; top: 78rpx;  transform: rotate(18deg); animation-delay: -2.6s; }
.fxs__bamboo__leaf--3 { right: 0;     top: 132rpx; transform: rotate(-14deg); animation-delay: -5.1s; }
.fxs__bamboo__leaf--4 { right: 78rpx; top: 178rpx; transform: rotate(30deg); animation-delay: -7.3s; }
@keyframes fxs-bamboo-sway {
  0%, 100% { opacity: .75; }
  50% { opacity: 1; }
}
/* ink 模式微调：色斑转黛青薄雾 */
.fxs--ink .fxs__blob--a { background: radial-gradient(circle, rgba(117, 137, 124, .16), rgba(0, 0, 0, 0) 70%); }
.fxs--ink .fxs__blob--b { background: radial-gradient(circle, rgba(201, 205, 185, .22), rgba(0, 0, 0, 0) 70%); }

/* ---------- pixelcamp 游戏像素：夜空篝火 ---------- */
.fxs__pxmoon {
  position: absolute;
  right: 12%;
  top: 7%;
  width: 16rpx;
  height: 16rpx;
  background: #F8D878;
  /* box-shadow 点阵拼出像素月亮（3x3 缺角） */
  box-shadow:
    16rpx 0 0 #F8D878,
    32rpx 0 0 #F8D878,
    0 16rpx 0 #F8D878,
    16rpx 16rpx 0 #FCE9A8,
    32rpx 16rpx 0 #F8D878,
    48rpx 16rpx 0 #F8D878,
    0 32rpx 0 #F8D878,
    16rpx 32rpx 0 #F8D878,
    32rpx 32rpx 0 #FCE9A8,
    0 48rpx 0 #F8D878,
    16rpx 48rpx 0 #F8D878;
  animation: fxs-px-blink 5s steps(2) infinite;
  will-change: opacity;
}
.fxs__pxstar {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  background: #CFE3FF;
  animation: fxs-px-blink 3.4s steps(2) infinite;
}
.fxs__pxstar--1 { left: 16%; top: 10%; animation-delay: -1.1s; }
.fxs__pxstar--2 { left: 44%; top: 6%;  animation-delay: -2.2s; animation-duration: 4.2s; }
.fxs__pxstar--3 { right: 34%; top: 15%; animation-delay: -0.6s; animation-duration: 2.9s; }
@keyframes fxs-px-blink {
  0%, 100% { opacity: .45; }
  50% { opacity: 1; }
}
.fxs__pxground {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 190rpx;
  background:
    repeating-linear-gradient(90deg, rgba(38, 62, 44, .55) 0 64rpx, rgba(30, 52, 38, .55) 64rpx 128rpx),
    linear-gradient(180deg, rgba(38, 62, 44, 0) 0%, rgba(30, 48, 36, .85) 34%, #16241B 100%);
}
.fxs__pxfire {
  position: absolute;
  left: 50%;
  bottom: 130rpx;
  width: 220rpx;
  height: 220rpx;
  margin-left: -110rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 176, 80, .5) 0%, rgba(255, 120, 50, .22) 46%, rgba(0, 0, 0, 0) 74%);
  filter: blur(6rpx);
  animation: fxs-pxfire-flicker 2.6s ease-in-out infinite;
  will-change: opacity, transform;
}
@keyframes fxs-pxfire-flicker {
  0%, 100% { opacity: .7; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.12); }
}
/* pixelcamp 模式微调：光轴关闭，色斑压成夜空深蓝 */
.fxs--pixelcamp .fxs__rays { opacity: 0; }
.fxs--pixelcamp .fxs__blob--a { background: radial-gradient(circle, rgba(61, 52, 104, .4), rgba(0, 0, 0, 0) 70%); }
.fxs--pixelcamp .fxs__blob--b { background: radial-gradient(circle, rgba(28, 44, 78, .5), rgba(0, 0, 0, 0) 70%); }
.fxs--pixelcamp .fxs__topglow { opacity: .4; }

/* ---------- 场景图模式（src 非空）：真实照片背景 ----------
 * 真机验证结论：图片元素直接 position:fixed + 显式 100vw/100vh（内联样式写在 wxml 上），
 * 不包容器、不挂动画/transform/will-change —— 这是 iOS 真机最稳的结构。
 * 这里只保留遮罩压暗层；类样式仅作语义标记，关键尺寸全部内联。 */
