/* view-switcher —— 中古侘寂改版：暖纸胶囊 + 墨色滑块（保留原类名） */
.view-switcher { display: flex; justify-content: center; padding: 12rpx 0; }
.view-track {
  position: relative;
  display: flex;
  background: var(--color-bg-soft);
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
  padding: 6rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}
.view-thumb {
  position: absolute; top: 6rpx; left: 6rpx; bottom: 6rpx;
  background: var(--gradient-primary, linear-gradient(135deg, #B5714C, #96573A));
  border-radius: 999rpx;
  transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1), width 280ms cubic-bezier(0.22, 1, 0.36, 1);
  box-shadow: 0 6rpx 16rpx var(--color-primary-shadow, rgba(150, 87, 58, 0.24));
}
.view-item {
  position: relative; z-index: 1;
  display: flex; align-items: center; gap: 8rpx;
  padding: 14rpx 28rpx;
  font-size: 24rpx;
  color: var(--color-text-mute);
  transition: color 200ms;
}
.view-item.is-active { color: #FFFFFF; font-weight: 600; }
.view-icon { font-size: 28rpx; transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1); }
.view-item.is-active .view-icon { transform: scale(1.12); }
