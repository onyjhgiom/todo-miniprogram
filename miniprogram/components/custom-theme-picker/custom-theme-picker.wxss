/* custom-theme-picker */
.ctp {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.ctp-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-soft);
  letter-spacing: 0.4rpx;
}

/* 实时预览卡 */
.ctp-preview {
  border-radius: 20rpx;
  padding: 28rpx;
  color: #ffffff;
  box-shadow: var(--shadow-md);
}
.ctp-preview-title {
  font-size: 26rpx;
  font-weight: 600;
  opacity: 0.92;
  margin-bottom: 18rpx;
}
.ctp-preview-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}
.ctp-preview-btn {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #1f2937;
  font-size: 24rpx;
  font-weight: 600;
}
.ctp-preview-chip {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.ctp-preview-tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  font-size: 22rpx;
}

/* 色板 */
.ctp-swatches {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 14rpx;
}
.ctp-swatch {
  position: relative;
  height: 76rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
  border: 3rpx solid transparent;
  transition: transform 0.16s ease, border-color 0.16s ease;
}
.ctp-swatch.is-active {
  border-color: var(--color-text);
  transform: scale(1.06);
}
.ctp-swatch--bg {
  background: var(--color-bg-soft);
  border: 2rpx solid var(--color-border);
}
.ctp-swatch--bg.is-active {
  border-color: var(--color-primary);
}
.ctp-check {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.3);
}
.ctp-check--dark {
  color: var(--color-text);
  text-shadow: none;
}
.ctp-auto {
  font-size: 20rpx;
  color: var(--color-text-soft);
}

/* 明暗模式切换 */
.ctp-modes {
  display: flex;
  gap: 16rpx;
}
.ctp-mode {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 18rpx 0;
  border-radius: 16rpx;
  background: var(--color-bg-soft);
  color: var(--color-text-soft);
  font-size: 26rpx;
  font-weight: 500;
  border: 2rpx solid transparent;
  transition: all 0.18s ease;
}
.ctp-mode.is-active {
  background: var(--color-primary-soft);
  color: var(--color-primary);
  border-color: var(--color-primary);
  font-weight: 600;
}
.ctp-mode-icon {
  font-size: 28rpx;
}
