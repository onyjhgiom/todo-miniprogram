.hist {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f3ef;
  box-sizing: border-box;
}

.topbar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  flex-shrink: 0;
}
.tb-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  border-radius: 12rpx;
  background: #fff;
  color: #333;
  line-height: 1.4;
}
.tb-btn.primary {
  background: #b5714c;
  color: #fff;
}
.tb-btn.share {
  margin: 0;
  font-size: 28rpx;
}
.tb-btn.share::after {
  border: none;
}

.stat {
  padding: 0 24rpx 12rpx;
  font-size: 24rpx;
  color: #8a8077;
}

.list {
  flex: 1;
  overflow: hidden;
}

.card {
  margin: 16rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.card-main {
  padding: 4rpx 4rpx 12rpx;
}
.card-preview {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.card-name {
  font-size: 24rpx;
  color: #8a8077;
  margin-top: 6rpx;
}
.card-meta {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 4rpx;
}
.card-ops {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
  border-top: 1rpx solid #f0ece6;
  padding-top: 14rpx;
}
.op {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  padding: 8rpx 0;
  background: #f3efe9;
  border-radius: 20rpx;
}
.op.on {
  background: #ffe9c7;
  color: #b5714c;
}
.op.del {
  background: rgba(224, 72, 72, 0.12);
  color: #e04848;
}

.empty {
  text-align: center;
  font-size: 26rpx;
  color: #aaa;
  padding: 80rpx 0;
}
