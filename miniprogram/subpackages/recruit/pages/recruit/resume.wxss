/* pages/recruit/resume.wxss */
@import "../../interaction.wxss";

.rm { min-height: 100vh; padding-bottom: 80rpx; }

.rm__hero { padding: 40rpx 32rpx 32rpx; color: #fff; }
.rm__hero-title { font-size: 40rpx; font-weight: 700; display: block; }
.rm__hero-sub { font-size: 25rpx; opacity: 0.9; display: block; margin-top: 10rpx; }

.rm__tip {
  margin: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  background: var(--color-primary-soft);
  border: 2rpx solid #bfdbfe;
  font-size: 23rpx;
  color: #1d4ed8;
  line-height: 1.6;
}

.rm__card {
  margin: 0 24rpx 24rpx;
  padding: 26rpx 24rpx;
  background: var(--color-card);
  border-radius: 18rpx;
  border: 2rpx solid var(--color-border);
}
.rm__card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 18rpx;
}

.rm__field { margin-bottom: 20rpx; }
.rm__field:last-child { margin-bottom: 4rpx; }
.rm__row2 { display: flex; gap: 18rpx; }
.rm__field--half { flex: 1; min-width: 0; margin-bottom: 16rpx; }
.rm__label { font-size: 24rpx; color: var(--color-text-mute); display: block; margin-bottom: 12rpx; }
.rm__input {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  line-height: 1.4;
  font-size: 28rpx;
  padding: 0 22rpx;
  color: var(--color-text);
  background: var(--color-card);
  border-radius: 14rpx;
  border: 2rpx solid var(--color-border);
  margin-bottom: 16rpx;
}
.rm__input:focus {
  background: var(--color-card);
  border-color: #2563eb;
}
.rm__area {
  width: 100%;
  box-sizing: border-box;
  min-height: 200rpx;
  font-size: 27rpx;
  line-height: 1.7;
  padding: 20rpx 22rpx;
  color: var(--color-text);
  background: var(--color-card);
  border-radius: 14rpx;
  border: 2rpx solid var(--color-border);
}
.rm__area:focus {
  background: var(--color-card);
  border-color: #2563eb;
}

.rm__item {
  padding: 18rpx;
  margin-bottom: 18rpx;
  border-radius: 14rpx;
  background: var(--color-card);
  border: 2rpx dashed #cbd5e1;
}
.rm__item-head { display: flex; align-items: center; margin-bottom: 12rpx; }
.rm__item-no { font-size: 23rpx; color: #94a3b8; flex: 1; }
.rm__item-del { font-size: 23rpx; color: #ef4444; padding: 4rpx 14rpx; }
.rm__item-del:active { opacity: 0.7; }
.rm__item .rm__input { background: var(--color-card); }
.rm__item .rm__area { background: var(--color-card); }

.rm__add {
  text-align: center;
  font-size: 25rpx;
  color: #2563eb;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background: rgba(37, 99, 235, 0.06);
}
.rm__add:active { opacity: 0.8; }

.rm__btn--ai {
  margin: 4rpx 24rpx 0;
  text-align: center;
  font-size: 27rpx;
  padding: 22rpx 0;
  border-radius: 16rpx;
  background: linear-gradient(135deg, var(--color-primary-soft), #ecfeff);
  color: #1d4ed8;
  border: 2rpx solid #bfdbfe;
  font-weight: 600;
}
.rm__btn--ai:active { opacity: 0.85; }
.rm__btn--ai[disabled] { opacity: 0.55; }

.rm__actions { display: flex; gap: 18rpx; padding: 16rpx 24rpx 0; }
.rm__btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  padding: 24rpx 0;
  border-radius: 16rpx;
}
.rm__btn:active { opacity: 0.85; }
.rm__btn--primary { background: #2563eb; color: #fff; font-weight: 600; }
.rm__btn--ghost { background: var(--color-bg-soft); color: var(--color-text-soft); }
.rm__btn--line {
  margin: 18rpx 24rpx 0;
  background: var(--color-card);
  color: #2563eb;
  border: 2rpx solid #93c5fd;
}

/* 离屏 canvas：保持在视口内、不可见但**必定参与渲染**。
   历史写法是 left:-10000rpx（挪到视口外），真机（尤其 Android）上
   2d canvas 会被判定为不可见而不渲染，canvasToTempFilePath 导出空白图或失败
   —— 表现为「点了生成却拿到空白 PDF / 导出失败」。
   改为 opacity:0 + pointer-events:none：保留在视口内正常渲染，用户看不到也点不到。 */
.rm__canvas {
  position: fixed;
  left: 0;
  top: 0;
  width: 750rpx;
  height: 1060rpx;
  opacity: 0;
  pointer-events: none;
  z-index: -1;
}

/* ---------- 模板弹层 ---------- */
.rm__mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex; align-items: flex-end;
  z-index: 100;
}
.rm__sheet {
  width: 100%;
  background: var(--color-card);
  border-radius: 26rpx 26rpx 0 0;
  padding: 32rpx 28rpx 40rpx;
  max-height: 76vh;
  overflow-y: auto;
}
.rm__sheet-title { font-size: 31rpx; font-weight: 700; color: var(--color-text); display: block; }
.rm__sheet-sub { font-size: 23rpx; color: #94a3b8; display: block; margin-top: 8rpx; }
.rm__tpl {
  margin-top: 18rpx;
  padding: 26rpx 24rpx;
  border-radius: 14rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-border);
  font-size: 27rpx;
  color: var(--color-text-soft);
}
.rm__tpl:active { background: var(--color-primary-soft); border-color: #93c5fd; }
.rm__sheet-cancel {
  margin-top: 24rpx;
  text-align: center;
  font-size: 27rpx;
  color: var(--color-text-mute);
  padding: 20rpx 0;
}

/* ---------- PDF 配色主题选择 ---------- */
.rm__themes { display: flex; flex-wrap: wrap; gap: 16rpx; }
.rm__theme {
  min-width: 132rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 600;
  color: #fff;
  padding: 16rpx 22rpx;
  border-radius: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.12);
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}
.rm__theme:active { transform: scale(0.96); }
.rm__theme--on {
  outline: 4rpx solid rgba(15, 23, 42, 0.55);
  outline-offset: 2rpx;
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.22);
}
/* 语言 / 版式选择下的说明文字 */
.rm__hint {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: var(--color-text-mute);
  line-height: 1.5;
}

/* 小标题（证件照 / 图片区说明） */
.rm__sub2 {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--color-text-soft);
  margin: 8rpx 0 12rpx;
}

/* ---------- 图片上传（插入对应模块） ---------- */
.rm__img-add {
  text-align: center;
  font-size: 24rpx;
  color: #2563eb;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background: rgba(37, 99, 235, 0.06);
  border: 2rpx dashed #bfdbfe;
  margin-bottom: 16rpx;
}
.rm__img-add:active { opacity: 0.8; }

.rm__imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 4rpx 0 16rpx;
}
.rm__img {
  position: relative;
  width: 200rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-border);
  border-radius: 12rpx;
  padding: 10rpx;
}
.rm__img-thumb {
  width: 100%;
  height: 178rpx;
  border-radius: 8rpx;
  background: var(--color-bg-soft);
  display: block;
}
.rm__img-cap {
  width: 100%;
  height: 76rpx;
  box-sizing: border-box;
  margin-top: 10rpx;
  font-size: 21rpx;
  padding: 0 14rpx;
  color: var(--color-text);
  background: var(--color-card);
  border-radius: 8rpx;
  border: 2rpx solid var(--color-border);
}
.rm__img-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  font-size: 30rpx;
  color: #fff;
  background: #ef4444;
  border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.2);
}
.rm__img-del:active { opacity: 0.8; }

/* 证件照（方形，页眉右上角对应） */
.rm__photo {
  position: relative;
  width: 200rpx;
  margin-bottom: 14rpx;
}
.rm__photo-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: var(--color-bg-soft);
  border: 2rpx solid var(--color-border);
  display: block;
}
.rm__photo-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  font-size: 30rpx;
  color: #fff;
  background: #ef4444;
  border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.2);
}
.rm__photo-del:active { opacity: 0.8; }

/* ---------- 简历诊断 / 目标匹配 ---------- */
.rm__card--plain { background: #fbfdff; }
.rm__diag-score {
  float: right;
  font-size: 24rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.rm__diag-score--good { color: #047857; background: var(--color-success-soft); }
.rm__diag-score--ok { color: #1d4ed8; background: var(--color-primary-soft); }
.rm__diag-score--warn { color: var(--color-warning); background: var(--color-warning-soft); }
.rm__diag-score--bad { color: var(--color-danger); background: var(--color-danger-soft); }

.rm__sub {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--color-text-soft);
  margin: 20rpx 0 12rpx;
}
.rm__checks { display: flex; flex-wrap: wrap; gap: 12rpx; }
.rm__chk {
  display: flex; align-items: center; gap: 8rpx;
  font-size: 23rpx; padding: 8rpx 16rpx; border-radius: 12rpx;
  background: var(--color-card); border: 2rpx solid var(--color-border);
}
.rm__chk-dot {
  width: 30rpx; height: 30rpx; line-height: 30rpx; text-align: center;
  border-radius: 50%; font-size: 20rpx; color: #fff;
}
.rm__chk--ok .rm__chk-dot { background: #10b981; }
.rm__chk--no .rm__chk-dot { background: #ef4444; }
.rm__chk--no { background: #fff5f5; border-color: #fecaca; }

.rm__metrics { display: flex; flex-wrap: wrap; gap: 12rpx; }
.rm__metric {
  flex: 1 1 30%; min-width: 150rpx; text-align: center;
  padding: 16rpx 8rpx; border-radius: 12rpx; background: var(--color-card); border: 2rpx solid var(--color-border);
}
.rm__metric-v { display: block; font-size: 28rpx; font-weight: 700; color: var(--color-text); }
.rm__metric-l { display: block; font-size: 21rpx; color: var(--color-text-mute); margin-top: 4rpx; }
.rm__metric--no .rm__metric-v { color: #dc2626; }

.rm__pills { display: flex; flex-wrap: wrap; gap: 10rpx; }
.rm__pill {
  font-size: 22rpx; padding: 8rpx 16rpx; border-radius: 999rpx; line-height: 1.4;
}
.rm__pill--ok { color: #047857; background: var(--color-success-soft); }

.rm__issue {
  padding: 16rpx 18rpx; margin-bottom: 12rpx; border-radius: 12rpx;
  background: var(--color-card); border: 2rpx solid var(--color-border);
}
.rm__issue-badge {
  display: inline-block; font-size: 20rpx; font-weight: 700; padding: 2rpx 12rpx;
  border-radius: 999rpx; margin-right: 10rpx; vertical-align: middle;
}
.rm__issue-badge--high { color: var(--color-danger); background: var(--color-danger-soft); }
.rm__issue-badge--mid { color: var(--color-warning); background: var(--color-warning-soft); }
.rm__issue-badge--low { color: var(--color-text-soft); background: var(--color-bg-soft); }
.rm__issue-title { font-size: 25rpx; font-weight: 600; color: var(--color-text); }
.rm__issue-fix { display: block; font-size: 22rpx; color: var(--color-text-mute); margin-top: 6rpx; line-height: 1.6; }

.rm__next {
  font-size: 24rpx; color: #1d4ed8; padding: 12rpx 0; line-height: 1.6;
  border-top: 2rpx dashed var(--color-border);
}
.rm__next:first-of-type { border-top: none; }

.rm__tag {
  float: right; font-size: 21rpx; font-weight: 600; color: #1d4ed8;
  background: var(--color-primary-soft); padding: 4rpx 14rpx; border-radius: 999rpx;
}
.rm__goal-src { font-size: 22rpx; color: #94a3b8; margin-bottom: 12rpx; }
.rm__match {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx; margin-bottom: 12rpx; border-radius: 12rpx;
  background: var(--color-card); border: 2rpx solid var(--color-border);
}
.rm__match:active { background: var(--color-primary-soft); border-color: #93c5fd; }
.rm__match-main { flex: 1; min-width: 0; padding-right: 16rpx; }
.rm__match-co { display: block; font-size: 26rpx; font-weight: 600; color: var(--color-text); }
.rm__match-pos { display: block; font-size: 22rpx; color: var(--color-text-mute); margin-top: 4rpx; }
.rm__match-score { text-align: center; min-width: 120rpx; }
.rm__match-num { display: block; font-size: 34rpx; font-weight: 700; color: #2563eb; }
.rm__match-tag { display: block; font-size: 20rpx; color: var(--color-text-mute); margin-top: 2rpx; }

.rm__goal-empty-title { font-size: 26rpx; font-weight: 700; color: var(--color-text); margin-bottom: 8rpx; }
.rm__goal-empty { font-size: 23rpx; color: var(--color-text-mute); line-height: 1.7; }

/* ---------- 岗位匹配 · 智能提炼 ---------- */
.rm__smart { border-color: #bfdbfe; }
.rm__area--jd { min-height: 160rpx; }
.rm__smart-empty {
  font-size: 23rpx; color: var(--color-text-mute); line-height: 1.7;
  padding: 14rpx 16rpx; border-radius: 12rpx; background: var(--color-bg-soft);
}
.rm__pill--gap {
  color: var(--color-warning); background: var(--color-warning-soft);
  border: 2rpx solid #fde68a;
}
.rm__hit {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 18rpx; margin-bottom: 12rpx; border-radius: 12rpx;
  background: var(--color-card); border: 2rpx solid var(--color-border);
}
.rm__hit-main { flex: 1; min-width: 0; padding-right: 16rpx; }
.rm__hit-name {
  display: block; font-size: 26rpx; font-weight: 600; color: var(--color-text);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.rm__hit-sub { display: block; font-size: 21rpx; color: var(--color-text-mute); margin-top: 4rpx; }
.rm__hit-lv {
  font-size: 21rpx; font-weight: 700; padding: 6rpx 16rpx; border-radius: 999rpx;
  color: var(--color-text-soft); background: var(--color-bg-soft); white-space: nowrap;
}
.rm__hit-lv--high { color: #047857; background: var(--color-success-soft); }
.rm__hit-lv--mid { color: #1d4ed8; background: var(--color-primary-soft); }
.rm__hit-lv--low { color: var(--color-warning); background: var(--color-warning-soft); }

.rm__btn--smart {
  margin-top: 20rpx; text-align: center; font-size: 26rpx; font-weight: 600;
  padding: 20rpx 0; border-radius: 14rpx;
  background: linear-gradient(135deg, #0ea5e9, #2563eb); color: #fff;
}
.rm__btn--smart:active { opacity: 0.85; }

/* ---------- 版式选择（卡片式，带说明） ---------- */
.rm__layouts { display: flex; flex-direction: column; gap: 14rpx; }
.rm__layout {
  padding: 20rpx 22rpx; border-radius: 14rpx;
  background: var(--color-card); border: 2rpx solid var(--color-border);
  transition: transform 150ms ease, border-color 150ms ease, background-color 150ms ease;
}
.rm__layout:active { transform: scale(0.985); }
.rm__layout--on { border-color: #2563eb; background: var(--color-primary-soft); }
.rm__layout-name { display: block; font-size: 27rpx; font-weight: 600; color: var(--color-text); }
.rm__layout--on .rm__layout-name { color: #1d4ed8; }
.rm__layout-desc { display: block; font-size: 22rpx; color: var(--color-text-mute); margin-top: 6rpx; line-height: 1.6; }

/* ---------- 模板弹层：分组 ---------- */
.rm__tpl-group {
  margin-top: 22rpx; font-size: 23rpx; font-weight: 700; color: var(--color-text-soft);
}
.rm__tpl-name { display: block; font-size: 27rpx; color: var(--color-text-soft); }
.rm__tpl-desc { display: block; font-size: 21rpx; color: var(--color-text-mute); margin-top: 6rpx; line-height: 1.5; }
.rm__tpl--on .rm__tpl-name { color: #1d4ed8; }

/* ---------- 表单校验：错误态 ---------- */
.rm__input--err {
  background: var(--color-danger-soft);
  border-color: #C0522F;
}
.rm__err {
  display: block;
  font-size: 22rpx;
  color: #C0522F;
  margin-top: 8rpx;
  line-height: 1.5;
}

/* ============================================================
 * 交互反馈层（按压 / 悬停 / 弹层过渡 / 校验态）
 * 只补充反馈，不改变任何布局、尺寸与配色。
 * ============================================================ */

/* 按压反馈：小控件 / 按钮 */
.rm__btn, .rm__theme, .rm__add, .rm__photo-del, .rm__img-add, .rm__item-del, .rm__img-del, .rm__tpl, .rm__sheet-cancel, .rm__match, .rm__layout, .rm__btn--smart {
  transition: transform 150ms ease, opacity 150ms ease, box-shadow 150ms ease;
}
.rm__btn:active, .rm__theme:active, .rm__add:active, .rm__photo-del:active, .rm__img-add:active, .rm__item-del:active, .rm__img-del:active, .rm__tpl:active, .rm__sheet-cancel:active, .rm__match:active, .rm__layout:active, .rm__btn--smart:active {
  transform: scale(0.955);
  opacity: 0.74;
}

/* 弹层过渡：遮罩淡入 + 面板上滑 */
.rm__mask { animation: ix-fade-in 180ms ease both; }
.rm__sheet { animation: ix-sheet-up 260ms cubic-bezier(0.22, 0.61, 0.36, 1) both; }

/* 桌面端悬停：仅对真正有鼠标的设备生效，触屏不受影响 */
@media (hover: hover) and (pointer: fine) {
  .rm__btn:hover, .rm__theme:hover, .rm__tpl:hover, .rm__match:hover {
    box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.12);
    transform: translateY(-2rpx);
  }
}


/* 生成类按钮忙碌态：保留按钮形状，只降饱和并锁定点击 */
.rm__btn--busy { opacity: 0.6; }
.rm__btn--busy:active { transform: none; opacity: 0.6; }

/* 选中态过渡（标签 / 分段控件） */
.rm__theme {
  transition: background-color 160ms ease, color 160ms ease,
              transform 160ms ease, opacity 160ms ease, box-shadow 160ms ease;
}
