@import "../../../../styles/tool-shell.wxss";

/* subpackages/travel/pages/trip-summary/trip-summary.wxss */

.tshell__wrap {
  padding-bottom: 80rpx;
}

.hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
}
.hero__emo {
  font-size: 52rpx;
}
.hero__texts {
  flex: 1;
  min-width: 0;
}
.hero__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
}
.hero__sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--color-text-mute);
}

/* ===== 核心数字 ===== */
.nums {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 8rpx;
}
.num {
  width: 50%;
  box-sizing: border-box;
  text-align: center;
  padding: 16rpx 0;
}
.num__v {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-primary);
}
.num__v--sm {
  font-size: 27rpx;
}
.num__k {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--color-text-mute);
}

/* ===== 去过的地方 ===== */
.places {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 4rpx 0;
}
.place {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: var(--color-bg-soft);
}
.place__emo {
  font-size: 22rpx;
}
.place__name {
  font-size: 24rpx;
  color: var(--color-text);
}
.place__n {
  font-size: 20rpx;
  color: var(--color-text-mute);
}

/* ===== 花费 ===== */
.cost {
  padding: 16rpx 0;
  border-top: 1rpx solid var(--color-border);
}
.cost:first-child {
  border-top: none;
}
.cost__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.cost__cat {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}
.cost__amt {
  font-size: 26rpx;
  color: var(--color-primary);
}
.cost__bar {
  margin-top: 10rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--color-bg-soft);
  overflow: hidden;
}
.cost__fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--color-primary);
}
.cost__meta {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--color-text-mute);
}

/* ===== 行李复盘 ===== */
.rev__title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 14rpx;
}
.rev__empty {
  font-size: 23rpx;
  color: var(--color-text-mute);
  padding: 8rpx 0;
}
.rev__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--color-border);
}
.rev__row--warn .rev__name {
  color: var(--color-danger, #C0522F);
  font-weight: 600;
}
.rev__name {
  font-size: 25rpx;
  color: var(--color-text);
}
.rev__cat {
  font-size: 21rpx;
  color: var(--color-text-mute);
}
.rev__go {
  margin-top: 16rpx;
  text-align: right;
  font-size: 23rpx;
  color: var(--color-primary);
}

/* ===== 计划 vs 实际 ===== */
.cmp {
  display: flex;
  padding: 8rpx 0;
}
.cmp__cell {
  flex: 1;
  text-align: center;
}
.cmp__k {
  font-size: 21rpx;
  color: var(--color-text-mute);
}
.cmp__v {
  margin-top: 6rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--color-text);
}
.cmp__tip {
  margin-top: 16rpx;
  font-size: 21rpx;
  color: var(--color-text-mute);
  line-height: 1.5;
}

/* ===== 日记 ===== */
.note {
  padding: 18rpx 0;
  border-top: 1rpx solid var(--color-border);
}
.note:first-child {
  border-top: none;
}
.note__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.note__day {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--color-primary);
}
.note__del {
  font-size: 21rpx;
  color: var(--color-text-mute);
}
.note__text {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--color-text);
  line-height: 1.6;
  white-space: pre-wrap;
}
.note__photos {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}
.note__photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm, 12rpx);
}
.note__add {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: var(--radius-md, 16rpx);
  border: 1rpx dashed var(--color-input-line);
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-mute);
}

/* ===== 操作 ===== */
.ops {
  display: flex;
  gap: 20rpx;
}
.ops .ts-btn {
  flex: 1;
}

/* ===== 弹层 ===== */
.mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: var(--color-overlay);
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  max-height: 84vh;
  overflow-y: auto;
  padding: 32rpx 28rpx 40rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: var(--color-bg-elevated);
}
.sheet__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 24rpx;
}
.sheet__field {
  margin-bottom: 22rpx;
}
.sheet__label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 23rpx;
  color: var(--color-text-soft);
}
.sheet__picker {
  padding: 18rpx 20rpx;
  border-radius: var(--radius-md, 16rpx);
  border: 1rpx solid var(--color-input-line);
  background: var(--color-bg);
  color: var(--color-text);
  font-size: 27rpx;
}
.sheet__area {
  width: 100%;
  box-sizing: border-box;
  min-height: 200rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-md, 16rpx);
  border: 1rpx solid var(--color-input-line);
  background: var(--color-bg);
  color: var(--color-text);
  font-size: 27rpx;
}
.sheet__ops {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}
.sheet__ops .ts-btn {
  flex: 1;
}

.ts-empty--sm {
  padding: 36rpx 0;
}

.press {
  opacity: 0.86;
}
