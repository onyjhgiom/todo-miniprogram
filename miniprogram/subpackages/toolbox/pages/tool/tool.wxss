/* ============================================================
 * 翻页时钟 · 翻页卡面默认（晨光白卡）+ 配色注入变量
 * ============================================================ */
.clock {
  --fc-face-top: linear-gradient(180deg, #ffffff 0%, #f3f6fc 100%);
  --fc-face-bottom: linear-gradient(180deg, #e9edf7 0%, #f6f8fd 100%);
  --fc-face-line: #e2e8f5;
  --fc-face-ink: #31406b;
  --fc-face-shade: 101, 122, 176;
  --fc-font-family: inherit;
}
/* 曜夜深空 */
.clock--noir {
  background: linear-gradient(168deg, #0f172a 0%, #1e293b 55%, #0b1120 100%);
  box-shadow: 0 24rpx 48rpx rgba(0, 0, 0, 0.45);
  --fc-face-top: linear-gradient(180deg, #3b4a66 0%, #2c3a54 100%);
  --fc-face-bottom: linear-gradient(180deg, #243149 0%, #1f2b42 100%);
  --fc-face-line: #4a5b7c;
  --fc-face-ink: #f1f5f9;
  --fc-face-shade: 10, 14, 30;
}
.clock--noir .clock__blob--sky {
  background: radial-gradient(circle, rgba(129, 140, 248, 0.34) 0%, rgba(129, 140, 248, 0) 68%);
}
.clock--noir .clock__blob--peach {
  background: radial-gradient(circle, rgba(236, 72, 153, 0.16) 0%, rgba(236, 72, 153, 0) 68%);
}
.clock--noir .clock__blob--mint {
  background: radial-gradient(circle, rgba(45, 212, 191, 0.16) 0%, rgba(45, 212, 191, 0) 70%);
}
.clock--noir .clock__greet-text { color: #cbd5e1; }
.clock--noir .clock__noon {
  background: rgba(51, 65, 85, 0.55);
  border-color: rgba(148, 163, 184, 0.3);
  color: #93a5d1;
}
.clock--noir .clock__unit-label { color: #64748b; }
.clock--noir .clock__colon-dot {
  background: #C08468;
  box-shadow: 0 0 12rpx rgba(129, 140, 248, 0.7);
}
.clock--noir .clock__date-card {
  background: rgba(30, 41, 59, 0.6);
  border-color: rgba(100, 116, 139, 0.35);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.3);
}
.clock--noir .clock__date { color: #cbd5e1; }
.clock--noir .clock__progress-track {
  background: rgba(51, 65, 85, 0.5);
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.4);
}
.clock--noir .clock__progress-fill {
  background: linear-gradient(90deg, #E3B999, #C08468);
}
.clock--noir .clock__progress-text { color: #7c8db0; }

/* 玫瑰金晨 */
.clock--rose {
  background: linear-gradient(168deg, #ffe9f2 0%, #fff5f8 45%, #fff7f2 100%);
  box-shadow: 0 24rpx 48rpx rgba(244, 114, 182, 0.18);
  --fc-face-top: linear-gradient(180deg, #ffffff 0%, #fff3f6 100%);
  --fc-face-bottom: linear-gradient(180deg, #fdeef2 0%, #fef6f8 100%);
  --fc-face-line: #f3d5de;
  --fc-face-ink: #9d3c61;
  --fc-face-shade: 232, 120, 160;
}
.clock--rose .clock__blob--sky {
  background: radial-gradient(circle, rgba(255, 150, 190, 0.32) 0%, rgba(255, 150, 190, 0) 68%);
}
.clock--rose .clock__blob--peach {
  background: radial-gradient(circle, rgba(255, 190, 150, 0.3) 0%, rgba(255, 190, 150, 0) 68%);
}
.clock--rose .clock__blob--mint {
  background: radial-gradient(circle, rgba(200, 160, 255, 0.2) 0%, rgba(200, 160, 255, 0) 70%);
}
.clock--rose .clock__greet-text { color: #9d3c61; }
.clock--rose .clock__noon {
  background: rgba(255, 255, 255, 0.75);
  border-color: rgba(240, 150, 180, 0.45);
  color: #c26a8b;
}
.clock--rose .clock__unit-label { color: #d298b1; }
.clock--rose .clock__colon-dot {
  background: #C08468;
  box-shadow: 0 0 12rpx rgba(244, 114, 182, 0.8);
}
.clock--rose .clock__date-card {
  background: rgba(255, 255, 255, 0.82);
  border-color: rgba(247, 190, 210, 0.85);
}
.clock--rose .clock__date { color: #a85377; }
.clock--rose .clock__progress-track {
  background: rgba(255, 240, 244, 0.8);
}
.clock--rose .clock__progress-fill {
  background: linear-gradient(90deg, #E3B999, #C08468);
}
.clock--rose .clock__progress-text { color: #ce8aa6; }

/* 薄荷清晨 */
.clock--mint {
  background: linear-gradient(168deg, #e6fbf3 0%, #f0fdf8 45%, #f7fbf0 100%);
  box-shadow: 0 24rpx 48rpx rgba(52, 211, 153, 0.16);
  --fc-face-top: linear-gradient(180deg, #ffffff 0%, #f2fdf8 100%);
  --fc-face-bottom: linear-gradient(180deg, #e0f7ee 0%, #eefbf5 100%);
  --fc-face-line: #bfe6d5;
  --fc-face-ink: #25645a;
  --fc-face-shade: 16, 150, 120;
}
.clock--mint .clock__blob--sky {
  background: radial-gradient(circle, rgba(110, 231, 183, 0.34) 0%, rgba(110, 231, 183, 0) 68%);
}
.clock--mint .clock__blob--peach {
  background: radial-gradient(circle, rgba(190, 242, 100, 0.2) 0%, rgba(190, 242, 100, 0) 68%);
}
.clock--mint .clock__blob--mint {
  background: radial-gradient(circle, rgba(94, 234, 212, 0.26) 0%, rgba(94, 234, 212, 0) 70%);
}
.clock--mint .clock__greet-text { color: #25645a; }
.clock--mint .clock__noon {
  background: rgba(255, 255, 255, 0.75);
  border-color: rgba(110, 231, 183, 0.45);
  color: #3f8d80;
}
.clock--mint .clock__unit-label { color: #6fae9f; }
.clock--mint .clock__colon-dot {
  background: #34d399;
  box-shadow: 0 0 12rpx rgba(52, 211, 153, 0.8);
}
.clock--mint .clock__date-card {
  background: rgba(255, 255, 255, 0.82);
  border-color: rgba(160, 230, 205, 0.8);
}
.clock--mint .clock__date { color: #2e7d6f; }
.clock--mint .clock__progress-track {
  background: rgba(230, 250, 240, 0.9);
}
.clock--mint .clock__progress-fill {
  background: linear-gradient(90deg, #6ee7b7, #34d399);
}
.clock--mint .clock__progress-text { color: #6fb3a2; }

/* ============================================================
 * 翻页时钟 · 数字字体维度（modern 默认系统字体）
 * ============================================================ */
.clock--font-serif {
  --fc-font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
}

/* ============================================================
 * 翻页时钟 · 背景氛围维度（aurora 默认）
 * ============================================================ */
/* 极简纯色：隐藏光斑，保留渐变底色 */
.clock--bg-plain .clock__deco {
  opacity: 0;
}
/* 网格都市：光斑减弱 + 叠加细网格 */
.clock--bg-grid .clock__deco {
  opacity: 0.45;
}
.clock--bg-grid .clock__deco::after {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-image:
    linear-gradient(rgba(100, 116, 139, 0.08) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(100, 116, 139, 0.08) 1rpx, transparent 1rpx);
  background-size: 44rpx 44rpx;
}

/* ============================================================
 * 生日豪华专区（仅生日当天）：彩带礼花 + 三风格祝福动效
 * ============================================================ */
.bday {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  border-radius: 34rpx;
  padding: 34rpx 30rpx 30rpx;
  overflow: hidden;
  background:
    radial-gradient(120% 90% at 100% 0%, rgba(255, 228, 230, 0.9) 0%, transparent 55%),
    linear-gradient(165deg, #fff7f8 0%, #fff1f4 55%, #fff8ef 100%);
  border: 2rpx solid rgba(255, 214, 221, 0.9);
  box-shadow:
    0 18rpx 40rpx rgba(244, 114, 182, 0.2),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.85);
  animation: bday-pop 640ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
@keyframes bday-pop {
  from { opacity: 0; transform: scale(0.92) translateY(16rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

/* ---- 飘落彩纸 ---- */
.bday__confetti {
  position: absolute;
  top: -30rpx;
  width: 14rpx;
  height: 22rpx;
  border-radius: 3rpx;
  opacity: 0;
  animation: confetti-fall 5.6s linear infinite;
}
.bday__confetti--1 { left: 6%;  background: #C08468; animation-duration: 5.2s; animation-delay: 0s; }
.bday__confetti--2 { left: 18%; background: #fbbf24; width: 18rpx; height: 12rpx; animation-delay: 0.7s; }
.bday__confetti--3 { left: 31%; background: #34d399; animation-duration: 6.1s; animation-delay: 1.4s; }
.bday__confetti--4 { left: 44%; background: #60a5fa; width: 12rpx; height: 20rpx; animation-delay: 0.4s; }
.bday__confetti--5 { left: 58%; background: #fbbf24; animation-duration: 5.9s; animation-delay: 2.0s; }
.bday__confetti--6 { left: 70%; background: #e879a8; width: 16rpx; height: 12rpx; animation-delay: 1.1s; }
.bday__confetti--7 { left: 82%; background: #C09A5E; animation-duration: 5.4s; animation-delay: 2.6s; }
.bday__confetti--8 { left: 92%; background: #fb923c; width: 12rpx; height: 16rpx; animation-delay: 1.8s; }
@keyframes confetti-fall {
  0% { transform: translateY(0) rotate(0deg); opacity: 0; }
  8% { opacity: 0.95; }
  100% { transform: translateY(760rpx) rotate(680deg); opacity: 0; }
}

/* ---- 星光闪烁 ---- */
.bday__spark {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #ffffff 0%, #fde68a 45%, transparent 72%);
  opacity: 0;
  animation: spark-twinkle 1.9s ease-in-out infinite;
}
.bday__spark--1 { top: 12%; right: 14%; animation-delay: 0.3s; }
.bday__spark--2 { top: 40%; right: 8%;  animation-delay: 1.0s; width: 10rpx; height: 10rpx; }
.bday__spark--3 { top: 24%; left: 12%; animation-delay: 1.5s; }
.bday__spark--4 { bottom: 26%; left: 20%; animation-delay: 0.8s; width: 10rpx; height: 10rpx; }
@keyframes spark-twinkle {
  0%, 100% { opacity: 0; transform: scale(0.4); }
  50% { opacity: 1; transform: scale(1.15); }
}

/* ---- 顶部：气球 + 主标题 ---- */
.bday__top {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin-bottom: 24rpx;
}
.bday__balloon {
  font-size: 56rpx;
  line-height: 1;
  animation: balloon-sway 2.4s ease-in-out infinite;
  transform-origin: 50% 100%;
}
.bday__balloon--2 { animation-delay: -1.2s; }
@keyframes balloon-sway {
  0%, 100% { transform: rotate(-8deg); }
  50% { transform: rotate(10deg); }
}
.bday__cap { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.bday__cap-en {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  background: linear-gradient(90deg, #B5714C 0%, #D8A05C 25%, #C08468 50%, #A8C0A0 75%, #B5714C 100%);
  background-size: 200% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: grad-flow 3.2s linear infinite;
}
@keyframes grad-flow {
  to { background-position: -200% 0; }
}
.bday__cap-cn {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #be123c;
  text-shadow: 0 2rpx 0 rgba(255, 255, 255, 0.8);
}

/* ---- 祝福卡片通用 ---- */
.bday__card {
  position: relative;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 18rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 2rpx solid rgba(255, 205, 216, 0.75);
  box-shadow: 0 6rpx 18rpx rgba(190, 24, 93, 0.08);
  opacity: 0;
  animation: card-rise 560ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
}
@keyframes card-rise {
  from { opacity: 0; transform: translateY(22rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.bday__tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  margin-bottom: 12rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #C08468, #B5714C);
}

/* 走心卡：打字机文本 + 光标 */
.bday__card--heart { animation-delay: 0.18s; }
.bday__type-row { display: flex; align-items: flex-end; }
.bday__type-text {
  flex: 0 1 auto;
  font-size: 28rpx;
  line-height: 1.7;
  color: #6b3a52;
  letter-spacing: 0.6rpx;
  font-weight: 500;
  word-break: break-all;
}
.bday__caret {
  flex-shrink: 0;
  width: 4rpx;
  height: 30rpx;
  margin: 0 0 4rpx 6rpx;
  border-radius: 4rpx;
  background: #B5714C;
  animation: caret-blink 0.9s steps(1) infinite;
}
@keyframes caret-blink {
  0%, 49% { opacity: 1; }
  50%, 100% { opacity: 0; }
}

/* 俏皮卡：弹跳入场 */
.bday__card--fun { animation-delay: 1.9s; }
.bday__fun-text {
  display: inline-block;
  font-size: 30rpx;
  font-weight: 600;
  color: #db2777;
  letter-spacing: 0.8rpx;
  opacity: 0;
  animation: fun-bounce 900ms cubic-bezier(0.34, 1.56, 0.64, 1) 2.1s forwards;
}
@keyframes fun-bounce {
  0% { opacity: 0; transform: scale(0.2) rotate(-6deg); }
  55% { opacity: 1; transform: scale(1.14) rotate(3deg); }
  75% { transform: scale(0.96) rotate(-1deg); }
  100% { opacity: 1; transform: scale(1) rotate(0); }
}

/* 正式卡：渐变流光 + 描金 */
.bday__card--formal {
  border-color: rgba(245, 158, 11, 0.45);
  animation-delay: 2.6s;
}
.bday__formal-text {
  display: inline-block;
  font-size: 28rpx;
  line-height: 1.7;
  letter-spacing: 1rpx;
  font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
  background: linear-gradient(90deg, #a16207 0%, #b45309 20%, #d97706 40%, #a16207 60%, #92400e 80%, #a16207 100%);
  background-size: 200% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  opacity: 0;
  animation: formal-flow 4.5s linear 3.1s infinite, card-rise 560ms 2.6s forwards;
}
@keyframes formal-flow {
  to { background-position: -200% 0; }
}

/* 尾句 */
.bday__wish {
  text-align: center;
  font-size: 24rpx;
  color: #b4536b;
  letter-spacing: 2rpx;
  margin-top: 4rpx;
  opacity: 0;
  animation: card-rise 560ms cubic-bezier(0.22, 1, 0.36, 1) 3.4s forwards;
}
