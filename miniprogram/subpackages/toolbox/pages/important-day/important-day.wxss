/* subpackages/toolbox/pages/important-day/important-day.wxss
  重要日 · 时间管理中心 —— 浅色玻璃拟态 + 柔和渐变视觉系统
  主色：雾霾蓝 #6C7BE0 / 薰衣草紫 #9B8AD8 / 浅粉 #E488A6
  背景：极浅灰白渐变（非纯白）；卡片 20~28rpx 圆角、极柔阴影、半透明磨砂。
*/

.imp {
  --lav: #6C7BE0;
  --pur: #9B8AD8;
  --pink: #E488A6;
  --ink: #2C2C3E;
  --soft: #8A8AA2;
  --glass: rgba(255, 255, 255, 0.74);
  --glass-2: rgba(255, 255, 255, 0.6);
  --line: rgba(108, 123, 224, 0.14);
  --shadow: 0 10rpx 34rpx rgba(108, 123, 224, 0.14);
  --shadow-soft: 0 6rpx 20rpx rgba(60, 60, 90, 0.08);
  min-height: 100vh;
  padding-bottom: 70rpx;
  box-sizing: border-box;
  background:
    radial-gradient(120% 60% at 80% -10%, rgba(155, 138, 216, 0.20), transparent 60%),
    radial-gradient(120% 50% at 0% 0%, rgba(108, 123, 224, 0.16), transparent 55%),
    linear-gradient(180deg, #EAEEF8 0%, #F1F0F7 36%, #F6F3EC 100%);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", Arial, sans-serif;
  color: var(--ink);
}

/* ============================ 通用图标（线性统一体系） ============================ */
.ic {
  width: 34rpx;
  height: 34rpx;
  position: relative;
  display: inline-block;
  box-sizing: border-box;
  color: currentColor;
  vertical-align: middle;
}
.ic::before, .ic::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}
/* 返回（左箭头） */
.ic--back::before {
  width: 14rpx; height: 14rpx;
  left: 9rpx; top: 9rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg);
}
/* 右侧箭头 */
.ic--right::before {
  width: 13rpx; height: 13rpx;
  left: 5rpx; top: 9rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(45deg);
}
/* 加号 */
.ic--plus::before {
  width: 22rpx; height: 3rpx; left: 4rpx; top: 15rpx;
  background: currentColor; border-radius: 3rpx;
}
.ic--plus::after {
  width: 3rpx; height: 22rpx; left: 14rpx; top: 5rpx;
  background: currentColor; border-radius: 3rpx;
}
/* 关闭 × */
.ic--close::before {
  width: 22rpx; height: 3rpx; left: 5rpx; top: 16rpx;
  background: currentColor; border-radius: 3rpx; transform: rotate(45deg);
}
.ic--close::after {
  width: 22rpx; height: 3rpx; left: 5rpx; top: 16rpx;
  background: currentColor; border-radius: 3rpx; transform: rotate(-45deg);
}
/* 更多 ⋯（横向三点） */
.ic--dots::before {
  width: 6rpx; height: 6rpx; border-radius: 50%;
  left: 4rpx; top: 14rpx; background: currentColor;
  box-shadow: 10rpx 0 0 currentColor, 20rpx 0 0 currentColor;
}
/* 设置（齿轮简化：环 + 中心孔） */
.ic--gear::before {
  width: 24rpx; height: 24rpx; left: 5rpx; top: 4rpx;
  border: 3rpx solid currentColor; border-radius: 50%;
}
.ic--gear::after {
  width: 9rpx; height: 9rpx; left: 12rpx; top: 11rpx;
  border-radius: 50%; background: currentColor;
}
/* 搜索 */
.ic--search::before {
  width: 18rpx; height: 18rpx; left: 5rpx; top: 4rpx;
  border: 3rpx solid currentColor; border-radius: 50%;
}
.ic--search::after {
  width: 9rpx; height: 3rpx; left: 20rpx; top: 22rpx;
  background: currentColor; border-radius: 3rpx; transform: rotate(45deg);
}
/* 排序（三横线） */
.ic--sort::before {
  width: 22rpx; height: 3rpx; left: 5rpx; top: 8rpx;
  background: currentColor; border-radius: 3rpx;
  box-shadow: 0 9rpx 0 currentColor, 0 18rpx 0 currentColor;
}
/* 漏斗（筛选） */
.ic--funnel::before {
  width: 0; height: 0; left: 6rpx; top: 4rpx;
  border-left: 11rpx solid transparent;
  border-right: 11rpx solid transparent;
  border-top: 13rpx solid currentColor;
}
.ic--funnel::after {
  width: 5rpx; height: 11rpx; left: 14rpx; top: 17rpx;
  background: currentColor; border-radius: 3rpx;
}
/* 对勾 */
.ic--check::before {
  width: 14rpx; height: 8rpx; left: 7rpx; top: 12rpx;
  border-left: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor;
  transform: rotate(-45deg);
}
/* 日历 */
.ic--cal::before {
  width: 22rpx; height: 19rpx; left: 5rpx; top: 8rpx;
  border: 3rpx solid currentColor; border-radius: 6rpx;
}
.ic--cal::after {
  width: 6rpx; height: 6rpx; left: 6rpx; top: 2rpx;
  border-left: 3rpx solid currentColor; border-right: 3rpx solid currentColor;
}
/* 已完成圈 */
.ic--checkc::before {
  width: 22rpx; height: 22rpx; left: 5rpx; top: 6rpx;
  border: 3rpx solid currentColor; border-radius: 50%;
}
.ic--checkc::after {
  width: 11rpx; height: 6rpx; left: 10rpx; top: 14rpx;
  border-left: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor;
  transform: rotate(-45deg);
}
/* 铃铛 */
.ic--bell::before {
  width: 20rpx; height: 18rpx; left: 6rpx; top: 5rpx;
  border: 3rpx solid currentColor; border-bottom: none;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
}
.ic--bell::after {
  width: 6rpx; height: 6rpx; left: 13rpx; top: 22rpx;
  border-radius: 50%; background: currentColor;
}
/* 垃圾桶 */
.ic--trash::before {
  width: 20rpx; height: 18rpx; left: 6rpx; top: 12rpx;
  border: 3rpx solid currentColor; border-radius: 4rpx;
  border-top: none;
}
.ic--trash::after {
  width: 26rpx; height: 3rpx; left: 3rpx; top: 8rpx;
  background: currentColor; border-radius: 3rpx;
}
/* 编辑（铅笔） */
.ic--edit::before {
  width: 18rpx; height: 18rpx; left: 6rpx; top: 5rpx;
  border: 3rpx solid currentColor; border-radius: 4rpx;
  transform: rotate(45deg);
}
.ic--edit::after {
  width: 12rpx; height: 3rpx; left: 11rpx; top: 24rpx;
  background: currentColor; border-radius: 3rpx; transform: rotate(45deg);
}
/* 复制（重叠双框） */
.ic--copy::before {
  width: 17rpx; height: 19rpx; left: 4rpx; top: 9rpx;
  border: 3rpx solid currentColor; border-radius: 4rpx;
}
.ic--copy::after {
  width: 17rpx; height: 19rpx; left: 11rpx; top: 4rpx;
  border: 3rpx solid currentColor; border-radius: 4rpx; background: rgba(255,255,255,0.6);
}
/* 归档（盒子 + 下箭头） */
.ic--archive::before {
  width: 24rpx; height: 16rpx; left: 4rpx; top: 9rpx;
  border: 3rpx solid currentColor; border-radius: 3rpx;
}
.ic--archive::after {
  width: 10rpx; height: 3rpx; left: 11rpx; top: 16rpx;
  background: currentColor; border-radius: 3rpx;
}
/* 星火（四角星） */
.ic--spark::before {
  width: 18rpx; height: 18rpx; left: 7rpx; top: 7rpx;
  background: currentColor; border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  transform: rotate(45deg);
}

/* ============================ 天空 Hero ============================ */
.sky {
  position: relative;
  width: 100%;
  height: 540rpx;
  overflow: hidden;
  background:
    radial-gradient(120% 70% at 85% -20%, rgba(245, 179, 204, 0.35), transparent 55%),
    radial-gradient(100% 60% at 10% 0%, rgba(155, 138, 216, 0.30), transparent 60%),
    linear-gradient(180deg, #DCE4F6 0%, #E9ECF7 45%, #F3F1EA 100%);
}
.sky__wash {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(255,255,255,0.10), rgba(255,255,255,0));
}
.sky__cloud {
  position: absolute;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 50%;
  filter: blur(6rpx);
}
.sky__cloud--1 { width: 180rpx; height: 70rpx; left: 8%; top: 90rpx; }
.sky__cloud--2 { width: 130rpx; height: 52rpx; left: 64%; top: 60rpx; opacity: 0.9; }
.sky__cloud--3 { width: 160rpx; height: 60rpx; left: 38%; top: 150rpx; opacity: 0.8; }
.sky__cloud--4 { width: 110rpx; height: 44rpx; left: 82%; top: 180rpx; opacity: 0.7; }
.sky__sun {
  position: absolute;
  width: 120rpx; height: 120rpx; right: 60rpx; top: 70rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,236,200,0.95), rgba(255,214,170,0.35) 60%, transparent 72%);
}
.sky__glow {
  position: absolute; right: 30rpx; top: 40rpx;
  width: 220rpx; height: 220rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(255,220,180,0.35), transparent 70%);
  filter: blur(8rpx);
}
/* 城市天际线 */
.sky__city {
  position: absolute; left: 0; right: 0; bottom: 0;
  height: 230rpx;
}
.sky__b {
  position: absolute; bottom: 0;
  border-radius: 10rpx 10rpx 0 0;
  background: linear-gradient(180deg, rgba(108,123,224,0.30), rgba(108,123,224,0.10));
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.4);
}
.sky__tower {
  position: absolute; bottom: 0; left: 70%;
  width: 70rpx; height: 200rpx;
}
.sky__tower-spire {
  position: absolute; left: 33rpx; top: -8rpx;
  width: 4rpx; height: 40rpx; background: rgba(108,123,224,0.55);
}
.sky__tower-ball {
  position: absolute; left: 18rpx; border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #fff, rgba(155,138,216,0.65));
  box-shadow: 0 4rpx 10rpx rgba(108,123,224,0.25);
}
.sky__tower-ball--top { top: 36rpx; width: 34rpx; height: 34rpx; }
.sky__tower-ball--bot { top: 92rpx; width: 54rpx; height: 54rpx; left: 8rpx; }
.sky__tower-shaft {
  position: absolute; left: 29rpx; top: 70rpx;
  width: 12rpx; height: 130rpx;
  background: linear-gradient(180deg, rgba(155,138,216,0.55), rgba(108,123,224,0.30));
  border-radius: 6rpx;
}
.sky__water {
  position: absolute; left: 0; right: 0; bottom: 0; height: 40rpx;
  background: linear-gradient(180deg, rgba(108,123,224,0.12), rgba(155,138,216,0.20));
  filter: blur(2rpx);
}
.sky__fade {
  position: absolute; left: 0; right: 0; bottom: 0; height: 70rpx;
  background: linear-gradient(180deg, rgba(243,241,234,0), #F3F1EA);
}

/* 导航 */
.nav {
  position: absolute; left: 0; right: 0; top: 0; z-index: 20;
  transition: background 0.25s ease, backdrop-filter 0.25s ease;
}
.nav--blur {
  background: rgba(244, 243, 238, 0.72);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  box-shadow: 0 1rpx 0 rgba(108,123,224,0.10);
}
.nav__row { position: relative; display: flex; align-items: center; }
.nav__back {
  position: absolute; left: 16rpx; top: 50%; transform: translateY(-50%);
  width: 60rpx; height: 60rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: var(--ink); background: rgba(255,255,255,0.55);
  box-shadow: var(--shadow-soft);
}
.nav__title {
  width: 100%; text-align: center;
  font-size: 34rpx; font-weight: 600; color: var(--ink);
  letter-spacing: 2rpx;
}
.nav__acts { position: absolute; top: 50%; transform: translateY(-50%); display: flex; gap: 10rpx; }
.nav__btn {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: var(--ink); background: rgba(255,255,255,0.55);
  box-shadow: var(--shadow-soft); font-size: 28rpx;
}
.nav__btn:nth-child(1) { color: var(--lav); }

/* 标语 */
.sky__slogan {
  position: absolute; left: 40rpx; top: 200rpx; z-index: 10;
}
.sky__slogan-t {
  font-size: 46rpx; line-height: 64rpx; font-weight: 600;
  color: rgba(44, 44, 62, 0.88);
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 10rpx rgba(255,255,255,0.5);
}
.sky__slogan-line {
  margin-top: 10rpx; width: 320rpx; height: 12rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, rgba(228,136,166,0.9), rgba(155,138,216,0.2));
}
/* ＋ 新增悬浮 */
.sky__add {
  position: absolute; right: 32rpx; bottom: 150rpx; z-index: 12;
  width: 96rpx; height: 96rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 50rpx;
  background: linear-gradient(135deg, var(--lav), var(--pur));
  box-shadow: 0 12rpx 30rpx rgba(108,123,224,0.45);
}

/* ============================ 玻璃核心卡 ============================ */
.hero {
  position: relative; z-index: 15;
  margin: -70rpx 28rpx 0;
  padding: 30rpx 28rpx;
  display: flex; align-items: center; gap: 24rpx;
  border-radius: 28rpx;
  background: var(--glass);
  backdrop-filter: blur(22rpx);
  -webkit-backdrop-filter: blur(22rpx);
  box-shadow: var(--shadow);
  border: 1rpx solid rgba(255,255,255,0.7);
}
.hero__icon { flex: none; }
.hero__body { flex: 1; min-width: 0; }
.hero__title {
  font-size: 30rpx; font-weight: 600; color: var(--ink);
}
.hero__sub {
  margin-top: 8rpx; font-size: 23rpx; line-height: 32rpx;
  color: var(--soft);
}
.hero__arrow { flex: none; color: var(--lav); font-size: 30rpx; }

/* 3D 日历图标 */
.cal3d {
  position: relative; width: 84rpx; height: 84rpx;
  transform-style: preserve-3d; transform: rotateX(12deg) rotateY(-18deg);
}
.cal3d__ring {
  position: absolute; top: 8rpx; width: 26rpx; height: 68rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, rgba(155,138,216,0.55), rgba(108,123,224,0.25));
}
.cal3d__ring--l { left: 0; transform: rotateY(40deg); }
.cal3d__ring--r { right: 0; transform: rotateY(-40deg); }
.cal3d__body {
  position: absolute; left: 16rpx; top: 0; width: 52rpx; height: 76rpx;
  border-radius: 12rpx; background: linear-gradient(160deg, #ffffff, #EEF0FB);
  box-shadow: 0 8rpx 18rpx rgba(108,123,224,0.28);
  border: 1rpx solid rgba(108,123,224,0.18);
  overflow: hidden;
}
.cal3d__bar {
  position: absolute; left: 0; right: 0; top: 0; height: 16rpx;
  background: linear-gradient(90deg, var(--lav), var(--pur));
}
.cal3d__lines { position: absolute; left: 9rpx; right: 9rpx; top: 28rpx; }
.cal3d__line {
  height: 6rpx; border-radius: 6rpx; margin-bottom: 7rpx;
  background: rgba(108,123,224,0.28);
}
.cal3d__line--s { width: 60%; }
.heart {
  position: absolute; right: 6rpx; bottom: 6rpx; width: 16rpx; height: 16rpx;
  background: var(--pink);
  transform: rotate(45deg);
  border-radius: 3rpx;
}
.heart::before, .heart::after {
  content: ""; position: absolute; width: 16rpx; height: 16rpx;
  background: var(--pink); border-radius: 50%;
}
.heart::before { left: -8rpx; top: 0; }
.heart::after { top: -8rpx; left: 0; }

/* ============================ Tab ============================ */
.tabs {
  position: relative; z-index: 15;
  margin: 24rpx 28rpx 0;
  display: flex; align-items: center;
  height: 84rpx; border-radius: 22rpx;
  background: var(--glass-2);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  box-shadow: var(--shadow-soft);
  border: 1rpx solid rgba(255,255,255,0.6);
  padding: 0 10rpx;
}
.tabs__pill {
  position: absolute; top: 8rpx; bottom: 8rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, var(--lav), var(--pur));
  box-shadow: 0 6rpx 16rpx rgba(108,123,224,0.35);
  transition: left 0.28s cubic-bezier(.4,1.2,.5,1), width 0.28s ease;
}
.tabs__item {
  position: relative; z-index: 2;
  flex: 1; display: flex; align-items: center; justify-content: center;
  gap: 10rpx; height: 100%;
  font-size: 28rpx; color: var(--soft); font-weight: 500;
  transition: color 0.2s ease, transform 0.2s ease;
}
.tabs__item.is-on { color: #fff; transform: scale(1.02); }
.tabs__t { font-size: 28rpx; }

/* ============================ 考研倒计时 ============================ */
.ky {
  position: relative; z-index: 14;
  margin: 22rpx 28rpx 0;
  padding: 30rpx 28rpx 26rpx;
  border-radius: 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #7B86E8 0%, #9B8AD8 55%, #C49BE0 100%);
  box-shadow: 0 14rpx 34rpx rgba(123,134,232,0.40);
  overflow: hidden;
}
.ky::after {
  content: ""; position: absolute; right: -60rpx; top: -60rpx;
  width: 240rpx; height: 240rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.22), transparent 70%);
}
.ky__top { display: flex; align-items: center; justify-content: space-between; }
.ky__label { font-size: 26rpx; opacity: 0.95; font-weight: 500; }
.ky__tag {
  font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 20rpx;
  background: rgba(255,255,255,0.28); color: #fff;
}
.ky__tag.is-on { background: rgba(255,255,255,0.92); color: #6C5BD0; font-weight: 600; }
.ky__num-row { display: flex; align-items: baseline; gap: 10rpx; margin: 14rpx 0 8rpx; }
.ky__num {
  font-size: 92rpx; line-height: 1; font-weight: 700;
  letter-spacing: 1rpx; text-shadow: 0 6rpx 18rpx rgba(80,60,160,0.35);
}
.ky__unit { font-size: 32rpx; opacity: 0.92; }
.ky__set { margin: 20rpx 0 22rpx; font-size: 26rpx; line-height: 40rpx; opacity: 0.95; }
.ky__meta { display: flex; align-items: center; justify-content: space-between; }
.ky__date { font-size: 24rpx; opacity: 0.95; }
.ky__weeks { font-size: 24rpx; opacity: 0.9; }
.ky__bar {
  margin: 18rpx 0 16rpx; height: 10rpx; border-radius: 10rpx;
  background: rgba(255,255,255,0.28); overflow: hidden;
}
.ky__bar-fill {
  height: 100%; border-radius: 10rpx;
  background: linear-gradient(90deg, #fff, #FFE3F0);
  transition: width 0.4s ease;
}
.ky__foot {
  display: flex; align-items: center; gap: 10rpx;
  font-size: 24rpx; opacity: 0.96;
}
.ky__foot-a { margin-left: auto; font-weight: 600; }
.ky__foot .ic { color: #fff; }

/* ============================ 工具条 ============================ */
.tools {
  margin: 24rpx 28rpx 0;
  display: flex; align-items: center; gap: 14rpx;
}
.tools__search {
  flex: 1; height: 72rpx; display: flex; align-items: center; gap: 12rpx;
  padding: 0 22rpx; border-radius: 20rpx;
  background: var(--glass);
  border: 1rpx solid rgba(255,255,255,0.7);
  box-shadow: var(--shadow-soft);
  color: var(--soft);
  transition: box-shadow 0.2s ease;
}
.tools__search.is-open { box-shadow: 0 0 0 3rpx rgba(108,123,224,0.25); }
.tools__input { flex: 1; font-size: 27rpx; color: var(--ink); }
.tools__ph { color: var(--soft); }
.tools__btn {
  flex: none; width: 72rpx; height: 72rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--glass); color: var(--lav);
  border: 1rpx solid rgba(255,255,255,0.7);
  box-shadow: var(--shadow-soft);
}
.chips-row { margin: 16rpx 28rpx 0; display: flex; gap: 12rpx; flex-wrap: wrap; }
.chip {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 10rpx 20rpx; border-radius: 24rpx;
  background: var(--glass-2); color: var(--soft); font-size: 23rpx;
  border: 1rpx solid rgba(255,255,255,0.6);
}
.chip .ic { width: 22rpx; height: 22rpx; color: var(--soft); }
.chip--on { color: var(--lav); border-color: rgba(108,123,224,0.4); background: rgba(108,123,224,0.10); }

/* ============================ 管理模式条 ============================ */
.manage {
  margin: 16rpx 28rpx 0; padding: 16rpx 22rpx;
  display: flex; align-items: center; justify-content: space-between;
  border-radius: 20rpx; background: rgba(108,123,224,0.10);
  border: 1rpx solid rgba(108,123,224,0.22);
}
.manage__t { font-size: 25rpx; color: var(--lav); font-weight: 600; }
.manage__acts { display: flex; gap: 12rpx; }
.manage__btn {
  font-size: 24rpx; padding: 10rpx 18rpx; border-radius: 18rpx;
  background: #fff; color: var(--ink); box-shadow: var(--shadow-soft);
}
.manage__btn--danger { color: #E4708E; }

/* ============================ 列表 ============================ */
.list { margin: 18rpx 28rpx 0; }
.day {
  position: relative; overflow: hidden;
  margin-bottom: 18rpx; border-radius: 24rpx;
}
.day__del {
  position: absolute; right: 0; top: 0; bottom: 0;
  width: 150rpx; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 6rpx;
  background: linear-gradient(135deg, #F2A0B4, #E4708E);
  color: #fff; font-size: 22rpx;
}
.day__del .ic { color: #fff; width: 32rpx; height: 32rpx; }
.day__slide {
  position: relative; z-index: 2;
  padding: 26rpx 24rpx;
  border-radius: 24rpx;
  background: var(--glass);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  box-shadow: var(--shadow-soft);
  border: 1rpx solid rgba(255,255,255,0.7);
  transition: transform 0.26s cubic-bezier(.4,1.1,.5,1);
}
.day.is-open .day__slide { transform: translateX(-150rpx); }
.day--closed .day__slide { opacity: 0.72; }
.day--past .day__slide { background: rgba(245,245,250,0.7); }
.day__top { display: flex; align-items: flex-start; gap: 18rpx; }
.day__datebox {
  flex: none; width: 96rpx; height: 96rpx; border-radius: 20rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: linear-gradient(160deg, #fff, #EEF0FB);
  box-shadow: inset 0 0 0 1rpx rgba(108,123,224,0.12);
  color: var(--lav);
}
.day__num { font-size: 42rpx; font-weight: 700; line-height: 1; }
.day__mon { font-size: 22rpx; color: var(--soft); margin-top: 4rpx; }
.day__topr { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.day__cd { font-size: 30rpx; font-weight: 700; color: var(--lav); }
.day__cd.is-urgent { color: #E4708E; }
.day__cd.is-past { color: var(--soft); font-weight: 600; }
.day__date { font-size: 23rpx; color: var(--soft); }
.day__wk { font-size: 23rpx; color: var(--soft); display: flex; align-items: center; gap: 10rpx; }
.day__today {
  font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 16rpx;
  background: #E4708E; color: #fff; font-weight: 600;
}
.day__pick {
  flex: none; width: 44rpx; height: 44rpx; border-radius: 50%;
  border: 3rpx solid rgba(108,123,224,0.4);
  display: flex; align-items: center; justify-content: center;
  color: #fff;
}
.day__pick.is-on { background: var(--lav); border-color: var(--lav); }
.day__pick.is-on .ic { color: #fff; width: 24rpx; height: 24rpx; }
.day__edit {
  flex: none; width: 56rpx; height: 56rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  color: var(--lav); background: rgba(108,123,224,0.10);
}
.day__hr {
  height: 1rpx; margin: 20rpx 0 16rpx;
  background: linear-gradient(90deg, rgba(108,123,224,0.18), rgba(108,123,224,0.04));
}
.day__main { display: flex; align-items: center; gap: 16rpx; }
.day__ico {
  flex: none; width: 64rpx; height: 64rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; box-shadow: var(--shadow-soft);
}
.day__main-b { flex: 1; min-width: 0; display: flex; align-items: center; gap: 12rpx; }
.day__title {
  font-size: 30rpx; font-weight: 600; color: var(--ink);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.day__st {
  flex: none; font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 14rpx;
  background: rgba(108,123,224,0.12); color: var(--lav);
}
.day__bell { flex: none; color: #E9A23B; }
.day__bell .ic { width: 30rpx; height: 30rpx; }
.day__meta { margin-top: 16rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.tag {
  font-size: 21rpx; padding: 6rpx 16rpx; border-radius: 16rpx;
  background: rgba(108,123,224,0.08); color: var(--soft);
}
.tag--pri { background: rgba(228,112,142,0.10); }
.tag--sys { background: rgba(155,138,216,0.14); color: #7B6FC0; }
.day__desc {
  margin-top: 14rpx; font-size: 24rpx; line-height: 34rpx; color: var(--soft);
}
.day__foot {
  margin-top: 16rpx; display: flex; align-items: center; gap: 8rpx;
  font-size: 23rpx; color: var(--lav);
}
.day__foot .ic { width: 24rpx; height: 24rpx; color: var(--lav); }
.day__foot-d { margin-left: auto; color: var(--soft); }

/* ============================ 空状态 ============================ */
.empty {
  margin: 60rpx 28rpx 0; padding: 40rpx 28rpx 50rpx;
  display: flex; flex-direction: column; align-items: center; text-align: center;
}
.empty__art { position: relative; width: 280rpx; height: 220rpx; }
.empty__ring {
  position: absolute; left: 50%; top: 30rpx; transform: translateX(-50%);
  width: 180rpx; height: 180rpx; border-radius: 50%;
  border: 2rpx dashed rgba(108,123,224,0.35);
}
.empty__ring::before, .empty__ring::after {
  content: ""; position: absolute; border-radius: 50%;
  border: 2rpx dashed rgba(155,138,216,0.30);
}
.empty__ring::before { inset: -26rpx; }
.empty__ring::after { inset: 26rpx; border-color: rgba(228,136,166,0.30); }
.empty__spark {
  position: absolute; left: 70%; top: 0;
  width: 60rpx; height: 60rpx;
}
.empty__spark .spark {
  width: 40rpx; height: 40rpx; margin: 10rpx;
  color: #E9C36B; background: currentColor;
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  transform: rotate(45deg);
  box-shadow: 0 0 20rpx rgba(233,195,107,0.5);
}
.empty__swoosh {
  position: absolute; left: 10%; right: 10%; bottom: 20rpx; height: 40rpx;
  background: radial-gradient(ellipse at center, rgba(108,123,224,0.16), transparent 70%);
}
.cal3d--big { position: absolute; left: 50%; top: 40rpx; transform: translateX(-50%) rotateX(12deg) rotateY(-18deg); }
.cal3d--big .cal3d__body { width: 76rpx; height: 110rpx; }
.cal3d--big .cal3d__ring { height: 100rpx; }
.empty__title { margin-top: 30rpx; font-size: 32rpx; font-weight: 600; color: var(--ink); }
.empty__sub { margin-top: 12rpx; font-size: 24rpx; line-height: 34rpx; color: var(--soft); max-width: 480rpx; }
.empty__btn {
  margin-top: 32rpx; display: inline-flex; align-items: center; gap: 10rpx;
  padding: 18rpx 36rpx; border-radius: 30rpx;
  color: #fff; font-size: 27rpx; font-weight: 600;
  background: linear-gradient(135deg, var(--lav), var(--pur));
  box-shadow: 0 12rpx 28rpx rgba(108,123,224,0.40);
}
.empty__btn .ic { color: #fff; width: 30rpx; height: 30rpx; }

/* ============================ 底部装饰 ============================ */
.foot {
  position: relative; margin-top: 50rpx; height: 180rpx; overflow: hidden;
}
.foot__wave {
  position: absolute; left: -10%; width: 120%; height: 80rpx; border-radius: 50%;
}
.foot__wave--a { bottom: 40rpx; background: rgba(108,123,224,0.12); }
.foot__wave--b { bottom: 70rpx; background: rgba(155,138,216,0.12); }
.foot__leaf { position: absolute; left: 30rpx; bottom: 30rpx; width: 120rpx; height: 80rpx; opacity: 0.5; }
.leaf {
  position: absolute; width: 26rpx; height: 26rpx;
  background: #9CC2A0; border-radius: 0 50% 50% 50%;
  transform: rotate(45deg);
}
.leaf--1 { left: 0; bottom: 10rpx; }
.leaf--2 { left: 34rpx; bottom: 30rpx; transform: rotate(20deg); opacity: 0.8; }
.leaf--3 { left: 70rpx; bottom: 6rpx; transform: rotate(70deg); opacity: 0.7; }
.foot__slogan {
  position: absolute; right: 36rpx; bottom: 36rpx; text-align: right;
}
.foot__slogan-t {
  display: block; font-size: 30rpx; font-weight: 700; letter-spacing: 2rpx;
  background: linear-gradient(90deg, var(--lav), var(--pink));
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.foot__slogan-line {
  margin-top: 6rpx; margin-left: auto; width: 200rpx; height: 6rpx; border-radius: 6rpx;
  background: linear-gradient(90deg, rgba(155,138,216,0.2), var(--lav));
}

/* ============================ 底部弹层 ============================ */
.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 100;
  background: rgba(40, 40, 70, 0.34);
  backdrop-filter: blur(4rpx); -webkit-backdrop-filter: blur(4rpx);
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; max-height: 86vh; display: flex; flex-direction: column;
  border-radius: 36rpx 36rpx 0 0;
  background: linear-gradient(180deg, #FFFFFF, #F7F6FB);
  box-shadow: 0 -10rpx 40rpx rgba(60,60,90,0.18);
  padding: 16rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  animation: sheetUp 0.3s cubic-bezier(.2,1,.3,1);
}
@keyframes sheetUp { from { transform: translateY(40rpx); opacity: 0.4; } to { transform: translateY(0); opacity: 1; } }
.sheet__handle {
  width: 72rpx; height: 8rpx; border-radius: 8rpx; margin: 6rpx auto 18rpx;
  background: rgba(108,123,224,0.25);
}
.sheet__title { font-size: 33rpx; font-weight: 700; color: var(--ink); }
.sheet__desc { margin-top: 10rpx; font-size: 23rpx; line-height: 34rpx; color: var(--soft); }
.sheet__body { flex: 1; overflow-y: auto; margin-top: 18rpx; }

/* 弹层内容区滚动：配合遮罩 catchtouchmove 锁住背景滑动 */
.sheet__scroll {
  max-height: 56vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.kylist, .catlist, .menulist, .sortlist {
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.kylist { max-height: 48vh; }
.catlist, .menulist, .sortlist { max-height: 56vh; }

/* 详情 */
.detail__head { display: flex; align-items: center; gap: 18rpx; }
.detail__ico {
  flex: none; width: 76rpx; height: 76rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center; font-size: 40rpx;
}
.detail__head-b { flex: 1; min-width: 0; }
.detail__title { font-size: 32rpx; font-weight: 700; color: var(--ink); }
.detail__lab { font-size: 23rpx; }
.detail__head .ic--close {
  flex: none; width: 48rpx; height: 48rpx; border-radius: 50%;
  background: rgba(108,123,224,0.08); color: var(--soft);
}
.detail__cd {
  margin-top: 24rpx; padding: 24rpx; border-radius: 22rpx;
  display: flex; align-items: center; justify-content: space-between;
  background: linear-gradient(135deg, rgba(108,123,224,0.12), rgba(155,138,216,0.10));
}
.detail__cd-l { display: flex; flex-direction: column; }
.detail__cd-label { font-size: 23rpx; color: var(--soft); }
.detail__cd-num { display: flex; align-items: baseline; gap: 6rpx; margin-top: 6rpx; }
.detail__cd-n { font-size: 72rpx; font-weight: 800; color: var(--lav); line-height: 1; }
.detail__cd-u { font-size: 28rpx; color: var(--lav); }
.detail__cd-r { text-align: right; display: flex; flex-direction: column; gap: 6rpx; }
.detail__cd-date { font-size: 26rpx; color: var(--ink); font-weight: 600; }
.detail__cd-wk, .detail__cd-weeks { font-size: 22rpx; color: var(--soft); }
.detail__rows { margin-top: 24rpx; }
.drow {
  display: flex; align-items: flex-start; gap: 16rpx;
  padding: 18rpx 0; border-bottom: 1rpx solid rgba(108,123,224,0.10);
}
.drow__k { flex: none; width: 120rpx; font-size: 25rpx; color: var(--soft); }
.drow__v { flex: 1; font-size: 26rpx; color: var(--ink); }
.drow__v--wrap { line-height: 36rpx; }
.detail__grid {
  margin-top: 24rpx; display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx;
}
.dact {
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx;
  padding: 20rpx 6rpx; border-radius: 18rpx;
  background: rgba(108,123,224,0.07); color: var(--lav); font-size: 22rpx;
}
.dact .ic { width: 38rpx; height: 38rpx; }
.detail__danger {
  margin-top: 24rpx; text-align: center; padding: 22rpx;
  border-radius: 20rpx; color: #E4708E; font-size: 27rpx; font-weight: 600;
  background: rgba(228,112,142,0.10); border: 1rpx solid rgba(228,112,142,0.25);
}

/* 表单 */
.field { margin-top: 22rpx; }
.field--half { display: flex; gap: 20rpx; }
.field--switch { display: flex; align-items: center; justify-content: space-between; }
.field__col { flex: 1; min-width: 0; }
.field__label { font-size: 24rpx; color: var(--soft); }
.field__input, .pick {
  margin-top: 10rpx; width: 100%; height: 80rpx; box-sizing: border-box;
  padding: 0 22rpx; border-radius: 18rpx; font-size: 28rpx; color: var(--ink);
  background: rgba(108,123,224,0.06); border: 1rpx solid rgba(108,123,224,0.12);
  display: flex; align-items: center;
}
.pick { justify-content: space-between; }
.pick .ic { width: 26rpx; height: 26rpx; color: var(--lav); }
.field__switch { transform: scale(0.9); }
.field__inline { margin-top: 12rpx; display: flex; align-items: center; gap: 10rpx; }
.field__hint { font-size: 24rpx; color: var(--soft); }
.field__tiny {
  width: 110rpx; height: 64rpx; text-align: center; border-radius: 14rpx;
  background: rgba(108,123,224,0.06); border: 1rpx solid rgba(108,123,224,0.12);
  font-size: 28rpx; color: var(--ink);
}
.field__err { margin-top: 16rpx; font-size: 23rpx; color: #E4708E; }
.chips { margin-top: 12rpx; display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip--cat { display: inline-flex; align-items: center; gap: 10rpx; padding: 12rpx 22rpx; border-radius: 22rpx; background: rgba(108,123,224,0.06); color: var(--ink); font-size: 25rpx; border: 1rpx solid transparent; }
.chip--cat .chip__ico { width: 44rpx; height: 44rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; }
.chip.is-on, .chip--cat.is-on { color: #fff; background: linear-gradient(135deg, var(--lav), var(--pur)); border-color: transparent; box-shadow: 0 6rpx 16rpx rgba(108,123,224,0.30); }
.chip.is-on .ic, .chip--cat.is-on .ic { color: #fff; }
.sheet__save {
  margin-top: 24rpx; text-align: center; padding: 26rpx;
  border-radius: 24rpx; color: #fff; font-size: 30rpx; font-weight: 700;
  background: linear-gradient(135deg, var(--lav), var(--pur));
  box-shadow: 0 12rpx 28rpx rgba(108,123,224,0.40);
}
.sheet--editor { max-height: 92vh; }

/* 分类管理 */
.catlist { margin-top: 20rpx; }
.catrow {
  display: flex; align-items: center; gap: 18rpx;
  padding: 20rpx 0; border-bottom: 1rpx solid rgba(108,123,224,0.10);
}
.catrow__ico {
  flex: none; width: 72rpx; height: 72rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center; font-size: 38rpx;
  box-shadow: var(--shadow-soft);
}
.catrow__ico--all { background: linear-gradient(135deg, var(--lav), var(--pur)); color: #fff; }
.catrow__b { flex: 1; min-width: 0; }
.catrow__t { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.catrow__d { font-size: 22rpx; color: var(--soft); }
.catrow__n { font-size: 30rpx; font-weight: 700; color: var(--lav); }
.catrow .ic--right { color: var(--soft); width: 28rpx; height: 28rpx; }
.catrow.is-on { background: rgba(108,123,224,0.06); border-radius: 18rpx; padding-left: 16rpx; padding-right: 16rpx; }
.catrow--all.is-on { background: rgba(108,123,224,0.10); }

/* 考研节点 */
.kylist { margin-top: 18rpx; }
.kyrow {
  display: flex; align-items: center; gap: 14rpx;
  padding: 20rpx 18rpx; margin-bottom: 14rpx; border-radius: 20rpx;
  background: rgba(108,123,224,0.05); border: 1rpx solid rgba(108,123,224,0.10);
}
.kyrow.is-target { border-color: rgba(108,123,224,0.5); background: rgba(108,123,224,0.10); }
.kyrow__b { flex: 1; min-width: 0; }
.kyrow__line { display: flex; align-items: center; gap: 12rpx; }
.kyrow__t { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.kyrow__tag { font-size: 19rpx; padding: 2rpx 12rpx; border-radius: 14rpx; background: rgba(155,138,216,0.20); color: #7B6FC0; }
.kyrow__tag.is-on { background: #fff; color: #6C5BD0; font-weight: 600; box-shadow: 0 2rpx 6rpx rgba(108,123,224,0.2); }
.kyrow__added { font-size: 19rpx; padding: 2rpx 12rpx; border-radius: 14rpx; background: rgba(108,123,224,0.14); color: var(--lav); }
.kyrow__edited { font-size: 19rpx; padding: 2rpx 12rpx; border-radius: 14rpx; background: rgba(233,162,59,0.16); color: #C98A2E; }
.kyrow__date { display: block; margin-top: 6rpx; font-size: 22rpx; color: var(--soft); }
.kyrow__desc { display: block; margin-top: 4rpx; font-size: 21rpx; color: var(--soft); }
.kyrow__acts { flex: none; display: flex; align-items: center; gap: 12rpx; }
.kyrow__edit-btn {
  width: 60rpx; height: 60rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(233,162,59,0.14); color: #C98A2E;
}
.kyrow__edit-btn .ic { color: #C98A2E; width: 30rpx; height: 30rpx; }
.kyrow__add {
  flex: none; width: 60rpx; height: 60rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, var(--lav), var(--pur)); color: #fff;
}
.kyrow__add .ic { color: #fff; width: 30rpx; height: 30rpx; }
.kyrow__add.is-done { background: rgba(108,123,224,0.14); color: var(--lav); }
.kyrow__add.is-done .ic { color: var(--lav); }
.sheet__note { margin-top: 16rpx; font-size: 21rpx; color: var(--soft); line-height: 32rpx; }
.sheet__clear {
  margin-top: 18rpx; text-align: center; padding: 20rpx;
  border-radius: 20rpx; color: #C0607A; font-size: 24rpx;
  background: rgba(228,112,142,0.08); border: 1rpx solid rgba(228,112,142,0.20);
}

/* 排序 / 更多 */
.sortlist { margin-top: 18rpx; }
.sortrow {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 18rpx; border-radius: 18rpx; margin-bottom: 12rpx;
  background: rgba(108,123,224,0.05); font-size: 28rpx; color: var(--ink);
}
.sortrow.is-on { background: rgba(108,123,224,0.12); color: var(--lav); font-weight: 600; }
.sortrow .ic { color: var(--lav); width: 30rpx; height: 30rpx; }
.menulist { margin-top: 14rpx; }
.menurow {
  display: flex; align-items: center; gap: 18rpx;
  padding: 24rpx 18rpx; border-radius: 18rpx; margin-bottom: 10rpx;
  background: rgba(108,123,224,0.05); font-size: 27rpx; color: var(--ink);
}
.menurow .ic { width: 34rpx; height: 34rpx; color: var(--lav); }
.menurow__e { font-size: 32rpx; }

/* 设置 */
.setblock { margin-top: 22rpx; padding: 22rpx; border-radius: 22rpx; background: rgba(108,123,224,0.05); border: 1rpx solid rgba(108,123,224,0.10); }
.setblock--last { margin-bottom: 10rpx; }
.setblock__h { font-size: 27rpx; font-weight: 600; color: var(--ink); }
.setblock__d { margin-top: 8rpx; font-size: 22rpx; line-height: 33rpx; color: var(--soft); }
.setblock__row { margin-top: 16rpx; display: flex; align-items: center; justify-content: space-between; }
.setblock__state { font-size: 24rpx; color: var(--lav); font-weight: 600; }
.setblock__btn {
  padding: 14rpx 26rpx; border-radius: 22rpx; color: #fff; font-size: 24rpx; font-weight: 600;
  background: linear-gradient(135deg, var(--lav), var(--pur));
  box-shadow: 0 8rpx 18rpx rgba(108,123,224,0.32);
}
.setblock__switch { transform: scale(0.86); transform-origin: right center; }
.setblock .chip { background: rgba(255,255,255,0.7); }
.setblock .chip.is-on { background: linear-gradient(135deg, var(--lav), var(--pur)); color: #fff; }

/* ============================ 通用按压反馈 ============================
   hover-class="press" 只在按下瞬间给元素加 .press 类，
   所以按压视觉直接写在 .press 上（不能只写 :active，WXSS 不触发）。
   基础元素补 transition，保证松手回弹也是动画而不是瞬切。 */
.imp .hero, .imp .ky, .imp .tools__btn, .imp .empty__btn, .imp .sheet__save,
.imp .dact, .imp .menurow, .imp .day__edit, .imp .day__del, .imp .nav__btn,
.imp .nav__back, .imp .sky__add, .imp .setblock__btn, .imp .manage__btn,
.imp .kyrow__add, .imp .chip, .imp .catrow, .imp .setblock__btn {
  transition: transform 0.18s ease, opacity 0.18s ease;
}
.press { transform: scale(0.97); opacity: 0.72; }