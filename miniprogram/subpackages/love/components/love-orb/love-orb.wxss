/* components/love-orb/love-orb.wxss */
/* 组件自带深空舞台底与光晕投影，页面只需给宽度 */

.orb-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 28rpx;
  /* 深空舞台：与球体渲染的星空自然衔接 */
  background: linear-gradient(170deg, #0B0B24 0%, #14102C 55%, #1C1236 100%);
  box-shadow: inset 0 0 60rpx rgba(0, 0, 0, 0.45);
}

.orb-cv {
  width: 100%;
  height: 100%;
  display: block;
}

.orb-hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 18rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 1rpx;
  pointer-events: none;
}

.orb-form {
  position: absolute;
  left: 24rpx;
  top: 22rpx;
  display: flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(6rpx);
  pointer-events: none;
}

.orb-form__lv {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-right: 10rpx;
}

.orb-form__name {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 600;
}
