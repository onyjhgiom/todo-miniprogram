/* components/love-core/love-core.wxss */
/* 画布背景刻意透明：水晶球要「长」在页面的动态渐变上，而不是自己的黑底舞台里 */

.core-wrap {
  position: relative;
  width: 100%;
  overflow: visible;
}

.core-cv {
  display: block;
  width: 100%;
  height: 100%;
}

.core-hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 1rpx;
  pointer-events: none;
}
