/* pages/love/memory/memory.wxss
 * 回忆 · 沉浸式爱情记忆空间
 * 深海军蓝星空 + 粉紫光效 + 玻璃质感；皮肤只影响球体与点缀色（--ay-primary）。
 */
@import "../../styles/love-common.wxss";

page {
  background: #070B1E;
}

.ay {
  position: relative;
  z-index: 0;
  min-height: 100vh;
  padding-bottom: 230rpx;
  box-sizing: border-box;
  color: #F2F5FF;
  font-size: 28rpx;
  line-height: 1.6;
  background:
    radial-gradient(560rpx 420rpx at 86% -4%, rgba(150, 120, 255, 0.16) 0%, rgba(150, 120, 255, 0) 64%),
    radial-gradient(480rpx 380rpx at -8% 16%, rgba(255, 130, 180, 0.12) 0%, rgba(255, 130, 180, 0) 60%),
    linear-gradient(180deg, #0A0E24 0%, #0A1030 34%, #0B0B24 58%, #111A3E 100%);
}
/* 远景星尘（静态、极轻） */
.ay::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: -1;
  background-image:
    radial-gradient(3rpx 3rpx at 12% 9%, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0) 100%),
    radial-gradient(2rpx 2rpx at 68% 6%, rgba(255, 255, 255, 0.42) 0%, rgba(255, 255, 255, 0) 100%),
    radial-gradient(2rpx 2rpx at 84% 21%, rgba(255, 220, 240, 0.4) 0%, rgba(255, 220, 240, 0) 100%),
    radial-gradient(2rpx 2rpx at 30% 30%, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0) 100%),
    radial-gradient(2rpx 2rpx at 52% 44%, rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0) 100%);
}

.mm-press { opacity: 0.85; transform: scale(0.985); }

/* ====================== Hero ====================== */
.mm-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 32rpx 8rpx;
}
.mm-hero__t {
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #F8FAFF;
}
.mm-hero__s {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255, 199, 222, 0.78);
}
.mm-hero__more {
  width: 64rpx;
  height: 64rpx;
  line-height: 58rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #C9D2F5;
  border-radius: 50%;
  background: rgba(150, 165, 255, 0.1);
  border: 1rpx solid rgba(190, 200, 255, 0.2);
  box-sizing: border-box;
}

/* ====================== 能量胶囊 ====================== */
.mm-cap {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 20rpx 32rpx 0;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(150, 165, 255, 0.08);
  border: 1rpx solid rgba(190, 200, 255, 0.16);
  backdrop-filter: blur(20rpx);
}
.mm-cap__ico {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 26rpx;
  color: #FFD7E6;
  background: radial-gradient(circle at 35% 30%, rgba(255, 155, 192, 0.55) 0%, rgba(199, 155, 255, 0.35) 100%);
  box-shadow: 0 0 18rpx rgba(255, 155, 192, 0.35);
  flex-shrink: 0;
}
.mm-cap__main { flex: 1; min-width: 0; }
.mm-cap__row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.mm-cap__t { font-size: 24rpx; color: #F2F5FF; font-weight: 600; }
.mm-cap__n { font-size: 22rpx; color: #6F7AA9; }
.mm-cap__track {
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(150, 165, 255, 0.14);
  overflow: hidden;
}
.mm-cap__fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FF9BC0 0%, #C79BFF 60%, #F3E3C8 100%);
  box-shadow: 0 0 12rpx rgba(255, 155, 192, 0.5);
  transition: width 700ms cubic-bezier(0.22, 0.8, 0.3, 1);
}

/* ====================== 页签 ====================== */
.mm-tabs {
  display: flex;
  gap: 12rpx;
  margin: 22rpx 32rpx 0;
  padding: 6rpx;
  border-radius: 999rpx;
  background: rgba(150, 165, 255, 0.08);
  border: 1rpx solid rgba(190, 200, 255, 0.14);
  width: fit-content;
}
.mm-tab {
  padding: 12rpx 34rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: #A9B3DC;
  transition: all 200ms ease-out;
}
.mm-tab--on {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #FF8FB8 0%, #C79BFF 100%);
  box-shadow: 0 6rpx 20rpx rgba(255, 143, 184, 0.35);
}

/* ====================== 玻璃卡通用 ====================== */
.mm-card {
  margin: 20rpx 32rpx 0;
  padding: 30rpx;
  border-radius: 28rpx;
  background: rgba(150, 165, 255, 0.08);
  border: 1rpx solid rgba(190, 200, 255, 0.16);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 12rpx 40rpx rgba(4, 8, 24, 0.35);
  box-sizing: border-box;
}
.mm-card__hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.mm-card__title { font-size: 29rpx; font-weight: 600; color: #F2F5FF; }
.mm-card__more { font-size: 22rpx; color: #6F7AA9; }

.mm-mt { margin-top: 18rpx; }
.mm-t { font-size: 26rpx; color: #C9D2F5; }
.mm-strong { color: #FF9BC0; font-weight: 700; }
.mm-faint { font-size: 24rpx; color: #6F7AA9; }
.mm-between { display: flex; align-items: center; justify-content: space-between; }

/* ====================== 表单 ====================== */
.mm-field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(190, 200, 255, 0.1);
}
.mm-field__label {
  width: 176rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #A9B3DC;
}
.mm-field__input {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: #F2F5FF;
}
.mm-ph { color: #59648F; }

.mm-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.mm-chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #A9B3DC;
  background: rgba(150, 165, 255, 0.1);
  border: 1rpx solid rgba(190, 200, 255, 0.16);
  transition: all 200ms ease-out;
}
.mm-chip--on {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #FF8FB8 0%, #C79BFF 100%);
  border-color: rgba(255, 155, 192, 0.4);
  box-shadow: 0 4rpx 16rpx rgba(255, 143, 184, 0.3);
}
.mm-chip--sm { padding: 8rpx 22rpx; font-size: 23rpx; }
.mm-chip--accent {
  color: #FFC7DE;
  background: rgba(255, 143, 184, 0.14);
  border-color: rgba(255, 143, 184, 0.3);
}

.mm-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 40rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #FF8FB8 0%, #C79BFF 100%);
  box-shadow: 0 8rpx 26rpx rgba(255, 143, 184, 0.35), inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}
.mm-btn--block {
  display: flex;
  width: 100%;
  box-sizing: border-box;
}
.mm-btn--pill { padding: 14rpx 48rpx; }

.mm-del { font-size: 22rpx; color: #E08A9B; opacity: 0.85; }
.mm-del--r { text-align: right; margin-top: 14rpx; }

/* ====================== 互动列表行 ====================== */
.mm-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(190, 200, 255, 0.08);
}
.mm-row__ico {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 18rpx;
  font-size: 28rpx;
  background: rgba(150, 165, 255, 0.12);
  flex-shrink: 0;
}
.mm-row__main { flex: 1; min-width: 0; }
.mm-row__t { font-size: 26rpx; color: #F2F5FF; font-weight: 600; }
.mm-row__d { font-size: 22rpx; color: #6F7AA9; margin-top: 4rpx; }

.mm-empty {
  padding: 56rpx 0 40rpx;
  text-align: center;
}
.mm-empty__ico { font-size: 56rpx; }
.mm-empty__t { margin-top: 14rpx; font-size: 26rpx; color: #A9B3DC; }
.mm-empty__s { margin-top: 8rpx; font-size: 22rpx; color: #59648F; }

/* ====================== 3D 球舞台 ====================== */
.mm-stage {
  position: relative;
  margin-top: 8rpx;
}
.mm-stage > love-orb {
  display: block;
  border-radius: 0;
  overflow: hidden;
}
/* 舞台顶部与页面底色融合 */
.mm-stage::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 120rpx;
  background: linear-gradient(180deg, #0A1030 0%, rgba(10, 16, 48, 0) 100%);
  pointer-events: none;
  z-index: 2;
}

.mm-stage__side {
  position: absolute;
  top: 44%;
  z-index: 3;
  width: 168rpx;
  padding: 16rpx 12rpx;
  border-radius: 22rpx;
  text-align: center;
  background: rgba(10, 14, 36, 0.42);
  border: 1rpx solid rgba(190, 200, 255, 0.18);
  backdrop-filter: blur(12rpx);
  pointer-events: none;
}
.mm-stage__side--l { left: 18rpx; }
.mm-stage__side--r { right: 18rpx; }
.mm-stage__num {
  display: block;
  font-size: 23rpx;
  font-weight: 600;
  color: #FFD7E6;
  text-shadow: 0 0 12rpx rgba(255, 155, 192, 0.45);
}
.mm-stage__sub {
  display: block;
  margin-top: 6rpx;
  font-size: 19rpx;
  color: #8C97C7;
}

/* 悬浮平台 · 能量环 */
.mm-stage__pad {
  position: absolute;
  left: 50%;
  bottom: 30rpx;
  transform: translateX(-50%);
  width: 440rpx;
  height: 96rpx;
  z-index: 3;
  pointer-events: none;
}
.mm-stage__ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 155, 192, 0.32);
  box-shadow: 0 0 30rpx rgba(255, 155, 192, 0.22), inset 0 0 24rpx rgba(199, 155, 255, 0.16);
}
.mm-stage__core {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 300rpx;
  height: 44rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(255, 155, 192, 0.28) 0%, rgba(199, 155, 255, 0.12) 55%, rgba(0, 0, 0, 0) 75%);
}

/* ====================== 能量等级玻璃卡 ====================== */
.mm-energy {
  display: flex;
  align-items: center;
  gap: 30rpx;
  margin: 22rpx 32rpx 0;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(160deg, rgba(255, 143, 184, 0.1) 0%, rgba(150, 165, 255, 0.08) 100%);
  border: 1rpx solid rgba(190, 200, 255, 0.18);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 12rpx 40rpx rgba(4, 8, 24, 0.35), inset 0 0 40rpx rgba(255, 143, 184, 0.05);
}
.mm-energy__l { flex-shrink: 0; }
.mm-energy__name { font-size: 22rpx; color: #A9B3DC; }
.mm-energy__lv {
  font-size: 52rpx;
  font-weight: 700;
  color: #FFD7E6;
  text-shadow: 0 0 24rpx rgba(255, 155, 192, 0.5);
  letter-spacing: -1rpx;
}
.mm-energy__r { flex: 1; min-width: 0; }
.mm-energy__nums { display: flex; align-items: baseline; gap: 8rpx; }
.mm-energy__cur { font-size: 34rpx; font-weight: 700; color: #F2F5FF; letter-spacing: -0.5rpx; }
.mm-energy__goal { font-size: 22rpx; color: #6F7AA9; }
.mm-energy__track {
  height: 10rpx;
  margin: 10rpx 0 8rpx;
  border-radius: 999rpx;
  background: rgba(150, 165, 255, 0.14);
  overflow: hidden;
}
.mm-energy__fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FF9BC0 0%, #C79BFF 60%, #F3E3C8 100%);
  box-shadow: 0 0 14rpx rgba(255, 155, 192, 0.5);
  transition: width 700ms cubic-bezier(0.22, 0.8, 0.3, 1);
}
.mm-energy__next { font-size: 22rpx; color: #8C97C7; }

/* ====================== 回忆分区 ====================== */
.mm-sec { margin: 30rpx 32rpx 0; }
.mm-sec__hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.mm-sec__t { font-size: 32rpx; font-weight: 700; color: #F2F5FF; }
.mm-sec__n { color: #FF9BC0; }
.mm-seg {
  display: flex;
  gap: 4rpx;
  padding: 4rpx;
  border-radius: 999rpx;
  background: rgba(150, 165, 255, 0.1);
  border: 1rpx solid rgba(190, 200, 255, 0.14);
}
.mm-seg__it {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #A9B3DC;
}
.mm-seg__it--on {
  color: #fff;
  font-weight: 600;
  background: rgba(255, 143, 184, 0.3);
}

.mm-filters { white-space: nowrap; margin-bottom: 18rpx; }
.mm-filters__in { display: inline-flex; gap: 12rpx; }

/* 回忆卡片：左图右文 */
.mm-mem {
  display: flex;
  gap: 20rpx;
  margin-bottom: 18rpx;
  padding: 22rpx;
  border-radius: 26rpx;
  background: rgba(150, 165, 255, 0.08);
  border: 1rpx solid rgba(190, 200, 255, 0.16);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 10rpx 34rpx rgba(4, 8, 24, 0.3);
}
.mm-mem__img,
.mm-mem__heart {
  width: 150rpx;
  height: 150rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}
.mm-mem__img { display: block; }
.mm-mem__heart {
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 35% 30%, rgba(255, 143, 184, 0.3) 0%, rgba(199, 155, 255, 0.16) 100%);
  border: 1rpx solid rgba(255, 155, 192, 0.28);
  box-sizing: border-box;
}
.mm-mem__heart-ico { font-size: 52rpx; }
.mm-mem__main { flex: 1; min-width: 0; }
.mm-mem__t {
  font-size: 28rpx;
  font-weight: 600;
  color: #F2F5FF;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.mm-mem__meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}
.mm-mem__tag {
  font-size: 20rpx;
  color: #FFC7DE;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 143, 184, 0.14);
  border: 1rpx solid rgba(255, 143, 184, 0.26);
}
.mm-mem__date { font-size: 22rpx; color: #6F7AA9; }
.mm-mem__note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #A9B3DC;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.mm-mem__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.mm-mem__energy {
  font-size: 22rpx;
  color: #FF9BC0;
  text-shadow: 0 0 10rpx rgba(255, 155, 192, 0.35);
}

/* 空态欢迎卡 */
.mm-welcome {
  text-align: center;
  padding: 60rpx 40rpx;
  border-radius: 28rpx;
  background: rgba(150, 165, 255, 0.08);
  border: 1rpx solid rgba(190, 200, 255, 0.16);
  backdrop-filter: blur(20rpx);
}
.mm-welcome__orb {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  font-size: 52rpx;
  color: #FFD7E6;
  background: radial-gradient(circle at 35% 30%, rgba(255, 143, 184, 0.4) 0%, rgba(199, 155, 255, 0.2) 70%, rgba(150, 165, 255, 0.08) 100%);
  border: 1rpx solid rgba(255, 155, 192, 0.35);
  box-shadow: 0 0 40rpx rgba(255, 143, 184, 0.3);
  box-sizing: border-box;
}
.mm-welcome__t { font-size: 28rpx; font-weight: 600; color: #F2F5FF; }
.mm-welcome__s { margin: 10rpx 0 26rpx; font-size: 23rpx; color: #8C97C7; }

/* ====================== 水晶 FAB ====================== */
.mm-fab {
  position: fixed;
  right: 30rpx;
  bottom: 200rpx;
  z-index: 690;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 118rpx;
  height: 118rpx;
  border-radius: 50%;
  background:
    radial-gradient(circle at 32% 28%, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0) 34%),
    linear-gradient(150deg, rgba(255, 143, 184, 0.85) 0%, rgba(199, 155, 255, 0.8) 100%);
  border: 1rpx solid rgba(255, 220, 236, 0.5);
  box-shadow: 0 14rpx 40rpx rgba(255, 143, 184, 0.4), 0 0 60rpx rgba(199, 155, 255, 0.25);
}
.mm-fab--press { transform: scale(0.94); opacity: 0.9; }
.mm-fab__plus { font-size: 40rpx; font-weight: 300; color: #fff; line-height: 1; }
.mm-fab__t { margin-top: 4rpx; font-size: 19rpx; color: rgba(255, 255, 255, 0.92); }

/* ====================== 底部 Dock ====================== */
.mm-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 700;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-sizing: border-box;
  /* 【修复】安全区拆成两行写。
   * 原来 `padding: 14rpx 8rpx calc(14rpx + env(...))` 写成一行，
   * 一旦基础库不识别 env()，**整条 padding 全部失效** → dock 贴到屏幕最底，
   * 被 iPhone 的 Home Indicator 盖住下半截，「能量站」按钮点不到（真机反馈：无响应）。
   * 现在：先给不依赖 env 的兜底值，再单行覆盖 padding-bottom，
   * 即使 env() 不生效，左右与上下内边距也依然正确。 */
  padding: 14rpx 8rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 14rpx);
  background: rgba(8, 12, 32, 0.88);
  border-top: 1rpx solid rgba(190, 200, 255, 0.14);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}
.mm-dock__it {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 18rpx;
  /* 扩大可点区域：小程序按钮热区偏小，真机上「点不到」多半是热区不足 */
  min-height: 88rpx;
  justify-content: center;
}
.mm-dock__ico { font-size: 34rpx; filter: grayscale(0.4) opacity(0.7); }
.mm-dock__t { font-size: 20rpx; color: #6F7AA9; }
.mm-dock__it--on .mm-dock__ico { filter: none; }
.mm-dock__it--on .mm-dock__t {
  color: #FF9BC0;
  font-weight: 600;
  text-shadow: 0 0 12rpx rgba(255, 155, 192, 0.55);
}

/* ====================== 底部抽屉（写回忆） ====================== */
.mm-mask {
  position: fixed;
  inset: 0;
  z-index: 800;
  background: rgba(4, 7, 20, 0.72);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.mm-mask--center {
  justify-content: center;
  align-items: center;
}
.mm-sheet {
  max-height: 82vh;
  overflow-y: auto;
  /* 同 .mm-dock：安全区拆两行，避免 env() 不识别时整条 padding 塌陷 */
  padding: 20rpx 32rpx 36rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 36rpx);
  border-radius: 36rpx 36rpx 0 0;
  background: linear-gradient(180deg, #10173B 0%, #0C1230 100%);
  border-top: 1rpx solid rgba(190, 200, 255, 0.2);
  box-shadow: 0 -20rpx 60rpx rgba(2, 5, 16, 0.6);
  box-sizing: border-box;
  animation: mmSheetUp 300ms cubic-bezier(0.22, 0.8, 0.3, 1) both;
}
.mm-sheet__grab {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(190, 200, 255, 0.24);
  margin: 0 auto 22rpx;
}
@keyframes mmSheetUp {
  from { transform: translateY(60rpx); opacity: 0; }
  to   { transform: translateY(0);     opacity: 1; }
}

/* ====================== 配图选择 ====================== */
.mm-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 12rpx;
}
.mm-photo {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: rgba(150, 165, 255, 0.12);
}
.mm-photo__img { width: 100%; height: 100%; display: block; }
.mm-photo__del {
  position: absolute;
  right: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  background: rgba(4, 7, 20, 0.6);
  border-bottom-left-radius: 18rpx;
}
.mm-photo--add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #8C97C7;
  border: 2rpx dashed rgba(190, 200, 255, 0.35);
  box-sizing: border-box;
}
.mm-mphoto {
  width: 100%;
  height: 260rpx;
  border-radius: 20rpx;
  margin-top: 14rpx;
}

/* ====================== 回忆详情 ====================== */
.mm-detail {
  position: relative;
  width: 600rpx;
  max-width: 86vw;
  padding: 48rpx 40rpx 36rpx;
  border-radius: 36rpx;
  text-align: center;
  background: linear-gradient(170deg, rgba(20, 27, 62, 0.96) 0%, rgba(14, 19, 46, 0.96) 100%);
  border: 1rpx solid rgba(190, 200, 255, 0.2);
  box-shadow: 0 24rpx 80rpx rgba(2, 5, 16, 0.7), 0 0 60rpx rgba(255, 143, 184, 0.12);
  overflow: hidden;
  box-sizing: border-box;
}
.mm-detail__photo {
  width: 100%;
  height: 320rpx;
  border-radius: 24rpx;
  margin-bottom: 18rpx;
  display: block;
}
.mm-detail__halo {
  position: absolute;
  top: -56rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  filter: blur(1rpx);
}
.mm-detail__emoji {
  position: relative;
  font-size: 64rpx;
  margin-top: 30rpx;
}
.mm-detail__title { font-size: 32rpx; font-weight: 600; color: #F2F5FF; }
.mm-detail__meta { margin-top: 6rpx; font-size: 24rpx; color: #8C97C7; }

/* ====================== 飞入中的回忆卡片 ====================== */
.mm-ghost {
  position: fixed;
  z-index: 900;
  pointer-events: none;
}
.mm-ghost__card {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(18, 24, 54, 0.94);
  border: 1rpx solid rgba(255, 155, 192, 0.4);
  box-shadow: 0 10rpx 36rpx rgba(2, 5, 16, 0.6), 0 0 30rpx rgba(255, 143, 184, 0.3);
  transform-origin: center center;
  animation: mmGhostShrink 620ms cubic-bezier(0.4, 0, 0.6, 1) forwards;
}
.mm-ghost__emoji { font-size: 32rpx; }
.mm-ghost__t {
  font-size: 26rpx;
  color: #FFD7E6;
  max-width: 320rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
@keyframes mmGhostShrink {
  0%   { transform: scale(1);    opacity: 1; }
  55%  { transform: scale(0.62); opacity: 1; }
  100% { transform: scale(0.16); opacity: 0; }
}

/* ====================== 升级横幅 ====================== */
.mm-lvup {
  position: fixed;
  inset: 0;
  z-index: 950;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.mm-lvup__card {
  text-align: center;
  padding: 44rpx 66rpx;
  border-radius: 36rpx;
  background: linear-gradient(160deg, rgba(18, 24, 54, 0.95) 0%, rgba(38, 24, 66, 0.95) 100%);
  border: 1rpx solid rgba(255, 155, 192, 0.35);
  box-shadow: 0 0 70rpx rgba(255, 155, 200, 0.35);
  animation: mmLvUpIn 420ms cubic-bezier(0.2, 0.9, 0.3, 1.2) both;
}
.mm-lvup__lv {
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 215, 230, 0.75);
}
.mm-lvup__name {
  margin-top: 6rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}
.mm-lvup__mode {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #FFD7E6;
}
.mm-lvup__desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(201, 210, 245, 0.66);
  max-width: 440rpx;
}
@keyframes mmLvUpIn {
  0%   { transform: scale(0.7) translateY(30rpx); opacity: 0; }
  60%  { transform: scale(1.06) translateY(0);    opacity: 1; }
  100% { transform: scale(1) translateY(0);       opacity: 1; }
}

/* ====================== 入场动效 ====================== */
.mm-anim {
  animation: mmFadeUp 320ms ease-out both;
}
@keyframes mmFadeUp {
  from { transform: translateY(16rpx); opacity: 0; }
  to   { transform: translateY(0);     opacity: 1; }
}
