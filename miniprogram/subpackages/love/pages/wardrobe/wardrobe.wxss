/* pages/love/wardrobe/wardrobe.wxss */
@import "../../styles/love-common.wxss";

/* 拍照位 */
.wd-shot {
  height: 320rpx;
  border-radius: 24rpx;
  background: var(--ay-card-soft, #FFF1EC);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx dashed var(--ay-line, #F8E3DC);
}
.wd-shot:active {
  opacity: 0.8;
}
.wd-shot__img {
  width: 100%;
  height: 100%;
}
.wd-shot__ico {
  font-size: 60rpx;
  margin-bottom: 8rpx;
}

/* 单品网格 */
.wd-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 18rpx 0;
}
.wd-item {
  position: relative;
  width: 50%;
  padding: 8rpx;
  box-sizing: border-box;
}
.wd-item__img {
  width: 100%;
  height: 300rpx;
  border-radius: 20rpx;
  background: var(--ay-card-soft, #FFF1EC);
}
.wd-item__body {
  padding: 10rpx 6rpx 4rpx;
}
.wd-item__name {
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wd-item__ops {
  display: flex;
  gap: 20rpx;
  margin-top: 6rpx;
}
.wd-item__op {
  font-size: 23rpx;
  color: var(--ay-primary, #FF7F9C);
}
.wd-item__op--del {
  color: var(--ay-faint, #B79AA1);
}
.wd-item__dot {
  position: absolute;
  left: 22rpx;
  top: 22rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.85);
}
.wd-item__fav {
  position: absolute;
  right: 22rpx;
  top: 18rpx;
  font-size: 26rpx;
}

/* 每天搭配 */
.wd-look {
  display: flex;
  gap: 14rpx;
  overflow-x: auto;
  padding-bottom: 6rpx;
}
.wd-look__i {
  flex: none;
  width: 150rpx;
}
.wd-look__img {
  width: 150rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: var(--ay-card-soft, #FFF1EC);
}
.wd-look__empty {
  width: 150rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: var(--ay-card-soft, #FFF1EC);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  color: var(--ay-faint, #B79AA1);
}
.wd-look__n {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--ay-sub, #8A6E74);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
