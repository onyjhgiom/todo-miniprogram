<!-- pages/love/share/share.wxml -->
<view class="ay" data-skin="{{skin.key}}" style="{{skin.style}}">
  <!-- 状态 -->
  <view class="ay-card ay-anim">
    <view class="ay-card__hd">
      <text class="ay-card__title">🔗 共享状态</text>
      <text class="ay-card__more">{{view.bound ? '已配对' : '未配对'}}</text>
    </view>
    <view class="ay-row">
      <text class="ay-row__ico">🏠</text>
      <view class="ay-row__main">
        <view class="ay-row__t">房间号 {{view.room || '——'}}</view>
        <view class="ay-row__d">{{view.roleText}}</view>
      </view>
    </view>
    <view class="ay-row">
      <text class="ay-row__ico">☁️</text>
      <view class="ay-row__main">
        <view class="ay-row__t">{{view.cloudOn ? '云端已连接' : '云端未连接'}}</view>
        <view class="ay-row__d">{{view.channelText}}</view>
      </view>
    </view>
    <view class="ay-row">
      <text class="ay-row__ico">🕒</text>
      <view class="ay-row__main">
        <view class="ay-row__t">上次同步 {{view.lastSyncText}}</view>
        <view class="ay-row__d" wx:if="{{view.lastMsg}}">{{view.lastMsg}}</view>
      </view>
    </view>
    <view class="ay-faint ay-mt">
      本地：互动 {{view.counts.interaction}} · 回忆 {{view.counts.memory}} · 礼物 {{view.counts.gift}}
    </view>
  </view>

  <!-- 配对 -->
  <view class="ay-card ay-anim">
    <view class="ay-card__hd"><text class="ay-card__title">💌 配对</text></view>
    <view class="ay-faint">一个人生成房间号，另一个人输入同一个号，双方就绑在一起了。</view>
    <view class="ay-wrap ay-mt">
      <view class="ay-btn {{busy?'ay-btn--off':''}}" bindtap="onCreateRoom">生成房间号</view>
      <view class="ay-btn ay-btn--line" data-v="me" bindtap="onRole">我是「我」</view>
      <view class="ay-btn ay-btn--line" data-v="him" bindtap="onRole">我是「他」</view>
    </view>
    <view class="ay-field ay-mt">
      <text class="ay-field__label">房间号</text>
      <input class="ay-field__input" placeholder="输入对方的 6 位房间号" maxlength="6"
             value="{{roomInput}}" bindinput="onRoomInput" />
    </view>
    <view class="ay-btn ay-btn--block ay-mt" bindtap="onJoinRoom">加入房间</view>
  </view>

  <!-- 云端同步 -->
  <view class="ay-card ay-anim">
    <view class="ay-card__hd"><text class="ay-card__title">☁️ 云端同步</text></view>
    <view class="ay-wrap">
      <view class="ay-btn {{busy?'ay-btn--off':''}}" bindtap="onPush">⬆️ 上传我的</view>
      <view class="ay-btn ay-btn--ghost {{busy?'ay-btn--off':''}}" bindtap="onPull">⬇️ 拉取对方的</view>
    </view>
    <view class="ay-faint ay-mt">
      上传后让对方点「拉取」，两边就会合并。同一条记录不会重复——按 id 去重，谁先记的都保留。
    </view>
  </view>

  <!-- 离线通道 -->
  <view class="ay-card ay-anim">
    <view class="ay-card__hd"><text class="ay-card__title">📤 离线同步（没云端也能用）</text></view>
    <view class="ay-faint">把数据复制成一段文字，微信发给他；他粘贴进来即可，效果与云端一致。</view>
    <view class="ay-btn ay-btn--block ay-mt" bindtap="onExport">📋 导出并复制</view>
    <view class="ay-btn ay-btn--block ay-btn--ghost ay-mt" bindtap="onImportClipboard">📥 从剪贴板导入</view>
    <textarea class="ay-field__input ay-story ay-mt" placeholder="或者把对方发来的内容粘贴到这里"
              value="{{importText}}" bindinput="onImportText" maxlength="-1" />
    <view class="ay-btn ay-btn--block ay-mt" bindtap="onImport">导入这段内容</view>
  </view>

  <!-- 共享范围 -->
  <view class="ay-card ay-anim">
    <view class="ay-card__hd"><text class="ay-card__title">🔒 我要共享哪些内容</text></view>
    <view class="ay-row" wx:for="{{scopeMeta}}" wx:key="key">
      <text class="ay-row__ico">{{item.emoji}}</text>
      <view class="ay-row__main">
        <view class="ay-row__t">{{item.label}}</view>
        <view class="ay-row__d">{{item.desc}}</view>
      </view>
      <view class="ay-btn ay-btn--sm {{scope[item.key] ? '' : 'ay-btn--line'}}"
            data-k="{{item.key}}" bindtap="onToggleScope">{{scope[item.key] ? '已共享' : '不同步'}}</view>
    </view>
    <view class="ay-faint ay-mt">
      经期数据默认关闭，只有你主动打开才会同步。随时可以关掉——关掉后新导出的数据里就不再包含它。
    </view>
  </view>
</view>
