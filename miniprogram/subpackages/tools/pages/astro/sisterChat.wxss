/* pages/astro/sisterChat.wxss */
@import "../../styles/astro-common.wxss";

/* 资料卡 / 头像 / 在线点 */
.sister-head { display: flex; align-items: center; gap: 14rpx; }
.sister-avatar-wrap { position: relative; flex-shrink: 0; }
.sister-avatar { width: 116rpx; height: 116rpx; border-radius: 50%; flex-shrink: 0; border: 2rpx solid rgba(192, 132, 104, 0.6); }
.sister-online {
  position: absolute; right: 2rpx; bottom: 2rpx;
  width: 18rpx; height: 18rpx; border-radius: 50%;
  background: #4ade80; border: 3rpx solid #0a0f24;
}
.sister-tagline { display: block; margin-top: 6rpx; font-size: 22rpx; color: rgba(220, 225, 245, 0.7); }
.sister-badge {
  font-size: 18rpx; color: #4ade80;
  background: rgba(74, 222, 128, 0.12);
  border: 1rpx solid rgba(74, 222, 128, 0.4);
  padding: 2rpx 12rpx; border-radius: 999rpx;
}
.sister-switch-btn {
  flex-shrink: 0; font-size: 22rpx; color: #f1d9c6;
  background: rgba(192, 132, 104, 0.18);
  border: 1rpx solid rgba(192, 132, 104, 0.5);
  padding: 12rpx 18rpx; border-radius: 999rpx;
}
.sister-switch-btn--hover { transform: scale(0.96); opacity: 0.85; }

/* 聊天气泡头像 */
.chat-avatar { width: 76rpx; height: 76rpx; border-radius: 50%; flex-shrink: 0; border: 1rpx solid rgba(192,132,104,0.4); }

/* 正在输入气泡 */
.typing { display: flex; align-items: center; gap: 10rpx; padding: 18rpx 22rpx; }
.typing-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: rgba(220, 225, 245, 0.6);
  animation: typing-bounce 1.2s infinite ease-in-out;
}
.typing-dot:nth-child(2) { animation-delay: 0.18s; }
.typing-dot:nth-child(3) { animation-delay: 0.36s; }
@keyframes typing-bounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-8rpx); opacity: 1; }
}

/* 切换姐姐面板（页面顶层 fixed） */
.sister-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(4, 8, 20, 0.62);
  z-index: 100;
  display: flex; align-items: flex-end;
}
.sister-sheet {
  width: 100%;
  background: #141a30;
  border-radius: 28rpx 28rpx 0 0;
  padding: 20rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.4);
}
.sister-sheet__bar {
  width: 72rpx; height: 8rpx; border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  margin: 0 auto 18rpx;
}
.sister-sheet__title {
  display: block; text-align: center; font-size: 26rpx;
  color: #f1f5ff; margin-bottom: 18rpx;
}
.sister-sheet__list { display: flex; flex-direction: column; gap: 14rpx; max-height: 60vh; overflow-y: auto; }
.sister-opt {
  display: flex; align-items: center; gap: 18rpx;
  padding: 16rpx 18rpx; border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  transition: all 200ms ease;
}
.sister-opt.is-active {
  background: rgba(192, 132, 104, 0.16);
  border-color: rgba(192, 132, 104, 0.6);
}
.sister-opt--hover { transform: scale(0.98); }
.sister-opt__avatar { width: 96rpx; height: 96rpx; border-radius: 50%; flex-shrink: 0; border: 1rpx solid rgba(192,132,104,0.4); }
.sister-opt__info { flex: 1; min-width: 0; }
.sister-opt__name { display: block; font-size: 28rpx; color: #fff; font-weight: 600; }
.sister-opt__tag { display: block; font-size: 21rpx; color: rgba(220, 225, 245, 0.65); margin-top: 4rpx; }
.sister-opt__check { font-size: 34rpx; color: #C08468; flex-shrink: 0; }

.topic-row { display: flex; flex-wrap: wrap; gap: 10rpx; }
.topic-chip {
  font-size: 22rpx; padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: rgba(220, 225, 245, 0.85);
  transition: all 200ms ease;
}
.topic-chip.is-active {
  background: linear-gradient(135deg, #96573A, #C08468);
  color: #fff;
  border-color: transparent;
}
.topic-chip--hover { transform: scale(0.97); }

.mood-row { display: flex; flex-wrap: wrap; gap: 10rpx; }
.mood-chip {
  font-size: 22rpx; padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: rgba(220, 225, 245, 0.85);
  transition: all 200ms ease;
}
.mood-chip.is-active {
  background: linear-gradient(135deg, #C08468, #B5714C);
  color: #fff;
  border-color: transparent;
}
.mood-chip--hover { transform: scale(0.97); }

.chat-card { display: flex; flex-direction: column; }
.chat-scroll {
  height: 560rpx;
  margin: 0 -24rpx 14rpx;
  padding: 4rpx 24rpx;
}
.chat-row { display: flex; gap: 10rpx; margin-bottom: 14rpx; }
.chat-row--user { justify-content: flex-end; flex-direction: column; align-items: flex-end; }
.chat-row--ai { justify-content: flex-start; }
.chat-avatar { width: 76rpx; height: 76rpx; border-radius: 50%; flex-shrink: 0; }
.chat-bubble {
  max-width: 70%;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  line-height: 1.55;
  letter-spacing: 0.3rpx;
  word-break: break-all;
  white-space: pre-wrap;
}
.chat-bubble--user {
  background: linear-gradient(135deg, #96573A, #C08468);
  color: #fff;
  border-bottom-right-radius: 4rpx;
  box-shadow: 0 4rpx 14rpx rgba(99, 102, 241, 0.35);
}
.chat-bubble--ai {
  background: rgba(255, 255, 255, 0.06);
  color: #f1f5ff;
  border-bottom-left-radius: 4rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}
.chat-meta { font-size: 18rpx; color: rgba(190, 200, 230, 0.6); margin-bottom: 6rpx; padding-right: 6rpx; }

/* 底部输入栏 */
.input-row {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
  padding: 14rpx 0 calc(6rpx + env(safe-area-inset-bottom));
}
.input-row.is-focused .input-box {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(192, 132, 104, 0.55);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08),
    0 0 0 3rpx rgba(192, 132, 104, 0.12),
    0 6rpx 20rpx rgba(0, 0, 0, 0.3);
}

/* 输入框容器 */
.input-box {
  flex: 1;
  min-width: 0;
  position: relative;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.06),
    0 4rpx 14rpx rgba(0, 0, 0, 0.25);
  transition: all 220ms ease;
}

/* 多行自适应输入框 */
.sister-textarea {
  width: 100%;
  min-height: 78rpx;
  max-height: 168rpx;
  box-sizing: border-box;
  padding: 18rpx 58rpx 18rpx 22rpx;
  border-radius: 28rpx;
  background: transparent;
  color: #f8faff;
  font-size: 28rpx;
  line-height: 1.5;
  letter-spacing: 0.3rpx;
}
.sister-textarea__placeholder {
  color: rgba(190, 200, 230, 0.45);
}

/* 清空按钮 */
.input-clear {
  position: absolute;
  right: 10rpx;
  bottom: 12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 180ms ease;
}
.input-clear__icon {
  color: rgba(220, 225, 245, 0.7);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1;
}
.input-clear--hover {
  transform: scale(0.92);
  background: rgba(255, 255, 255, 0.18);
}

/* 发送按钮 */
.send-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 78rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #C08468 0%, #B5714C 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 20rpx rgba(181, 113, 76, 0.35);
  transition: all 200ms ease;
}
.send-btn--hover {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(181, 113, 76, 0.45);
}
.send-btn--disabled {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(220, 225, 245, 0.35);
  box-shadow: none;
  pointer-events: none;
}

/* 底部辅助信息：隐私提示 + 字数统计 */
.input-hint {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
  padding: 0 6rpx;
}
.input-hint__text {
  font-size: 20rpx;
  color: rgba(190, 200, 230, 0.45);
}
.input-hint__count {
  font-size: 20rpx;
  color: rgba(190, 200, 230, 0.45);
  transition: color 200ms ease;
}
.input-hint__count.is-near {
  color: #F4AFAF;
}

/* ============================================================
 * 真人语音能力（2026-09-29）
 * 资料卡音色行 / 语音条 / 按住说话按钮 / 录音浮层 / 自动朗读开关
 * ============================================================ */

/* ---- 资料卡：声音来源 + 试听 ---- */
.sister-voice-row { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.sister-voice-tag {
  font-size: 19rpx; color: #f1d9c6;
  background: rgba(192, 132, 104, 0.16);
  border: 1rpx solid rgba(192, 132, 104, 0.42);
  padding: 4rpx 12rpx; border-radius: 999rpx;
  max-width: 420rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.sister-voice-try {
  flex-shrink: 0; font-size: 19rpx; color: #fff;
  background: linear-gradient(135deg, #C08468, #B5714C);
  padding: 4rpx 16rpx; border-radius: 999rpx;
}
.sister-tone-tag {
  display: block; margin-top: 6rpx; font-size: 19rpx;
  color: rgba(220, 225, 245, 0.55);
}

/* ---- 聊天气泡列（气泡 + 语音条 上下排列） ---- */
.bubble-col { max-width: 74%; display: flex; flex-direction: column; align-items: flex-start; }
.bubble-col .chat-bubble { max-width: 100%; }

/* ---- 语音条 ---- */
.voice-bar {
  display: inline-flex; align-items: center; gap: 12rpx;
  margin-top: 10rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(192, 132, 104, 0.42);
  transition: all 200ms ease;
}
.voice-bar--user {
  margin-top: 0; margin-bottom: 8rpx;
  background: rgba(192, 132, 104, 0.2);
  border-color: rgba(192, 132, 104, 0.6);
}
.voice-bar--hover { transform: scale(0.98); }
.voice-bar.is-playing {
  background: rgba(192, 132, 104, 0.26);
  border-color: rgba(230, 168, 132, 0.75);
}
.voice-bar__icon {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; color: #fff;
  background: linear-gradient(135deg, #C08468, #B5714C);
}
.voice-bar__wave { display: flex; align-items: flex-end; gap: 4rpx; height: 30rpx; }
.voice-bar__bar {
  width: 4rpx; border-radius: 4rpx;
  background: rgba(241, 217, 198, 0.55);
  height: 12rpx;
}
.voice-bar__bar:nth-child(2n) { height: 22rpx; }
.voice-bar__bar:nth-child(3n) { height: 16rpx; }
.voice-bar__bar:nth-child(5n) { height: 26rpx; }
.voice-bar.is-playing .voice-bar__bar {
  background: #F4CDA8;
  animation: voice-bar-pulse 900ms ease-in-out infinite;
}
.voice-bar.is-playing .voice-bar__bar:nth-child(2n) { animation-delay: 120ms; }
.voice-bar.is-playing .voice-bar__bar:nth-child(3n) { animation-delay: 240ms; }
.voice-bar.is-playing .voice-bar__bar:nth-child(4n) { animation-delay: 360ms; }
@keyframes voice-bar-pulse {
  0%, 100% { transform: scaleY(0.6); opacity: 0.7; }
  50% { transform: scaleY(1.15); opacity: 1; }
}
.voice-bar__dur { font-size: 21rpx; color: rgba(241, 217, 198, 0.85); }
.voice-bar__info {
  width: 34rpx; height: 34rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; color: rgba(220, 225, 245, 0.7);
  background: rgba(255, 255, 255, 0.08);
}

/* ---- 语音来源小字 ---- */
.voice-src { margin-top: 6rpx; max-width: 100%; }
.voice-src__text {
  font-size: 18rpx; color: rgba(190, 200, 230, 0.5);
  word-break: break-all;
}

/* ---- 顶部：自动朗读开关 + 状态提示 ---- */
.voice-head {
  display: flex; align-items: center; justify-content: space-between;
  gap: 12rpx; margin-bottom: 12rpx;
}
.voice-toggle {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 8rpx 18rpx; border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  font-size: 21rpx; color: rgba(220, 225, 245, 0.7);
  transition: all 200ms ease;
}
.voice-toggle.is-on {
  background: rgba(192, 132, 104, 0.2);
  border-color: rgba(192, 132, 104, 0.6);
  color: #f1d9c6;
}
.voice-toggle--hover { transform: scale(0.97); }
.voice-toggle__dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: rgba(220, 225, 245, 0.4);
}
.voice-toggle.is-on .voice-toggle__dot { background: #F4CDA8; }
.voice-tip { font-size: 20rpx; color: rgba(190, 200, 230, 0.6); }
.voice-tip.is-warn { color: #F4AFAF; }

/* ---- 按住说话按钮 ---- */
.voice-btn {
  flex-shrink: 0;
  width: 78rpx; height: 78rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(192, 132, 104, 0.45);
  transition: all 200ms ease;
}
.voice-btn--hover { transform: scale(0.94); background: rgba(192, 132, 104, 0.18); }
.voice-btn.is-recording {
  background: linear-gradient(135deg, #C08468, #B5714C);
  border-color: transparent;
  box-shadow: 0 0 0 8rpx rgba(192, 132, 104, 0.18);
}
.voice-btn__icon { font-size: 30rpx; color: #f1d9c6; line-height: 1; }
.voice-btn.is-recording .voice-btn__icon { color: #fff; }

/* ---- 录音浮层 ---- */
.rec-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(4, 8, 20, 0.6);
  z-index: 120;
  display: flex; align-items: center; justify-content: center;
}
.rec-panel {
  width: 460rpx;
  padding: 40rpx 30rpx 34rpx;
  border-radius: 32rpx;
  background: #141a30;
  border: 1rpx solid rgba(192, 132, 104, 0.4);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
  display: flex; flex-direction: column; align-items: center; gap: 16rpx;
}
.rec-wave { display: flex; align-items: center; gap: 10rpx; height: 70rpx; }
.rec-wave__bar {
  width: 10rpx; height: 16rpx; border-radius: 6rpx;
  background: rgba(241, 217, 198, 0.3);
  transition: all 120ms ease;
}
.rec-wave__bar.is-hot {
  background: linear-gradient(180deg, #F4CDA8, #C08468);
  height: 52rpx;
}
.rec-sec { font-size: 44rpx; font-weight: 700; color: #f8faff; }
.rec-tip { font-size: 21rpx; color: rgba(190, 200, 230, 0.6); }

/* ---- 切换面板里的音色小字 ---- */
.sister-opt__voice {
  display: block; font-size: 19rpx; color: rgba(241, 217, 198, 0.7);
  margin-top: 4rpx;
}