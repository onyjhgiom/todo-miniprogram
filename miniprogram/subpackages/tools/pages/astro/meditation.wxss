/* pages/astro/meditation.wxss */
@import "../../styles/astro-common.wxss";

.layout-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.layout-item {
  flex: 1 0 calc(50% - 6rpx);
  padding: 16rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex; flex-direction: column; gap: 4rpx;
  transition: all 200ms ease;
}
.layout-item.is-active {
  background: linear-gradient(135deg, #96573A, #C08468);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(99, 102, 241, 0.4);
}
.layout-item--hover { transform: scale(0.97); }
.layout-item__name { font-size: 24rpx; font-weight: 600; }
.layout-item__desc { font-size: 20rpx; color: rgba(200, 210, 240, 0.65); }
.layout-item.is-active .layout-item__desc { color: rgba(255, 255, 255, 0.85); }

.duration-row { display: flex; gap: 12rpx; margin-top: 14rpx; }
.dur {
  flex: 1; text-align: center;
  padding: 14rpx 0;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 22rpx;
  color: rgba(220, 225, 245, 0.8);
  transition: all 200ms ease;
}
.dur.is-active {
  background: linear-gradient(135deg, #96573A, #C08468);
  color: #fff;
  border-color: transparent;
}
.dur--hover { transform: scale(0.97); }

/* 环境白噪音选择 chips */
.noise-row { display: flex; gap: 12rpx; margin-top: 14rpx; }
.noise-chip {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 6rpx;
  padding: 14rpx 0;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 22rpx;
  color: rgba(220, 225, 245, 0.8);
  transition: all 200ms ease;
}
.noise-chip__icon { font-size: 26rpx; }
.noise-chip__eq {
  font-size: 20rpx; color: #a5b4fc;
  animation: noise-eq 900ms ease-in-out infinite alternate;
}
.noise-chip.is-active {
  background: linear-gradient(135deg, #96573A, #C08468);
  color: #fff;
  border-color: transparent;
}
.noise-chip.is-active .noise-chip__eq { color: #fff; }
@keyframes noise-eq {
  from { opacity: 0.35; }
  to { opacity: 1; }
}

.med-stage {
  display: flex; align-items: center;
  gap: 24rpx;
}
.med-ring {
  flex-shrink: 0;
  width: 220rpx; height: 220rpx;
  border-radius: 50%;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  background:
    radial-gradient(circle at 50% 50%, rgba(99, 102, 241, 0.28), rgba(99, 102, 241, 0.05) 70%),
    rgba(20, 24, 50, 0.6);
  border: 2rpx solid rgba(168, 145, 247, 0.5);
  transition: transform 220ms ease;
}
.med-ring.is-pulse { transform: scale(1.06); }
.med-ring__time { font-size: 48rpx; font-weight: 700; color: #f1f5ff; }
.med-ring__label { font-size: 20rpx; color: rgba(200, 210, 240, 0.7); letter-spacing: 4rpx; }

.med-prompts { flex: 1; }
.med-prompt {
  display: block;
  font-size: 26rpx;
  color: rgba(220, 225, 245, 0.45);
  line-height: 1.8;
  margin-bottom: 8rpx;
  transition: all 220ms ease;
}
.med-prompt.is-active { color: #f8faff; transform: translateX(4rpx); }

.stat-row { display: flex; gap: 18rpx; }
.stat-cell {
  flex: 1;
  display: flex; flex-direction: column;
  gap: 6rpx;
  padding: 18rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  align-items: flex-start;
}
.stat-cell .astro-title { font-size: 30rpx; }