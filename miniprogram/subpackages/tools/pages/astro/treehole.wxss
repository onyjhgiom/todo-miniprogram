/* pages/astro/treehole.wxss */
@import "../../styles/astro-common.wxss";

.layout-row { display: flex; flex-wrap: wrap; gap: 8rpx; }

.filter-chip {
  font-size: 22rpx; padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: rgba(220, 225, 245, 0.8);
  transition: all 200ms ease;
}
.filter-chip.is-active {
  background: linear-gradient(135deg, #96573A, #C08468);
  color: #fff;
  border-color: transparent;
}
.filter-chip--hover { transform: scale(0.97); }

.tree-card { position: relative; }
.tree-card.is-sealed .tree-card__head,
.tree-card.is-sealed .tree-card__title,
.tree-card.is-sealed .tree-card__body {
  filter: blur(18rpx);
  pointer-events: none;
}
.tree-card.is-sealed .tree-card__foot {
  filter: blur(12rpx);
  pointer-events: none;
}
.tree-mask {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: rgba(10, 14, 36, 0.65);
  backdrop-filter: blur(8rpx);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 10rpx;
}
.tree-mask__lock { font-size: 56rpx; }
.tree-mask__text { font-size: 22rpx; color: rgba(220, 225, 245, 0.8); letter-spacing: 2rpx; }

.tree-card__head { display: flex; align-items: center; margin-bottom: 12rpx; }
.tree-card__title { display: block; margin-bottom: 10rpx; }
.tree-card__body { display: block; margin-bottom: 12rpx; white-space: pre-wrap; }
.tree-card__foot { display: flex; gap: 8rpx; flex-wrap: wrap; }