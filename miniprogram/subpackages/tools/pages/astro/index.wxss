}
.bnav__i--hover {
  transform: scale(0.94);
}
.bnav__ic {
  font-size: calc(34 * var(--u));
  line-height: 1;
  opacity: 0.62;
  transition: opacity 200ms ease;
}
.bnav__tx {
  font-size: calc(19 * var(--u));
  letter-spacing: calc(1 * var(--u));
  color: rgba(159, 163, 196, 0.8);
}
.bnav__i.is-on .bnav__ic {
  opacity: 1;
  filter: drop-shadow(0 0 calc(14 * var(--u)) rgba(139, 124, 246, 0.9));
}
.bnav__i.is-on .bnav__tx {
  color: var(--a-white);
  font-weight: 700;
}

/* ============================ AstrologyDetail 弹层 ============================ */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: calc(60 * var(--u));
  background: rgba(4, 6, 18, 0.76);
  backdrop-filter: blur(calc(10 * var(--u)));
  -webkit-backdrop-filter: blur(calc(10 * var(--u)));
}
.detail {
  position: relative;
  width: 100%;
  max-width: calc(600 * var(--u));
  padding: calc(44 * var(--u)) calc(34 * var(--u)) calc(30 * var(--u));
  border-radius: calc(32 * var(--u));
  overflow: hidden;
  text-align: center;
  background: linear-gradient(165deg, rgba(48, 38, 92, 0.98) 0%, rgba(13, 11, 38, 0.99) 100%);
  border: calc(1 * var(--u)) solid rgba(139, 124, 246, 0.34);
  box-shadow: 0 calc(24 * var(--u)) calc(64 * var(--u)) rgba(0, 0, 0, 0.66);
  animation: detailIn 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
}
@keyframes detailIn {
  0%   { opacity: 0; transform: translateY(calc(30 * var(--u))) scale(0.94); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}
.detail__halo {
  position: absolute;
  left: 50%;
  top: calc(-120 * var(--u));
  width: calc(420 * var(--u));
  height: calc(420 * var(--u));
  margin-left: calc(-210 * var(--u));
  border-radius: 50%;
  background: radial-gradient(circle, rgba(216, 182, 106, 0.26) 0%, rgba(139, 124, 246, 0.12) 44%, rgba(139, 124, 246, 0) 70%);
  pointer-events: none;
}
.detail__name {
  position: relative;
  font-size: calc(42 * var(--u));
  font-weight: 800;
  letter-spacing: calc(4 * var(--u));
  color: var(--a-white);
  text-shadow: 0 0 calc(30 * var(--u)) rgba(216, 182, 106, 0.6);
}
.detail__energy {
  position: relative;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: calc(8 * var(--u));
  margin: calc(26 * var(--u)) 0 calc(18 * var(--u));
}
.detail__elabel {
  font-size: calc(24 * var(--u));
  color: var(--a-sub);
  margin-right: calc(6 * var(--u));
}
.detail__eval {
  font-size: calc(66 * var(--u));
  font-weight: 800;
  line-height: 1;
  color: var(--a-gold);
  text-shadow: 0 0 calc(26 * var(--u)) rgba(216, 182, 106, 0.7);
}
.detail__eunit {
  font-size: calc(24 * var(--u));
  color: var(--a-sub);
}
.detail__bar {
  height: calc(10 * var(--u));
  border-radius: calc(999 * var(--u));
  background: rgba(255, 255, 255, 0.1);
  overflow: hidden;
  margin-bottom: calc(22 * var(--u));
}
.detail__bin {
  height: 100%;
  border-radius: calc(999 * var(--u));
  background: linear-gradient(90deg, var(--a-primary), var(--a-gold));
  box-shadow: 0 0 calc(14 * var(--u)) rgba(216, 182, 106, 0.7);
  transition: width 620ms cubic-bezier(0.22, 1, 0.36, 1);
}
.detail__hint {
  font-size: calc(23 * var(--u));
  line-height: 1.6;
  color: rgba(233, 236, 255, 0.8);
  margin-bottom: calc(28 * var(--u));
}
.detail__acts {
  display: flex;
  gap: calc(16 * var(--u));
}
.detail__btn {
  flex: 1;
  padding: calc(22 * var(--u)) 0;
  border-radius: calc(999 * var(--u));
  text-align: center;
  font-size: calc(26 * var(--u));
  font-weight: 700;
  letter-spacing: calc(1 * var(--u));
  color: var(--a-white);
  background: linear-gradient(135deg, var(--a-primary) 0%, var(--a-secondary) 100%);
  box-shadow: 0 calc(10 * var(--u)) calc(26 * var(--u)) rgba(109, 92, 231, 0.48);
}
.detail__btn--ghost {
  background: transparent;
  border: calc(1 * var(--u)) solid rgba(255, 255, 255, 0.22);
  box-shadow: none;
  color: rgba(233, 236, 255, 0.86);
}

/* ============================ 减弱动态效果（需求十） ============================
 * 小程序不支持 @media (prefers-reduced-motion)，故由 ts 探测系统设置后挂 `.is-reduced`。
 * 策略：关掉背景大动画与循环动画，入场动画改为「直接到末态」。
 */
.astro-home.is-reduced .cbg__nebula--1,
.astro-home.is-reduced .cbg__nebula--2,
.astro-home.is-reduced .cbg__dust,
.astro-home.is-reduced .cbg__glow,
.astro-home.is-reduced .ring::after,
.astro-home.is-reduced .ring__glow,
.astro-home.is-reduced .cta__orb {
  animation: none;
}
.astro-home.is-reduced .hero__canvas,
.astro-home.is-reduced .hero__text,
.astro-home.is-reduced .hero__note,
.astro-home.is-reduced .hero__hint,
.astro-home.is-reduced .zodiac,
.astro-home.is-reduced .energy,
.astro-home.is-reduced .ai,
.astro-home.is-reduced .fcard,
.astro-home.is-reduced .cta,
.astro-home.is-reduced .recent {
  transition: none;
  animation: none;
  opacity: 1;
  transform: none;
}

/* ============================ 响应式：平板 / PC 宽窗 ============================
 * 【为什么不用 @media (min-width: 740px)】
 *   小程序 WXSS 里 @media 的 px 判定口径与浏览器不同（工具按设备像素、真机可能
 *   按物理像素），375pt 宽的手机会被判成 ≥740px 恒命中宽窗样式，导致 --u 被缩到
 *   0.62px、模块变 4 列，flex 子项压到极窄 → 标题被挤成单字竖排（真机已复现）。
 *   结论：小程序里**不要用 px 媒体查询做版式分支**。
 *   改由 ts 用 wx.getWindowInfo().windowWidth 判定（阈值 600，远高于任何手机逻辑
 *   像素宽），挂 .is-wide 类；见 index.ts 的 applyLayout()。
 * ============================================================================ */
.astro-home.is-wide {
  /* 尺寸参考系由「视口比例」切换为「固定桌面尺度」。
     注：applyLayout() 会同时在根节点内联同样的 0.62px（内联优先级更高），
     这里只作 JS 未注入时的兜底。 */
  --u: 0.62px;
}

/* 每组 4 个模块 → 一行一组，整整齐齐 */
.is-wide .fgrid {
  grid-template-columns: repeat(4, 1fr);
}

/* 内容列定宽居中（只设左右 margin，保留各块原有的 margin-top） */
.is-wide .hero,
.is-wide .zodiac,
.is-wide .energy,
.is-wide .ai,
.is-wide .feats,
.is-wide .cta,
.is-wide .recent,
.is-wide .astro-foot {
  max-width: 900px;
  margin-left: auto;
  margin-right: auto;
}

/* 宽窗可用鼠标：hover 反馈做成常驻（小程序 hover-class 只在按住时生效） */
.is-wide .fcard:hover {
  transform: translateY(calc(-8 * var(--u))) scale(1.02);
  border-color: rgba(139, 124, 246, 0.5);
  box-shadow: 0 calc(18 * var(--u)) calc(44 * var(--u)) rgba(109, 92, 231, 0.45), 0 0 calc(30 * var(--u)) rgba(139, 124, 246, 0.32);
}

/* 超宽窗：只把内容列放宽一点，避免两侧留白过大 */
.astro-home.is-wide-xl {
  max-width: 1040px;
}
.is-wide-xl .hero,
.is-wide-xl .zodiac,
.is-wide-xl .energy,
.is-wide-xl .ai,
.is-wide-xl .feats,
.is-wide-xl .cta,
.is-wide-xl .recent,
.is-wide-xl .astro-foot {
  max-width: 1040px;
}
