}
.recent__row--hover {
  background: rgba(255, 255, 255, 0.09);
  transform: scale(0.99);
}
.recent__ico {
  flex-shrink: 0;
  width: calc(56 * var(--u));
  height: calc(56 * var(--u));
  border-radius: calc(16 * var(--u));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(28 * var(--u));
  background: rgba(255, 255, 255, 0.08);
}
.recent__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: calc(4 * var(--u));
}
.recent__name {
  font-size: calc(25 * var(--u));
  color: rgba(233, 236, 255, 0.94);
}
.recent__time {
  font-size: calc(20 * var(--u));
  color: var(--a-sub);
}

.astro-foot {
  position: relative;
  z-index: 1;
  text-align: center;
  margin-top: calc(30 * var(--u));
  font-size: calc(20 * var(--u));
  letter-spacing: calc(1 * var(--u));
  color: rgba(159, 163, 196, 0.45);
}

/* ============================ BottomNavigation ============================ */
.bnav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  padding: calc(14 * var(--u)) calc(12 * var(--u)) calc(30 * var(--u));
  background: linear-gradient(180deg, rgba(8, 10, 28, 0.72) 0%, rgba(8, 10, 28, 0.97) 62%);
  backdrop-filter: blur(calc(20 * var(--u)));
  -webkit-backdrop-filter: blur(calc(20 * var(--u)));
