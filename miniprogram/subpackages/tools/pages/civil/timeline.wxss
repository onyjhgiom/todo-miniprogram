/* subpackages/tools/pages/civil/timeline.wxss */

.ctl { min-height: 100vh; padding-bottom: 190rpx; }

/* ===== 顶部 ===== */
.ctl__hero {
  padding: 40rpx 32rpx 34rpx;
  color: #fff;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
}
.ctl__hero-title { font-size: 40rpx; font-weight: 800; letter-spacing: 1rpx; }
.ctl__hero-sub { font-size: 23rpx; opacity: 0.9; display: block; margin-top: 14rpx; line-height: 1.65; }
.ctl__hero-now {
  display: inline-block;
  margin-top: 22rpx;
  font-size: 21rpx;
  padding: 9rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* ===== 下一节点 ===== */
.ctl__next {
  display: flex;
  gap: 16rpx;
  margin: 22rpx 24rpx 0;
  padding: 22rpx;
  border-radius: 20rpx;
  background: var(--color-primary-soft);
}
.ctl__next-icon { font-size: 32rpx; flex-shrink: 0; line-height: 1.4; }
.ctl__next-main { flex: 1; min-width: 0; }
.ctl__next-t { font-size: 26rpx; font-weight: 700; color: var(--color-text); line-height: 1.6; }
.ctl__next-s { font-size: 22rpx; color: var(--color-text-soft); display: block; margin-top: 8rpx; line-height: 1.6; }

/* ===== 筛选 ===== */
.ctl__filters { white-space: nowrap; padding: 24rpx 24rpx 10rpx; }
.ctl__filter {
  display: inline-block;
  font-size: 23rpx;
  padding: 14rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-border);
  color: var(--color-text-soft);
}
.ctl__filter--on { color: #fff; font-weight: 700; }
.ctl__filter-n { font-size: 19rpx; opacity: 0.8; margin-left: 8rpx; }

/* ===== 月份轴 ===== */
.ctl__months { padding: 6rpx 24rpx 0; }
.ctl__m { display: flex; gap: 18rpx; }

/* 左侧轴 */
.ctl__rail { width: 76rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; }
.ctl__rail-dot {
  width: 68rpx;
  height: 68rpx;
  border-radius: 999rpx;
  background: var(--color-card);
  border: 3rpx solid var(--color-border);
  color: var(--color-text-soft);
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ctl__rail-dot--past { opacity: 0.55; }
.ctl__rail-dot--now {
  background: var(--gradient-primary);
  border-color: transparent;
  color: #fff;
  box-shadow: 0 0 0 8rpx var(--color-primary-soft);
}
.ctl__rail-line { flex: 1; width: 4rpx; background: var(--color-border); margin: 8rpx 0; min-height: 30rpx; }

/* 右侧内容 */
.ctl__body { flex: 1; min-width: 0; padding-bottom: 30rpx; }
.ctl__m-head { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; padding-top: 8rpx; }
.ctl__m-label { font-size: 30rpx; font-weight: 800; color: var(--color-text); }
.ctl__m-now {
  font-size: 19rpx;
  font-weight: 700;
  color: #fff;
  background: var(--gradient-primary);
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
}
.ctl__m-n { font-size: 20rpx; color: var(--color-text-mute); margin-left: auto; }
.ctl__m-major { color: var(--color-primary); font-weight: 700; }
.ctl__m-theme { font-size: 22rpx; color: var(--color-text-mute); display: block; margin-top: 8rpx; }

/* 事件 */
.ctl__e {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-border);
  border-radius: 18rpx;
  padding: 20rpx;
  overflow: hidden;
}
.ctl__e-bar { width: 8rpx; border-radius: 999rpx; flex-shrink: 0; }
.ctl__e-main { flex: 1; min-width: 0; }
.ctl__e-head { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.ctl__e-chip { font-size: 19rpx; font-weight: 700; padding: 5rpx 14rpx; border-radius: 999rpx; }
.ctl__e-star { font-size: 19rpx; font-weight: 700; color: #b45309; }
.themed[data-theme='dark'] .ctl__e-star,
.themed[data-theme='rose'] .ctl__e-star { color: #fbbf24; }
.ctl__e-title { font-size: 26rpx; font-weight: 700; color: var(--color-text); display: block; margin-top: 12rpx; line-height: 1.55; }
.ctl__e-desc { font-size: 22rpx; color: var(--color-text-soft); display: block; margin-top: 8rpx; line-height: 1.68; }

/* 聚焦月高亮 */
.ctl__m--focus .ctl__body > .ctl__m-head .ctl__m-label { color: var(--color-primary); }

.ctl__legend {
  margin: 10rpx 24rpx 0;
  font-size: 21rpx;
  color: var(--color-text-mute);
  line-height: 1.7;
}
.ctl__press { opacity: 0.72; }
.ctl__pad { height: 24rpx; }

/* ===== 底部 ===== */
.ctl__bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-bg-elevated);
  border-top: 2rpx solid var(--color-border);
}
.ctl__btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 700;
  color: #fff;
  border-radius: 20rpx;
  background: var(--gradient-primary);
}
