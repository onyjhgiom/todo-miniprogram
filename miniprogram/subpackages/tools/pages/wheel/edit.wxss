/* subpackages/tools/pages/wheel/edit.wxss
 * 选项编辑页：白卡表单 + 底部固定操作区（dock 不随内容滚动）。 */

.we {
  --we-bg: #F5F1E8;
  --we-card: #FFFFFF;
  --we-ink: #2C2620;
  --we-ink-2: #7A6E62;
  --we-ink-3: #A99C8C;
  --we-line: #EDE6DA;
  --we-accent: #C08552;
  --we-accent-soft: rgba(192, 133, 82, 0.12);
  --we-danger: #C0522F;
  --we-shadow: 0 6rpx 20rpx rgba(90, 70, 45, 0.08);
  --we-mask: rgba(30, 24, 18, 0.45);
  min-height: 100vh;
  background: var(--we-bg);
  color: var(--we-ink);
  padding: 20rpx 24rpx 0;
}

.we[data-theme='dark'],
.we[data-theme='rose'] {
  --we-bg: #17161A;
  --we-card: #222024;
  --we-ink: #F3EFE9;
  --we-ink-2: #A79E92;
  --we-ink-3: #6E665C;
  --we-line: #2E2B2F;
  --we-accent: #D8A771;
  --we-accent-soft: rgba(216, 167, 113, 0.16);
  --we-danger: #E0704E;
  --we-mask: rgba(0, 0, 0, 0.6);
}

.we__card {
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  background: var(--we-card);
  box-shadow: var(--we-shadow);
}

.we__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--we-line);
}

.we__row:last-child {
  border-bottom: none;
}

.we__label {
  font-size: 28rpx;
  color: var(--we-ink-2);
}

.we__input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  margin-left: 20rpx;
}

.we__right {
  display: flex;
  align-items: center;
}

.we__muted {
  font-size: 26rpx;
  color: var(--we-ink-3);
}

.we__arrow {
  margin-left: 10rpx;
  font-size: 30rpx;
  color: var(--we-ink-3);
}

.we__secHead {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.we__secTitle {
  font-size: 30rpx;
  font-weight: 700;
}

.we__secTip {
  font-size: 22rpx;
  color: var(--we-ink-3);
}

/* ===== 选项行 ===== */

.we__item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--we-line);
}

.we__itemTop {
  display: flex;
  align-items: center;
}

.we__swatch {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  margin-right: 14rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
}

.we__iconBtn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--we-accent-soft);
  color: var(--we-accent);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
}

.we__text {
  flex: 1;
  height: 64rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  background: var(--we-accent-soft);
  font-size: 27rpx;
}

.we__w {
  min-width: 64rpx;
  height: 64rpx;
  margin-left: 12rpx;
  border-radius: 16rpx;
  background: var(--we-accent-soft);
  color: var(--we-accent);
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.we__del {
  width: 56rpx;
  height: 64rpx;
  margin-left: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--we-ink-3);
  font-size: 30rpx;
}

.we__itemBtm {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  padding-left: 58rpx;
}

.we__mv {
  margin-right: 24rpx;
  font-size: 23rpx;
  color: var(--we-ink-3);
}

.we__tag {
  font-size: 20rpx;
  color: var(--we-accent);
  background: var(--we-accent-soft);
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.we__add {
  width: 100%;
  margin-top: 20rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: var(--we-accent-soft);
  color: var(--we-accent);
  font-size: 27rpx;
}

.we__empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--we-ink-3);
}

.we__pad {
  height: 280rpx;
}

/* ===== 底部 dock ===== */

.we__dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--we-card);
  box-shadow: 0 -6rpx 24rpx rgba(90, 70, 45, 0.10);
}

.we__dockRow {
  display: flex;
  margin-bottom: 14rpx;
}

.we__dockBtn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  margin: 0 6rpx;
  border-radius: 999rpx;
  background: var(--we-accent-soft);
  color: var(--we-accent);
  font-size: 25rpx;
}

.we__dockBtn--main {
  height: 88rpx;
  line-height: 88rpx;
  background: var(--we-accent);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  margin: 0;
}

.we__dockBtn--danger {
  color: var(--we-danger);
}

/* ===== 浮层 ===== */

.we__mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: var(--we-mask);
  display: flex;
  align-items: flex-end;
  z-index: 50;
}

.we__sheet {
  width: 100%;
  max-height: 1000rpx;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: var(--we-bg);
  display: flex;
  flex-direction: column;
}

.we__sheetHead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.we__sheetTitle {
  font-size: 32rpx;
  font-weight: 700;
}

.we__x {
  font-size: 32rpx;
  color: var(--we-ink-3);
  padding: 8rpx 12rpx;
}

.we__grid {
  display: flex;
  flex-wrap: wrap;
  max-height: 560rpx;
  overflow-y: auto;
}

.we__gridItem {
  width: 20%;
  height: 96rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.we__grid--color {
  padding: 8rpx 0;
}

.we__colorItem {
  width: 20%;
  height: 96rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.we__colorItem::after {
  content: '';
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: inherit;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.15);
}

.we__textarea {
  width: 100%;
  height: 300rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: var(--we-card);
  font-size: 27rpx;
  box-sizing: border-box;
}

.we__sheetBtns {
  display: flex;
  margin-top: 20rpx;
}

.we__sbtn {
  flex: 1;
  margin: 0 8rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  background: var(--we-card);
  color: var(--we-ink-2);
  font-size: 28rpx;
}

.we__sbtn--main {
  background: var(--we-accent);
  color: #FFFFFF;
}

.we__todoList {
  max-height: 620rpx;
}

.we__todo {
  display: flex;
  align-items: center;
  padding: 20rpx 22rpx;
  margin-bottom: 14rpx;
  border-radius: 20rpx;
  background: var(--we-card);
}

.we__check {
  width: 40rpx;
  height: 40rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  border: 2rpx solid var(--we-line);
}

.we__check.is-on {
  background: var(--we-accent);
  border-color: var(--we-accent);
}

.we__todoMain {
  flex: 1;
  min-width: 0;
}

.we__todoText {
  font-size: 27rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.we__todoMeta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--we-ink-3);
}
