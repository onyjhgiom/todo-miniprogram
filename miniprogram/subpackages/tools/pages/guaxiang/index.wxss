/* pages/guaxiang/index.wxss */
.page {
  min-height: 100vh;
  background: var(--color-bg, #f5f6fb);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ==================== 头部 ==================== */
.head { padding: 0 0 8rpx; }
.head__bar {
  position: relative;
  padding: 48rpx 32rpx 44rpx;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
  color: #fff;
  overflow: hidden;
}
.head__bar::before {
  content: '';
  position: absolute;
  top: -40rpx; right: -40rpx;
  width: 200rpx; height: 200rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
}
.head__bar::after {
  content: '';
  position: absolute;
  bottom: -30rpx; left: -20rpx;
  width: 140rpx; height: 140rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
}

/* 装饰线 */
.head__decor {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.head__line {
  width: 48rpx;
  height: 2rpx;
  background: rgba(255,255,255,0.35);
  border-radius: 2rpx;
}
.head__dot {
  width: 10rpx;
  height: 10rpx;
  background: rgba(255,255,255,0.5);
  border-radius: 50%;
}

.head__title {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.15);
}
.head__sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.82;
  letter-spacing: 1rpx;
}

.body { flex: 1; padding: 28rpx 24rpx 0; box-sizing: border-box; }

/* ==================== 区块 ==================== */
.sec { margin-bottom: 28rpx; }

.sec__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.sec__title {
  font-size: 29rpx;
  color: var(--color-text, #334155);
  font-weight: 600;
  margin: 0;
}
.sec__optional {
  font-weight: 400;
  color: var(--color-text-mute, #94a3b8);
  font-size: 25rpx;
  margin-left: 6rpx;
}
.sec__badge {
  font-size: 22rpx;
  color: #b45309;
  background: rgba(180,83,9,0.10);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 500;
}
.sec__note {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-mute, #94a3b8);
  margin: 14rpx 4rpx 0;
}
.sec__hint {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-mute, #94a3b8);
  margin-top: 12rpx;
  padding-left: 4rpx;
}

/* ==================== 起卦方式卡片 ==================== */
.methods {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}
.method {
  position: relative;
  background: var(--color-card, #fff);
  border-radius: 20rpx;
  padding: 28rpx 24rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border: 2rpx solid transparent;
  display: flex;
  flex-direction: column;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  overflow: hidden;
}
.method::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4rpx;
  background: transparent;
  border-radius: 20rpx 20rpx 0 0;
  transition: background 0.2s ease;
}

.method.is-on {
  border-color: rgba(180, 83, 9, 0.25);
  background: linear-gradient(180deg, rgba(180,83,9,0.06) 0%, #fff 40%);
  box-shadow: 0 4rpx 20rpx rgba(180, 83, 9, 0.12), 0 1rpx 4rpx rgba(0,0,0,0.03);
  transform: translateY(-2rpx);
}
.method.is-on::before {
  background: linear-gradient(90deg, #b45309, #d97706);
}

.method__icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: var(--color-bg-soft, #f7f8fc);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  transition: background 0.2s ease;
}
.method.is-on .method__icon-wrap {
  background: rgba(180, 83, 9, 0.12);
}
.method__icon { font-size: 36rpx; }
.method__label {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text, #1f2937);
  letter-spacing: 1rpx;
}
.method__desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-text-mute, #94a3b8);
}

/* 选中勾选 */
.method__check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #b45309, #d97706);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(180, 83, 9, 0.3);
}
.method__check-icon {
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
}

/* ==================== 数字输入 ==================== */
.numrow { display: flex; align-items: center; gap: 16rpx; }
.numinput-wrap {
  flex: 1;
  position: relative;
}
/* ⚠️ 原生 <input> 必须显式定高：box-sizing: border-box + 24rpx 竖向 padding
 * 会把 input 自带的默认高度（约 1.4rem）吃成负值，占位文字完全不可见。 */
.numinput {
  width: 100%;
  height: 88rpx;
  background: var(--color-card, #fff);
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text, #1f2937);
  box-sizing: border-box;
  border: 2rpx solid var(--color-border, #e8eaf0);
  transition: border-color 0.2s ease;
}
.numinput:focus {
  border-color: #b45309;
}
.numrow__plus {
  font-size: 28rpx;
  color: var(--color-text-mute, #94a3b8);
  font-weight: 300;
}

/* ==================== 心境标签 ==================== */
.chips { display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: var(--color-card, #fff);
  font-size: 25rpx;
  color: var(--color-text-soft, #64748b);
  border: 2rpx solid transparent;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.03);
  transition: all 0.2s ease;
}
.chip__icon { font-size: 26rpx; line-height: 1; }
.chip__label { font-size: 25rpx; }

.chip.is-on {
  background: linear-gradient(135deg, rgba(180,83,9,0.10), rgba(217,119,6,0.08));
  color: #b45309;
  border-color: rgba(180, 83, 9, 0.25);
  box-shadow: 0 2rpx 10rpx rgba(180, 83, 9, 0.10);
  font-weight: 500;
}
.chip--history {
  padding: 12rpx 20rpx;
  background: var(--color-bg-soft, #f7f8fc);
}
.chip--history .chip__sub {
  font-size: 20rpx;
  color: var(--color-text-mute, #94a3b8);
  margin-left: 6rpx;
}

/* ==================== 起卦按钮 ==================== */
.cast-wrap {
  padding: 10rpx 0 24rpx;
}
.cast {
  position: relative;
  text-align: center;
  border-radius: 20rpx;
  overflow: hidden;
  padding: 32rpx 0;
  cursor: pointer;
}
.cast__text {
  position: relative;
  z-index: 1;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #fff;
}
.cast__glow {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #b45309 0%, #d97706 50%, #f59e0b 100%);
  transition: opacity 0.3s ease, transform 0.3s ease;
}
.cast__glow::after {
  content: '';
  position: absolute;
  top: -50%; left: -50%;
  width: 200%; height: 200%;
  background: radial-gradient(circle at center, rgba(255,255,255,0.15) 0%, transparent 60%);
  animation: cast-pulse 3s ease-in-out infinite;
}
@keyframes cast-pulse {
  0%, 100% { transform: scale(0.95); opacity: 0.5; }
  50% { transform: scale(1.05); opacity: 1; }
}

.cast--active {
  transform: scale(0.97);
}
.cast--active .cast__glow {
  opacity: 0.85;
}

/* ==================== 结果卡 ==================== */
.card {
  background: var(--color-card, #fff);
  border-radius: 24rpx;
  padding: 32rpx 28rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.05);
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(0,0,0,0.03);
}

.res__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--color-border, #f0f1f5);
}
.res__name-wrap {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.res__name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text, #1f2937);
  letter-spacing: 3rpx;
}
.res__num {
  font-size: 24rpx;
  color: var(--color-text-mute, #94a3b8);
  background: var(--color-bg-soft, #f7f8fc);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

/* ==================== 卦画 ==================== */
.gua-section {
  margin-bottom: 26rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #fafbfD, #f7f8fc);
  border-radius: 16rpx;
  border: 1rpx solid rgba(0,0,0,0.04);
}
.gua-section__title {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-mute, #94a3b8);
  margin-bottom: 16rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.gua { margin: 0; }
.gua__row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  min-height: 36rpx;
}
.gua__idx {
  width: 36rpx;
  font-size: 20rpx;
  color: var(--color-text-mute, #c0c8d4);
  text-align: center;
  font-weight: 500;
  flex-shrink: 0;
}
.gua__idx--empty {
  color: transparent;
}
.gua__bars {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  gap: 0;
}
.gua__bar {
  height: 20rpx;
  border-radius: 6rpx;
  background: var(--color-text, #334155);
  transition: background 0.3s ease;
}
.gua__bar--yang { width: 220rpx; }
.gua__bar--yin { width: 94rpx; }
.gua__bar--gap { width: 24rpx; flex-shrink: 0; }
.gua__bar.is-moving {
  background: linear-gradient(90deg, #d97706, #f59e0b);
  box-shadow: 0 0 12rpx rgba(217, 119, 6, 0.35);
}
.gua__mark {
  margin-left: 16rpx;
  font-size: 20rpx;
  color: #d97706;
  font-weight: 600;
  background: rgba(217, 119, 6, 0.10);
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

/* 变卦小号 */
.gua--sm { margin: 16rpx 0 14rpx; padding: 0; background: none; border: none; }
.gua--sm .gua__row { margin-bottom: 8rpx; min-height: 28rpx; }
.gua--sm .gua__bars { width: 160rpx; flex: none; }
.gua--sm .gua__bar { height: 12rpx; border-radius: 4rpx; }
.gua--sm .gua__bar--yang { width: 160rpx; }
.gua--sm .gua__bar--yin { width: 66rpx; }
.gua--sm .gua__bar--gap { width: 20rpx; }
.gua--sm .gua__idx { display: none; }

/* ==================== 文本块 ==================== */
.blk {
  margin-bottom: 26rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--color-border, #f3f4f6);
}
.blk:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }

.blk__header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
.blk__tag {
  font-size: 23rpx;
  color: #b45309;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.blk__tag-sub {
  font-size: 20rpx;
  color: var(--color-text-mute, #94a3b8);
  font-weight: 400;
}
.blk__tag--warn { color: #d97706; }
.blk__tag--mood { color: #7c3aed; }
.blk__tag--primary {
  color: #fff;
  background: linear-gradient(135deg, #b45309, #d97706);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.blk--cite { background: var(--color-bg-soft, #f7f8fc); border-radius: 14rpx; padding: 20rpx; margin-bottom: 24rpx; border: none; }
.blk--cite .blk__header { margin-bottom: 10rpx; }
.blk--moving { background: rgba(217,119,6,0.03); border-radius: 14rpx; padding: 20rpx; border: 1rpx solid rgba(217,119,6,0.08); }
.blk--mood { background: rgba(124,58,237,0.03); border-radius: 14rpx; padding: 20rpx; border: 1rpx solid rgba(124,58,237,0.06); }
.blk--guide { background: rgba(180,83,9,0.02); border-radius: 14rpx; padding: 20rpx; border: 1rpx solid rgba(180,83,9,0.06); }

.blk__cite {
  display: block;
  font-size: 27rpx;
  line-height: 1.8;
  color: var(--color-text, #1e293b);
  font-weight: 500;
}
.blk__text {
  display: block;
  font-size: 27rpx;
  line-height: 1.8;
  color: var(--color-text-soft, #475569);
}
.blk__text--opener {
  font-style: italic;
  color: var(--color-text-mute, #64748b);
  margin-bottom: 8rpx;
}

/* 动爻列表 */
.moving-list { display: flex; flex-direction: column; gap: 12rpx; }
.moving-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.moving-item__name {
  font-size: 25rpx;
  font-weight: 600;
  color: #d97706;
}
.moving-item__hint {
  font-size: 25rpx;
  line-height: 1.65;
  color: var(--color-text-soft, #475569);
}

/* ==================== 关键词 ==================== */
.kw-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--color-border, #e8eaf0);
}
.kw {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(180,83,9,0.08), rgba(217,119,6,0.05));
  color: #b45309;
  font-size: 23rpx;
  font-weight: 500;
  border: 1rpx solid rgba(180, 83, 9, 0.10);
}

/* ==================== 免责提示 ==================== */
.res__tip-wrap {
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  background: var(--color-bg-soft, #f7f8fc);
  border-radius: 12rpx;
  border-left: 4rpx solid #cbd5e1;
}
.res__tip {
  display: block;
  font-size: 22rpx;
  line-height: 1.65;
  color: var(--color-text-mute, #94a3b8);
}

/* ==================== 操作按钮 ==================== */
.acts {
  display: flex;
  gap: 14rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border, #f0f1f5);
}
.act {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 22rpx 0;
  border-radius: 14rpx;
  font-size: 25rpx;
  color: var(--color-text-soft, #64748b);
  background: var(--color-bg-soft, #f7f8fc);
  border: 1rpx solid var(--color-border, #e8eaf0);
  transition: all 0.15s ease;
}
.act--primary {
  color: #b45309;
  background: rgba(180, 83, 9, 0.06);
  border-color: rgba(180, 83, 9, 0.15);
  font-weight: 500;
}
.act__icon { font-size: 26rpx; line-height: 1; }
.act__text { font-size: 25rpx; }

/* ==================== 底部安全区 ==================== */
.safe-bottom { height: 40rpx; }

/* ==================== 底部永久免责 ==================== */
.disclaimer {
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  font-size: 22rpx;
  line-height: 1.65;
  color: var(--color-text-mute, #94a3b8);
  text-align: center;
  background: var(--color-bg-elevated, #eef1f7);
  border-top: 1rpx solid var(--color-border, #eef0f6);
  letter-spacing: 0.5rpx;
}

/* ==================== 交互态 ==================== */
.press { opacity: 0.65; transform: scale(0.98); }
.chip-press { opacity: 0.75; transform: scale(0.96); }

/* 滑入动画（数字输入面板） */
.sec--slide-in {
  animation: slideDown 0.25s ease-out;
}
@keyframes slideDown {
  from { opacity: 0; transform: translateY(-12rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 舞台层配合：fx-stage 为 position:fixed，需把内容容器抬到其上，
   否则卷首 / 正文 / 免责条会被氛围层盖住。 */
.head,
.body,
.disclaimer {
  position: relative;
  z-index: 1;
}

/* ============================================================
 * 【东方玄学】卦象模块 · 视觉体系
 * ------------------------------------------------------------
 * 这一页不做通用 UI，而是一方「宣纸卷轴」：
 *   · 底色    绢帛宣纸（暖黄纤维）
 *   · 主墨    深墨 · 辅墨淡烟
 *   · 朱砂    印章红 —— 唯一的强强调色，只用在「定」的地方（卦名、动爻、印章）
 *   · 旧金    次要点缀（卦序、装饰线）
 *   · 语汇    八卦符侧栏、朱砂印、联珠纹、宣纸暗纹、竖排题签、笔锋分隔
 *   · 动势    墨轮缓旋 / 印章落盖 / 卦画逐爻浮现 / 结果区如展卷般展开
 *
 * 兼容：所有颜色都是变量，深色主题单独给一组；不涉及任何结构调整，
 *       因此不影响既有交互逻辑与数据绑定。
 * ============================================================ */

.gx {
  --gx-paper: #F7F1E4;          /* 宣纸 */
  --gx-paper-2: #EFE6D2;        /* 绢帛暗部 */
  --gx-ink: #241F1A;            /* 深墨 */
  --gx-ink-2: #574D40;          /* 淡烟墨 */
  --gx-ink-3: #8B7F6C;          /* 极淡批注 */
  --gx-cinnabar: #B02A26;       /* 朱砂 / 印泥红 */
  --gx-cinnabar-2: #D1493F;
  --gx-cinnabar-soft: rgba(176, 42, 38, .12);
  --gx-gold: #B08B4F;           /* 旧金 */
  --gx-jade: #43655A;           /* 黛青 */

  /* 宣纸：一层高光晕 + 一层暖金晕 + 一道自上而下的柔和受光 */
  background:
    radial-gradient(96% 52% at 8% -10%, rgba(255, 253, 246, .9), rgba(0, 0, 0, 0) 62%),
    radial-gradient(80% 46% at 96% 0%, rgba(191, 158, 96, .1), rgba(0, 0, 0, 0) 60%),
    linear-gradient(180deg, var(--gx-paper) 0%, var(--gx-paper-2) 100%);
}
.themed[data-theme='dark'] .gx,
.themed[data-theme='rose'] .gx {
  --gx-paper: #221E19;
  --gx-paper-2: #171412;
  --gx-ink: #EDE4D2;
  --gx-ink-2: #B7A88F;
  --gx-ink-3: #8A7C66;
  --gx-cinnabar: #D8564C;
  --gx-cinnabar-2: #E97A6E;
  --gx-cinnabar-soft: rgba(216, 86, 76, .16);
  --gx-gold: #C9A25E;
  --gx-jade: #7FA396;
}

/* ---------- 卷首：绢帛标题区 ---------- */
.head__bar {
  position: relative;
  overflow: hidden;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow:
    0 20rpx 44rpx rgba(36, 31, 26, .2),
    inset 0 -3rpx 0 rgba(176, 42, 38, .22);
}
/* 联珠纹：卷首下缘的一圈传统联珠装饰带 */
.head__bar::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 20rpx;
  background-image: radial-gradient(circle at 10rpx 10rpx, rgba(255, 255, 255, .32) 5rpx, rgba(255, 255, 255, 0) 6rpx);
  background-size: 20rpx 20rpx;
  opacity: .55;
  pointer-events: none;
}
.head__title {
  position: relative;
  z-index: 2;
  letter-spacing: 6rpx;
  text-shadow: 0 4rpx 14rpx rgba(36, 31, 26, .4);
}
.head__sub { position: relative; z-index: 2; }

/* 朱砂印：右上角一枚传统阳文方印 */
.gx-seal {
  position: absolute;
  right: 36rpx;
  top: 28rpx;
  z-index: 3;
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  color: #FFF3EC;
  background: linear-gradient(140deg, var(--gx-cinnabar-2), var(--gx-cinnabar));
  border-radius: 14rpx;
  box-shadow:
    0 8rpx 20rpx rgba(176, 42, 38, .38),
    inset 0 0 0 3rpx rgba(255, 255, 255, .42),
    inset 0 2rpx 0 rgba(255, 255, 255, .3);
  transform: rotate(-6deg);
  animation: gx-seal-breathe 5.6s ease-in-out infinite;
  pointer-events: none;
}
@keyframes gx-seal-breathe {
  0%, 100% { transform: rotate(-6deg) scale(1); }
  50% { transform: rotate(-5deg) scale(1.05); }
}

/* ---------- 区块题签：竖排朱线 + 题名 ---------- */
.sec__title {
  position: relative;
  padding-left: 22rpx;
  color: var(--gx-ink);
  font-weight: 600;
  letter-spacing: 2rpx;
}
.sec__title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 6rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, var(--gx-cinnabar), var(--gx-cinnabar-2));
  box-shadow: 0 0 10rpx rgba(176, 42, 38, .4);
}
.sec__badge {
  border: 2rpx solid rgba(176, 138, 79, .45);
  color: var(--gx-gold);
  background: rgba(176, 138, 79, .1);
}
.sec__hint,
.sec__note { color: var(--gx-ink-3); }

/* ---------- 起卦方式：玉牌 ---------- */
.method {
  position: relative;
  overflow: hidden;
  border-radius: 26rpx;
  background: linear-gradient(165deg, rgba(255, 253, 246, .96), var(--gx-paper-2));
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, .85),
    0 8rpx 22rpx rgba(36, 31, 26, .08),
    0 0 0 1rpx rgba(36, 31, 26, .07);
  transition: transform 280ms cubic-bezier(.16, .84, .28, 1), box-shadow 280ms ease;
}
/* 选中：朱砂描环 + 抬升，像被朱笔点定 */
.method.is-on {
  border-color: transparent;
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, .85),
    0 16rpx 34rpx rgba(176, 42, 38, .18),
    0 0 0 3rpx var(--gx-cinnabar-soft),
    0 0 0 5rpx rgba(176, 42, 38, .16);
  transform: translate3d(0, -4rpx, 0);
}
.method__check {
  background: linear-gradient(140deg, var(--gx-cinnabar-2), var(--gx-cinnabar));
  box-shadow: 0 6rpx 14rpx rgba(176, 42, 38, .4), inset 0 2rpx 0 rgba(255, 255, 255, .35);
}
.method__icon-wrap {
  filter: drop-shadow(0 2rpx 4rpx rgba(36, 31, 26, .12));
}
.method__label { color: var(--gx-ink); }
.method__desc { color: var(--gx-ink-2); }

/* 心境 chip：未选中如宣纸，选中如朱砂 */
.chip {
  border-radius: 999rpx;
  background: rgba(255, 253, 246, .9);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .8), 0 0 0 1rpx rgba(36, 31, 26, .07);
  transition: all 240ms cubic-bezier(.16, .84, .28, 1);
}
.chip.is-on {
  background: linear-gradient(140deg, var(--gx-cinnabar-2), var(--gx-cinnabar));
  color: #FFF3EC;
  box-shadow: 0 8rpx 20rpx rgba(176, 42, 38, .32), inset 0 2rpx 0 rgba(255, 255, 255, .32);
}

/* ---------- 起卦按钮：落一枚朱砂大印 ---------- */
.cast {
  position: relative;
  overflow: hidden;
  border-radius: 20rpx;
  background: linear-gradient(140deg, var(--gx-cinnabar-2), var(--gx-cinnabar) 62%, #8E1F1C);
  box-shadow:
    0 18rpx 40rpx rgba(176, 42, 38, .38),
    inset 0 0 0 3rpx rgba(255, 255, 255, .38),
    inset 0 3rpx 0 rgba(255, 255, 255, .34);
}
.cast__text {
  position: relative;
  z-index: 2;
  color: #FFF6EF;
  letter-spacing: 10rpx;
  font-weight: 700;
  text-shadow: 0 4rpx 12rpx rgba(90, 16, 14, .5);
}
/* 印面的一道高光扫过 */
.cast__glow {
  background: linear-gradient(100deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, .45), rgba(255, 255, 255, 0));
  transform: skewX(-18deg);
}
/* 落印手感 */
.cast--active {
  transform: translate3d(0, 4rpx, 0) scale(.975);
  box-shadow:
    0 8rpx 18rpx rgba(176, 42, 38, .3),
    inset 0 0 0 3rpx rgba(255, 255, 255, .3);
}

/* ---------- 结果：宣纸卷轴 ---------- */
.result {
  position: relative;
  overflow: hidden;
  border-radius: 34rpx;
  background: linear-gradient(170deg, #FFFDF6 0%, var(--gx-paper) 42%, var(--gx-paper-2) 100%);
  box-shadow:
    0 26rpx 60rpx rgba(36, 31, 26, .16),
    inset 0 2rpx 0 rgba(255, 255, 255, .9),
    0 0 0 1rpx rgba(36, 31, 26, .07);
  animation: gx-scroll-open .68s cubic-bezier(.16, .84, .28, 1) both;
}
/* 展卷：从上而下缓缓铺开 */
@keyframes gx-scroll-open {
  from { opacity: 0; transform: translate3d(0, 26rpx, 0) scaleY(.97); }
  to { opacity: 1; transform: translate3d(0, 0, 0) scaleY(1); }
}

/* 八卦侧栏：results 卡片右侧的一列暗纹卦符 */
.gx-trigrams {
  position: absolute;
  right: 14rpx;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  padding: 30rpx 0;
  pointer-events: none;
  z-index: 0;
}
.gx-trigrams__i {
  font-size: 34rpx;
  color: var(--gx-ink);
  opacity: .07;
  line-height: 1.2;
  letter-spacing: 0;
}

/* 卦名：竖向朱线 + 大号题名，配一枚小小的朱砂序号印 */
.res__head { position: relative; z-index: 1; }
.res__name {
  color: var(--gx-ink);
  font-weight: 700;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 6rpx rgba(36, 31, 26, .1);
}
.res__num {
  color: var(--gx-gold);
  border: 2rpx solid rgba(176, 138, 79, .4);
  background: rgba(176, 138, 79, .1);
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  letter-spacing: 1rpx;
}

/* 卦画：爻条从宣纸里「浮」出来 */
.gua-section {
  position: relative;
  z-index: 1;
}
.gua-section__title {
  color: var(--gx-ink-2);
  letter-spacing: 3rpx;
  position: relative;
  padding-bottom: 10rpx;
}
/* 笔锋分隔：一道中间实、两端飞白的墨线 */
.gua-section__title::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(36, 31, 26, 0), rgba(36, 31, 26, .22) 20%, rgba(36, 31, 26, .22) 80%, rgba(36, 31, 26, 0));
}
.gua__row { animation: gx-yao 0.5s cubic-bezier(.16, .84, .28, 1) both; }
.gua__row:nth-child(1) { animation-delay: .32s; }
.gua__row:nth-child(2) { animation-delay: .26s; }
.gua__row:nth-child(3) { animation-delay: .2s; }
.gua__row:nth-child(4) { animation-delay: .14s; }
.gua__row:nth-child(5) { animation-delay: .08s; }
.gua__row:nth-child(6) { animation-delay: .02s; }
@keyframes gx-yao {
  from { opacity: 0; transform: translate3d(-18rpx, 0, 0); }
  to { opacity: 1; transform: translate3d(0, 0, 0); }
}
/* 阳爻：实心墨条；阴爻：断墨。动爻：朱砂描边 */
.gua__bar--yang,
.gua__bar--yin {
  background: var(--gx-ink);
  box-shadow: 0 2rpx 6rpx rgba(36, 31, 26, .22);
  border-radius: 3rpx;
}
.gua__bar.is-moving {
  background: linear-gradient(140deg, var(--gx-cinnabar-2), var(--gx-cinnabar));
  box-shadow: 0 0 14rpx rgba(176, 42, 38, .5), 0 2rpx 6rpx rgba(176, 42, 38, .3);
}
.gua__idx { color: var(--gx-gold); }
.gua__mark {
  color: var(--gx-cinnabar);
  font-weight: 700;
}

/* ---------- 文块：古籍引文的批处理 ---------- */
.blk {
  position: relative;
  z-index: 1;
  background: rgba(255, 253, 246, .72);
  border-radius: 22rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .85), 0 0 0 1rpx rgba(36, 31, 26, .06);
  transition: box-shadow 240ms ease;
}
/* 古籍原文：左侧一道朱线，像宣纸上的句读 */
.blk--cite {
  border-left: 4rpx solid var(--gx-cinnabar);
  background: linear-gradient(100deg, var(--gx-cinnabar-soft), rgba(255, 253, 246, .72) 40%);
}
.blk__tag {
  color: var(--gx-ink);
  font-weight: 700;
  letter-spacing: 2rpx;
}
.blk__tag-sub { color: var(--gx-ink-3); }
.blk__tag--warn { color: var(--gx-cinnabar); }
.blk__tag--primary { color: var(--gx-jade); }
.blk__tag--mood { color: var(--gx-gold); }
.blk__cite {
  color: var(--gx-ink);
  font-family: var(--font-serif, 'Songti SC', serif);
  letter-spacing: 1.5rpx;
  line-height: 1.9;
}
.blk__text { color: var(--gx-ink-2); line-height: 1.85; }
.blk__text--opener { color: var(--gx-ink); font-weight: 600; }
/* 动爻 / 人生疏导：给块加一点主题光晕聚焦 */
.blk--moving { background: linear-gradient(120deg, var(--gx-cinnabar-soft), rgba(255, 253, 246, .72) 46%); }
.blk--guide { background: linear-gradient(120deg, rgba(67, 101, 90, .1), rgba(255, 253, 246, .72) 46%); }
.blk--mood { background: linear-gradient(120deg, rgba(176, 138, 79, .12), rgba(255, 253, 246, .72) 46%); }

/* ---------- 关键词：朱砂小印 ---------- */
.kw {
  color: var(--gx-cinnabar);
  border: 2rpx solid rgba(176, 42, 38, .32);
  background: var(--gx-cinnabar-soft);
  border-radius: 8rpx;
  letter-spacing: 1rpx;
}

/* ---------- 操作：宣纸按扣 ---------- */
.act {
  border-radius: 18rpx;
  background: rgba(255, 253, 246, .92);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .9), 0 6rpx 16rpx rgba(36, 31, 26, .08), 0 0 0 1rpx rgba(36, 31, 26, .07);
  transition: transform 220ms cubic-bezier(.34, 1.56, .64, 1);
}
.act--primary {
  background: linear-gradient(140deg, var(--gx-cinnabar-2), var(--gx-cinnabar));
  box-shadow: 0 10rpx 24rpx rgba(176, 42, 38, .3), inset 0 2rpx 0 rgba(255, 255, 255, .32);
}
.act--primary .act__text,
.act--primary .act__icon { color: #FFF6EF; }

/* ---------- 免责：淡淡的批注语 ---------- */
.res__tip,
.disclaimer { color: var(--gx-ink-3); }
.disclaimer {
  background: rgba(255, 253, 246, .92);
  box-shadow: 0 -6rpx 20rpx rgba(36, 31, 26, .08);
}

/* ---------- 历史 chip：如旧签文 ---------- */
.chip--history {
  border-radius: 14rpx;
  background: rgba(255, 253, 246, .9);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .85), 0 0 0 1rpx rgba(36, 31, 26, .07);
}
.chip__sub { color: var(--gx-ink-3); }

/* ---------- 数字输入：宣纸格 ---------- */
.numinput-wrap {
  border-radius: 18rpx;
  background: rgba(255, 253, 246, .95);
  box-shadow: inset 0 2rpx 6rpx rgba(36, 31, 26, .08), 0 0 0 1rpx rgba(36, 31, 26, .07);
}
.numrow__plus { color: var(--gx-cinnabar); }
