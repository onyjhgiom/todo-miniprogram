/* pages/guaxiang/library.wxss */
.page {
  min-height: 100vh;
  background: var(--color-bg, #f5f6fb);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.head { padding: 0 0 8rpx; }
.head__bar {
  padding: 36rpx 32rpx 40rpx;
  border-bottom-left-radius: 28rpx;
  border-bottom-right-radius: 28rpx;
  color: #fff;
}
.head__title { font-size: 44rpx; font-weight: 600; letter-spacing: 4rpx; }
.head__sub { display: block; margin-top: 10rpx; font-size: 24rpx; opacity: 0.86; }

.body { flex: 1; padding: 24rpx 24rpx 0; box-sizing: border-box; }

/* 搜索 */
.search {
  display: flex;
  align-items: center;
  background: var(--color-card, #fff);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx var(--color-primary-shadow, rgba(99,102,241,0.10));
}
.search__input { flex: 1; font-size: 27rpx; color: var(--color-text, #1f2937); }
.search__clear { padding-left: 18rpx; font-size: 26rpx; color: var(--color-text-mute, #94a3b8); }

/* 宫格 */
.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18rpx; }
.cell {
  background: var(--color-card, #fff);
  border-radius: 16rpx;
  padding: 24rpx 12rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 14rpx var(--color-primary-shadow, rgba(99,102,241,0.08));
  display: flex; flex-direction: column; align-items: center;
}
.cell--hover { transform: scale(0.96); opacity: 0.9; }
.cell__num { font-size: 20rpx; color: var(--color-text-mute, #94a3b8); }
.cell__name { margin-top: 8rpx; font-size: 34rpx; font-weight: 600; color: #b45309; letter-spacing: 2rpx; }
.cell__nature { margin-top: 6rpx; font-size: 20rpx; color: var(--color-text-mute, #94a3b8); }

.empty { padding: 80rpx 0; text-align: center; font-size: 26rpx; color: var(--color-text-mute, #94a3b8); }

.safe-bottom { height: 40rpx; }

.disclaimer {
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-text-mute, #94a3b8);
  text-align: center;
  background: var(--color-bg-elevated, #eef1f7);
  border-top: 1rpx solid var(--color-border, #eef0f6);
}

.press { opacity: 0.7; }
