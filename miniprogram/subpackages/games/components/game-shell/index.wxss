@import "/styles/themes.wxss";

.gs { display: flex; flex-direction: column; min-height: 100vh; background: var(--paper); }
.gs__head {
  position: relative; overflow: hidden;
  padding: 20rpx 28rpx 22rpx;
  background: linear-gradient(160deg, #FFFCF3 0%, #FBF1E1 100%);
  border-bottom: 2rpx solid var(--line);
}
.gs__top { gap: 16rpx; }
.gs__back, .gs__pause { width: 44rpx; height: 44rpx; color: var(--ink-2); flex: 0 0 auto; }
.gs__pause { font-size: 0; }
.gs__pause::before, .gs__pause::after { font-size: 0; }
.gs__title { flex: 1; font-size: 34rpx; text-align: center; color: var(--ink); }
.gs__meta { margin-top: 14rpx; }
.gs__metaItem { gap: 8rpx; color: var(--clay); }
.gs__stat { color: var(--mint-deep); }

.gs__body { flex: 1; padding: 28rpx; display: flex; flex-direction: column; }

.gs__foot {
  display: flex; gap: 18rpx; padding: 18rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card); border-top: 2rpx solid var(--line);
}
.gs__btn {
  flex: 1; height: 84rpx; border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  font-size: 26rpx; font-weight: 600;
}
.gs__btn--ghost { background: var(--card-2); color: var(--ink-2); border: 2rpx solid var(--line); }
.gs__btn--primary { background: linear-gradient(135deg, #8C6444, #BB8C5C); color: #FFF8EC; box-shadow: 0 8rpx 20rpx rgba(140,100,68,.28); }
.gs__btn:active { transform: scale(.97); opacity: .9; }

/* ===== 通关庆祝层 ===== */
.gs__win {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 50;
  display: flex; align-items: center; justify-content: center; padding: 48rpx;
  background: rgba(58, 50, 42, .42);
  backdrop-filter: blur(6rpx); -webkit-backdrop-filter: blur(6rpx);
  animation: gsWinFade .22s ease-out both;
}
@keyframes gsWinFade { from { opacity: 0; } to { opacity: 1; } }

.gs__winCard {
  position: relative; overflow: hidden;
  width: 100%; max-width: 580rpx;
  padding: 44rpx 40rpx 36rpx;
  display: flex; flex-direction: column; align-items: center;
  border-radius: var(--r-lg);
  border: 2rpx solid var(--line-2);
  box-shadow: var(--sd-2);
  animation: gsWinPop .34s cubic-bezier(.22, 1, .36, 1) both;
}
@keyframes gsWinPop {
  from { opacity: 0; transform: translateY(40rpx) scale(.9); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* 顶部柔光：庆祝呼吸感 */
.gs__winGlow {
  position: absolute; top: -140rpx; left: 50%; margin-left: -180rpx;
  width: 360rpx; height: 360rpx; border-radius: 50%; pointer-events: none;
  background: radial-gradient(circle, rgba(201,162,94,.34), rgba(201,162,94,0) 68%);
  animation: gsWinBreathe 2.4s ease-in-out infinite;
}
@keyframes gsWinBreathe {
  0%, 100% { transform: scale(1); opacity: .75; }
  50%      { transform: scale(1.18); opacity: .35; }
}

.gs__winBadge {
  position: relative; width: 108rpx; height: 108rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #C9A25E, #E2C48C);
  box-shadow: 0 10rpx 26rpx rgba(201,162,94,.42);
  animation: gsWinBadge .5s cubic-bezier(.22, 1.4, .4, 1) both;
}
@keyframes gsWinBadge {
  from { opacity: 0; transform: rotate(-28deg) scale(.4); }
  to   { opacity: 1; transform: rotate(0) scale(1); }
}
.gs__winBadgeTxt { font-size: 40rpx; font-weight: 700; color: #FFF8EC; letter-spacing: 2rpx; }

.gs__winTitle {
  margin-top: 24rpx; font-size: 52rpx; color: var(--clay); letter-spacing: 4rpx;
}
.gs__winSub { margin-top: 10rpx; text-align: center; }

.gs__winStats {
  margin-top: 30rpx; width: 100%;
  display: flex; gap: 16rpx;
}
.gs__winStat {
  flex: 1; padding: 20rpx 10rpx; border-radius: var(--r-md);
  background: var(--card-2); border: 2rpx solid var(--line);
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
}
.gs__winStatVal { font-size: 40rpx; color: var(--ink); }
.gs__winStatLbl { letter-spacing: 1rpx; }

.gs__winBest {
  margin-top: 20rpx; padding: 10rpx 26rpx; border-radius: 999rpx;
  background: var(--gold-soft); color: #9C7F3F;
  animation: gsWinBreathe 1.8s ease-in-out infinite;
}

.gs__winQuote {
  margin-top: 24rpx; text-align: center; line-height: 1.7; color: var(--ink-2);
}

.gs__winBtns {
  margin-top: 34rpx; width: 100%; display: flex; gap: 18rpx;
}
.gs__winBtn {
  flex: 1; height: 84rpx; border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 27rpx; font-weight: 600;
}
.gs__winBtn--ghost { background: var(--card-2); color: var(--ink-2); border: 2rpx solid var(--line); }
.gs__winBtn--primary {
  background: linear-gradient(135deg, #8C6444, #BB8C5C); color: #FFF8EC;
  box-shadow: 0 8rpx 20rpx rgba(140,100,68,.28);
}
.gs__winBtn:active { transform: scale(.97); opacity: .9; }

/* ===== 失败层（可选） ===== */
.gs__fail {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 50;
  display: flex; align-items: center; justify-content: center; padding: 48rpx;
  background: rgba(58, 50, 42, .38);
  backdrop-filter: blur(4rpx); -webkit-backdrop-filter: blur(4rpx);
  animation: gsWinFade .2s ease-out both;
}
.gs__failCard { padding-top: 40rpx; }
.gs__failBadge {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #9AA0A6, #6E7681);
  box-shadow: 0 6rpx 16rpx rgba(110, 118, 129, .3);
}
.gs__failBadgeTxt { font-size: 34rpx; font-weight: 700; color: #FFF8EC; letter-spacing: 2rpx; }
.gs__failHome { margin-top: 20rpx; text-align: center; text-decoration: underline; }
