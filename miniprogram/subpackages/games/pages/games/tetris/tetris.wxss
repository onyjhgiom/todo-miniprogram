.tt { display: flex; flex-direction: column; align-items: center; }
.tt__hud { width: 100%; max-width: 600rpx; }
.tt__board {
  margin-top: 20rpx; width: 100%; max-width: 600rpx; aspect-ratio: 1 / 2;
  background: var(--card); border-radius: var(--r-md); border: 2rpx solid var(--line);
  box-shadow: var(--sd-1); overflow: hidden;
}
.tt__cv { width: 100%; height: 100%; display: block; }
.tt__tip { margin-top: 18rpx; }
.tt__again {
  margin-top: 16rpx; width: 100%; max-width: 600rpx; height: 84rpx; border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #8C6444, #BB8C5C); color: #FFF8EC; font-weight: 600; font-size: 28rpx;
}
.tt__again:active { transform: scale(.97); }
