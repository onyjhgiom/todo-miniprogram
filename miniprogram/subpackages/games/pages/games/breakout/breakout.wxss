.bk { display: flex; flex-direction: column; align-items: center; gap: 18rpx; width: 100%; }

/* 关卡切换条 */
.bk__lv {
  width: 100%; max-width: 640rpx; gap: 16rpx;
  background: var(--card); border: 2rpx solid var(--line); border-radius: var(--r-lg);
  padding: 16rpx 20rpx;
}
.bk__lvb {
  width: 68rpx; height: 68rpx; flex: 0 0 auto; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 38rpx; color: var(--clay);
  background: var(--card-2); border: 2rpx solid var(--line);
}
.bk__lvb:active { transform: scale(.92); }
.bk__lvinfo { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }

.bk__stage {
  width: 100%; max-width: 640rpx; height: 820rpx; border-radius: var(--r-lg);
  background: var(--card); border: 2rpx solid var(--line); box-shadow: var(--sd-1); overflow: hidden;
}
.bk__cv { width: 100%; height: 100%; }
