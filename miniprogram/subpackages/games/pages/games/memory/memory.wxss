.mem { display: flex; flex-direction: column; align-items: center; gap: 24rpx; }
.mem__board {
  width: 100%; max-width: 620rpx; display: grid; gap: 16rpx;
}
.mem__cell {
  aspect-ratio: 1 / 1; border-radius: var(--r-md); background: var(--card-3);
  display: flex; align-items: center; justify-content: center; border: 2rpx solid var(--line);
  box-shadow: var(--sd-1); transition: transform .15s ease, background .15s ease;
}
.mem__cell:active { transform: scale(.95); }
.mem__cell--open { background: var(--card); border-color: var(--mint); }
.mem__sym { font-size: 56rpx; }
.mem__q { font-size: 44rpx; color: var(--ink-4); font-weight: 700; }
