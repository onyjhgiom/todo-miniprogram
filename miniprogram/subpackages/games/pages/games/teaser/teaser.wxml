<game-shell title="{{title}}" timeText="{{timeText}}" statText="{{'连击 ' + combo}}" paused="{{paused}}"
  win="{{win}}" winSub="{{winSub}}" winStats="{{winStats}}" winNewBest="{{winNewBest}}" winQuote="{{winQuote}}"
  bind:back="onBack" bind:reset="onReset" bind:hint="onHint" bind:home="onHome" bind:pause="onPause"
  bind:again="onAgain" bind:winhome="onWinHome">
  <view class="tz">
    <view class="row tz__diff">
      <view wx:for="{{diffs}}" wx:key="index"
        class="chip tz__dc {{diff === index ? 'chip--active' : ''}}" data-d="{{index}}" bindtap="selectDiff">{{item}}</view>
      <view class="tz__wrong" bindtap="toggleWrong">错题本 ({{wrongBook.length}})</view>
    </view>

    <view class="row row--between tz__prog">
      <text class="t-xs muted-2">进度 {{solved}} / {{total}}</text>
      <text class="t-xs muted-2">答满全部题目即通关</text>
    </view>

    <view class="tz__q card--flat">{{q}}</view>

    <view class="tz__answer {{locked ? (correct ? 'tz__answer--ok' : 'tz__answer--no') : ''}}">
      <input class="tz__input" value="{{input}}" focus="{{focusInput}}" disabled="{{locked}}"
        placeholder="写下你的答案…" placeholder-class="muted-3"
        confirm-type="done" bindinput="onInput" bindconfirm="submit" />
      <view wx:if="{{input && !locked}}" class="tz__clr" bindtap="onClear">×</view>
    </view>

    <view wx:if="{{locked && !correct}}" class="tz__ref">
      <text class="t-xs muted-2">参考答案</text>
      <text class="t-md serif">「{{answer}}」</text>
    </view>

    <view class="row tz__acts">
      <view class="tz__btn tz__btn--ghost {{locked ? 'tz__btn--dim' : ''}}" bindtap="giveUp">看答案</view>
      <view class="tz__btn tz__btn--primary {{locked ? 'tz__btn--dim' : ''}}" bindtap="submit">确定</view>
    </view>

    <view class="tz__msg tz__msg--{{msgType}}">{{message}}</view>

    <view wx:if="{{showWrong}}" class="tz__wb card--tint grain">
      <text class="t-lg serif heavy">错题本</text>
      <view wx:if="{{wrongBook.length === 0}}" class="t-sm muted-2 mt-16">还没有错题，继续加油！</view>
      <view wx:for="{{wrongBook}}" wx:key="qid" class="tz__wbitem mt-16">
        <text class="t-sm">{{item.q}}</text>
        <text class="t-xs muted-2 mt-8">答案：{{item.a}}</text>
      </view>
      <view wx:if="{{wrongBook.length}}" class="tz__wbclear" bindtap="clearWrong">清空错题本</view>
    </view>
  </view>
</game-shell>
