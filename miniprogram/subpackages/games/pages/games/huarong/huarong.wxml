<game-shell title="{{title}}" timeText="{{timeText}}" statText="{{statText}}" paused="{{paused}}"
  win="{{win}}" winSub="{{winSub}}" winStats="{{winStats}}" winNewBest="{{winNewBest}}" winQuote="{{winQuote}}"
  bind:back="onBack" bind:reset="onReset" bind:hint="onHint" bind:home="onHome" bind:pause="onPause"
  bind:again="onAgain" bind:winhome="onWinHome">
  <view class="hv" bindtouchstart="onTouchStart" catchtouchmove="onTouchMove" bindtouchend="onTouchEnd">
    <view class="row hv__bar">
      <view class="chip {{size===3?'chip--active':''}}" bindtap="pick3">3×3</view>
      <view class="chip {{size===4?'chip--active':''}}" bindtap="pick4">4×4</view>
    </view>

    <view class="row row--between hv__progressbar">
      <text class="t-xs muted-2">已归位 {{progress}}/{{size*size-1}}</text>
      <view class="hv__track">
        <view class="hv__fill" style="width: {{progressPct}}%;"></view>
      </view>
    </view>

    <view class="hv__board" style="{{boardPx ? 'width:' + boardPx + 'px;' : ''}}grid-template-columns: repeat({{size}}, 1fr);">
      <view wx:for="{{board}}" wx:key="index"
        class="hv__cell {{item===0?'hv__cell--blank':''}} {{item!==0 && item===index+1 ? 'hv__cell--placed' : ''}} {{solvedIndex===index ? 'hv__cell--done' : ''}} {{movedTo===index ? 'hv__cell--slide' : ''}} {{shakeIndex===index ? 'hv__cell--shake' : ''}}"
        style="{{cellPx ? 'width:' + cellPx + 'px;height:' + cellPx + 'px;' : ''}}"
        data-index="{{index}}" bindtap="onTapTile">
        <text wx:if="{{item!==0}}" class="hv__num serif" style="{{numPx ? 'font-size:' + numPx + 'px' : ''}}">{{item}}</text>
      </view>
    </view>

    <view class="hv__ctrls">
      <view class="hv__undo {{canUndo ? '' : 'hv__undo--disabled'}}" bindtap="onUndo">
        <text class="hv__undoIcon">↶</text>
        <text class="t-xs">撤销</text>
      </view>
      <view class="hv__dir">
        <view class="hv__d" bindtap="onDirTap" data-dr="-1" data-dc="0">
          <view class="hv__arrow hv__arrow--up"></view>
        </view>
        <view class="row">
          <view class="hv__d" bindtap="onDirTap" data-dr="0" data-dc="-1">
            <view class="hv__arrow hv__arrow--left"></view>
          </view>
          <view class="hv__d" bindtap="onDirTap" data-dr="1" data-dc="0">
            <view class="hv__arrow hv__arrow--down"></view>
          </view>
          <view class="hv__d" bindtap="onDirTap" data-dr="0" data-dc="1">
            <view class="hv__arrow hv__arrow--right"></view>
          </view>
        </view>
      </view>
    </view>

    <text class="t-xs muted-2 center mt-16">点击相邻块，或朝想移动的方向滑动 / 按方向键</text>
  </view>
</game-shell>
