.sd { display: flex; flex-direction: column; align-items: center; }
.sd__bar { gap: 16rpx; margin-bottom: 24rpx; }
.sd__board {
  width: 100%; max-width: 660rpx; display: grid; gap: 4rpx;
  background: var(--clay-soft); padding: 8rpx; border-radius: var(--r-lg); border: 2rpx solid var(--line-2);
}
.sd__cell {
  aspect-ratio: 1 / 1; background: var(--card); border-radius: 8rpx;
  display: flex; align-items: center; justify-content: center;
}
.sd__cell--given { background: var(--card-2); }
.sd__cell--sel { box-shadow: inset 0 0 0 4rpx var(--mint); }
.sd__num { font-size: 36rpx; color: var(--ink); }
.sd__cell--given .sd__num { color: var(--clay); font-weight: 700; }
.sd__pad { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14rpx; width: 100%; max-width: 660rpx; margin-top: 28rpx; }
.sd__n {
  height: 88rpx; border-radius: var(--r-md); background: var(--card);
  display: flex; align-items: center; justify-content: center; font-size: 36rpx; color: var(--ink-2);
  border: 2rpx solid var(--line); box-shadow: var(--sd-1);
}
.sd__n:active { transform: scale(.95); }
.sd__n--del { color: var(--clay); }
