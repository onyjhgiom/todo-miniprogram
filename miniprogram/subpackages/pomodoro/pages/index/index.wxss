/* pages/index/index.wxss
 * 番茄时钟 · 「高级智能自律学习中心」
 *
 * 【视觉语言（2026-10-07 按参照图重排）】
 *   · 场景背景（上海天际线 + 远山 + 云海）以 base64 data URI 铺底，
 *     上面压一层极淡白纱（.pd__veil）保证任意位置文字都有对比度；
 *   · 卡片统一走「玻璃白」：rgba(255,255,255,.74) + 1rpx 极淡描边 + 柔和阴影，
 *     让场景从卡片边缘自然透出，而不是被一整块白底盖死；
 *   · 主色低饱和蓝 #5E74B5 / #7188C8；暖金 #C9A24B 只用于「目标 / 成就」点睛，
 *     番茄红只留给 🍅 图标（面积 < 3%）。
 *
 * 【硬约束（踩过的坑，迁移时别丢）】
 *  1. WXSS 不支持 `*` 通用选择器，box-sizing 必须逐个声明；
 *  2. 小程序不默认 border-box；
 *  3. 不用 conic-gradient（Skyline 不支持），进度一律「条宽百分比」；
 *  4. 所有尺寸写 calc(N * var(--u, 1rpx))：--u 手机端=1rpx、宽窗端=固定 px，
 *     由 index.ts 的 layoutScale() 按真实窗口宽内联到 .pd 上，杜绝 @media 误判。
 */

/* ============================ 页面骨架 ============================ */
.pd {
  --u: 1rpx;

  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  /* 底部给 fixed 导航留白，避免最后一行被遮 */
  padding-bottom: calc(150 * var(--u, 1rpx));
  overflow-x: hidden;
  color: #2E3644;
  /* 兜底底色：场景图万一加载失败也不至于全透 */
  background: #EEF3FA;
}

/* 场景背景：base64 data URI 走内联 background-image（WXSS 不支持本地路径） */
.pd__bg {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 0;
  box-sizing: border-box;
  background-size: cover;
  background-position: center;
  transition: filter 1000ms ease;
}
.pd.is-focusing .pd__bg {
  filter: brightness(0.97) saturate(1.03);
}

/* 白纱：顶/底各压一点白，托住页头与页脚文字；中段几乎透明让场景透出 */
.pd__veil {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
  box-sizing: border-box;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.34) 0%,
    rgba(255, 255, 255, 0.10) 22%,
    rgba(255, 255, 255, 0.02) 48%,
    rgba(255, 255, 255, 0.06) 78%,
    rgba(255, 255, 255, 0.26) 100%
  );
}

/* ============================ 顶部品牌区 ============================ */
.hd {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  /* padding-top / padding-right 由 JS 内联（状态栏高度 + 胶囊避让） */
  padding-left: calc(24 * var(--u, 1rpx));
  padding-bottom: calc(10 * var(--u, 1rpx));
}
/* 左侧「返回键 + 品牌」组合：justify-content: space-between 只认两个子项，
   所以必须把返回键和 logo 包进一个 lead 容器，否则返回键会被推到中间。 */
.hd__lead {
  display: flex;
  align-items: center;
  gap: calc(12 * var(--u, 1rpx));
  min-width: 0;
}
/* 返回键：与右侧胶囊按钮同族的毛玻璃圆钮，视觉重量一致 */
.hd__back {
  flex-shrink: 0;
  width: calc(52 * var(--u, 1rpx));
  height: calc(52 * var(--u, 1rpx));
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  border: calc(1 * var(--u, 1rpx)) solid rgba(120, 140, 180, 0.12);
  box-shadow: 0 calc(4 * var(--u, 1rpx)) calc(12 * var(--u, 1rpx)) rgba(90, 110, 150, 0.08);
  transition: transform 200ms ease, background 200ms ease;
}
/* 纯 CSS 左向箭头（两条边 + 旋转），不依赖字体图标，跨端一致 */
.hd__back-ico {
  width: calc(16 * var(--u, 1rpx));
  height: calc(16 * var(--u, 1rpx));
  border-left: calc(3 * var(--u, 1rpx)) solid #5C77C2;
  border-bottom: calc(3 * var(--u, 1rpx)) solid #5C77C2;
  transform: rotate(45deg);
  /* 箭头视觉重心偏左，右移 2u 让它在圆钮里真正居中 */
  margin-left: calc(4 * var(--u, 1rpx));
}
.hd__back--tap {
  transform: scale(0.94);
  background: rgba(255, 255, 255, 0.9);
}
.hd__brand {
  display: flex;
  align-items: center;
  gap: calc(12 * var(--u, 1rpx));
  min-width: 0;
}
.hd__logo {
  flex-shrink: 0;
  width: calc(56 * var(--u, 1rpx));
  height: calc(56 * var(--u, 1rpx));
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: calc(18 * var(--u, 1rpx));
  background: rgba(255, 138, 102, 0.16);
  border: calc(1 * var(--u, 1rpx)) solid rgba(255, 138, 102, 0.28);
}
.hd__logo-tx {
  font-size: calc(30 * var(--u, 1rpx));
  line-height: 1;
}
.hd__titles {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.hd__t {
  font-size: calc(33 * var(--u, 1rpx));
  font-weight: 700;
  letter-spacing: calc(1 * var(--u, 1rpx));
  line-height: 1.2;
  color: #2E3644;
  white-space: nowrap;
}
.hd__s {
  margin-top: calc(2 * var(--u, 1rpx));
  font-size: calc(18 * var(--u, 1rpx));
  color: #6B7A90;
  white-space: nowrap;
}
.hd__acts {
  display: flex;
  align-items: center;
  gap: calc(10 * var(--u, 1rpx));
  flex-shrink: 0;
}
.act {
  padding: calc(7 * var(--u, 1rpx)) calc(16 * var(--u, 1rpx));
  box-sizing: border-box;
  border-radius: calc(999 * var(--u, 1rpx));
  font-size: calc(20 * var(--u, 1rpx));
  letter-spacing: 0;
  color: #5C77C2;
  background: rgba(255, 255, 255, 0.72);
  border: calc(1 * var(--u, 1rpx)) solid rgba(120, 140, 180, 0.12);
  white-space: nowrap;
  transition: transform 200ms ease, background 200ms ease;
}
.act--tap {
  transform: scale(0.96);
}
.act.is-on {
  color: #FFFFFF;
  background: linear-gradient(135deg, #7288C8, #6076B5);
  border-color: transparent;
}

/* ============================ 计时状态横幅 ============================ */
.banner {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: calc(10 * var(--u, 1rpx));
  box-sizing: border-box;
  margin: calc(4 * var(--u, 1rpx)) calc(22 * var(--u, 1rpx)) calc(14 * var(--u, 1rpx));
  padding: calc(10 * var(--u, 1rpx)) calc(18 * var(--u, 1rpx));
  border-radius: calc(999 * var(--u, 1rpx));
  background: rgba(113, 136, 209, 0.12);
  border: calc(1 * var(--u, 1rpx)) solid rgba(113, 136, 209, 0.2);
}
.banner__dot {
  flex-shrink: 0;
  width: calc(10 * var(--u, 1rpx));
  height: calc(10 * var(--u, 1rpx));
  border-radius: 50%;
  background: #7188D1;
  animation: dotPulse 2s ease-in-out infinite;
}
@keyframes dotPulse {
  0%   { opacity: 0.45; transform: scale(0.86); }
  50%  { opacity: 1;    transform: scale(1); }
  100% { opacity: 0.45; transform: scale(0.86); }
}
.banner__tx {
  font-size: calc(20 * var(--u, 1rpx));
  letter-spacing: 0;
  color: #5A6E9E;
  white-space: nowrap;
}

/* ============================ 两栏容器（宽窗双列服务） ============================
 * 手机端：普通块级竖向堆叠；宽窗端（JS 判定 ≥1080px）左右双列。换版式只改 CSS。 */
.pd__cols {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  padding: 0 calc(22 * var(--u, 1rpx));
}
.pd__col {
  box-sizing: border-box;
}

.pd__sec {
  position: relative;
  box-sizing: border-box;
  margin: 0 0 calc(14 * var(--u, 1rpx));
}

/* ============================ 今日目标卡 ============================ */
.goal {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: calc(14 * var(--u, 1rpx));
  box-sizing: border-box;
  margin-bottom: calc(14 * var(--u, 1rpx));
  padding: calc(16 * var(--u, 1rpx)) calc(20 * var(--u, 1rpx));
  border-radius: calc(24 * var(--u, 1rpx));
  background: rgba(255, 255, 255, 0.74);
  border: calc(1 * var(--u, 1rpx)) solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 calc(10 * var(--u, 1rpx)) calc(30 * var(--u, 1rpx)) rgba(48, 56, 70, 0.08);
}
.goal__main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: calc(12 * var(--u, 1rpx));
}
.goal__ico {
  flex-shrink: 0;
  width: calc(42 * var(--u, 1rpx));
  height: calc(42 * var(--u, 1rpx));
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: calc(14 * var(--u, 1rpx));
  background: rgba(201, 162, 75, 0.16);
  color: #C9A24B;
  font-size: calc(24 * var(--u, 1rpx));
  line-height: 1;
}
.goal__bd {
  flex: 1;
  min-width: 0;
}
.goal__t {
  display: block;
  font-size: calc(21 * var(--u, 1rpx));
  font-weight: 600;
  color: #2E3644;
  white-space: nowrap;
}
.goal__d {
  display: block;
  margin-top: calc(2 * var(--u, 1rpx));
  font-size: calc(18 * var(--u, 1rpx));
  color: #6B7A90;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.goal__bar {
  margin-top: calc(8 * var(--u, 1rpx));
  height: calc(8 * var(--u, 1rpx));
  border-radius: calc(999 * var(--u, 1rpx));
  background: #EAEFF7;
  overflow: hidden;
}
.goal__bar-in {
  height: 100%;
  border-radius: calc(999 * var(--u, 1rpx));
  background: linear-gradient(90deg, #C9A24B, #E2C078);
  transition: width 500ms cubic-bezier(0.22, 1, 0.36, 1);
}
.goal__n {
  flex-shrink: 0;
  font-size: calc(24 * var(--u, 1rpx));
  font-weight: 700;
  color: #C9A24B;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.goal__side {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: calc(8 * var(--u, 1rpx));
  padding-left: calc(14 * var(--u, 1rpx));
  border-left: calc(1 * var(--u, 1rpx)) solid rgba(120, 140, 170, 0.14);
}
.goal__sico {
  color: #C9A24B;
  font-size: calc(18 * var(--u, 1rpx));
  line-height: 1;
}
.goal__sbd {
  display: flex;
  flex-direction: column;
}
.goal__sk {
  font-size: calc(17 * var(--u, 1rpx));
  color: #8A97AC;
  white-space: nowrap;
}
.goal__sv {
  font-size: calc(19 * var(--u, 1rpx));
  font-weight: 600;
  color: #5C77C2;
  white-space: nowrap;
}

/* ============================ 核心番茄钟 ============================
 * 环 340u（≈iPhone 17 Pro 上 182px，约 45% 宽）：主视觉突出但不霸道，
 * 且 .core__stage 与 focus-ring 的 size 同值，环不外溢。
 * 左右各一条窄栏贴住圆的空白处，把「目标→行动→反馈」竖向串起来。 */
.core {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: calc(8 * var(--u, 1rpx));
  margin-bottom: calc(16 * var(--u, 1rpx));
}
.core__aside {
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}
/* 左右窄栏同宽（170u）：两侧等宽时 .core 的居中才真正把「环」摆在正中，
   否则环会偏向窄的一侧，看起来像没对齐。170+170+340 + 2×8 gap = 696u < 706u。 */
.core__aside--l {
  width: calc(170 * var(--u, 1rpx));
  align-items: flex-start;
  text-align: left;
}
.core__aside--r {
  width: calc(170 * var(--u, 1rpx));
  align-items: stretch;
}
.mside {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: calc(4 * var(--u, 1rpx));
}
.mside__ico {
  width: calc(38 * var(--u, 1rpx));
  height: calc(38 * var(--u, 1rpx));
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: calc(12 * var(--u, 1rpx));
  background: rgba(113, 136, 209, 0.14);
  color: #7188C8;
  font-size: calc(20 * var(--u, 1rpx));
  line-height: 1;
}
.mside__k {
  font-size: calc(17 * var(--u, 1rpx));
  color: #8A97AC;
}
.mside__v {
  font-size: calc(22 * var(--u, 1rpx));
  font-weight: 700;
  color: #5C77C2;
}
.core__quote {
  margin-top: calc(12 * var(--u, 1rpx));
  font-size: calc(18 * var(--u, 1rpx));
  line-height: 1.5;
  color: #6B7A90;
}

.core__ring {
  position: relative;
  flex-shrink: 0;
}
.core__stage {
  position: relative;
  width: calc(340 * var(--u, 1rpx));
  height: calc(340 * var(--u, 1rpx));
  box-sizing: border-box;
  border-radius: 50%;
  /* 内盘柔光（位于 canvas 与文字之下）：保留「环心不死白」，又不会罩白中心文字 */
  background: radial-gradient(
    circle at 50% 50%,
    rgba(255, 255, 255, 0.98) 0%,
    rgba(248, 250, 255, 0.92) 56%,
    rgba(234, 241, 253, 0.5) 86%,
    rgba(234, 241, 253, 0) 100%
  );
}
.core__center {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 calc(54 * var(--u, 1rpx));
}
.core__emoji {
  font-size: calc(28 * var(--u, 1rpx));
  line-height: 1;
}
.core__mode {
  margin-top: calc(4 * var(--u, 1rpx));
  font-size: calc(21 * var(--u, 1rpx));
  font-weight: 600;
  letter-spacing: calc(1 * var(--u, 1rpx));
  color: #5C77C2;
  white-space: nowrap;
}
.core__time {
  margin-top: calc(2 * var(--u, 1rpx));
  font-size: calc(64 * var(--u, 1rpx));
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: 0;
  color: #2E3644;
  font-family: 'DIN Alternate', 'SF Pro Display', 'Helvetica Neue', sans-serif;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.core__round {
  margin-top: calc(4 * var(--u, 1rpx));
  font-size: calc(19 * var(--u, 1rpx));
  letter-spacing: 0;
  color: #8A97AC;
  white-space: nowrap;
}

/* ============================ 主按钮 + 环境音 ============================ */
.ctarow {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: calc(14 * var(--u, 1rpx));
  margin-bottom: calc(6 * var(--u, 1rpx));
}
.cta {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: calc(10 * var(--u, 1rpx));
  box-sizing: border-box;
  height: calc(78 * var(--u, 1rpx));
  border-radius: calc(44 * var(--u, 1rpx));
  background: linear-gradient(90deg, #7188C8 0%, #5E74B5 100%);
  box-shadow: 0 calc(10 * var(--u, 1rpx)) calc(30 * var(--u, 1rpx)) rgba(93, 116, 181, 0.22);
  transition: transform 200ms ease, box-shadow 200ms ease;
}
.cta--tap {
  transform: scale(0.98);
  box-shadow: 0 calc(6 * var(--u, 1rpx)) calc(16 * var(--u, 1rpx)) rgba(93, 116, 181, 0.18);
}
.cta.is-running {
  background: linear-gradient(90deg, #647BB9 0%, #51659E 100%);
}
.cta__ico {
  flex-shrink: 0;
  min-width: calc(28 * var(--u, 1rpx));
  text-align: center;
  font-size: calc(24 * var(--u, 1rpx));
  line-height: 1;
  color: rgba(255, 255, 255, 0.92);
}
.cta__label {
  font-size: calc(26 * var(--u, 1rpx));
  font-weight: 700;
  letter-spacing: calc(1 * var(--u, 1rpx));
  color: #FFFFFF;
  white-space: nowrap;
}
.amb {
  flex-shrink: 0;
  width: calc(64 * var(--u, 1rpx));
  height: calc(64 * var(--u, 1rpx));
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  border: calc(1 * var(--u, 1rpx)) solid rgba(120, 140, 180, 0.16);
  transition: transform 200ms ease, background 200ms ease, border-color 200ms ease;
}
.amb--tap {
  transform: scale(0.95);
}
.amb.is-on {
  background: linear-gradient(135deg, #7288C8, #6076B5);
  border-color: transparent;
}
.amb__g {
  font-size: calc(26 * var(--u, 1rpx));
  line-height: 1;
  color: #5C77C2;
}
.amb.is-on .amb__g {
  color: #FFFFFF;
}
.cta__sub {
  position: relative;
  z-index: 2;
  margin-top: calc(8 * var(--u, 1rpx));
  margin-bottom: calc(14 * var(--u, 1rpx));
  text-align: center;
  font-size: calc(20 * var(--u, 1rpx));
  letter-spacing: 0;
  color: #8995A8;
}

/* ============================ 今日数据三列 ============================ */
.stats3 {
  position: relative;
  z-index: 2;
  display: flex;
  gap: calc(10 * var(--u, 1rpx));
  box-sizing: border-box;
  margin-bottom: calc(14 * var(--u, 1rpx));
  padding: calc(16 * var(--u, 1rpx)) calc(14 * var(--u, 1rpx));
  border-radius: calc(24 * var(--u, 1rpx));
  background: rgba(255, 255, 255, 0.74);
  border: calc(1 * var(--u, 1rpx)) solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 calc(10 * var(--u, 1rpx)) calc(30 * var(--u, 1rpx)) rgba(48, 56, 70, 0.08);
}
.stats3__col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: calc(4 * var(--u, 1rpx));
  box-sizing: border-box;
}
.stats3__col + .stats3__col {
  padding-left: calc(10 * var(--u, 1rpx));
  border-left: calc(1 * var(--u, 1rpx)) solid rgba(120, 140, 170, 0.12);
}
.stats3__hd {
  display: flex;
  align-items: center;
  gap: calc(5 * var(--u, 1rpx));
}
.stats3__ico {
  font-size: calc(17 * var(--u, 1rpx));
  line-height: 1;
}
.stats3__k {
  font-size: calc(17 * var(--u, 1rpx));
  color: #6B7A90;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.stats3__vrow {
  display: flex;
  align-items: baseline;
  gap: calc(3 * var(--u, 1rpx));
}
.stats3__v {
  font-size: calc(32 * var(--u, 1rpx));
  font-weight: 700;
  line-height: 1.1;
  color: #2E3644;
  font-variant-numeric: tabular-nums;
}
.stats3__u {
  font-size: calc(16 * var(--u, 1rpx));
  color: #8A97AC;
  white-space: nowrap;
}
.stats3__bar {
  margin-top: calc(2 * var(--u, 1rpx));
  height: calc(6 * var(--u, 1rpx));
  border-radius: calc(999 * var(--u, 1rpx));
  background: #EAEFF7;
  overflow: hidden;
}
.stats3__bar-in {
  height: 100%;
