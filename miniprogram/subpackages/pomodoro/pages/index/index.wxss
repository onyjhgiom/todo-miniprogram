.sheet__empty {
  box-sizing: border-box;
  padding: calc(48 * var(--u, 1rpx)) calc(6 * var(--u, 1rpx));
  text-align: center;
  font-size: calc(22 * var(--u, 1rpx));
  color: #A8B2C2;
}
.sheet__stats {
  display: flex;
  flex-direction: column;
}
.sheet__stat {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(16 * var(--u, 1rpx)) calc(6 * var(--u, 1rpx));
  box-sizing: border-box;
  border-bottom: calc(1 * var(--u, 1rpx)) solid rgba(120, 140, 170, 0.08);
}
.sheet__stat-k {
  font-size: calc(23 * var(--u, 1rpx));
  color: #6B7A90;
}
.sheet__stat-v {
  font-size: calc(23 * var(--u, 1rpx));
  font-weight: 600;
  color: #303846;
}

/* 成就面板：真实统计推导 */
.achv {
  display: flex;
  flex-direction: column;
  gap: calc(14 * var(--u, 1rpx));
  padding: calc(4 * var(--u, 1rpx)) 0;
}
.achv__sum {
  display: flex;
  box-sizing: border-box;
  border-radius: calc(20 * var(--u, 1rpx));
  overflow: hidden;
  background: rgba(113, 136, 209, 0.1);
}
.achv__sum-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: calc(2 * var(--u, 1rpx));
  padding: calc(14 * var(--u, 1rpx)) calc(6 * var(--u, 1rpx));
  box-sizing: border-box;
}
.achv__sum-cell + .achv__sum-cell {
  border-left: calc(1 * var(--u, 1rpx)) solid rgba(120, 140, 170, 0.14);
}
.achv__sum-n {
  font-size: calc(30 * var(--u, 1rpx));
  font-weight: 700;
  line-height: 1.1;
  color: #5E74B5;
  font-variant-numeric: tabular-nums;
}
.achv__sum-l {
  font-size: calc(17 * var(--u, 1rpx));
  color: #6B7A90;
}
.achv__grid {
  display: flex;
  flex-wrap: wrap;
  gap: calc(10 * var(--u, 1rpx));
}
.achv__badge {
  /* 三列：2 个 gap(10u) 由 100% 里扣除 */
  width: calc((100% - 20 * var(--u, 1rpx)) / 3);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: calc(3 * var(--u, 1rpx));
  padding: calc(14 * var(--u, 1rpx)) calc(6 * var(--u, 1rpx));
  border-radius: calc(18 * var(--u, 1rpx));
  background: rgba(120, 140, 170, 0.08);
  opacity: 0.55;
  transition: opacity 200ms ease, background 200ms ease, border-color 200ms ease;
}
.achv__badge.is-on {
  opacity: 1;
  background: linear-gradient(160deg, rgba(201, 162, 75, 0.18), rgba(226, 192, 120, 0.06));
  border: calc(1 * var(--u, 1rpx)) solid rgba(201, 162, 75, 0.3);
}
.achv__badge-g {
  font-size: calc(26 * var(--u, 1rpx));
  line-height: 1;
}
.achv__badge-t {
  font-size: calc(18 * var(--u, 1rpx));
  font-weight: 600;
  color: #3A4456;
}
.achv__badge-d {
  font-size: calc(15 * var(--u, 1rpx));
  color: #8A97AC;
  text-align: center;
  line-height: 1.35;
}

/* 设置项 */
.step {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(15 * var(--u, 1rpx)) calc(6 * var(--u, 1rpx));
  box-sizing: border-box;
  border-bottom: calc(1 * var(--u, 1rpx)) solid rgba(120, 140, 170, 0.08);
}
.step__k {
  font-size: calc(23 * var(--u, 1rpx));
  color: #3C4657;
}
.step__v {
  display: flex;
  align-items: center;
  gap: calc(16 * var(--u, 1rpx));
}
.step__btn {
  width: calc(46 * var(--u, 1rpx));
  height: calc(46 * var(--u, 1rpx));
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: calc(23 * var(--u, 1rpx));
  font-size: calc(24 * var(--u, 1rpx));
  color: #647BB9;
  background: rgba(113, 136, 209, 0.1);
}
.step__n {
  min-width: calc(104 * var(--u, 1rpx));
  text-align: center;
  font-size: calc(23 * var(--u, 1rpx));
  font-weight: 600;
  color: #303846;
  font-variant-numeric: tabular-nums;
}
.swrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(17 * var(--u, 1rpx)) calc(6 * var(--u, 1rpx));
  box-sizing: border-box;
  border-bottom: calc(1 * var(--u, 1rpx)) solid rgba(120, 140, 170, 0.08);
}
.swrow__k {
  font-size: calc(23 * var(--u, 1rpx));
  color: #3C4657;
}
.sw {
  flex-shrink: 0;
  width: calc(68 * var(--u, 1rpx));
  height: calc(38 * var(--u, 1rpx));
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: calc(3 * var(--u, 1rpx));
  border-radius: calc(19 * var(--u, 1rpx));
  background: #E1E7F0;
  transition: background 200ms ease;
}
.sw__dot {
  width: calc(32 * var(--u, 1rpx));
  height: calc(32 * var(--u, 1rpx));
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 calc(2 * var(--u, 1rpx)) calc(5 * var(--u, 1rpx)) rgba(60, 80, 120, 0.18);
  transition: transform 200ms ease;
}
.sw.is-on {
  background: linear-gradient(135deg, #7288C8, #6076B5);
}
.sw.is-on .sw__dot {
  transform: translateX(calc(30 * var(--u, 1rpx)));
}

/* ============================ 响应式：宽窗双栏 ============================
 * 完全由 JS（layoutScale）判定，不依赖任何 @media：
 *   ≥700px  --u 固定 0.78px；≥1080px 开启左右双列。 */
.pd.is-wide .hd,
.pd.is-wide .banner,
.pd.is-wide .pd__cols,
.pd.is-wide .pd__foot {
  max-width: 820px;
  margin-left: auto;
  margin-right: auto;
}
.pd.is-wide .pd__cols {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: calc(32 * var(--u, 1rpx));
  max-width: 1040px;
}
.pd.is-wide .pd__col {
  flex: 1 1 0;
  min-width: 0;
}
.pd.is-wide .pd__col > .goal:first-child,
.pd.is-wide .pd__col > .stats3:first-child {
  margin-top: 0;
}
.pd.is-wide.is-zen .pd__cols {
  display: block;
  max-width: 820px;
}
.pd.is-wide .pill:hover,
.pd.is-wide .hd__back:hover {
  background: rgba(255, 255, 255, 0.94);
}
.pd.is-wide .cta:hover {
  box-shadow: 0 calc(14 * var(--u, 1rpx)) calc(36 * var(--u, 1rpx)) rgba(93, 116, 181, 0.3);
}
