/* components/focus-ring/focus-ring.wxss
 * 成长进度环：容器只负责「呼吸」与「完成光环」，环本体由 canvas 绘制。
 * 尺寸单位沿用页面缩放参考系 --u（手机端 = 1rpx，宽窗端 = 固定 px），
 * 与 pages/index 保持同一套坐标系，避免环与中心文字在不同宽度下错位。
 */
.ring {
  position: relative;
  box-sizing: border-box;
  display: block;
}
.ring__cv {
  display: block;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

/* 计时中：极弱的呼吸（需求十五）——4s 一个周期、幅度仅 1.5%，
   目标是「持续但不引人注意」，做成明显跳动反而廉价。 */
.ring.is-running {
  animation: ringBreathe 4s ease-in-out infinite;
}
@keyframes ringBreathe {
  0%   { transform: scale(1); }
  50%  { transform: scale(1.015); }
  100% { transform: scale(1); }
}
.ring.is-reduced {
  animation: none;
}

/* 完成一轮：光环扩散一次（需求十六「克制」原则 —— 只扩散一次、不循环） */
.ring__halo {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  margin-left: -50%;
  margin-top: -50%;
  border-radius: 50%;
  border: calc(4 * var(--u, 1rpx)) solid rgba(113, 136, 209, 0.55);
  pointer-events: none;
  animation: haloOut 1000ms cubic-bezier(0.22, 1, 0.36, 1) both;
}
@keyframes haloOut {
  0%   { transform: scale(0.82); opacity: 0.9; }
  100% { transform: scale(1.22); opacity: 0; }
}
.ring.is-reduced .ring__halo {
  animation: none;
  opacity: 0;
}
