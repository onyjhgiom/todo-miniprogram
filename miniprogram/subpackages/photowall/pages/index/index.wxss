/* 照片墙 · 作品列表（梦幻玻璃拟态 · 高级版） */
page {
  background: #9BA0C8;
}

.pw {
  min-height: 100vh;
  padding-bottom: 200rpx;
  box-sizing: border-box;
  color: #fff;
  /* 梦幻紫粉渐变 + 柔光斑 + 左下叶片暗影 */
  background:
    radial-gradient(520rpx 420rpx at 88% 30%, rgba(240, 205, 205, 0.5), rgba(240, 205, 205, 0) 70%),
    radial-gradient(600rpx 500rpx at 12% 88%, rgba(64, 86, 48, 0.32), rgba(64, 86, 48, 0) 72%),
    radial-gradient(700rpx 560rpx at 50% 62%, rgba(226, 196, 232, 0.55), rgba(226, 196, 232, 0) 74%),
    linear-gradient(180deg, #9298C2 0%, #A29ECB 14%, #B2A6D4 32%, #C2B2DA 48%, #B4A8CF 66%, #9A97C0 84%, #8B92B6 100%);
}

/* ===== 待办联动解锁条（玻璃） ===== */
.pw-unlock {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.26));
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 8rpx 30rpx rgba(58, 52, 100, 0.18);
  backdrop-filter: blur(20rpx);
}
.pw-unlock--new {
  background: linear-gradient(135deg, rgba(255, 222, 240, 0.62), rgba(214, 196, 255, 0.4));
  border-color: rgba(255, 214, 240, 0.85);
}
.pw-unlock-ic {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: linear-gradient(160deg, #FFE9A8, #F5C24B 58%, #E8A62E);
  box-shadow: 0 6rpx 18rpx rgba(214, 150, 40, 0.45);
}
.pw-unlock-bd { flex: 1; min-width: 0; }
.pw-unlock-t {
  font-size: 27rpx;
  font-weight: 600;
  color: #4A4462;
  line-height: 1.4;
  white-space: nowrap;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.5);
}
.pw-unlock-num {
  font-size: 38rpx;
  font-weight: 800;
  color: #E8A11C;
  padding: 0 2rpx;
}
.pw-unlock-hl {
  font-weight: 800;
  color: #D9860F;
}
.pw-unlock-s {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #7A7391;
}
.pw-unlock-go {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #918CF5, #5D4FE8);
  box-shadow: 0 6rpx 18rpx rgba(93, 79, 232, 0.45);
}

/* ===== Tab（玻璃胶囊） ===== */
.pw-tabs {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 24rpx 8rpx;
}
.pw-tab {
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.24);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  transition: all 0.18s ease;
}
.pw-tab.on {
  color: #fff;
  font-weight: 700;
  background: linear-gradient(135deg, #8E85F2, #5D4FE8);
  border-color: rgba(255, 255, 255, 0.5);
  box-shadow: 0 8rpx 24rpx rgba(93, 79, 232, 0.45);
}

/* ===== 列表 ===== */
.pw-wrap { padding: 16rpx 24rpx; }
.pw-grid { display: flex; flex-direction: column; gap: 20rpx; }

.pw-row {
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
}
.pw-card {
  position: relative;
  display: flex;
  align-items: center;
  padding: 18rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0.36));
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 8rpx 26rpx rgba(58, 52, 100, 0.16);
  transition: transform 0.22s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.pw-cover {
  flex-shrink: 0;
  width: 132rpx;
  height: 132rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}
.pw-cover-img { width: 100%; height: 100%; }
.pw-cover-ph { font-size: 48rpx; opacity: 0.8; }

.pw-card-bd { flex: 1; min-width: 0; margin-left: 22rpx; }
.pw-card-t {
  font-size: 29rpx;
  font-weight: 700;
  color: #423C5C;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pw-card-m { margin-top: 8rpx; font-size: 24rpx; color: #6E6790; }
.pw-card-d { margin-top: 6rpx; font-size: 21rpx; color: #948DAE; }
.pw-card-fav {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 30rpx;
  color: #E8A33C;
}

.pw-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 152rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  color: #fff;
  background: #E0607E;
}

.pw-end {
  padding: 30rpx 0 10rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* ===== 空状态 ===== */
.pw-empty { padding: 8rpx 0 20rpx; text-align: center; }

.pw-hero {
  display: block;
  width: 100%;
  /* 底部渐隐，与页面渐变无缝衔接 */
  -webkit-mask-image: linear-gradient(180deg, #000 80%, rgba(0, 0, 0, 0) 100%);
  mask-image: linear-gradient(180deg, #000 80%, rgba(0, 0, 0, 0) 100%);
}

.pw-empty-t {
  margin-top: 26rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 18rpx rgba(70, 60, 120, 0.45);
}
.pw-empty-t--sm { font-size: 34rpx; }
.pw-empty-s {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.95);
  text-shadow: 0 2rpx 10rpx rgba(70, 60, 120, 0.35);
}
.pw-empty-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 34rpx;
  padding: 20rpx 60rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #B494F8, #7C6AF3 55%, #6A57EE);
  box-shadow:
    0 14rpx 40rpx rgba(124, 102, 240, 0.55),
    0 0 0 8rpx rgba(255, 255, 255, 0.16);
}
.pw-btn-plus {
  font-size: 34rpx;
  font-weight: 500;
  margin-right: 8rpx;
}

.pw-mini-empty {
  margin-top: 40rpx;
  padding: 70rpx 40rpx 60rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0.2));
  border: 1rpx solid rgba(255, 255, 255, 0.55);
}
.pw-empty-ic { font-size: 88rpx; opacity: 0.85; }

/* ===== 推荐模板 ===== */
.pw-rec { margin-top: 64rpx; }
.pw-rec-head {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.pw-rec-line {
  width: 64rpx;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.55);
}
.pw-rec-dia { font-size: 18rpx; color: rgba(255, 255, 255, 0.85); }
.pw-rec-t {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 12rpx rgba(70, 60, 120, 0.4);
}
.pw-rec-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}
.pw-rec-item {
  border-radius: 26rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 28rpx rgba(58, 52, 100, 0.25);
  background: rgba(255, 255, 255, 0.35);
}
.pw-rec-img {
  display: block;
  width: 100%;
  height: 214rpx;
}

/* ===== 悬浮创建按钮 ===== */
.pw-fab {
  position: fixed;
  right: 40rpx;
  bottom: 70rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 300;
  color: #fff;
  background: linear-gradient(160deg, #7FA4FF, #5D63EC 70%);
  box-shadow:
    0 12rpx 34rpx rgba(93, 99, 236, 0.55),
    0 0 0 10rpx rgba(255, 255, 255, 0.14);
  z-index: 20;
}
