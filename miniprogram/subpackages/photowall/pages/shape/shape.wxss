/* 照片墙 · 形状模板库 */
.ps {
  min-height: 100vh;
  padding-bottom: 160rpx;
  background: var(--color-bg);
  color: var(--color-text);
  box-sizing: border-box;
}

/* ===== 搜索 ===== */
.ps-search { padding: 20rpx 24rpx 4rpx; }
.ps-search-box {
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 60rpx 0 26rpx;
  height: 76rpx;
  border-radius: 999rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
}
.ps-search-input { flex: 1; font-size: 27rpx; color: var(--color-text); }
.ps-search-ph { color: var(--color-text-mute); }
.ps-search-x {
  position: absolute;
  right: 18rpx;
  top: 0;
  height: 76rpx;
  width: 44rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--color-text-mute);
}

/* ===== 分类 ===== */
.ps-cats {
  white-space: nowrap;
  padding: 20rpx 24rpx 6rpx;
}
.ps-cat {
  display: inline-block;
  margin-right: 14rpx;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--color-text-soft);
  background: var(--color-bg-soft);
}
.ps-cat.on {
  color: #fff;
  background: var(--color-primary);
  font-weight: 600;
}

/* ===== 最近使用 ===== */
.ps-block { padding: 24rpx 24rpx 0; }
.ps-block-t {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
}
.ps-recent { white-space: nowrap; }
.ps-recent-i {
  display: inline-block;
  width: 132rpx;
  margin-right: 16rpx;
  padding: 18rpx 0 14rpx;
  border-radius: var(--radius-md);
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  text-align: center;
}
.ps-recent-ic { font-size: 40rpx; }
.ps-recent-n {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--color-text-soft);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 形状网格 ===== */
.ps-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 16rpx 0;
}
.ps-cell {
  position: relative;
  width: 25%;
  padding: 0 8rpx 16rpx;
  box-sizing: border-box;
}
.ps-shape {
  padding: 22rpx 0 16rpx;
  border-radius: var(--radius-md);
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  text-align: center;
}
.ps-shape:active { background: var(--color-bg-soft); }
.ps-shape-ic { font-size: 46rpx; line-height: 1.1; }
.ps-shape-n {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-soft);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 固定上传张数徽标：选形状时就知道要准备多少张 */
.ps-shape-cnt {
  margin-top: 4rpx;
  font-size: 18rpx;
  line-height: 1.4;
  color: var(--color-primary, #b5714c);
  opacity: 0.9;
}
.ps-fav {
  position: absolute;
  top: 6rpx;
  right: 14rpx;
  font-size: 28rpx;
  color: var(--color-text-mute);
  padding: 6rpx;
}
.ps-fav.on { color: #E8A33C; }

/* ===== 文字 / 蒙版 ===== */
.ps-text {
  padding: 22rpx;
  border-radius: var(--radius-lg);
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
}
.ps-textarea {
  width: 100%;
  height: 120rpx;
  font-size: 30rpx;
  color: var(--color-text);
  box-sizing: border-box;
}
.ps-tip {
  margin: 12rpx 0 0;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-text-mute);
}
.ps-btn {
  margin-top: 22rpx;
  padding: 20rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  background: var(--color-primary);
}
.ps-btn--ghost {
  color: var(--color-primary);
  background: var(--color-primary-soft);
  border: 1rpx solid var(--color-border);
}

.ps-masks {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.ps-mask {
  position: relative;
  width: 160rpx;
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx;
  border-radius: var(--radius-md);
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  text-align: center;
}
.ps-mask-img { width: 120rpx; height: 120rpx; }
.ps-mask-n {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-mute);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ps-mask-x {
  position: absolute;
  top: 2rpx;
  right: 8rpx;
  font-size: 32rpx;
  color: var(--color-text-mute);
  padding: 6rpx;
}

/* ===== 空状态 ===== */
.ps-empty { padding: 100rpx 40rpx; text-align: center; }
.ps-empty-ic { font-size: 84rpx; opacity: 0.5; }
.ps-empty-t { margin-top: 20rpx; font-size: 29rpx; font-weight: 600; }
.ps-empty-s { margin-top: 8rpx; font-size: 23rpx; color: var(--color-text-mute); }

/* ===== 底部 ===== */
.ps-foot { padding: 40rpx 24rpx 0; }
.ps-back {
  padding: 20rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-soft);
  background: var(--color-bg-soft);
}
