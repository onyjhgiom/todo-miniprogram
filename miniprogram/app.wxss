/* ========== 通用工具类 ========== */
.row { display: flex; flex-direction: row; align-items: center; }
.col { display: flex; flex-direction: column; }
.between { justify-content: space-between; }
.center { justify-content: center; align-items: center; }
.gap-xs { gap: 8rpx; }
.gap-sm { gap: 16rpx; }
.gap-md { gap: 24rpx; }
.flex-1 { flex: 1; }

.text-mute { color: var(--color-text-mute); }
.text-soft { color: var(--color-text-soft); }
.text-primary { color: var(--color-primary); }
.text-danger { color: var(--color-danger); }
.text-success { color: var(--color-success); }
.text-warn { color: var(--color-warning); }

.font-xs { font-size: 22rpx; }
.font-sm { font-size: 24rpx; }
.font-base { font-size: 28rpx; }
.font-lg { font-size: 32rpx; }
.font-xl { font-size: 40rpx; }
.font-2xl { font-size: 56rpx; }
.font-bold { font-weight: 600; }
.font-semibold { font-weight: 500; }

.card {
  background: var(--color-card);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
  padding: 28rpx;
}
.card-flat {
  background: var(--color-card);
  border-radius: var(--radius-xl);
  border: 2rpx solid var(--color-border);
}

.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 16rpx 0;
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.scroll-hidden::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

.no-select {
  user-select: none;
  -webkit-user-select: none;
}

/* 按下反馈 */
.press {
  transition: transform var(--duration-fast) var(--ease-out);
}
.press:active {
  transform: scale(0.96);
}
/* 全局即时按压反馈：任意页面 view 均可 hover-class="tap-press"（view 的 :active 不生效） */
.tap-press {
  opacity: 0.74;
  transform: scale(0.97);
}

/* ============================================================
 * 暖纸质感共享层（中古侘寂改版；保留原类名，玻璃→暖纸半透）
 * ============================================================ */

/* 暖纸面板：半透纸白 + 内高光 + 暖柔影 */
.glass {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--glass-shadow);
}
/* 更实的面板（导航 / dock / 弹层用） */
.glass-strong {
  background: var(--glass-bg-strong);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--glass-shadow);
}
/* 胶囊（搜索 / chips / 分段控件用） */
.glass-pill {
  background: var(--glass-bg-soft);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
}

/* 数字排版：等宽数字，统计跳动不抖动 */
.font-num {
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

/* ===== 环境氛围层：页面根节点第一子元素，柔和光斑缓慢漂移 ===== */
.ambient-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}
.ambient-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(90rpx);
  transform: translateZ(0);
  animation: ambient-drift 18s ease-in-out infinite alternate;
}
.ambient-blob--1 {
  width: 520rpx;
  height: 520rpx;
  top: -160rpx;
  right: -120rpx;
  background: radial-gradient(circle, var(--ambient-1), transparent 68%);
}
.ambient-blob--2 {
  width: 420rpx;
  height: 420rpx;
  top: 30%;
  left: -180rpx;
  background: radial-gradient(circle, var(--ambient-2), transparent 68%);
  animation-delay: -6s;
  animation-duration: 22s;
}
.ambient-blob--3 {
  width: 460rpx;
  height: 460rpx;
  bottom: -140rpx;
  right: 12%;
  background: radial-gradient(circle, var(--ambient-3), transparent 68%);
  animation-delay: -11s;
  animation-duration: 26s;
}
@keyframes ambient-drift {
  0% { transform: translate3d(0, 0, 0) scale(1); }
  50% { transform: translate3d(44rpx, -34rpx, 0) scale(1.08); }
  100% { transform: translate3d(-36rpx, 30rpx, 0) scale(0.94); }
}

/* 页面内容层：压在氛围层之上（配合 .ambient-layer 使用） */
.ambient-content {
  position: relative;
  z-index: 1;
}

/* ===== 通用呼吸光晕（FAB / 强化焦点） ===== */
@keyframes soft-breathe {
  0%, 100% { transform: scale(1); opacity: 0.55; }
  50% { transform: scale(1.18); opacity: 0.2; }
}

/* ============================================================
 * 编制色调标签（仕途衡鉴 · 体制内模块）
 * 全模块 6 个页面共用：把「有没有编制」做成一眼可辨的统一视觉语言。
 *   有编(bian) 绿 / 无编(unbian) 灰 / 慎选(warn) 红
 * 深色主题单独给一组高亮值，保证深底上同样可读。
 * ============================================================ */
.cx-tag {
  display: inline-block;
  font-size: 21rpx;
  font-weight: 600;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  border: 2rpx solid transparent;
  white-space: nowrap;
  line-height: 1.5;
}
.cx-tag--bian { color: #1f7a4d; background: rgba(34, 160, 95, 0.14); border-color: rgba(34, 160, 95, 0.3); }
.cx-tag--unbian { color: #556074; background: rgba(100, 116, 139, 0.14); border-color: rgba(100, 116, 139, 0.3); }
.cx-tag--warn { color: #b3261e; background: rgba(220, 38, 38, 0.13); border-color: rgba(220, 38, 38, 0.3); }
.themed[data-theme='dark'] .cx-tag--bian,
.themed[data-theme='rose'] .cx-tag--bian { color: #6ee7a8; background: rgba(34, 160, 95, 0.22); border-color: rgba(110, 231, 168, 0.4); }
.themed[data-theme='dark'] .cx-tag--unbian,
.themed[data-theme='rose'] .cx-tag--unbian { color: #c3ccdb; background: rgba(148, 163, 184, 0.24); border-color: rgba(195, 204, 219, 0.4); }
.themed[data-theme='dark'] .cx-tag--warn,
.themed[data-theme='rose'] .cx-tag--warn { color: #ff9b91; background: rgba(220, 38, 38, 0.24); border-color: rgba(255, 155, 145, 0.42); }

/* ===== BEGIN recruit-theme（由 scripts/gen-recruit-theme.js 生成，勿手改） ===== */
/* 秋招模块深色主题覆盖
 *
 * 页面 WXSS 大量硬编码浅色，只补 data-theme 会出现「深色页面底色 + 白色卡片」的割裂感。
 * 这里把主要容器与文字按主题变量统一覆盖；语义色（徽标、进度条、状态点）保持原样不覆盖，
 * 避免把「进行中 / 已截止」这类颜色语义抹平。
 * 浅色主题不在此列 —— 必须保证浅色下与改动前逐像素一致。
 *
 * 为什么放主包的 app.wxss 而不是 recruit 自己的 wxss：
 * tools 分包已到 98% 的 2MB 红线，这 12KB 放分包里会挤压余量；
