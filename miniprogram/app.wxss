/**
 * app.wxss
 * 全局样式：5 套主题（通过 page 根元素 data-theme 属性切换）+ 设计 token
 *
 * ★ 中古 / 侘寂改版（对齐「拾光待办」设计语言）：
 *  - 基调：暖灰宣纸底 + 深炭墨 + 低饱和四彩（奶油黄/鼠尾草绿/陶土粉/燕麦米）
 *  - 主强调色由紫色 #6366f1 改为陶土棕 #B5714C（沿用 --color-primary 变量名，
 *    所有页面/组件无需改动即可整体换肤）
 *  - 玻璃拟态 token 保留变量名，值调整为侘寂暖白半透明（毛玻璃 → 暖纸半透）
 *  - 圆角整体加大一档（16/24/32rpx），家具般的圆润感
 *
 * 引入链说明：
 *  - styles/common.wxss 提供「侘寂」体系变量（--paper/--ink/--clay/--r-md/--sd-1…）
 *    与公共类库（.page / .card--flat / .grain / .serif / .tape / .muted-2 / .t-xxl…），
 *    游戏分包（subpackages/games）与 pages/tool 均依赖它。
 *  - 注意：WXSS 的 @import 必须位于文件最顶部且为顶层语句。
 */

@import "/styles/common.wxss";

page {
  /* ===== 暮金夜色 · 基础色板（默认 light 槽位，已整体改造为深色）=====
   * 参照用户效果图：暗夜棕黑底 + 琥珀金强调 + 玻璃卡片。
   * 变量名保持不变，全站页面/组件零改动级联。 */
  --color-bg: #15110D;
  --color-bg-elevated: #221B14;
  --color-bg-soft: #2C2318;
  --color-card: rgba(40, 31, 22, 0.72);
  --color-text: #F3EAD9;
  --color-text-soft: #DCD1BA;
  --color-text-mute: #B3A78E;
  --color-border: rgba(226, 178, 115, 0.16);
  --color-input-line: rgba(226, 178, 115, 0.3);
  --color-primary: #E2B273;
  --color-primary-deep: #C9955C;
  --color-primary-ink: #3A2A16;
  --color-primary-ink-2: #57401f;
  --color-primary-soft: rgba(226, 178, 115, 0.16);
  --color-primary-shadow: rgba(0, 0, 0, 0.5);
  --color-accent: #D9B36C;
  --color-success: #8FBA8F;
  --color-warning: #E0A06A;
  --color-danger: #E07A5C;
  --color-overlay: rgba(8, 6, 4, 0.66);

  /* ===== 夜色玻璃 token（原玻璃拟态变量名，暮金值）===== */
  --glass-bg: rgba(38, 30, 22, 0.55);
  --glass-bg-strong: rgba(38, 30, 22, 0.82);
  --glass-bg-soft: rgba(38, 30, 22, 0.4);
  --glass-border: rgba(226, 178, 115, 0.22);
  --glass-highlight: rgba(255, 233, 198, 0.22);
  --glass-blur: blur(20rpx) saturate(120%);
  --glass-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.42), inset 0 1rpx 0 rgba(255, 233, 198, 0.14);

  /* ===== 主题氛围光斑（暮金晖光）===== */
  --ambient-1: rgba(226, 168, 92, 0.16);
  --ambient-2: rgba(217, 179, 108, 0.1);
  --ambient-3: rgba(120, 96, 66, 0.12);

  /* ===== 主页「风格」维度 · 工艺 token =====
   * 与主题正交：主题给颜色，风格给工艺（圆角 / 描边宽度 / 阴影形状 / 玻璃质感）。
   * 这里的默认值 = 现有侘寂工艺，因此不选风格时主页观感与改版前完全一致。
   * 各风格在 pages/index/index.wxss 的 .themed.home-style-X 里整体覆盖。
   * 组件（stats-card / todo-card / bottom-tab）通过 var() 消费这些 token，
   * 所以换风格不需要改动组件逻辑 —— CSS 变量会级联进自定义组件。 */
  --home-card-r: 34rpx;            /* 待办卡片圆角 */
  --home-card-edge: 1rpx;          /* 待办卡片描边宽度 */
  --home-card-shadow: 0 1rpx 0 rgba(255, 233, 198, 0.12) inset, 0 8rpx 24rpx rgba(0, 0, 0, 0.38);
  --home-hero-r: 44rpx;            /* 顶部 hero 面板圆角 */
  --home-hero-edge-w: 0rpx;        /* hero 描边宽度 */
  --home-hero-edge-c: transparent; /* hero 描边颜色 */
  --home-hero-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.5);
  --home-bar-r: 999rpx;            /* 底部 dock 圆角 */
  --home-bar-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.55), 0 1rpx 0 rgba(255, 233, 198, 0.14) inset;

  --gradient-hero: linear-gradient(135deg, #2A1D10 0%, #3D2C18 50%, #6B4A26 100%);
  --gradient-primary: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-deep) 100%);
  --gradient-success: linear-gradient(135deg, #6E8E6E 0%, #8FAE8F 100%);
  --gradient-danger: linear-gradient(135deg, #C0522F 0%, #D06B49 100%);

  /* 阴影：深色系 */
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
  --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.36), 0 1px 2px rgba(0, 0, 0, 0.22);
  --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.5), 0 2px 6px rgba(0, 0, 0, 0.3);
  --shadow-press: inset 0 1px 2px rgba(0, 0, 0, 0.35);

  /* 圆角：整体加大一档 */
  --radius-xs: 6rpx;
  --radius-sm: 12rpx;
  --radius-md: 18rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-pill: 999rpx;

  --duration-fast: 160ms;
  --duration-base: 240ms;
  --duration-slow: 320ms;
  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  background: var(--color-bg);
}

/* ========== 5 套主题切换（侘寂化） ==========
 * 说明：小程序无法在 <page> 根元素上绑定自定义属性（data-theme 挂不到 page 上），
 * 因此各页面在根 wrapper view 上绑定 data-theme + themed 类，
 * 主题变量通过 .themed[data-theme='X'] 生效并向下级联。
 */
.themed {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
  color: var(--color-text);
}
/* 暖陶（原 dark 槽位 → 深炭墨侘寂） */
.themed[data-theme='dark'] {
  --color-bg: #2C2823;
  --color-bg-elevated: #38332C;
  --color-bg-soft: #45403A;
  --color-card: #3A352E;
  --color-text: #F2EDE4;
  --color-text-soft: #BFB5A5;
  --color-text-mute: #8F8574;
  --color-border: #4A443C;
  --color-input-line: #5C554B;
  --color-primary: #D89A6A;
  --color-primary-deep: #C08468;
  --color-primary-ink: #865F42;
  --color-primary-ink-2: #9C6F4C;
  --color-primary-soft: rgba(216, 154, 106, 0.18);
  --color-primary-shadow: rgba(0, 0, 0, 0.4);
  --color-accent: #C9A25E;
  --color-overlay: rgba(0, 0, 0, 0.65);
  --gradient-hero: linear-gradient(135deg, #3B362F 0%, #4A4038 50%, #96573A 100%);
  --gradient-primary: linear-gradient(135deg, #D89A6A 0%, #C08468 100%);
  --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.35), 0 1px 2px rgba(0, 0, 0, 0.2);
  --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.5), 0 2px 6px rgba(0, 0, 0, 0.3);
  --glass-bg: rgba(58, 53, 46, 0.6);
  --glass-bg-strong: rgba(58, 53, 46, 0.85);
  --glass-bg-soft: rgba(58, 53, 46, 0.45);
  --glass-border: rgba(191, 181, 165, 0.22);
  --glass-highlight: rgba(191, 181, 165, 0.3);
  --glass-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  --ambient-1: rgba(216, 160, 92, 0.14);
  --ambient-2: rgba(192, 154, 94, 0.1);
  --ambient-3: rgba(126, 158, 126, 0.08);
  /* 深色底：主页工艺 token 必须一并压暗 —— 否则 hero / 卡片会是「暖纸亮面板」贴在深底上 */
  --home-card-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.06) inset, 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
  --home-hero-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.4);
  --home-bar-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.45), 0 1rpx 0 rgba(255, 255, 255, 0.08) inset;
}
/* 深邃暗夜（原 rose 槽位 → 深蓝夜空 · 冷调深色）
 * 深色主题必须把「暖纸玻璃 token」与阴影一并覆盖：
 * page 默认值是浅色系（glass-bg 接近白、阴影是暖灰），
 * 只改 --color-bg / --color-text 会让浮层、卡片仍是白玻璃块，深色下非常刺眼。
 * 变量清单与 data-theme='dark' 保持一致，避免出现漏改的浅色残留。 */
.themed[data-theme='rose'] {
  --color-bg: #0C1017;
  --color-bg-elevated: #18202C;
  --color-bg-soft: #212A38;
  --color-card: #18202C;
  --color-text: #E9EEF7;
  --color-text-soft: #A6B2C6;
  --color-text-mute: #7C8A9E;
  --color-border: #262F3E;
  --color-input-line: #364154;
  --color-primary: #6F84CE;
  --color-primary-deep: #55679F;
  --color-primary-ink: #2A3150;
  --color-primary-ink-2: #3A4468;
  --color-primary-soft: rgba(111, 132, 206, 0.2);
  --color-primary-shadow: rgba(0, 0, 0, 0.45);
  --color-accent: #9FB6E8;
  --color-overlay: rgba(0, 0, 0, 0.68);
  --gradient-hero: linear-gradient(135deg, #101828 0%, #1B2743 50%, #3B4A7E 100%);
  --gradient-primary: linear-gradient(135deg, #6F84CE 0%, #55679F 100%);
  --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.4), 0 1px 2px rgba(0, 0, 0, 0.25);
  --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.55), 0 2px 6px rgba(0, 0, 0, 0.35);
  --glass-bg: rgba(24, 32, 44, 0.6);
  --glass-bg-strong: rgba(24, 32, 44, 0.85);
  --glass-bg-soft: rgba(24, 32, 44, 0.45);
  --glass-border: rgba(166, 178, 198, 0.2);
  --glass-highlight: rgba(166, 178, 198, 0.28);
  --glass-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.45), inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
  --ambient-1: rgba(111, 132, 206, 0.16);
  --ambient-2: rgba(159, 182, 232, 0.1);
  --ambient-3: rgba(92, 110, 160, 0.1);
  /* 深色底：主页工艺 token 同 dark 档（rose 槽位也是深色主题） */
  --home-card-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.06) inset, 0 8rpx 24rpx rgba(0, 0, 0, 0.32);
  --home-hero-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.42);
  --home-bar-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.48), 0 1rpx 0 rgba(255, 255, 255, 0.08) inset;
}
/* ⑪ 自然森系·Forest Calm：森林绿 / 苔藓绿 / 米白 / 木棕 / 雾蓝 +
 * 半透玻璃 + 自然纹理 + 大圆角 + 柔和阴影，像漂浮在森林里的信息面板（专注、放松） */
.themed[data-theme='forest'] {
  --color-bg: #EAF1E9;
  --color-bg-elevated: #FBFDFA;
  --color-bg-soft: #DCE8DB;
  --color-card: #FBFDFA;
  --color-text: #25352B;
  --color-text-soft: #4F6655;
  --color-text-mute: #8AA294;
  --color-border: #D5E2D4;
  --color-input-line: #B6CDB8;
  --color-primary: #3F7A52;
  --color-primary-deep: #2C5E3E;
  --color-primary-ink: #1E3D28;
  --color-primary-ink-2: #274A33;
  --color-primary-soft: rgba(63, 122, 82, 0.14);
  --color-primary-shadow: rgba(44, 94, 62, 0.24);
  --color-accent: #7FA8C9;
  --color-overlay: rgba(37, 53, 43, 0.42);
  --gradient-hero: linear-gradient(135deg, #3F7A52 0%, #6B9E74 50%, #AECDB0 100%);
  --gradient-primary: linear-gradient(135deg, #3F7A52 0%, #2C5E3E 100%);
  --shadow-md: 0 4px 14px rgba(37, 53, 43, 0.1), 0 1px 3px rgba(37, 53, 43, 0.06);
  --shadow-lg: 0 12px 30px rgba(37, 53, 43, 0.14), 0 2px 8px rgba(37, 53, 43, 0.08);
  --glass-bg: rgba(251, 253, 250, 0.72);
  --glass-bg-strong: rgba(251, 253, 250, 0.9);
  --glass-bg-soft: rgba(251, 253, 250, 0.52);
  --glass-border: rgba(176, 205, 184, 0.4);
  --glass-highlight: rgba(255, 255, 255, 0.9);
  --glass-shadow: 0 8rpx 28rpx rgba(37, 53, 43, 0.1);
  --metal-1: #3F7A52;
  --metal-2: #AEBBA9;
  --metal-3: #2C5E3E;
  --ambient-1: rgba(111, 158, 116, 0.16);
  --ambient-2: rgba(174, 205, 176, 0.16);
  --ambient-3: rgba(127, 168, 201, 0.1);
  /* 森系工艺：标准大圆角 + 极轻绿影 */
  --home-card-r: 36rpx;
  --home-card-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.85) inset, 0 8rpx 22rpx rgba(37, 53, 43, 0.08);
  --home-hero-r: 44rpx;
  --home-hero-shadow: 0 14rpx 34rpx rgba(63, 122, 82, 0.2);
  --home-bar-r: 999rpx;
  --home-bar-shadow: 0 12rpx 30rpx rgba(37, 53, 43, 0.12);
}
/* 暮金（原 twilight 槽位 → 旧金侘寂） */
.themed[data-theme='twilight'] {
  --color-bg: #F1EDE2;
  --color-bg-elevated: #FCFBF6;
  --color-bg-soft: #EAE4D4;
  --color-card: #FCFBF6;
  --color-text: #342F26;
  --color-text-soft: #6B6250;
  --color-text-mute: #A0957F;
  --color-border: #E2DAC6;
  --color-input-line: #D0C5A9;
  --color-primary: #A98743;
  --color-primary-deep: #8C6E30;
  --color-primary-ink: #5D4A25;
  --color-primary-ink-2: #735C2E;
  --color-primary-soft: rgba(169, 135, 67, 0.12);
  --color-primary-shadow: rgba(140, 110, 48, 0.26);
  --color-accent: #C09A5E;
  --gradient-hero: linear-gradient(135deg, #8C6E30 0%, #A98743 50%, #D8BC85 100%);
  --gradient-primary: linear-gradient(135deg, #A98743 0%, #8C6E30 100%);
  --glass-border: rgba(252, 250, 242, 0.9);
  --ambient-1: rgba(192, 154, 94, 0.14);
  --ambient-2: rgba(216, 160, 92, 0.12);
  --ambient-3: rgba(126, 158, 126, 0.08);
}
/* 艳红绯纸（scarlet）：绯红陶土调 */
.themed[data-theme='scarlet'] {
  --color-bg: #F4E9E2;
  --color-bg-elevated: #FCF8F4;
  --color-bg-soft: #EBDDD2;
  --color-card: #FCF8F4;
  --color-text: #3A2C26;
  --color-text-soft: #7A5A4C;
  --color-text-mute: #AC8776;
  --color-border: #E8D5C8;
  --color-input-line: #D6B8A5;
  --color-primary: #B5502F;
  --color-primary-deep: #96401F;
  --color-primary-ink: #642C1A;
  --color-primary-ink-2: #7B3620;
  --color-primary-soft: rgba(181, 80, 47, 0.12);
  --color-primary-shadow: rgba(150, 64, 31, 0.26);
  --color-accent: #C08468;
  --gradient-hero: linear-gradient(135deg, #8C2F2F 0%, #C0522F 50%, #E3A084 100%);
  --gradient-primary: linear-gradient(135deg, #B5502F 0%, #96401F 100%);
  --glass-border: rgba(252, 248, 244, 0.9);
  --ambient-1: rgba(192, 82, 47, 0.13);
  --ambient-2: rgba(224, 160, 106, 0.11);
  --ambient-3: rgba(192, 154, 94, 0.08);
}
/* 翠玉青瓷（jade）：青瓷玉绿调 */
.themed[data-theme='jade'] {
  --color-bg: #E8EFE9;
  --color-bg-elevated: #FAFCF9;
  --color-bg-soft: #DCE7DE;
  --color-card: #FAFCF9;
  --color-text: #2C362E;
  --color-text-soft: #5C7263;
  --color-text-mute: #8FA396;
  --color-border: #D5E2D7;
  --color-input-line: #B8CCBC;
  --color-primary: #3E6B52;
  --color-primary-deep: #2E5540;
  --color-primary-ink: #223B2D;
  --color-primary-ink-2: #2A4938;
  --color-primary-soft: rgba(62, 107, 82, 0.12);
  --color-primary-shadow: rgba(46, 85, 64, 0.26);
  --color-accent: #749C84;
  --gradient-hero: linear-gradient(135deg, #3E6B52 0%, #5C8E6E 50%, #A8CBB2 100%);
  --gradient-primary: linear-gradient(135deg, #3E6B52 0%, #2E5540 100%);
  --glass-border: rgba(250, 252, 249, 0.9);
  --ambient-1: rgba(92, 142, 110, 0.14);
  --ambient-2: rgba(168, 203, 178, 0.11);
  --ambient-3: rgba(192, 154, 94, 0.07);
}
/* 靛蓝夜航（indigo）：靛蓝青金调 */
.themed[data-theme='indigo'] {
  --color-bg: #E9EBF2;
  --color-bg-elevated: #FAFBFD;
  --color-bg-soft: #DDE1EC;
  --color-card: #FAFBFD;
  --color-text: #2A3040;
  --color-text-soft: #5A6478;
  --color-text-mute: #8E96AB;
  --color-border: #D8DCE8;
  --color-input-line: #BCC2D4;
  --color-primary: #4A5A8C;
  --color-primary-deep: #384670;
  --color-primary-ink: #29324D;
  --color-primary-ink-2: #323D5F;
  --color-primary-soft: rgba(74, 90, 140, 0.12);
  --color-primary-shadow: rgba(56, 70, 112, 0.26);
  --color-accent: #7C8CBA;
  --gradient-hero: linear-gradient(135deg, #3A4A7C 0%, #5C6E9E 50%, #A8B4D8 100%);
  --gradient-primary: linear-gradient(135deg, #4A5A8C 0%, #384670 100%);
  --glass-border: rgba(250, 251, 253, 0.9);
  --ambient-1: rgba(92, 110, 158, 0.14);
  --ambient-2: rgba(168, 180, 216, 0.11);
  --ambient-3: rgba(216, 160, 92, 0.07);
}
/* ===== 十大风格槽位（对齐效果图，每套自带差异化首页工艺） ===== */

/* ① 极简白·Clean Minimal：纯白 / 暖白 / 浅灰 + 少量深灰与蓝色强调 + 大量留白 +
 * 纤细线性图标 + 细腻圆角 + 极轻阴影 + 清晰信息层级 */
.themed[data-theme='minimal'] {
  --color-bg: #FFFFFF;
  --color-bg-elevated: #FFFFFF;
  --color-bg-soft: #F4F6F9;
  --color-card: #FFFFFF;
  --color-text: #1C2230;
  --color-text-soft: #5B6573;
  --color-text-mute: #9AA3AF;
  --color-border: #ECEFF3;
  --color-input-line: #DCE1E8;
  --color-primary: #2F6BFF;
  --color-primary-deep: #1E54E8;
  --color-primary-ink: #16307F;
  --color-primary-ink-2: #20408F;
  --color-primary-soft: rgba(47, 107, 255, 0.1);
  --color-primary-shadow: rgba(30, 84, 232, 0.16);
  --color-accent: #38BDF8;
  --color-overlay: rgba(15, 23, 42, 0.38);
  --gradient-hero: linear-gradient(135deg, #5B8DEF 0%, #2F6BFF 50%, #7FA8FF 100%);
  --gradient-primary: linear-gradient(135deg, #2F6BFF 0%, #1E54E8 100%);
  --shadow-md: 0 2px 10px rgba(20, 28, 46, 0.05), 0 1px 2px rgba(20, 28, 46, 0.03);
  --shadow-lg: 0 8px 28px rgba(20, 28, 46, 0.09), 0 2px 6px rgba(20, 28, 46, 0.05);
  --glass-bg: rgba(255, 255, 255, 0.8);
  --glass-bg-strong: rgba(255, 255, 255, 0.92);
  --glass-bg-soft: rgba(255, 255, 255, 0.6);
  --glass-border: rgba(20, 28, 46, 0.07);
  --glass-highlight: rgba(255, 255, 255, 0.95);
  --glass-shadow: 0 6rpx 20rpx rgba(20, 28, 46, 0.05);
  --metal-1: #2F6BFF;
  --metal-2: #7FA8FF;
  --metal-3: #1E54E8;
  --ambient-1: rgba(47, 107, 255, 0.06);
