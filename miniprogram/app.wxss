/* ============================================================
 * 【光影剧场】全局电影级视觉基座
 * ------------------------------------------------------------
 * 设计目标：在既有「侘寂」低饱和美学之上，叠加电影级的「光、影、材质、动势」，
 * 让任意页面一打开就有纵深与呼吸感，而不是一块平涂的底色。
 *
 * 为什么放在全局 / app.wxss：
 *   • 47 个页面的根 wrapper 都是 .themed，改它的背景即可零改动级联全站；
 *   • 小程序无法给 <page> 绑 data-theme，所有主题分支仍需靠 .themed[data-theme] ;
 *   • 分包体积吃紧，本段以「变量 + 通用类」提供能力，不增加任何图片资源。
 *
 * 性能约束（务必遵守）：
 *   • 动画只允许动 transform / opacity（走合成层，不触发 layout / paint）；
 *   • 不用 backdrop-filter 铺大面（低端机掉帧），毛玻璃只留给小面积 dock / pill；
 *   • 同屏常驻动画元素 ≤ 3，其余用一次性入场动画。
 * ============================================================ */

page {
  /* ===== 景深：多段阴影（暮金夜色版：黑影 + 金调缘线） ===== */
  --elev-1: 0 2rpx 8rpx rgba(0, 0, 0, .3), 0 1rpx 2rpx rgba(0, 0, 0, .2);
  --elev-2: 0 8rpx 24rpx rgba(0, 0, 0, .38), 0 2rpx 6rpx rgba(0, 0, 0, .24);
  --elev-3: 0 18rpx 48rpx rgba(0, 0, 0, .5), 0 6rpx 16rpx rgba(0, 0, 0, .3);
  --elev-4: 0 32rpx 72rpx rgba(0, 0, 0, .6), 0 10rpx 26rpx rgba(0, 0, 0, .36);
  /* 顶缘反光：让卡片像有厚度的实体而非贴纸 */
  --edge-top: inset 0 1rpx 0 rgba(255, 233, 198, .16);
  --edge-line: 0 0 0 1rpx rgba(226, 178, 115, .16);
  /* 王冠光：卡片上缘的一道细亮线，营造「被顶光照亮」的剧场感 */
  --crown-light: inset 0 2rpx 0 rgba(255, 233, 198, .18), inset 0 -1rpx 0 rgba(0, 0, 0, .25);

  /* ===== 金属强调（琥珀金），用于重点数字 / 标题 / 徽标 ===== */
  --metal-1: #E2B273;
  --metal-2: #F2D9A8;
  --metal-3: #B98A4E;
  --gradient-metal: linear-gradient(135deg, var(--metal-3) 0%, var(--metal-1) 40%, var(--metal-2) 70%, var(--metal-1) 100%);

  /* ===== 体积光 / 光轴：大幅柔和，作为背景顶层高光 ===== */
  --shaft-1: rgba(255, 232, 190, .14);
  --shaft-2: rgba(255, 232, 190, .07);

  /* ===== 影片质感叠层：颗粒 + 暗角 ===== */
  --fx-grain-a: rgba(255, 255, 255, .05);
  --fx-grain-b: rgba(255, 255, 255, .035);
  /* 颗粒与暗角都直接由上面两个颜色的 alpha 控制，不再叠加整层 opacity
     （否则会把暗角一起淡掉，失去电影构图感） */
  --fx-vignette: radial-gradient(125% 92% at 50% 40%, rgba(0, 0, 0, 0) 46%, rgba(0, 0, 0, .38) 100%);

  /* ===== 缓动曲线（更接近电影感的「先快后缓」） ===== */
  --ease-cinema: cubic-bezier(.16, .84, .28, 1);
  --ease-spring: cubic-bezier(.34, 1.56, .64, 1);
}

/* 深色主题槽位（dark/rose/tech/noir/pixel/deepsea/career 保持各自的深色基座，与暮金默认一致） */
.themed[data-theme='dark'],
.themed[data-theme='rose'],
.themed[data-theme='tech'],
.themed[data-theme='noir'],
.themed[data-theme='pixel'],
.themed[data-theme='deepsea'],
.themed[data-theme='career'] {
  --elev-1: 0 2rpx 8rpx rgba(0, 0, 0, .3), 0 1rpx 2rpx rgba(0, 0, 0, .2);
  --elev-2: 0 8rpx 24rpx rgba(0, 0, 0, .38), 0 2rpx 6rpx rgba(0, 0, 0, .24);
  --elev-3: 0 18rpx 48rpx rgba(0, 0, 0, .5), 0 6rpx 16rpx rgba(0, 0, 0, .3);
  --elev-4: 0 32rpx 72rpx rgba(0, 0, 0, .6), 0 10rpx 26rpx rgba(0, 0, 0, .36);
  --edge-top: inset 0 1rpx 0 rgba(255, 255, 255, .1);
  --edge-line: 0 0 0 1rpx rgba(255, 255, 255, .07);
  --crown-light: inset 0 2rpx 0 rgba(255, 255, 255, .12), inset 0 -1rpx 0 rgba(0, 0, 0, .2);
  --shaft-1: rgba(255, 255, 255, .09);
  --shaft-2: rgba(255, 255, 255, .05);
  --fx-grain-a: rgba(255, 255, 255, .05);
  --fx-grain-b: rgba(255, 255, 255, .035);
  --fx-vignette: radial-gradient(125% 92% at 50% 40%, rgba(0, 0, 0, 0) 46%, rgba(0, 0, 0, .36) 100%);
}

/* 深海蓝金：把「白缘线」换成「香槟金缘线」，让卡片边缘自带品牌识别 */
.themed[data-theme='deepsea'] {
  --edge-top: inset 0 1rpx 0 rgba(186, 210, 244, .12);
  --edge-line: 0 0 0 1rpx rgba(211, 172, 116, .16);
  --crown-light: inset 0 2rpx 0 rgba(186, 210, 244, .14), inset 0 -1rpx 0 rgba(0, 0, 0, .3);
  --shaft-1: rgba(186, 210, 244, .1);
  --shaft-2: rgba(211, 172, 116, .06);
  --fx-vignette: radial-gradient(125% 92% at 50% 38%, rgba(0, 0, 0, 0) 44%, rgba(2, 6, 14, .46) 100%);
}

/* 深海蓝金：悬浮新增按钮 = 蓝色玻璃材质 + 微弱金色边缘光（品牌元素） */
.themed[data-theme='deepsea'] .fab {
  background:
    radial-gradient(120% 120% at 30% 22%, rgba(186, 210, 244, .28) 0%, rgba(186, 210, 244, 0) 58%),
    linear-gradient(140deg, rgba(76, 125, 224, .92) 0%, rgba(53, 98, 196, .92) 100%);
  box-shadow:
    0 14rpx 34rpx rgba(2, 6, 14, .55),
    0 4rpx 10rpx rgba(2, 6, 14, .3),
    0 0 0 8rpx rgba(17, 32, 54, .5),
    0 0 0 2rpx rgba(211, 172, 116, .5),
    inset 0 2rpx 0 rgba(255, 255, 255, .24);
}
.themed[data-theme='deepsea'] .fab__halo {
  background: radial-gradient(circle, rgba(211, 172, 116, .5) 0%, rgba(211, 172, 116, 0) 70%);
}

/* 浅色主题槽位：电影级光影 token 需换成「日光版」——
 * 柔和灰影 + 白色冠光 + 极淡暗角，避免沿用暮金深影导致浅色页面发脏 */
.themed[data-theme='forest'],
.themed[data-theme='twilight'],
.themed[data-theme='scarlet'],
.themed[data-theme='jade'],
.themed[data-theme='indigo'],
.themed[data-theme='minimal'],
.themed[data-theme='healing'],
.themed[data-theme='candy'],
.themed[data-theme='retro'],
.themed[data-theme='morandi'],
.themed[data-theme='aurora'],
.themed[data-theme='ink'],
.themed[data-theme='liquid'] {
  --elev-1: 0 2rpx 8rpx rgba(23, 20, 14, .07), 0 1rpx 2rpx rgba(23, 20, 14, .04);
  --elev-2: 0 8rpx 24rpx rgba(23, 20, 14, .1), 0 2rpx 6rpx rgba(23, 20, 14, .06);
  --elev-3: 0 18rpx 48rpx rgba(23, 20, 14, .14), 0 6rpx 16rpx rgba(23, 20, 14, .08);
  --elev-4: 0 32rpx 72rpx rgba(23, 20, 14, .18), 0 10rpx 26rpx rgba(23, 20, 14, .1);
  --edge-top: inset 0 1rpx 0 rgba(255, 255, 255, .85);
  --edge-line: 0 0 0 1rpx rgba(23, 20, 14, .06);
  --crown-light: inset 0 2rpx 0 rgba(255, 255, 255, .9), inset 0 -1rpx 0 rgba(23, 20, 14, .04);
  --shaft-1: rgba(255, 255, 255, .5);
  --shaft-2: rgba(255, 255, 255, .28);
  --fx-grain-a: rgba(23, 20, 14, .026);
  --fx-grain-b: rgba(23, 20, 14, .018);
  --fx-vignette: radial-gradient(125% 92% at 50% 40%, rgba(0, 0, 0, 0) 54%, rgba(23, 20, 14, .09) 100%);
}

/* ============================================================
 * 一、大气底：让 .themed 从「一块平色」变成有光有纵深的空间
 * 三段环境晕（左上暖光 / 右上金光 / 底部回照）+ 一道斜向光轴，
 * 全部用既有 --ambient-* 变量，因此换主题自动联动。
 * ============================================================ */
.themed {
  background:
    linear-gradient(115deg, var(--shaft-2) 0%, rgba(0, 0, 0, 0) 34%),
    radial-gradient(88% 46% at 6% -8%, var(--ambient-1) 0%, rgba(0, 0, 0, 0) 62%),
    radial-gradient(72% 40% at 98% 2%, var(--ambient-2) 0%, rgba(0, 0, 0, 0) 60%),
    radial-gradient(92% 44% at 46% 104%, var(--ambient-3) 0%, rgba(0, 0, 0, 0) 64%),
    linear-gradient(180deg, var(--color-bg-elevated) 0%, var(--color-bg) 22%, var(--color-bg) 100%);
  background-repeat: no-repeat;
}

/* ============================================================
 * 二、影片质感：全局噪点 + 暗角（page::after，浮于内容之上）
 * pointer-events:none 保证不挡交互；极低的 alpha 保证不影响可读性。
 * 若某些真机不支持 page 伪元素，退化结果 = 没有这层加成，不会出错。
 * ============================================================ */
page::after {
  content: '';
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 9998;
  pointer-events: none;
  background-image:
    repeating-linear-gradient(0deg, var(--fx-grain-a) 0 1rpx, rgba(0, 0, 0, 0) 1rpx 3rpx),
    repeating-linear-gradient(90deg, var(--fx-grain-b) 0 1rpx, rgba(0, 0, 0, 0) 1rpx 3rpx),
    var(--fx-vignette);
  background-repeat: repeat, repeat, no-repeat;
}
/* 备注：这一层挂在 page 伪元素上，无法由后代 class 关掉（CSS 不能反向选祖先）。
 * 若某个页面确实需要纯净底（如图片编辑器画布），在该页 wxss 里写
 *   `page::after { display: none }` 局部覆盖即可。 */

/* ============================================================
 * 三、材质基类：让「面子」有厚度、有光泽、有巴掌感
 * ============================================================ */

/* 剧场卡片：顶缘冠光 + 两层投影 + 细描边 */
.fx-card {
  position: relative;
  border-radius: var(--radius-xl);
  background: var(--color-card);
  box-shadow: var(--crown-light), var(--elev-2), var(--edge-line);
  transition: transform var(--duration-fast) var(--ease-cinema), box-shadow var(--duration-base) var(--ease-cinema);
}
/* 高亮态 / 按下态：抬升 + 加深投影，形成明确的三维反馈 */
.fx-card--lift { box-shadow: var(--crown-light), var(--elev-3), var(--edge-line); }
.fx-card--press { transform: translate3d(0, 2rpx, 0) scale(.992); box-shadow: var(--crown-light), var(--elev-1), var(--edge-line); }

/* 英雄面板：更大圆角 + 渐变底色 + 内阴影，撑起首屏气势 */
.fx-hero {
  position: relative;
  overflow: hidden;
  border-radius: 44rpx;
  background: var(--gradient-hero);
  box-shadow: var(--home-hero-shadow, var(--elev-4)), inset 0 2rpx 0 rgba(255, 255, 255, .28);
}

/* 强调描边环（不依赖 mask 合成，兼容性优先） */
.fx-ring { box-shadow: var(--edge-line), var(--elev-2); }
.fx-ring--gold { box-shadow: 0 0 0 2rpx rgba(192, 154, 94, .38), var(--elev-2); }

/* 金属渐变文字：用于大数字 / 重要标题 */
.fx-metal-text {
  background: var(--gradient-metal);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}

/* 一道极细的底部渐隐分割线，替代生硬的 1rpx 实线 */
.fx-hairline {
  height: 2rpx;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0), var(--color-border) 18%, var(--color-border) 82%, rgba(0, 0, 0, 0));
  border: 0;
}

/* ============================================================
 * 四、动效原语（全部只动 transform / opacity）
 * ============================================================ */
@keyframes fx-rise {
  from { opacity: 0; transform: translate3d(0, 26rpx, 0) scale(.985); }
  to { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
}
@keyframes fx-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes fx-pop {
  0% { opacity: 0; transform: scale(.9); }
  60% { opacity: 1; transform: scale(1.03); }
  100% { transform: scale(1); }
}
@keyframes fx-float {
  0%, 100% { transform: translate3d(0, 0, 0); }
  50% { transform: translate3d(0, -10rpx, 0); }
}
@keyframes fx-breathe {
  0%, 100% { opacity: .5; transform: scale(1); }
  50% { opacity: .16; transform: scale(1.22); }
}
@keyframes fx-sweep {
  0% { left: -65%; }
  55%, 100% { left: 135%; }
}
@keyframes fx-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
@keyframes fx-drift {
  0% { transform: translate3d(0, 0, 0) scale(1); }
  50% { transform: translate3d(36rpx, -28rpx, 0) scale(1.07); }
  100% { transform: translate3d(-28rpx, 24rpx, 0) scale(.95); }
}

/* 入场：单个元素 */
.fx-rise { animation: fx-rise .52s var(--ease-cinema) both; }
.fx-fade { animation: fx-fade .5s linear both; }
.fx-pop { animation: fx-pop .46s var(--ease-spring) both; }

/* 入场：子元素逐个错落浮现（列表 / 宫格首选，最多铺 10 个）
   ⚠ WXSS 不支持 `*` 通配选择器（会直接编译报错：`error at token *`），
     因此这里显式枚举小程序内置标签。若子元素是自定义组件标签，
     给它加上 .fx-stagger__i 即可同样参与错落。 */
.fx-stagger > view,
.fx-stagger > text,
.fx-stagger > navigator,
.fx-stagger > button,
.fx-stagger .fx-stagger__i { animation: fx-rise .5s var(--ease-cinema) both; }

.fx-stagger > view:nth-child(1), .fx-stagger .fx-stagger__i:nth-child(1) { animation-delay: 0s; }
.fx-stagger > view:nth-child(2), .fx-stagger .fx-stagger__i:nth-child(2) { animation-delay: .05s; }
.fx-stagger > view:nth-child(3), .fx-stagger .fx-stagger__i:nth-child(3) { animation-delay: .1s; }
.fx-stagger > view:nth-child(4), .fx-stagger .fx-stagger__i:nth-child(4) { animation-delay: .15s; }
.fx-stagger > view:nth-child(5), .fx-stagger .fx-stagger__i:nth-child(5) { animation-delay: .2s; }
.fx-stagger > view:nth-child(6), .fx-stagger .fx-stagger__i:nth-child(6) { animation-delay: .25s; }
.fx-stagger > view:nth-child(7), .fx-stagger .fx-stagger__i:nth-child(7) { animation-delay: .3s; }
.fx-stagger > view:nth-child(8), .fx-stagger .fx-stagger__i:nth-child(8) { animation-delay: .34s; }
.fx-stagger > view:nth-child(9), .fx-stagger .fx-stagger__i:nth-child(9) { animation-delay: .38s; }
.fx-stagger > view:nth-child(n + 10), .fx-stagger .fx-stagger__i:nth-child(n + 10) { animation-delay: .42s; }

/* 常驻轻轻呼吸 / 漂浮（每个页面控制在 3 个以内） */
.fx-float { animation: fx-float 5.2s ease-in-out infinite; }
.fx-float--slow { animation-duration: 8s; }

/* 扫光：给重点按钮 / hero 加一道周期性划过的亮线 */
.fx-shine { position: relative; overflow: hidden; }
.fx-shine::after {
  content: '';
  position: absolute;
  top: 0;
  left: -65%;
  width: 42%;
  height: 100%;
  background: linear-gradient(100deg, rgba(255, 255, 255, 0), var(--shaft-1), rgba(255, 255, 255, 0));
  transform: skewX(-18deg);
  animation: fx-sweep 4.4s ease-in-out infinite;
  pointer-events: none;
}
.fx-shine--once::after { animation: fx-sweep 1.6s ease-out 1 both; }

/* 光晕底座（放在 FAB / 重点图标下方，营造发光体） */
.fx-halo { position: relative; }
.fx-halo::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 200%;
  height: 200%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(circle, var(--color-primary-soft), rgba(0, 0, 0, 0) 68%);
  animation: fx-breathe 3.4s ease-in-out infinite;
  pointer-events: none;
  z-index: 0;
}
/* ⚠ 同样不能用 `*`，显式枚举标签把内容抬到光晕之上 */
.fx-halo > view,
.fx-halo > text,
.fx-halo > image,
.fx-halo > button,
.fx-halo > navigator { position: relative; z-index: 1; }

/* 升级既有 .ambient-layer：更大更柔的光斑 + 更慢的漂移，剧院追光感 */
.themed .ambient-blob,
.ambient-blob { filter: blur(110rpx); }
.ambient-blob--1 { width: 620rpx; height: 620rpx; animation-duration: 26s; }
.ambient-blob--2 { width: 520rpx; height: 520rpx; animation-duration: 32s; }
.ambient-blob--3 { width: 560rpx; height: 560rpx; animation-duration: 38s; }

/* ============================================================
 * 五、通用Presses / 反馈增强
 * ============================================================ */
/* 卡片级按压：下沉而非单纯缩放，更符合「有厚度的实体」 */
.fx-tap { transition: transform var(--duration-fast) var(--ease-cinema), box-shadow var(--duration-fast) var(--ease-cinema); }
.fx-tap:active { transform: translate3d(0, 3rpx, 0) scale(.985); }
.tap-press { transform: scale(.97) translate3d(0, 2rpx, 0); opacity: .76; }
