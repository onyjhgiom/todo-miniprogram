{
  "compilerOptions": {
    "target": "ES2018",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2018"],
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "removeComments": false,
    "sourceMap": true,
    "types": []
  },
  "include": ["miniprogram/**/*.ts"],
  "exclude": ["node_modules", "cloudfunctions"]
}
